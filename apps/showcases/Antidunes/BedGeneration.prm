BedGeneration{
    // Sized so that avgParticleDiameter = 8.0 LU on the 128-cell-wide Antidunes domain (scalingFactor =
    // 128/domainSize_SI[0] = 2757.14; 6.0 LU on a 96-wide domain), with diameter_SI = 2.9 mm, the value of
    // the original antidunes branch, for which the computed lattice gravity converts back to 9.81 m/s^2
    // (g_SI depends only on diameter_SI here).
    //
    // domainSize_SI[1] carries a deliberate safety margin above the exact 60/128 (=45/96) ratio (+0.3 cell
    // at width 128, +0.225 at 96): Utility.h's getAvgDiameterScalingFactor re-derives scalingFactor from
    // spheres_out.dat's own (text-truncated, ~13-sig-fig) header line and checks
    // uint_c(scalingFactor*domainSize_SI[1]) == domainSize[1] EXACTLY -- uint_c() truncates rather than
    // rounds, so an exact-ratio value that round-trips through that text precision as even 1e-10 low
    // (59.999999999... instead of 60.0) truncates to the WRONG integer and aborts.
    domainSize_SI < 0.046424848318763846, 0.021870455887667655, 0.145077650996137 >;
    blocks < 3, 2, 12 >;
    diameter_SI 0.0029015530199227404;
    gravity_SI 9.81;
    densityFluid_SI 1000;
    densityParticle_SI 2550;
    generationSpacing_SI 0.005077717784864796;
    initialVelocity_SI 1;
    dt_SI 5e-5;
    frictionCoefficient 0.5;
    restitutionCoefficient 0.1;
    collisionTime_SI 5e-4;
    poissonsRatio 0.22;
    timeSteps 10000;
    visSpacing 100;
    outFileName spheres_out.dat;
    denseBottomLayer False;
    bottomLayerOffsetFactor 1.0;
}