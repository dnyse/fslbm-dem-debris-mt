#!/bin/bash -l
#SBATCH --job-name=antidunes-hopper-clog-pidon-2node
#SBATCH --partition=multinode
#SBATCH --nodes=2
#SBATCH --ntasks=144
#SBATCH --time=06:00:00
#SBATCH --output=sbatch-output/output/hopper_clog_pidon_2node_%j.out
#SBATCH --error=sbatch-output/error/hopper_clog_pidon_2node_%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=dennys.huber@fau.de

# [Claude, 2026-09-18] Thesis item 3 (THESIS_PLAN.md) -- second clogging setup, "hopper": two cylindrical
# pillars centred on the Y walls leave a 16 LU central gap; 1008 small spheres (d=6, each able to pass
# alone) start together in the water/at the surface upstream and are released at once (t=2000) to see
# whether they arch across the gap. See hopper_clog_pidon_2node_gas.prm's own header (generated by
# gen_hopper_clog_prm.py) for the full design.
#
# Same domain/decomposition as run_144_clog_measurement_validation_extreme_pidon_fresh_2node.sbatch
# (<768,40,180>, cellsPerBlock <64,20,30> -> 144 ranks), so the per-step cost is comparable; the 1008
# spheres add DEM/MEM load on the ~12 ranks that own the block. Runtime is UNVERIFIED (first run of
# this scenario): 6h requested; snapshotFrequency 5000 allows a resume if it runs long.
set -euo pipefail

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
    REPO="$(cd "$SLURM_SUBMIT_DIR/../../.." && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    REPO="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
fi
SH="$REPO/apps/showcases/Antidunes/antidunes.sh"
PRM_DIR="$REPO/apps/showcases/Antidunes/prms"
BIN_DIR="$REPO/build/apps/showcases/Antidunes"

for dir in vtk-out eval snapshots; do
    if [[ -d "$BIN_DIR/$dir" ]]; then
        echo "WARNING: removing leftover $BIN_DIR/$dir from an unarchived previous run" >&2
        rm -rf "${BIN_DIR:?}/$dir"
    fi
done

"$SH" --build --jobs "$(nproc)"

echo "############################################################"
echo "## hopper clog: 2 wall-centred pillars (gap 16), 1008 spheres d=6, densities 0.5/1.0/1.2, PID on"
echo "############################################################"
"$SH" --run --np 144 --prm "$PRM_DIR/hopper_clog_pidon_2node_gas.prm"

# Prefer $HPCVAULT, decided and verified HERE (right before use) -- see
# run_144_clog_measurement_validation_extreme_pidon_fresh_2node.sbatch for the rationale.
STAMP="$(date +%Y%m%d_%H%M%S)"
VAULT_CANDIDATE="${HPCVAULT:-}/antidunes-archive/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_${STAMP}"
if [[ -n "${HPCVAULT:-}" ]] && mkdir -p "$VAULT_CANDIDATE" 2>/dev/null \
   && touch "$VAULT_CANDIDATE/.write_test" 2>/dev/null; then
    rm -f "$VAULT_CANDIDATE/.write_test"
    ARCHIVE_ROOT="$VAULT_CANDIDATE"
else
    ARCHIVE_ROOT="$BIN_DIR/archive/${STAMP}_hopper_clog_pidon_2node"
    mkdir -p "$ARCHIVE_ROOT"
    echo "WARNING: \$HPCVAULT unavailable at archive time -- falling back to LOCAL archive at $ARCHIVE_ROOT (move this off manually to avoid quota pressure)" >&2
fi
for d in vtk-out eval snapshots; do
    [[ -d "$BIN_DIR/$d" ]] && mv "$BIN_DIR/$d" "$ARCHIVE_ROOT/$d"
done

echo "## DONE. Archived under $ARCHIVE_ROOT"
