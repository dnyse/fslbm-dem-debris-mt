#!/bin/bash -l
#SBATCH --job-name=antidunes-hopper-clog-box-frontblock-pidon-2node
#SBATCH --partition=multinode
#SBATCH --nodes=2
#SBATCH --ntasks=144
#SBATCH --time=06:00:00
#SBATCH --output=sbatch-output/output/hopper_clog_box_frontblock_pidon_2node_%j.out
#SBATCH --error=sbatch-output/error/hopper_clog_box_frontblock_pidon_2node_%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=dennys.huber@fau.de

# [Claude, 2026-09-30] Box hopper: FULL PRODUCTION-SCALE shape-comparison companion of the cylinder
# hopper (run_144_hopper_clog_cyl_frontblock_pidon_2node.sbatch) -- 406 boxes (halfExtents <3,9,3>,
# matching the rod's own bounding box exactly), same channel/pillars/PID/population grid/
# ModelParameters, generated by gen_hopper_clog_box_prm.py. Per explicit request ("go for the full
# cylinder that we did ... around 400 cylinders, run this but as a cuboid version"). This is the
# production-scale companion to the smaller 24x/48x box doubling-series runs: does the same
# ghost-ownership desync the cylinder hopper reliably produced (the multi-day debugging saga,
# THESIS_PLAN.md section 5) also occur with box-box SAT contacts at the SAME real population/density,
# or does the box shape avoid it even at full scale. The cylinder hopper took up to several hours for
# comparable step counts with heavy contact-diagnostic logging; 6 h requested here too.
set -euo pipefail

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
    REPO="$(cd "$SLURM_SUBMIT_DIR/../../.." && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    REPO="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
fi
SH="$REPO/apps/showcases/Antidunes/antidunes.sh"
PRM_DIR="$REPO/apps/showcases/Antidunes/prms"
BIN_DIR="$REPO/build/apps/showcases/Antidunes"

RESCUE="$BIN_DIR/archive/rescued_before_${SLURM_JOB_ID:-manual}_$(date +%Y%m%d_%H%M%S)"
for dir in vtk-out eval snapshots; do
    if [[ -d "$BIN_DIR/$dir" ]]; then
        mkdir -p "$RESCUE"
        echo "WARNING: leftover $BIN_DIR/$dir from a previous run -- moving to $RESCUE (NOT deleting)" >&2
        mv "$BIN_DIR/$dir" "$RESCUE/$dir"
    fi
done

"$SH" --build --jobs "$(nproc)"

echo "############################################################"
echo "## clog measurement validation: hopper BOXES front-block, PID on, 2-node/144-rank"
echo "############################################################"
set +e
"$SH" --run --np 144 --prm "$PRM_DIR/hopper_clog_box_frontblock_pidon_2node_gas.prm"
RUN_RC=$?
set -e
echo "## run exited with status $RUN_RC -- archiving whatever output exists"

STAMP="$(date +%Y%m%d_%H%M%S)"
VAULT_CANDIDATE="${HPCVAULT:-}/antidunes-archive/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_${STAMP}"
if [[ -n "${HPCVAULT:-}" ]] && mkdir -p "$VAULT_CANDIDATE" 2>/dev/null \
   && touch "$VAULT_CANDIDATE/.write_test" 2>/dev/null; then
    rm -f "$VAULT_CANDIDATE/.write_test"
    ARCHIVE_ROOT="$VAULT_CANDIDATE"
else
    ARCHIVE_ROOT="$BIN_DIR/archive/${STAMP}_hopper_clog_box_frontblock_pidon_2node"
    mkdir -p "$ARCHIVE_ROOT"
    echo "WARNING: \$HPCVAULT unavailable at archive time -- falling back to LOCAL archive at $ARCHIVE_ROOT (move this off manually to avoid quota pressure)" >&2
fi
for d in vtk-out eval snapshots; do
    [[ -d "$BIN_DIR/$d" ]] && mv "$BIN_DIR/$d" "$ARCHIVE_ROOT/$d"
done

echo "## DONE. Archived under $ARCHIVE_ROOT"
exit "$RUN_RC"
