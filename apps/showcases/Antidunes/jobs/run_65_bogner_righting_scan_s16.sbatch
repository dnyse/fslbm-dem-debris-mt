#!/bin/bash -l
#SBATCH --job-name=antidunes-bogner-righting-scan-s16
#SBATCH --partition=singlenode
#SBATCH --nodes=1
#SBATCH --ntasks=65
#SBATCH --time=03:00:00
#SBATCH --output=sbatch-output/output/bogner_righting_scan_s16_%j.out
#SBATCH --error=sbatch-output/error/bogner_righting_scan_s16_%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=dennys.huber@fau.de

# [Claude, 2026-09-19] Thesis item 1a (THESIS_PLAN.md): FIXED-HEEL RIGHTING-MOMENT SCAN with the raw MEM torque (Bogner 2017 Sec. 5.3.2 protocol), s = 16.
# Eight heel angles {0,5,10,15,20,25,26.565,30} deg, one run each, three held boxes per run (rho 0.75 / 0.5 / 0.25, each at its Archimedes heave), MEM-only buoyancy,
# NO analytic buoyancy. Ideal theory: the rho=0.25 and rho=0.75 torque curves are IDENTICAL; any difference is a bias of the MEM force computation.
# See prms/bogner_righting_scan_s16_a*_gas.prm (generated by gen_bogner_righting_scan_prm.py) and prms/bogner_righting_scan_s16_manifest.json (ideal reference values).
#
# Output per run: eval/, vtk-out/ (one mid-plane slice) and floater-history/rank_<N>_state.csv (raw MEM hydroForce/hydroTorque, windowed to steps 19000..19300 -- these CSVs have
# blown the home quota before, so each run's output is MOVED to the archive right after that run). A run that dies (sporadic NaN seen elsewhere) is retried once.
# Time: UNVERIFIED. 20000 steps at 65 ranks ~ 4.5 min (the 50000-step runs of this domain took ~11 min) + startup => ~45 min for 8 angles; 3 h requested.
set -euo pipefail

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
    REPO="$(cd "$SLURM_SUBMIT_DIR/../../.." && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    REPO="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
fi
SH="$REPO/apps/showcases/Antidunes/antidunes.sh"
PRM_DIR="$REPO/apps/showcases/Antidunes/prms"
BIN_DIR="$REPO/build/apps/showcases/Antidunes"
OUTDIRS=(vtk-out eval snapshots floater-history)

# Never DELETE a previous run's output (chained jobs share this checkout): move leftovers aside.
RESCUE="$BIN_DIR/archive/rescued_before_${SLURM_JOB_ID:-manual}_$(date +%Y%m%d_%H%M%S)"
for dir in "${OUTDIRS[@]}"; do
    if [[ -d "$BIN_DIR/$dir" ]]; then
        mkdir -p "$RESCUE"
        echo "WARNING: leftover $BIN_DIR/$dir from a previous run -- moving to $RESCUE (NOT deleting)" >&2
        mv "$BIN_DIR/$dir" "$RESCUE/$dir"
    fi
done

"$SH" --build --jobs "$(nproc)"

# Archive root: prefer $HPCVAULT, decided and verified once at first use (right before the first archive), else a LOCAL archive as a last resort.
STAMP="$(date +%Y%m%d_%H%M%S)"
ARCHIVE_ROOT=""
choose_archive_root() {
    [[ -n "$ARCHIVE_ROOT" ]] && return 0
    local cand="${HPCVAULT:-}/antidunes-archive/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_${STAMP}"
    if [[ -n "${HPCVAULT:-}" ]] && mkdir -p "$cand" 2>/dev/null && touch "$cand/.write_test" 2>/dev/null; then
        rm -f "$cand/.write_test"; ARCHIVE_ROOT="$cand"
    else
        ARCHIVE_ROOT="$BIN_DIR/archive/${STAMP}_bogner_righting_scan_s16"; mkdir -p "$ARCHIVE_ROOT"
        echo "WARNING: \$HPCVAULT unavailable -- LOCAL archive at $ARCHIVE_ROOT (move off manually)" >&2
    fi
}
archive_run() {  # $1 = tag, $2 = attempt
    choose_archive_root
    local dest="$ARCHIVE_ROOT/$1"; [[ "$2" != "1" ]] && dest="${dest}_attempt$2"
    mkdir -p "$dest"
    du -sh "$BIN_DIR/floater-history" 2>/dev/null | sed "s/^/floater-history size for $1: /" || true
    for d in "${OUTDIRS[@]}"; do [[ -d "$BIN_DIR/$d" ]] && mv "$BIN_DIR/$d" "$dest/$d"; done
    return 0
}

TAGS=(a00 a05 a10 a15 a20 a25 a26p565 a30)
FAILED=()
for tag in "${TAGS[@]}"; do
    ok=0
    for attempt in 1 2; do
        echo "############################################################"
        echo "## righting scan s=16, ${tag}  (attempt ${attempt})"
        echo "############################################################"
        set +e
        "$SH" --run --np 65 --prm "$PRM_DIR/bogner_righting_scan_s16_${tag}_gas.prm"
        rc=$?
        set -e
        archive_run "$tag" "$attempt"
        if [[ $rc -eq 0 ]]; then ok=1; break; fi
        echo "## ${tag} attempt ${attempt} exited with status ${rc}" >&2
    done
    [[ $ok -eq 1 ]] || FAILED+=("$tag")
done

choose_archive_root
{ echo "scan finished $(date)"; echo "angles: ${TAGS[*]}"; echo "failed after 2 attempts: ${FAILED[*]:-none}"; } | tee "$ARCHIVE_ROOT/SCAN_SUMMARY.txt"
echo "## DONE. Archived under $ARCHIVE_ROOT/<tag>/{eval,vtk-out,snapshots,floater-history}"
[[ ${#FAILED[@]} -eq 0 ]]
