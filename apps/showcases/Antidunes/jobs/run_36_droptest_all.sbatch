#!/bin/bash -l
#SBATCH --job-name=antidunes-droptest-all
#SBATCH --partition=singlenode
#SBATCH --nodes=1
#SBATCH --ntasks=36
#SBATCH --time=08:00:00
#SBATCH --output=sbatch-output/output/droptest_all_%j.out
#SBATCH --error=sbatch-output/error/droptest_all_%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=dennys.huber@fau.de

# NOTE: --constraint=el9 removed 2026-09-11 -- sbatch was rejecting ANY job (including pre-existing,
# previously-working scripts) with "allocation failure: Invalid feature specification" while this
# constraint was present, a cluster-side scheduler issue unrelated to this script. Every node in the
# singlenode partition already carries the el9 feature (confirmed via sinfo), so omitting the
# constraint is a safe no-op for node selection, not a behavior change -- re-add it once the scheduler
# issue is resolved cluster-side, if ever needed again.
#
# Fluid-free, DEM-only drop test (DropTest.cpp), now extended (2026-09-13) beyond cuboids to also
# support cylinders -- see that file's own header. Runs BOTH scenarios back-to-back in ONE job
# (box: prms/DropTest_gas.prm, then cylinders: prms/DropTest_cylinders_gas.prm -- structurally
# identical, generated by parsing the box file's own 1000-object spawn grid directly, radius 1.0/
# length 12/axis <1,0,0> matching the box's own long dimension) rather than as two separate jobs on
# two different cluster checkouts, since the other two available checkouts (mt-dennys,
# mt-dennys-mirror2) both currently have OTHER jobs still PENDING that could start at any moment --
# running two builds/runs concurrently on the SAME checkout would race on the shared build directory
# (the exact "stale file handle" failure mode this project has hit before with concurrent same-mirror
# jobs). This checkout (mt-dennys-mirror) was confirmed fully idle before submitting.
#
# HALVED to 36 processes (was 72) 2026-09-11: the original 72-process run (job 4216050) and a
# 12-process local run both stalled well short of step 1000 (many minutes elapsed, no crash) for the
# 1000-cuboid config, vs. 5.4s single-process for the original 48-cuboid config -- a suspected
# multi-rank sync-overhead scaling problem. DropTest.cpp's per-step [StepTiming] log (release/dem/vtk
# wall-clock ms, logged unconditionally) exists specifically to diagnose this directly. Neither
# scenario has ever actually completed (or even been timed) at 36 ranks before this job -- the 8h
# time limit here is a generous, uncalibrated guess covering BOTH runs, not a measured budget; the
# per-step log will show real progress either way, so this isn't wasted time even if one or both
# scenarios don't finish within it.
#
# Built directly via cmake/mpirun rather than antidunes.sh, since that script is hardcoded to the
# Antidunes/BedGeneration/tsunami target names and is left untouched per this session's own
# constraint (existing Antidunes files stay as-is).
set -euo pipefail

# antidunes.sh normally handles this module loading internally -- since this script bypasses it
# (see header comment), the same modules it would have loaded must be loaded here explicitly.
module load gcc/11.5.0
module load openmpi/4.1.3-gcc11.5.0
module load cmake/3.31.8
module load python/3.13-miniforge

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
    REPO="$(cd "$SLURM_SUBMIT_DIR/../../.." && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    REPO="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
fi
BUILD_DIR="$REPO/build"
BIN_DIR="$BUILD_DIR/apps/showcases/Antidunes"
PRM_DIR="$REPO/apps/showcases/Antidunes/prms"

for dir in vtk-out eval snapshots; do
    if [[ -d "$BIN_DIR/$dir" ]]; then
        echo "WARNING: removing leftover $BIN_DIR/$dir from an unarchived previous run" >&2
        rm -rf "${BIN_DIR:?}/$dir"
    fi
done

cmake --build "$BUILD_DIR" --target DropTest -- -j"$(nproc)"

cd "$BIN_DIR"

STAMP="$(date +%Y%m%d_%H%M%S)"
if [[ -n "${HPCVAULT:-}" ]] && mkdir -p "$HPCVAULT/antidunes-archive/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_$STAMP" 2>/dev/null; then
    ARCHIVE_ROOT="$HPCVAULT/antidunes-archive/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_$STAMP"
else
    ARCHIVE_ROOT="$BIN_DIR/archive/$STAMP"
    mkdir -p "$ARCHIVE_ROOT"
fi

archive_outputs() {  # $1 = label
    for d in vtk-out eval snapshots; do
        [[ -d "$BIN_DIR/$d" ]] && mkdir -p "$ARCHIVE_ROOT/$1" && mv "$BIN_DIR/$d" "$ARCHIVE_ROOT/$1/$d"
    done
}

run_case() {  # $1 = banner, $2 = prm file, $3 = label
    echo "############################################################"
    echo "## $1"
    echo "############################################################"
    mkdir -p eval snapshots
    mpirun -n 36 ./DropTest "$PRM_DIR/$2"
    archive_outputs "$3"
}

run_case "DropTest: cuboids"   DropTest_gas.prm           cuboids
run_case "DropTest: cylinders" DropTest_cylinders_gas.prm cylinders

echo "## DONE. Archived under $ARCHIVE_ROOT/{cuboids,cylinders}_{vtk-out,eval,snapshots}"
