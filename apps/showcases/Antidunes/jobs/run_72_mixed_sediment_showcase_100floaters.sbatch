#!/bin/bash -l
#SBATCH --job-name=antidunes-mixed-sediment-showcase-100floaters
#SBATCH --partition=singlenode
#SBATCH --nodes=1
#SBATCH --ntasks=72
#SBATCH --time=10:00:00
#SBATCH --output=sbatch-output/output/mixed_sediment_showcase_100floaters_%j.out
#SBATCH --error=sbatch-output/error/mixed_sediment_showcase_100floaters_%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=dennys.huber@fau.de

# [Claude, 2026-09-18] Thesis showcase (THESIS_PLAN.md item 1c): 100 mixed floaters (spheres/boxes/cylinders at
# densities 0.5/1.0/1.5) dropped into still water in a <120,120,120> cube, analytical Box SAT + hybrid Cylinder
# contacts + owner-rank tiebreak. See mixed_sediment_showcase_100floaters_gas.prm's header (generated by
# gen_mixed_sediment_prm.py). cellsPerBlock <20,30,40> -> 6x4x3 = 72 ranks = every core of one singlenode node (the 120^3 domain stays a cube, only the blocks are not) (no --constraint=el9,
# see run_72_cuboid_stillwater_realgravity981_d050.sbatch's own note on why it is dropped).
#
# Time: UNVERIFIED (first run). 100000 steps; the 72-rank cuboid rerun measured ~0.18 s/step on a comparable cell count and rank count (job 4038343:
# 2h27m for 50000 steps) -> ~5 h expected, 10 h requested for margin (singlenode allows more). snapshotFrequency 10000 allows a resume.
# VTK every 10000 steps. No spheres_out.dat regeneration: the prm sets avgParticleDiameterOverride/dxSIOverride, so SimulationParams.h
# takes the override branch and never reads it (the file is present in the checkout's build dir anyway).
# Chained with the extreme-clog PID-switch job via --dependency=afterany in the same checkout (see that script).
set -euo pipefail

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
    REPO="$(cd "$SLURM_SUBMIT_DIR/../../.." && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    REPO="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
fi
SH="$REPO/apps/showcases/Antidunes/antidunes.sh"
PRM_DIR="$REPO/apps/showcases/Antidunes/prms"
BIN_DIR="$REPO/build/apps/showcases/Antidunes"

# [Claude, 2026-09-18] Never DELETE a previous run's output. These jobs are chained in ONE checkout with --dependency, so a
# predecessor that crashed or hit its time limit leaves vtk-out/eval/snapshots here -- the old `rm -rf` would have destroyed it.
# Move them aside instead (same filesystem -> instant rename); archive/rescued_* is then moved off by hand.
RESCUE="$BIN_DIR/archive/rescued_before_${SLURM_JOB_ID:-manual}_$(date +%Y%m%d_%H%M%S)"
for dir in vtk-out eval snapshots; do
    if [[ -d "$BIN_DIR/$dir" ]]; then
        mkdir -p "$RESCUE"
        echo "WARNING: leftover $BIN_DIR/$dir from a previous run -- moving to $RESCUE (NOT deleting)" >&2
        mv "$BIN_DIR/$dir" "$RESCUE/$dir"
    fi
done

"$SH" --build --jobs "$(nproc)"

echo "############################################################"
echo "## mixed sediment showcase: 100 floaters (sphere/box/cylinder x 0.5/1.0/1.5), still water, 72 ranks"
echo "############################################################"
# a crashed run must still reach the archive step below (set -e would skip it), so capture the exit status
set +e
"$SH" --run --np 72 --prm "$PRM_DIR/mixed_sediment_showcase_100floaters_gas.prm"
RUN_RC=$?
set -e
echo "## run exited with status $RUN_RC -- archiving whatever output exists"

# Prefer $HPCVAULT, decided and verified HERE (right before use), not at job start -- see
# run_140_cuboid_stillwater_hires_d050.sbatch's own comment for the full rationale.
STAMP="$(date +%Y%m%d_%H%M%S)"
VAULT_CANDIDATE="${HPCVAULT:-}/antidunes-archive/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_${STAMP}"
if [[ -n "${HPCVAULT:-}" ]] && mkdir -p "$VAULT_CANDIDATE" 2>/dev/null \
   && touch "$VAULT_CANDIDATE/.write_test" 2>/dev/null; then
    rm -f "$VAULT_CANDIDATE/.write_test"
    ARCHIVE_ROOT="$VAULT_CANDIDATE"
else
    ARCHIVE_ROOT="$BIN_DIR/archive/${STAMP}_mixed_sediment_100floaters"
    mkdir -p "$ARCHIVE_ROOT"
    echo "WARNING: \$HPCVAULT unavailable at archive time -- falling back to LOCAL archive at $ARCHIVE_ROOT (move this off manually to avoid quota pressure)" >&2
fi

for d in vtk-out eval snapshots; do
    [[ -d "$BIN_DIR/$d" ]] && mkdir -p "$ARCHIVE_ROOT/mixed_sediment" && mv "$BIN_DIR/$d" "$ARCHIVE_ROOT/mixed_sediment/$d"
done

echo "## DONE. Archived under $ARCHIVE_ROOT/mixed_sediment/{eval,vtk-out,snapshots}"
exit "$RUN_RC"
