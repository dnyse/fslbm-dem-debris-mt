// sphere_waterlevel_sweep_low_bogner_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// WATER-LEVEL SWEEP (LOW), part of a 3-file short-run set testing whether the
// absolute water depth still influences a free-floating sphere's equilibrium
// submersion once gravity is a FIXED constant (gravityOverride, Bogner's own
// g=7.5e-4/tau=1.9), rather than this project's own Fr-derived gravity
// (gravity = (U/Fr)^2 / liquidHeight, which is INVERSELY tied to liquidHeight
// by construction). Siblings: sphere_waterlevel_sweep_mid_bogner_gas.prm,
// sphere_waterlevel_sweep_high_bogner_gas.prm.
//
// HYPOTHESIS UNDER TEST: with gravity fixed (independent of liquidHeight), a
// free-floating sphere of densityRatio=0.5 should settle to the SAME ~50%
// submerged equilibrium regardless of how deep the water column is, as long as
// there's enough clearance to float without touching the floor or breaching the
// domain ceiling -- basic Archimedes' principle (submerged fraction = density
// ratio) has no dependence on absolute water depth. This set holds domainSize and
// gravity/viscosity FIXED across all 3 runs and varies ONLY liquidHeightFactor
// (hence liquidHeight, hence where the waterline sits inside the same domain), to
// check that empirically. Expected result: submersion fraction converges to the
// same ~50% in all 3 runs, i.e. liquidHeight has NO measurable influence.
//
// GEOMETRY/PHYSICS -- reused verbatim from sphere_density_showcase_bogner_domain_
// matched_gas.prm (domain <96,45,40>, matching Bogner & Rude 2013's own validated
// regime exactly: 40-cell domain height with g=7.5e-4 gives the same ~9.0% Eq. 10
// margin he validated, so NO gravity rescaling is needed here, unlike the taller
// <128,60,180> showcases that DID need rescaling). Reduced from that file's three
// spheres (0.25/0.5/0.75) to a SINGLE densityRatio=0.5 sphere -- only the
// water-depth variable is swept here, not density. pinPosition/pinAxes<1,1,0>
// pins X,Y (no horizontal drift) but leaves Z free, so the sphere can only rise or
// sink to find its own vertical buoyancy equilibrium; pinRotation true (moot for
// a sphere, kept for consistency with the base file).
//
// THIS FILE (LOW): liquidHeightFactor 2.33277 -> liquidHeight ~14.0 (of 40 total,
// floorHeightFactor ~0 -> absoluteLiquidHeight ~14.0). Headspace above ~26,
// comfortably clear of the sphere (radius 8) and the domain ceiling. Sphere
// initial position set at z~14 (near the expected waterline) to keep this a SHORT
// run -- only small vertical settling motion should be needed to reach equilibrium.
//
// timesteps 5000 (short run, per request) -- just enough to observe convergence to
// (or away from) the ~50% submersion equilibrium; extend if not yet converged.
//
// Domain: <96, 45, 40> / cellsPerBlock <16, 15, 10> = 6×3×4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 10 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 45, 40>;
   wavePeriods        1;
   liquidHeightFactor 2.33277;   // -> liquidHeight ~14.0 (LOW)
   floorHeightFactor  0.01;      // -> floorHeight ~0.060 (kept nonzero only to satisfy the != 0 assertion)
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              5000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526
   gravityOverride        7.5e-4;      // matches Bogner's g — safe here: domain height 40 == his own
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      // densityRatio 0.5 -> Archimedes equilibrium: 50% submerged, independent of water depth.
      position     < 48, 22.5, 14 >;
      radius       8;
      densityRatio 0.5;
      settlingSteps 0;
      pinPosition  true;
      pinAxes      < 1, 1, 0 >;   // X,Y pinned, Z free — only vertical buoyancy motion allowed
      pinRotation  true;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the sphere
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       500;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 22, 0 >;  max < 96, 23, 40 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 45, 40 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 96, 45, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
