// buoyancy_calibration_r1_sphere_mem_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Thesis item 1b (THESIS_PLAN.md) -- CALIBRATION run, not part of the final comparison data. Same
// exact config as the real R=1/sphere/MEM comparison run (buoyancy_compare_sphere_r1_mem_gas.prm,
// created next) except `timesteps` here is a short, arbitrary exploratory value. Purpose: measure the
// actual rise rate (no closed-form prediction applies -- a rough hand check puts this well outside
// the Stokes-drag regime) from the [FloaterForces] log, extrapolate the step at which the sphere's
// top would reach the waterline (z≈81), and set every real comparison job's `timesteps` to a safe
// margin (e.g. 70%) below that -- per explicit instruction, Antidunes' free-surface/MEM coupling is
// not built to handle a floater passing through the interface, so this is a hard constraint on run
// length, not just a post-hoc analysis-window restriction.
//
// Domain: <48,48,96> / cellsPerBlock <16,16,12> = 3x3x8 = 72 processes. periodicity <1,1,0> (X AND Y
// periodic -- no production-scale footprint needed, just one floater rising in undisturbed still
// water; cross-section ~3x the sphere's own diameter, the minimum avoiding self-image interaction).
// liquidHeightFactor raised to 6 (from the production value 2.862) for a generous liquid column
// (~48 LU, waterline z≈81) so the floater has real room to rise. Floater centered at <24,24,41.5>
// (X,Y = domain center; Z = floor(≈33.1) + ~1.05x radius, just clear of the solid floor).
// targetMeanVelocityMagnitude=0 -- water genuinely at rest, no flow forcing at all.
//
// inFileName references the REAL generated bed (BedGeneration_buoyancy_r1.prm, run as cluster job
// 4222974) -- avgParticleDiameter/dx_SI are read naturally from its header via
// Utility.h::getAvgDiameterScalingFactor, NOT an override. Confirmed from the real generated file
// (245 spheres, avg diameter_SI=0.00289997651976604): scalingFactor=2757.144191,
// avgParticleDiameter(LU)=7.995653, dx_SI=0.000362694125 -- gravityOverride below (2.137150014e-05)
// is computed from THESE confirmed numbers (dt_SI = viscosity_LU/viscosity_SI * dx_SI^2,
// viscosity_LU=0.000214026 under useHardcodedUnits=true; gravityOverride = 9.81*dt_SI^2/dx_SI).
//
// MEM method: useMemOnlyBuoyancy=true, useBognerThreePhaseMEM=true (both already default, set
// explicitly for clarity -- see THESIS_PLAN.md's own Finding 1 for why these must be paired).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 16, 12 >;
   periodicity                   < 1, 1, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <48, 48, 96>;
   wavePeriods        1;
   liquidHeightFactor 6;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water, no flow forcing at all
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         5000;              // CALIBRATION -- short/exploratory, not the final budget
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   2.137150014e-05;   // true g_SI=9.81 m/s^2 -- see file header derivation
}

ParticleParameters
{
   inFileName spheres_out_buoyancy_r1.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 24, 24, 41.5 >; radius 8; densityRatio 0.5; settlingSteps 0; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;   // MEM method -- see file header
   useMemOnlyBuoyancy            true;   // MEM method -- see file header
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     10;           // fine-grained position/velocity tracking
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       10000000000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
