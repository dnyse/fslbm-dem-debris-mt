// [Claude, 2026-10-03] WATER-LOSS TEST A: identical to small_rods_192x_2x32x3_clog_skin0p5_curvguard_cappid_gas.prm
// (job 4292481: liquid mass -12.3 % in 100000 steps, ~1 % per 10000 steps while the debris keeps moving; the 406-rod
// capped run 4292534 stopped losing at -2.8 % once its jam froze) except ModelParameters.seedFillFromAllNeighbours true:
// a cell uncovered by a moving body gets its fill level from all resolved neighbours instead of the interface
// neighbours only (PdfReconstructionManager.h seedInterfaceFillFromNeighbourhood; 6 unit tests in
// BognerStateClassificationTest). Compare totalFluidMass with 4292481 step by step.
// [Claude, 2026-10-03] CAPPED-PID TEST (author's request: "run the 192 with this capped pid as a first test").
// Identical to small_rods_192x_2x32x3_clog_skin0p5_curvguard_gas.prm (job 4284594, 51000 steps COMPLETED, PID on,
// uncapped) except: (1) PIDParameters.maxActuatingVariable 1e-3 -> 2.65e-6; (2) ClogMeasurement.flowRateEnabled true;
// (3) timesteps 51000 -> 100000 (author's request; ~1.7 flow-throughs at the bulk velocity ~0.013).
// Cap = k a_ref with a_ref = 7.8e-7 (clean converged force of the centred-pillar channel, same domain/flow, job 4242918;
// the hopper's own a_ref comes from the clean reference hopper_clean_reference_pidon_gas.prm, run alongside) and
// k = 1 + F / (a_ref L_x / g) = 1 + 24.6 / 10.3 = 3.4 for a freeboard F = 0.5 h0 (h0 = 49.1): the forcing holds the
// discharge until the backwater would exceed half the water depth, then acts as a fixed force (THESIS_PLAN.md item 4,
// capped PID). For comparison: 4284594 used a median 1.97e-6 over steps 3k-20k, max 3.31e-6 -> the cap binds at the
// jam peaks only. maxRamp kept at 1e-4: the integral term accumulates only while |new - current| < maxRamp, so a small
// maxRamp would freeze the integral and leave a steady-state error; at the cap the windup is bounded by maxRamp.
// [Claude, 2026-10-02] CURVATURE-GUARD TEST: guardCurvatureInputs true added (new prm switch, off by default -- skips a curvature neighbour that is neither liquid/interface/gas/obstacle or whose normal isn't finite, sets curvature 0 if nothing usable is left, logs each case as [CURVATURE-GUARD]). Verified a true no-op on valid inputs elsewhere (box_pair_repro_gas.prm: 5828 force/position lines identical on/off, guard never fires). VTK switched to the discrete snapshot schedule 500/1000/2000/4000/8000/16000/32000/49000 (fluid_field_snapshots, same mechanism as the production hopper reruns) instead of the uniform every-10000-steps cadence. Also adds denseNanScanEnabled for steps 8900-9100, bracketing this run's own actual crash step (9069, job 4284164).
// ─────────────────────────────────────────────────────────────────────────────
// small_rods_192x_2x32x3_clog_skin0p5_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-10-01] DOUBLING-IN-X continues after the clean 48-rod skin test (job 4282396:
// full 51000 steps, exit 0, zero crash markers -- confirmed by direct log inspection, same result
// as the 24-rod test 4282267). Per explicit request ("we know the 48 cylinder works, then on two
// new freed directory run the 96 and the 192 version with the skin activated"), this is the next
// doubling step: 32 rows in X instead of 8 -- 2(Y) x 32(X) x 3(Z) = 192 rods --
// same geometry/densities/contact-mode/cylinderContactSkin 0.5/sealed-cell-guard-off as 4282267
// and 4282396, extended upstream at the SAME WIDENED 8 LU pitch: 364 (front, unchanged) down to
// 116 (32 rows total). No fixes besides the skin (Option A/B, SimpleBB.h
// guard all OFF), matching every other scenario in this series. VTK writeFrequency 10000,
// timesteps 51000 (same as every prior scenario in this series).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // [Claude, 2026-10-03] CAPPED PID, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;  // [Claude, 2026-10-03] 100k on request (51000 in 4284594)
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   denseNanScanEnabled           true;   // [Claude, 2026-10-02] pinpoint the first NaN near this run's own crash step
   denseNanScanFromStep          8900;
   denseNanScanToStep            9100;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

