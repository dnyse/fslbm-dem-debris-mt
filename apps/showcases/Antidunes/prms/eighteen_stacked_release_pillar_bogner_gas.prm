// eighteen_stacked_release_pillar_bogner_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// 18-object clogging drop, SIDE BY SIDE rather than stacked taller — corrected layout, replacing
// an earlier version of this file that stacked 9 new floaters directly ABOVE the original 9-sphere
// column (height 6). Per direct correction: height stays 3 (same as the original
// nine_stacked_release_pillar_bogner_gas.prm), and the extra 9 floaters sit at a SECOND upstream
// X-plane instead — two X=9/33 planes, each a 3(Y)×3(Z) grid, so 2×3×3=18 total, all still height 3.
//
//   • X planes: 9, 33 (both far upstream of the pillars at x=64, 31-LU clearance from the nearer
//     plane — same "upstream" placement as the original single-plane 9-sphere design).
//   • Y columns (unchanged from the original): 12, 30, 48.
//   • Z rows RAISED +20 LU from the original 66/84/102 -> 86/104/122 (crash-repro fix, see below).
//
// Z-RAISE FIX (this revision): job 3956749's run of the original 66/84/102 layout crashed at
// step ~57840-57865 inside mesa_pd's SyncNextNeighbors (ParseMessage.h "Received invalid
// notification type" MPI_ABORT). A VTK screenshot at step ~23000 -- well before the t=30000
// release -- showed the bottom row (bottom at z=58, only 2 LU above the flat-water reference
// absoluteLiquidHeight≈56.02) already touching/submerged in the wavy, PID-flow-driven free
// surface while still FIXED/pinned. That 2 LU margin (copied unchanged from the original 9-sphere
// design, which apparently tolerated it) is not enough headroom once real flow waves are added on
// top of 18 floaters instead of 9. Raising all three rows by +20 LU gives the bottom row a
// 86-8-56.02≈22 LU clearance from the flat reference, keeping every floater in the gas (and FIXED)
// until release at t=30000, while leaving row spacing (18 LU) and the top row's headroom below the
// z=180 ceiling (122+8=130, 50 LU of clearance) untouched. This isolates whether early water
// contact of the pinned stack was contributing to the eventual crash, or whether the crash
// reproduces anyway once the stack is genuinely dropped fresh into calm water at t=30000.
//
// Shapes are MIXED across the grid rather than grouped by row/column/plane — 6 spheres (radius 8),
// 6 boxes (halfExtents <6,6,6>, 12-cube), 6 cylinders (radius 6, length 16, axis <0,1,0>, spanwise
// "log"), assigned by a 3D Latin square: shape = (xi+yi+zi) mod 3 over the plane/column/row
// indices (xi∈{0,1}, yi/zi∈{0,1,2}), which guarantees every fixed-X plane, fixed-Y column, and
// fixed-Z row already contains all three shapes at least once — no two same-shape floaters need to
// be adjacent, and no single row/column/plane is shape-uniform. All three shape types are still
// Bogner three-phase MEM (useBognerThreePhaseMEM + useMemOnlyBuoyancy both true — see
// nine_stacked_release_pillar_bogner_gas.prm's header for the full buoyancy-model rationale).
// Boxes/cylinders exercise the box/cylinder submerged-volume path (computeSubmergedVolumesBox in
// ParticleKernels.h) instead of the sphere path, doubling as a mixed-shape stress test of that
// code path at the real E1 gravity scale, on top of the original phantom-lift regression.
//
// The two CylinderPillars and the domain are UNCHANGED from the original nine-stack file — same
// center <64,15,*>/<64,45,*>, radius 8, 14-LU gap, same BoundaryParameters BodyBC extents, same
// domain <128,60,180>. Since the stack is no longer taller than the original (height still 3), the
// domain didn't need touching at all this time, not even in Z.
//
// Released together at t=30000, same cushioning rationale as the original 9 (bottom row enters
// the water first, upper rows land on it rather than free-falling the full drop height).
//
// Spacing check (all positive => no overlap at creation, axis-aligned): worst-case pairwise
// half-extent per axis is 8 (sphere radius / cylinder half-length along Y). Z and Y row/column
// spacing is 18 LU (unchanged from the original design) => worst-case gap 18-8-8=2 LU, the same
// margin the original 9-sphere design already used safely. X-plane spacing is 24 LU (9 to 33) =>
// worst-case gap 24-8-8=8 LU, safe.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes (unchanged)
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two cylinder pillars — UNCHANGED from nine_stacked_release_pillar_bogner_gas.prm. Not moved.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

// Shape assignment follows the Latin square shape=(xi+yi+zi)%3 (0=sphere,1=box,2=cylinder) over
// X-plane index xi∈{9:0, 33:1}, Y-column index yi∈{12:0, 30:1, 48:2}, Z-row index zi∈{86:0, 104:1,
// 122:2} — see header. 6 of each shape, none of them adjacent-grouped.

FloatingSpheres
{
   // xi+yi+zi ≡ 0 (mod 3)
   FloatingSphere { position < 9, 12, 86 >;   radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 30, 122 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 48, 104 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 12, 122 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 30, 104 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 48, 86 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
}

FloatingBoxes
{
   // xi+yi+zi ≡ 1 (mod 3) — upright, uniform-density cubes (12 LU edge), no artificial righting
   // bias, so tumbling behaviour is governed purely by real hydrodynamics/contact.
   FloatingBox { position < 9, 12, 104 >;  halfExtents < 6, 6, 6 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingBox { position < 9, 30, 86 >;   halfExtents < 6, 6, 6 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingBox { position < 9, 48, 122 >;  halfExtents < 6, 6, 6 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingBox { position < 33, 12, 86 >;  halfExtents < 6, 6, 6 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingBox { position < 33, 30, 122 >; halfExtents < 6, 6, 6 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingBox { position < 33, 48, 104 >; halfExtents < 6, 6, 6 >; densityRatio 0.5; settlingSteps 30000; }
}

FloatingCylinders
{
   // xi+yi+zi ≡ 2 (mod 3) — spanwise "log" across the flow (axis Y), length 16 exceeds the 14-LU
   // pillar gap, same clogging intent as the original spheres (diameter 16 > gap 14).
   FloatingCylinder { position < 9, 12, 122 >;  radius 6; length 16; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingCylinder { position < 9, 30, 104 >;  radius 6; length 16; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingCylinder { position < 9, 48, 86 >;   radius 6; length 16; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingCylinder { position < 33, 12, 104 >; radius 6; length 16; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingCylinder { position < 33, 30, 86 >;  radius 6; length 16; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 30000; }
   FloatingCylinder { position < 33, 48, 122 >; radius 6; length 16; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 30000; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // Bogner & Rude (2013) three-phase MEM force, no rhoHydStat subtraction
   useMemOnlyBuoyancy             true;   // no separate vSub*g analytic buoyancy channel
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         density;   // real, live fluid density (=> pressure via p=cs^2*(density-1))
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         // CellBB_filter_2 alone spans the same volume as the union of _0/_1/_2 (both are subsets
         // of _2), so "combine" here nets the identical spatial region as before, intersected with
         // liquidInterfaceFilter -- gas cells are excluded from the output entirely, not just
         // zeroed. Plain top-level entries (no "combine") union rather than intersect, so listing
         // liquidInterfaceFilter alongside the CellBB filters as separate entries would NOT
         // exclude gas cells; ChainedFilter's "combine" is what performs the actual AND (see
         // src/vtk/ChainedFilter.h).
         combine CellBB_filter_2, liquidInterfaceFilter;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
