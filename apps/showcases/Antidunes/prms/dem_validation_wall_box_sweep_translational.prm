// Cuboid normal wall impact against the tilt angle, 0-90 deg in 5 deg steps, frictionless: data source of the
// cuboid wall-impact figures (Section 5.2, translational effective mass; the _rotational file is the counterpart with
// useRotationalEffectiveMass true, the _fine file gives the analytical curve). tangentialSpeedFraction 0 makes the
// impact purely normal, as in Kodam et al.'s Test 1 for cylinders. See runWallImpactBox (DEMValidationWallImpact.h).
DEMValidation{
    testCase wallImpactBox;
    useRotationalEffectiveMass false;

    boxHalfExtents < 1.0, 2.0, 2.0 >;
    density 1.0;
    restitutionCoefficient 0.6;
    frictionCoefficient 0.0;
    poissonsRatio 0.22;
    collisionTime 0.01;

    impactSpeed 1.0;
    tangentialSpeedFraction 0.0;
    tiltStartDeg 0.0;
    tiltEndDeg 90.0;
    tiltStepDeg 5.0;

    toleranceRelError 0.02;
    vtkSpacing 0;
    outputBaseName wall_impact_box_kodam_sweep_translational;
}
