// giant_rods_6x_clog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] SIX GIANT RODS, per explicit request ("release 6 of this large ones similar
// to our large tries give them the same different density depending in a 2x1x3"). Same single-rod
// geometry as giant_rod_clog_gas.prm (radius 6, length 36 -- 1:3 ratio, 90% of the 40 LU channel
// width, axis Y) -- but 6 of them, arranged 2(X) x 1(Y) x 3(Z):
//   - 1 in Y is forced: each rod already spans Y=[2,38], so a second one CANNOT sit beside it in Y
//     at all (would need >78 LU of a 40 LU channel) -- there is only ever one rod per (X,Z) slot.
//   - 2 rows in X, BOTH close to the pillars (per explicit request, "released right in front of the
//     hopper"): X=364 (front row, same position as the single-rod test, 20 LU upstream of the
//     pillars) and X=350 (second row, only 14 LU behind the front row -- diameter is 12, so this
//     gives 2 LU clearance between same-Z rods in the two rows, no start-of-run overlap, while
//     keeping both rows genuinely close to the hopper rather than staggered far upstream).
//   - 3 layers in Z, 15 LU apart (diameter 12 + >=3 LU clearance, no overlap): Z=15 (deep), Z=30
//     (mid -- same depth as the single-rod test), Z=45 (shallow, partially breaching the Z=49.13
//     water surface, same convention as the original 210-rod population's top tier).
//
// Density stratified by depth, heavy-low/light-high (same convention as the original population),
// centred on 0.75 -- CONFIRMED stable for this rod size (job 4268255): reaches and jams the pillar,
// settles to a steady equilibrium depth (Z stopped sinking and turned around, tiltY converging
// smoothly), zero corruption diagnostics. The deep/shallow tiers (0.85/0.65) remain an extrapolation
// from that one confirmed point, not independently verified.
//
// All three of this session's 2026-09-25 crash-mitigation fixes (Option A/B, SimpleBB.h guard) are
// DISABLED, matching the single-rod baseline. VTK writeFrequency 2000 from the start (not 50 -> 200
// -> 2000 this time) given the quota lesson from the single-rod attempts.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;  // [Claude, 2026-09-26] 50000 + 1000, per explicit request -- guarantees a
                              // dump lands exactly at step 50000 regardless of any off-by-one in the
                              // timeloop's own step indexing, rather than risking the last VTK write
                              // landing one writeFrequency short of the intended round number.
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // Front row (X=364, at the pillars) -- deep/mid/shallow, heavy-to-light.
   FloatingCylinder { position < 364, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 364, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 364, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Second row (X=350, 14 LU behind the front row) -- same three depths/densities.
   FloatingCylinder { position < 350, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 350, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 350, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and both rows (X 250..500, Z 0..100); the rods are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;  // [Claude, 2026-09-26] cut further per explicit request (2000 -> 10000)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
