// DEM validation "dropper case" showcase: a single, visually clean box corner-first wall impact for a
// thesis figure -- reuses dem_validation_wall_box.prm's own parameters (same geometry/material, see
// that file's own header for the full derivation and the Housner (1963) self-check citation), but at a
// SINGLE tilt (25deg, the middle of that file's own 5-40deg sweep) instead of a sweep, with VTK output
// enabled for an animation. Cluster-only per explicit instruction -- see
// jobs/run_24_dem_validation_dropper_case.sbatch.
DEMValidation{
    testCase wallImpactBox;

    boxHalfExtents < 1.0, 2.0, 2.0 >;
    density 1.0;
    restitutionCoefficient 0.6;
    frictionCoefficient 0.3;
    poissonsRatio 0.22;
    collisionTime 0.01;

    impactSpeed 1.0;
    tiltStartDeg 25.0;
    tiltEndDeg 25.0;
    tiltStepDeg 10.0;

    toleranceRelError 0.3;
    vtkSpacing 20;
    outputBaseName dropper_case_box;
}
