// giant_rods_24x_clog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] TWENTY-FOUR GIANT RODS, per explicit request ("keep doubling them in x until
// into our old issues again") -- second doubling step in this series, applied to
// `giant_rods_12x_clog_gas.prm` (job 4268493, in progress at the time this was written: 5/12 already
// jammed at the pillar by step 24000, matching the established X~366.2-366.3 threshold, 7 still in
// transit from the two rearward rows). Same rod geometry (radius 6, length 36, 1:3 ratio, axis Y)
// and same 3 Z-layer densities (0.85/0.75/0.65, heavy-low/light-high) as every scenario in this
// series, but 8 rows in X instead of 4 -- 8(X) x 1(Y, forced) x 3(Z) = 24 rods.
//
// X rows continue the SAME 14 LU pitch used throughout this series (364, 350, 336, 322 from the
// 12-rod scenario, extended upstream by four more rows at the same spacing): 364, 350, 336, 322,
// 308, 294, 280, 266. The purpose of this specific doubling step (per explicit request) is to keep
// packing more rods into the same channel/pillar geometry until the crowding reproduces one of this
// session's earlier-diagnosed crash mechanisms (MEM-GARBAGE-LINK / NAN-LINK / DRY-LINK / LOW-RHO /
// SEALED-CLOSE / STALE-PARTICLE-IDX) -- fixes intentionally left OFF throughout, so if/when a
// diagnostic fires, this is a genuine, undefended reproduction, not a near-miss.
//
// All three of this session's 2026-09-25 crash-mitigation fixes (Option A/B, SimpleBB.h guard)
// remain DISABLED. VTK writeFrequency 10000, timesteps 51000 (same as every prior scenario in this
// series).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // Row 1 (X=364, at the pillars) -- deep/mid/shallow, heavy-to-light.
   FloatingCylinder { position < 364, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 364, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 364, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 2 (X=350) -- same three depths/densities.
   FloatingCylinder { position < 350, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 350, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 350, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 3 (X=336) -- same three depths/densities.
   FloatingCylinder { position < 336, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 336, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 336, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 4 (X=322) -- same three depths/densities.
   FloatingCylinder { position < 322, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 322, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 322, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 5 (X=308, new in this doubling step) -- same three depths/densities.
   FloatingCylinder { position < 308, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 308, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 308, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 6 (X=294, new in this doubling step) -- same three depths/densities.
   FloatingCylinder { position < 294, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 294, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 294, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 7 (X=280, new in this doubling step) -- same three depths/densities.
   FloatingCylinder { position < 280, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 280, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 280, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }

   // Row 8 (X=266, new in this doubling step) -- same three depths/densities.
   FloatingCylinder { position < 266, 20, 15 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.85; settlingSteps 500; }
   FloatingCylinder { position < 266, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
   FloatingCylinder { position < 266, 20, 45 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.65; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all eight rows (X 200..500, Z 0..100); the rods are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 200, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
