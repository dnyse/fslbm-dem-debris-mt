// box_pillar_glance_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Box×CylindricalBoundary GLANCING-CONTACT test — part of the floater/pillar
// interaction test suite (see also: sphere_pillar_glance_gas.prm,
// box_pillar_gap_pass_gas.prm, box_pillar_corner_gas.prm, cylinder_pillar_*; the
// JAM/wedge case for a box is already covered by box_two_pillars_gas.prm and
// box_pillar_gas.prm).
//
// ONE pillar, box UPRIGHT (initialTiltAngleDeg=0): the box drifts downstream
// offset in Y so its flat +Y face clips the pillar's side. This isolates the
// basic face-on Box×CylindricalBoundary contact (rotation-aware code path, but
// with the box at its reference orientation) before testing an actual rotated
// approach in box_pillar_corner_gas.prm.
//
// Geometry (absoluteLiquidHeight = 56.024):
//   • Pillar: center (64, 30, 90), radius 8 → surface spans y=[22, 38].
//   • Box: cube halfExtents <3,3,3>, densityRatio 0.5 → 50% submerged equilibrium
//     at z=56. Start (30, 21, 56): |Δy| to pillar centre = 9 LU < r_pillar+hy = 11 LU
//     → up to 2 LU of overlap at closest approach — a shallow face-on glance.
//   • Expected outcome: brief nonzero F_contact as the box passes x≈64, pushed in
//     -Y, then clears and continues downstream (x periodic).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         40000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 64, 30, 90 >;
      radius 8;
   }
}

FloatingBoxes
{
   FloatingBox
   {
      // Cube halfExtents <3,3,3>, offset 9 LU from the pillar centreline
      // (< r_pillar+hy=11) → glances the pillar surface face-on, upright (no tilt).
      position             < 30, 21, 56 >;
      halfExtents          < 3, 3, 3 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  0;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 30, 0 >; max < 64, 30, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
