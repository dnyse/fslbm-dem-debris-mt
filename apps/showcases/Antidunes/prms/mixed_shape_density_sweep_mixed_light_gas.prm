// mixed_shape_density_sweep_mixed_light_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// DENSITY-ARRANGEMENT DIAGNOSTIC SWEEP -- variant "mixed_light", part of a 4-file short
// (20000-step) sweep run back-to-back by
// jobs/run_72_mixed_shape_density_arrangement_sweep.sbatch to isolate which exact
// density arrangement within a vertically-stacked floater group causes the DEM/MEM
// blowup seen in job 3858669 (mix_sed_pil.log, 54-floater SCRAMBLED grid,
// avgParticleVelocity non-finite ~step 1000). See
// mixed_shape_sedimentation_showcase_pillars_gas.prm's header for the full history
// (working vs. crashing arrangements) that motivated this sweep.
//
// REPRODUCTION: mixed density per stack, LIGHTEST object at the BOTTOM (closest to the
// water, reaches it first) -- this is the exact pattern the crashing 54-floater
// SCRAMBLED grid produced systematically (job 3858669, mix_sed_pil.log,
// avgParticleVelocity non-finite ~step 1000). Expected outcome, if the theory is right:
// reproduces the crash, and quickly (within the first ~1000-2000 steps, well inside this
// file's 20000-step budget).
//
// No pillars, no flow forcing (still water, targetMeanVelocityMagnitude 0) -- this
// sweep isolates ONLY the floater density-arrangement variable, nothing else.
// timesteps 20000 (short diagnostic run, not the full 100000).
// Grid: X-anchors 16/48/80 (16 LU rank-boundary clearance), Y-replicates 10/30/50,
// Z fixed per shape (sphere 64 / box 76 / cylinder 88), same as every proven-safe
// version of this file's grid.
//
// ParticleKernels.h's [DEM-WATCH]/[MEM-WATCH] logs (unconditional, every DEM
// sub-cycle) fire automatically if any floater's contact+lubrication force
// (DEM) or hydrodynamic force (MEM) exceeds ~0.05 (roughly 10x the ~1e-3 to
// ~1e-2 magnitudes seen in stable runs) -- if this variant crashes, grep its
// log for these tags: DEM-WATCH firing first / growing across subCycle=0..9
// within one step implicates DEM contact resolution; MEM-WATCH already large
// at subCycle=0 implicates the fluid momentum-exchange coupling instead.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4x3x6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — isolate the density-arrangement variable only
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         20000;               // short diagnostic run — see header
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 16, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 48, 10, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 0; }
   FloatingSphere { position < 48, 30, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 0; }
   FloatingSphere { position < 48, 50, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 0; }
   FloatingSphere { position < 80, 10, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 0; }
   FloatingSphere { position < 80, 30, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 0; }
   FloatingSphere { position < 80, 50, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 0; }
}

FloatingBoxes
{
   FloatingBox { position < 16, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 0; }
   FloatingBox { position < 16, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 0; }
   FloatingBox { position < 16, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 0; }
   FloatingBox { position < 48, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 0; }
   FloatingBox { position < 48, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 0; }
   FloatingBox { position < 48, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 0; }
   FloatingBox { position < 80, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 0; }
   FloatingBox { position < 80, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 0; }
   FloatingBox { position < 80, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 0; }
}

FloatingCylinders
{
   FloatingCylinder { position < 16, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 0; }
   FloatingCylinder { position < 16, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 0; }
   FloatingCylinder { position < 16, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 0; }
   FloatingCylinder { position < 48, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 0; }
   FloatingCylinder { position < 48, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 0; }
   FloatingCylinder { position < 48, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 0; }
   FloatingCylinder { position < 80, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCylinder { position < 80, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCylinder { position < 80, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 0; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     200;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h)
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
