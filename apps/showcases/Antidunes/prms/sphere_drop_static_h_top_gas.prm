// sphere_drop_static_h_top_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// STATIC-H ABLATION: identical to sphere_drop_two_pillars_gas.prm (the phantom /
// dynamic-H A/B baseline) except that the STATIC MEM reference height H is raised
// from the flat still-water level (absoluteLiquidHeight ≈ 56.02) to the TOP of the
// domain (z = 180) via ModelParameters.staticReferenceHeightOverride.
//
// What this probes: SimpleBB's rhoHydStat subtracts ρ_hyd(z) = 1 + 3·a_z·(z−H)
// from the MEM force. Shifting H by ΔH = 124 LU adds a CONSTANT density offset
// Δρ = 3·|a_z|·ΔH ≈ 2.6e-3 to the subtracted reference everywhere on the body.
//   • Fully submerged (closed) body: a constant offset integrates to ~zero net
//     force over the closed link set → the sphere should behave as in the
//     baseline while deep under water.
//   • Straddling the surface (open wetted cap): the offset is unbalanced —
//     expected extra DOWNWARD force ≈ Δp·A_proj with Δp = |a_z|·ΔH ≈ 8.7e-4,
//     up to π·r² ≈ 314 LU² at half submersion → O(0.27), ~13× the sphere's
//     weight (0.021). Prediction: the moment the sphere touches the waterline it
//     is slammed under; once closed the excess cancels, so it may hover fully
//     submerged just below the surface or bang up/down across it.
// This is the mirror image of the levitation baseline (H too HIGH instead of the
// local waterline being higher than H) and isolates how much of the MEM force
// error is a pure reference-offset effect on the open cap.
//
// Compare against: phantom.log / dynamic.log RUN A (identical setup, H = 56.02).
// The fluid initialisation is untouched (same fill/pressure fields as baseline).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         60000;   // 30000 held + 30000 free-floating after release
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Cylinder pillars — same geometry as the baseline run.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // Identical to the baseline: radius 10 LU, centre (30,30,78), held 30k steps.
      position     < 30, 30, 78 >;
      radius       10;
      densityRatio 0.5;
      settlingSteps 30000;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;   // same as baseline

   // THE ONE CHANGE vs the baseline: static MEM reference height H = domain top.
   // (usePhantomForceCorrection / useDynamicReferenceHeight stay at their false
   // defaults — this run isolates the pure H-offset effect.)
   staticReferenceHeightOverride 180;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
