// cylinder_stillwater_realgravity981_3xsphere_gas.prm
// REPRODUCIBILITY VARIANT: DYNAMIC/NATIVE GRAVITY -- no gravityOverride or
// relaxationRateOverride, useHardcodedUnits true. This is exactly "the values the dynamic
// formulas... produce at the default config" (SimulationParams.h comment): viscosity=
// 0.000214026, relaxationRate=1.99743, gravity=7.02618e-06 (g_SI~=1.36 m/s^2),
// surfaceTension=0.000849592 -- a THIRD gravity magnitude, ~7.2x smaller than the solved
// real-9.81 value and ~107x smaller than Bogner's own box value. Domain/shape/density
// otherwise identical to the run that originally crashed.
//
// ─────────────────────────────────────────────────────────────────────────────
// FREE-FLOATING CYLINDER, STILL WATER, TRUE g=9.81 m/s^2 IN SI UNITS, BOGNER BUOYANCY,
// SAME 3x-FAMILY DOMAIN/GRAVITY AS sphere_stillwater_realgravity981_3xsphere_gas.prm.
//
// Direct companion to the sphere study, same methodology: domain <96,135,120>,
// cellsPerBlock <16,45,30>, gravityOverride 5.06585e-05 (solved for g_SI=9.81 against
// dx_SI=0.000483592 / dt_SI=4.99725e-05 -- see the sphere file's header for the full
// derivation), 50000 timesteps, densityRatio in {0.25, 0.5, 0.75} across siblings.
//
// Cylinder sized to match the sphere's characteristic scale: radius 24 (= sphere radius),
// length 60, axis along Y (horizontal, "log" orientation -- circular cross-section is
// roll-neutral about its own axis, same reasoning as cylinder_stillwater_gas.prm, so no
// initialTiltAngleDeg is needed/used here). Centred at the same <48,67.5,60> the sphere
// used; length 60 leaves 37.5 LU clearance to each Y wall.
//
// densityRatio 0.5 here; see the _d025/_d075 siblings for the other two densities.
// Domain: <96, 135, 120> / cellsPerBlock <16, 45, 30> = 6×3×4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 45, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 135, 120>;
   wavePeriods        1;
   liquidHeightFactor 9.9681;
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // native/dynamic-equivalent gravity=7.02618e-06, NOT overridden to 9.81 or Bogner's box value
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 3;   // scaling-math lever only (useParticleBed false) -- see sphere sibling's header
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // densityRatio 0.75 -> Archimedes equilibrium: 75% submerged.
      position     < 48, 67.5, 60 >;
      radius       24;
      length       60;
      axis         < 0, 1, 0 >;
      densityRatio 0.75;
      settlingSteps 0;
      pinPosition  false;   // fully free
      pinRotation  false;   // fully free
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 67, 0 >;   max < 96, 68, 120 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 135, 120 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 96, 135, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
