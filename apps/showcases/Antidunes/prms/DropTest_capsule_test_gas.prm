// DropTest_capsule_test_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-23] FIRST local drop test of the new "pill" (Capsule) floater shape
// (mesa_pd::data::Capsule, SHAPE_TYPE 7): a cylindrical core with two hemispherical caps, radius 3,
// full end-to-end length 15 (matches this project's own rod radius; slightly shorter than the r=3/L=18
// cylinder rod so the caps' curvature is visually obvious). No closed-form contact algorithm exists for
// this shape anywhere in the project (deliberately, for now): every capsule pair goes through
// GeneralContactDetection's generic GJK/EPA path automatically (Capsule::support() is all that was
// needed -- see that file's own header comment), matching the explicit request "no analytical contact
// detection, just use GJK for the beginning". useAnalyticalContactDetection is set false below anyway,
// for clarity of intent (it has no effect on capsule pairs specifically, since none of the analytic
// overloads in ParticleKernels.h mention Capsule at all -- only Cylinder x Cylinder has one).
//
// 12 capsules dropped simultaneously from a small grid, real gravity (EXACT value from the proven
// DropTest_cylinders_250_gas.prm), settling under gravity + GJK/EPA contact against the floor/walls
// and each other. Purely a "does it fall, contact-detect, and settle without exploding" smoke test.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 15, 15, 120 >;  // 3x3x1 = 9 processes
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             1000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <45, 45, 120>;
   wavePeriods        1;      // unused -- required by parser
   liquidHeightFactor 2.5;    // unused -- required by parser
   floorHeightFactor  4.1393; // unused -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         4000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   2.1371500584054327e-05;  // EXACT value from the proven DropTest_cylinders_250_gas.prm
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                1.0;
   fixingHeightFactor          1.5;
   frictionCoefficient         0.5;
   restitutionCoefficient      0.5;
   numSubCycles                10;
   useLubricationCorrection    false;
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
}

// No Pillars / CylinderPillars -- just the 6 auto-created domain walls (SetupStages_drop_test.h).
FloatingCapsules
{
   FloatingCapsule { position < 12.5, 12.5, 90 >; radius 3; length 15; axis < 0, 0, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 22.5, 12.5, 90 >; radius 3; length 15; axis < 0.1, 0, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 32.5, 12.5, 90 >; radius 3; length 15; axis < -0.1, 0.05, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 12.5, 22.5, 90 >; radius 3; length 15; axis < 0, 0.1, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 22.5, 22.5, 90 >; radius 3; length 15; axis < 0, 0, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 32.5, 22.5, 90 >; radius 3; length 15; axis < 0.05, -0.1, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 12.5, 12.5, 106 >; radius 3; length 15; axis < 0, 0, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 22.5, 12.5, 106 >; radius 3; length 15; axis < -0.1, 0.1, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 32.5, 12.5, 106 >; radius 3; length 15; axis < 0, 0, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 12.5, 22.5, 106 >; radius 3; length 15; axis < 0.1, 0, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 22.5, 22.5, 106 >; radius 3; length 15; axis < 0, -0.1, 1 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCapsule { position < 32.5, 22.5, 106 >; radius 3; length 15; axis < 0.05, 0.05, 1 >; densityRatio 1.0; settlingSteps 0; }
}

ModelParameters
{
   useAnalyticalContactDetection false;  // explicit: GJK/EPA for everything, per request
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useSpheroBoxContact           false;
   spheroBoxRadius               0.05;
   useSpheroBoxAnalytical        false;
   useTightLayer1                true;
   useContactFilterOwnerTiebreak true;
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;  // REQUIRED true -- see DropTest.cpp's own header comment
   logFloaterHistory              false;
   logFloaterHistoryStartStep     0;
   logFloaterHistoryEndStep       10000;
   logContactAnomalies            false;
   contactAnomalyStartStep        0;
   contactAnomalyEndStep          10000;
   useHydrodynamicForceTimeAveraging true;
}

EvaluationParameters
{
   performanceLogFrequency 1000;
   evaluationFrequency     100;
   baseFolderName          eval;
   logContactDetectionStatsPeriodically true;
}

VTK
{
   fluid_field
   {
      writeFrequency       500;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
