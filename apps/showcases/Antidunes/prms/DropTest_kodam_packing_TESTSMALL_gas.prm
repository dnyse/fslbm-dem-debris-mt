// DropTest_kodam_packing_gas.prm  (auto-generated by gen_kodam_packing_prm.py, seed=42)
// ─────────────────────────────────────────────────────────────────────────────
// Local recreation of Kodam et al. (2010) Part II Sec. 3.3 "Static packing in a cylinder":
// 20 cylinders (R=4, L=5.3 LU=mm, L/D=0.6625, matching Kodam's real 8.0/5.3mm exactly),
// dropped ONE AT A TIME (each its own settlingSteps wave) into a square, area-matched stand-in
// for Kodam's real 50.6mm-diameter circular container -- see this script's own module docstring
// for the full derivation and every approximation made. friction/restitution taken directly from
// Kodam's Table 1 (0.5 / 0.85); gravity is NOT real-9.81-calibrated (demo speed only, does not
// affect final packing -- contact stiffness/damping here depends only on mass/restitution/
// collisionTimeFactor, never on gravity). 1 LU = 1 mm, so results compare directly against the
// paper's own mm figures with no conversion.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 15, 15, 190 >;  // 3x3x1 = 9 processes
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <45, 45, 190>;
   wavePeriods        1;      // unused -- required by parser
   liquidHeightFactor 2.5;    // unused -- required by parser
   floorHeightFactor  4.1393; // unused -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   // Unused -- DropTest.cpp never calls setupSimState()/constructs a PIDController. Block
   // required only because SimulationParams' constructor unconditionally parses it.
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         9000;
   Re                3100;   // unused (no fluid) -- required by parser
   Fr                1.31;   // unused -- required by parser
   We                15.6188; // unused -- required by parser
   useHardcodedUnits false;  // irrelevant here -- gravityOverride below wins unconditionally regardless
   gravityOverride   0.005;  // demo-speed, NOT real 9.81 -- see file header; does not affect final packing
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read -- overrides below bypass it
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                1.0;   // unused (no bed particles) -- required by parser
   fixingHeightFactor          1.5;   // unused -- required by parser
   frictionCoefficient         0.5;  // Kodam Table 1
   restitutionCoefficient      0.85; // Kodam Table 1
   numSubCycles                20;
   useLubricationCorrection    false;
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8;  // = cylinder diameter (LU=mm) -- only used to bypass reading inFileName's header
   dxSIOverride                1.0;    // placeholder -- dx_SI is never used (no SI-calibrated quantity read back)
}

// No Pillars / CylinderPillars / ArchTunnels -- just the 6 auto-created domain walls
// (SetupStages_drop_test.h) standing in for Kodam's cylindrical container (see module docstring).
