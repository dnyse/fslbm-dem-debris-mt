ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticalContactDetection true;  // see header note
   useTightLayer1                true;  // ADDED (absent, i.e. false, in the base file) -- checks the
                                        // NEW Box x Box single-axis pre-filter (this session,
                                        // paper_analytical::detail::boxesDefinitelySeparatedAlongCenterLine)
                                        // ahead of boxBoxSAT, on a genuine box-only scenario (this
                                        // showcase has no cylinders at all, unlike the widerstacks
                                        // cylinder-jam runs this flag was already validated against).
                                        // See SimulationParams.h's useTightLayer1 doc comment.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
   // ADDED for this run: print+reset [ContactDetectionStats] (including the NEW
   // boxTightLayer1CheaplyProvedSeparated counter) every performanceLogFrequency (10000) steps instead
   // of only once at the end -- see EvaluationParams::logContactDetectionStatsPeriodically.
   logContactDetectionStatsPeriodically true;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;   max < 160, 160, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
