// DEM dry-run validation: cylinder wall impact, replicating Kodam et al. (2010) Chem. Eng. Sci. 65(22),
// 5863-5871, Part II, Test 1 -- sweeping the cylinder's tilt angle relative to the wall normal from
// 0deg (face-on) to 90deg (band-on) and comparing simulated post-impact translational/angular velocity
// to the closed-form rigid-body-impact solution (AnalyticalSolutions.h::cylinderWallImpact), whose
// contact-point geometry is taken directly from the not-yet-simulation-wired Kodam/Guo closed forms in
// PaperAnalyticalContacts.h. Gravity is off (idealised instantaneous-impact "throw", not a drop).
DEMValidation{
    testCase wallImpactCylinder;

    cylinderRadius 1.0;
    cylinderLength 4.0;
    density 1.0;
    restitutionCoefficient 0.85;
    frictionCoefficient 0.3;
    poissonsRatio 0.22;
    collisionTime 0.01;

    impactSpeed 1.0;
    // Swept range restricted to 30-75deg: this is the single-clean-corner-contact regime where the
    // idealised single-point rigid-body-impact analytical model is actually a valid approximation.
    // Kodam et al. (2010) Part II's own Test 1 explicitly treats 0deg (face-on) and 90deg (band-on) as
    // separate/special cases ("contact occurs at the corner of the cylinder... except at 0deg and
    // 90deg") -- at those exact orientations, and near them, the true contact is distributed over a
    // whole flat face or the full band length rather than a single point, which the analytical model
    // cannot represent (confirmed empirically: at tilt=0/90 the DEM shows near-zero induced spin,
    // consistent with the physically-correct symmetric case, while the naive single-rim-point analytical
    // lever arm predicts substantial spurious spin).
    tiltStartDeg 30.0;
    tiltEndDeg 75.0;
    tiltStepDeg 15.0;

    // 0.3, looser than the sphere test's 0.25: on top of the same Cundall-Strack-vs-idealised-Coulomb
    // friction gap (AnalyticalSolutions.h's calibration note), the cylinder's contact point/lever arm
    // itself is only piecewise-defined (rim-point search, PaperAnalyticalContacts.h) rather than the
    // sphere's always-exact r_c=-R*n, adding geometric approximation error on top of the friction-model
    // gap. Observed empirically: ~1-3% at 30/75deg, ~18-28% at 45/60deg.
    toleranceRelError 0.3;
    vtkSpacing 0;
    outputBaseName wall_impact_cylinder;
}
