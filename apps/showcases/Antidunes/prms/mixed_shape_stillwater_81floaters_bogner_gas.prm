   FloatingSphere { position < 58, 50, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 0; }
   FloatingSphere { position < 70, 10, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 0; }
   FloatingSphere { position < 70, 30, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 0; }
   FloatingSphere { position < 70, 50, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 0; }
