// test_bridge_v1_lowwater_logjam_floaterlog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FLOATERLOG VARIANT of test_bridge_v1_lowwater_logjam_gas.prm: identical scenario (same
// geometry, same 9 staggered log releases, same timesteps=30000), with
// ModelParameters.logFloaterHistory turned on. The first run of this scenario (job 4134495)
// completed clean on the fluid side but produced one genuine anomaly worth investigating
// properly: uid 1008806316530991107 flew from Z~61 to Z~178.9 (near the domain ceiling)
// between steps 28000-29000 while approaching the central arch (Y~31), racking up 100
// [DEM-WATCH] + 100 [STRONG-CONTACT-FORCE] hits (both saturated their per-rank caps) just
// before the launch -- exactly the kind of event logFloaterHistory's per-subcycle
// position/velocity/force/torque log (not just the coarse 1000-step [BoxForces] samples)
// is needed to actually see happening, rather than only its aftermath. Only 9 floaters
// total here (vs. the 1000-floater box-sedimentation runs earlier this session that needed
// a release-step filter to stay affordable), so full unfiltered logging for the whole run
// is cheap -- no logFloaterHistoryReleaseStepFilter needed.
//
// LOG-JAM VARIANT of test_bridge_v1_lowwater_gas.prm: same domain, same recessed bridge
// geometry (piers/arches unchanged, DEM ArchTunnels matching LBM BodyBC exactly per the
// session's own DEM-vs-fluid consistency decision), same low-water free surface -- adds a
// staggered-release row of log-shaped FloatingBoxes to watch a clog form at the bridge,
// analogous to the real Pont ferroviaire record's July 2021 debris event (one opening
// blocked by a "main trunk").
//
// Changed from the lowwater base:
//   - restitutionCoefficient 0.97 -> 0.5 (near-elastic DEM contacts were the confirmed root
//     cause of the "flying floater" collision-cascade problem investigated at length this
//     session on the real-scale bridge/box-sedimentation scenarios; carrying the same fix
//     over here pre-emptively rather than rediscovering it on this scenario too).
//   - targetMeanVelocityMagnitude 0.02 -> 0.01 (slower current, gentler approach so logs
//     drift into the bridge rather than slamming it -- also gives the PID more steps to
//     settle before the first log arrives).
//   - timesteps unchanged at 30000; first 5000 steps have NO floaters active at all (see
//     FloatingBoxes below) so the free surface/flow field can develop under the new PID
//     target before any debris enters, then logs release in a staggered sequence from
//     step 5000 through 17000, needing roughly another ~4000-4500 steps at v=0.01 to drift
//     the ~45 LU from their spawn row to the bridge (X=61) -- leaving ~8500 steps at the
//     end purely to watch the resulting jam (or lack of one) interact with the structure.
//
// LOGS: FloatingBox, oriented long-axis along X (streamwise) since that's how elongated
// debris naturally travels before it tumbles/wedges -- halfExtents <6,1,1.5> = 12 LU long
// x 2 LU wide x 3 LU tall. Sized against the bridge's own openings (10 LU wide outer
// arches/pier gaps, 20 LU wide central arch): long enough that a log which rotates
// crosswise can plausibly bridge/wedge across an outer opening or catch on a pier corner,
// short/thin enough that any log staying streamwise passes through cleanly on its own --
// a real jam has to come from several logs interacting, not one log being an automatic
// plug. densityRatio 0.6 (real wood floats; the sediment bed's own 2.55 is rock/mineral
// density and would sink instantly).
//
// LAYOUT: two staggered upstream rows (X=15 and X=22, ~39-46 LU upstream of the bridge
// deck at X=61) so the "plan" is a loose X-Y grid, not a single line -- row 1 at
// Y=[5,17,30,43,55] (roughly centred on left arch/pier1/central arch/pier2/right arch),
// row 2 offset to Y=[11,24,36,49] (the gaps between row 1's targets), giving 9 logs total
// with a spread of arrival times and lateral aim across every opening and both piers.
// Spawned at Z=55, just above the away-from-bridge waterline (~49.1, see the lowwater
// base's own header) for a small, gentle drop-in rather than a violent splash.
//
// Everything else (domain, cellsPerBlock, arches, piers, Re/Fr/We, model parameters, VTK)
// is verbatim from test_bridge_v1_lowwater_gas.prm -- see that file's own header for the
// full derivation of the low-water column and the recessed-arch geometry decision.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;  // low-water variant -- see lowwater base's header; away-baseline absoluteLiquidHeight~49.1
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// xMin/xMax DELIBERATELY set to the piers' own straight-box span (61..67, i.e. pier x_center +-
// x_half), NOT the deck's outer X-span (56..72, what this used to be) -- recesses each arch
// collar's flat leading/trailing face behind the piers' rounded end-caps, so the round nose
// visibly sticks out past the deck edge instead of the deck being flush with the nose tip. Mirrors
// the same recess applied to the real-scale bridge (pont_ferroviere_rue_goffontaine_realscale_gas.prm)
// after 3D-voxel review there; the LBM BodyBC arch boxes below use the same 61..67 span, so DEM and
// fluid geometry never diverge. Not mesa_pd bodies -- consumed directly by ParticleKernels.h's
// ComputeTunnelContacts (see its class comment for why: DoubleCast can't give CylindricalBoundary a
// second, inside-out interpretation, since the pillars above already claim the outside-solid one).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; }  // right arch
}

// Log-jam debris: 2 upstream rows, staggered release (startInactive + settlingSteps), see this
// file's own header for the full rationale (sizing, spawn height, timing).
FloatingBoxes
{
   // Row 1 (X=15): aimed at left arch / pier1 / central arch / pier2 / right arch
   FloatingBox { position < 15, 5,  55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 5000;  startInactive true; }  // -> left arch
   FloatingBox { position < 15, 17, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 7000;  startInactive true; }  // -> pier1
   FloatingBox { position < 15, 30, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 9000;  startInactive true; }  // -> central arch
   FloatingBox { position < 15, 43, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 11000; startInactive true; }  // -> pier2
   FloatingBox { position < 15, 55, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 13000; startInactive true; }  // -> right arch

   // Row 2 (X=22): offset to the gaps between row 1's targets
   FloatingBox { position < 22, 11, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 6000;  startInactive true; }  // -> left arch/pier1 boundary
   FloatingBox { position < 22, 24, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 8000;  startInactive true; }  // -> central arch (left side)
   FloatingBox { position < 22, 36, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 10000; startInactive true; }  // -> central arch (right side)
   FloatingBox { position < 22, 49, 55 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 15000; startInactive true; }  // -> pier2/right arch boundary
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   // Explicit even though both already default to true (SimulationParams.h) -- an earlier bridge
   // run (mixed_75k) sank every floater to the domain floor regardless of density with
   // useBognerThreePhaseMEM=false (the pre-fix default), so this scenario keeps them explicit per
   // the lesson in test_bridge_v1_sphere_drip_lowwater_gas.prm's own header.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // Per-subcycle position/velocity/force/torque/hydroForce/density CSV log for every floater
   // (rank_<N>.csv contact/lubrication pairs, rank_<N>_state.csv world-state) -- only 9 floaters
   // here so unfiltered logging for the full run is cheap. See this file's own header for why
   // (investigating the flying-log event from job 4134495).
   logFloaterHistory              true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // Left arch (wall-to-pier1 span, Y=0..10, width 10 -> radius 5): same construction as
   // the central arch, sized to its own span so the opening is a true semicircular
   // half-pipe (full width at the springing line Z=56, point at the crown Z=61).
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 0, 56 >; max < 67, 10, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 5, 56 >; max < 67, 5, 56 >; radius 5; }
      }
      NoSlip{}
   }

   // Central arch (pier1-to-pier2 span, Y=20..40, width 20 -> radius 10): full width at
   // Z=56, crown at Z=66.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 20, 56 >; max < 67, 40, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 30, 56 >; max < 67, 30, 56 >; radius 10; }
      }
      NoSlip{}
   }

   // Right arch (pier2-to-wall span, Y=50..60, width 10 -> radius 5): mirrors the left arch.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 50, 56 >; max < 67, 60, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 55, 56 >; max < 67, 55, 56 >; radius 5; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
