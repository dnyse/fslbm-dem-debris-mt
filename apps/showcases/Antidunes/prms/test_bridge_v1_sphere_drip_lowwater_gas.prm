// test_bridge_v1_sphere_drip_lowwater_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Long-duration bridge floater-contact test: same piers+arches DEM geometry as
// test_bridge_v1_mixed_75k_gas.prm, but low-water free surface (liquidHeightFactor 2.0, matching
// test_bridge_v1_lowwater_gas.prm) and a single continuous "drip" of 100 radius-3, densityRatio=0.5
// spheres instead of one small mixed-shape batch.
//
// Release schedule: the flow field is allowed to develop undisturbed for the first 25000 steps (no
// floaters mapped/active at all), then starting at step 25000 one sphere activates every 1000 steps
// until all 100 have entered (last release at step 124000). timesteps=130000 leaves ~6000 steps after
// the last release for it to reach the bridge and settle.
//
// All 100 spheres are startInactive, sharing a 10-position Y-row (Y=5,11,...,59 at X=25, Z=65 -- "far
// left"/upstream, well above the (lowered) free surface so each falls in from the air) that cycles
// every 10 releases (10000 steps between reuses of the same Y slot) -- this is the startInactive
// mechanism at scale: each sphere is fully excluded from fluid mapping AND DEM contact (not just
// invisible -- physically absent) until its own settlingSteps, so 10x reuse of the same 10 physical
// spawn points across 100 releases is safe regardless of whether an earlier occupant has fully cleared
// the area by the time its slot comes back around.
//
// useBognerThreePhaseMEM/useMemOnlyBuoyancy explicit true: SimulationParams.h's own default as of the
// buoyancy-flag fix (previously useBognerThreePhaseMEM defaulted to false, which paired with the
// existing useMemOnlyBuoyancy=true default left densityRatio=0.5 floaters with NO net buoyant support
// at all -- confirmed via VTK output from the earlier test_bridge_v1_mixed_75k_gas.prm run, where every
// floater regardless of shape sank to the domain floor, Z~4-6, despite being half water's density).
// Stated explicitly here (not relying on the default alone) so this file's behaviour is self-contained.
//
// Domain/bridge geometry (piers/arches) UNCHANGED from test_bridge_v1_gas.prm -- see that file's own
// header for the full derivation.
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4x3x6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;  // low-water variant -- see test_bridge_v1_lowwater_gas.prm's header note
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         130000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// xMin/xMax DELIBERATELY set to the piers' own straight-box span (61..67, i.e. pier x_center +-
// x_half), NOT the deck's outer X-span (56..72, what this used to be) -- recesses each arch
// collar's flat leading/trailing face behind the piers' rounded end-caps, so the round nose
// visibly sticks out past the deck edge instead of the deck being flush with the nose tip. Mirrors
// the same recess applied to the real-scale bridge (pont_ferroviere_rue_goffontaine_realscale_gas.prm)
// after 3D-voxel review there; the LBM BodyBC arch boxes below use the same 61..67 span, so DEM and
// fluid geometry never diverge. Not mesa_pd bodies -- consumed directly by ParticleKernels.h's
// ComputeTunnelContacts (see its class comment for why: DoubleCast can't give CylindricalBoundary a
// second, inside-out interpretation, since the pillars above already claim the outside-solid one).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; }  // right arch
}

// 100 radius-3 densityRatio=0.5 spheres, released one every 1000 steps starting at step 25000 (after
// the flow field has developed), cycling through a 10-position Y-row at X=25 (far upstream), Z=65.
// See file header for the full startInactive/reuse rationale.
FloatingSpheres
{
   FloatingSphere { position < 25, 5, 65 >; radius 3; densityRatio 0.5; settlingSteps 25000; startInactive true; }
   FloatingSphere { position < 25, 11, 65 >; radius 3; densityRatio 0.5; settlingSteps 26000; startInactive true; }
   FloatingSphere { position < 25, 17, 65 >; radius 3; densityRatio 0.5; settlingSteps 27000; startInactive true; }
   FloatingSphere { position < 25, 23, 65 >; radius 3; densityRatio 0.5; settlingSteps 28000; startInactive true; }
   FloatingSphere { position < 25, 29, 65 >; radius 3; densityRatio 0.5; settlingSteps 29000; startInactive true; }
   FloatingSphere { position < 25, 35, 65 >; radius 3; densityRatio 0.5; settlingSteps 30000; startInactive true; }
   FloatingSphere { position < 25, 41, 65 >; radius 3; densityRatio 0.5; settlingSteps 31000; startInactive true; }
   FloatingSphere { position < 25, 47, 65 >; radius 3; densityRatio 0.5; settlingSteps 32000; startInactive true; }
   FloatingSphere { position < 25, 53, 65 >; radius 3; densityRatio 0.5; settlingSteps 33000; startInactive true; }
   FloatingSphere { position < 25, 59, 65 >; radius 3; densityRatio 0.5; settlingSteps 34000; startInactive true; }
   FloatingSphere { position < 25, 5, 65 >; radius 3; densityRatio 0.5; settlingSteps 35000; startInactive true; }
   FloatingSphere { position < 25, 11, 65 >; radius 3; densityRatio 0.5; settlingSteps 36000; startInactive true; }
   FloatingSphere { position < 25, 17, 65 >; radius 3; densityRatio 0.5; settlingSteps 37000; startInactive true; }
   FloatingSphere { position < 25, 23, 65 >; radius 3; densityRatio 0.5; settlingSteps 38000; startInactive true; }
   FloatingSphere { position < 25, 29, 65 >; radius 3; densityRatio 0.5; settlingSteps 39000; startInactive true; }
   FloatingSphere { position < 25, 35, 65 >; radius 3; densityRatio 0.5; settlingSteps 40000; startInactive true; }
   FloatingSphere { position < 25, 41, 65 >; radius 3; densityRatio 0.5; settlingSteps 41000; startInactive true; }
   FloatingSphere { position < 25, 47, 65 >; radius 3; densityRatio 0.5; settlingSteps 42000; startInactive true; }
   FloatingSphere { position < 25, 53, 65 >; radius 3; densityRatio 0.5; settlingSteps 43000; startInactive true; }
   FloatingSphere { position < 25, 59, 65 >; radius 3; densityRatio 0.5; settlingSteps 44000; startInactive true; }
