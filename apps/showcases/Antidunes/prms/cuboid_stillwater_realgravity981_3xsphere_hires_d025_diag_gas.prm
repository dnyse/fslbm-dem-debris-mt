// cuboid_stillwater_realgravity981_3xsphere_hires_d025_diag_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-15] DIAGNOSTIC RESUME for the R3 equilibrium job 4236462's own
// `[NaN-SCAN] aborting after timeloopFSLBM at t=72000` crash (a fresh, non-checkpoint run --
// unrelated to the debris-clogging checkpoint-resume bug fixed earlier the same day). That crash's
// own FATAL-cell report is misleading at face value: checkPdfNaN's per-block scan stops at the FIRST
// bad cell it finds (z-outer/y-middle/x-inner iteration order), so "82 of 84 FATAL cells are at
// local (0,0,0)" is very likely just a reporting artifact of a much more widespread blow-up, not
// evidence that block-corner cells are somehow special -- meanVelocity was still smooth and tiny
// (~8.9e-6) through the last periodic check at t=71500, giving no advance warning either way.
//
// Rather than re-running 72000 steps from scratch to observe the onset, this resumes job 4236462's
// own last checkpoint (t=70000, snapshotFrequency=10000, still on disk on mt-dennys/build's own
// snapshots/) with denseNanScanEnabled bracketing the known crash window tightly (70000-72500) and
// storeSnapshot left OFF so this diagnostic run cannot disturb that checkpoint. Otherwise
// byte-for-byte identical to cuboid_stillwater_realgravity981_3xsphere_hires_d025_gas.prm.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 17, 42, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  true;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <119, 168, 150>;
   wavePeriods        1;
   liquidHeightFactor 9.9681;
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              72500;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // keep physical constants valid while U = 0; viscosity=0.000214026 fixed
   gravityOverride        2.6596472613474883e-05;  // solved for g_SI = 9.81 m/s^2 at this resolution's dx_SI/dt_SI (see header)
   denseNanScanEnabled    true;
   denseNanScanFromStep   70000;
   denseNanScanToStep     72500;
   lowRhoPrecursorThreshold 0.1;
   highVelocityPrecursorThreshold 0.4;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 3;   // scaling-math lever only (useParticleBed false) -- see sphere sibling's header
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // densityRatio 0.25 -> Archimedes equilibrium: 25% submerged.
      position             < 59.5, 84, 75 >;
      halfExtents          < 18.59375, 37.1875, 18.59375 >;
      densityRatio         0.25;
      settlingSteps        0;
      initialTiltAngleDeg  5;
      comOffsetZ           0;
      pinPosition          false;   // fully free
      pinRotation          false;   // fully free
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       0;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         density;
         fill_level;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 84, 0 >;   max < 119, 85, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 168, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 119, 168, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
