// hopper_clog_pidoff_2node_frontblock_gas.prm   (copy of hopper_clog_pidon_2node_frontblock_gas.prm = job 4248723 with the PID OFF)
// [Claude, 2026-09-21] SPHERE hopper, whole 1015-sphere block against the pillars (pillar radius 12, gap 16) -- IDENTICAL to the completed PID-on run 4248723 (60000 steps, 1h50m, no clog) except:
// PIDParameters.enabled false + accelerationXOverride 5.9e-7 (steady no-clean-channel force from 4252463) and the fluid VTK crop z 0..140 (no extra diagnostics, so the cost per step equals the original: 1h50m for 60000 steps). VTK every 5000.
// hopper_clog_pidon_2node_frontblock_gas.prm   (GENERATED by gen_hopper_clog_prm.py -- edit the script, not this file)
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-18] THESIS ITEM 3 (THESIS_PLAN.md): second clogging setup, "hopper" variant.
//
// GEOMETRY  (plan view, flow left -> right, Y up):
//
//        Y=40 ─────)   (─────        two cylindrical pillars, axes at X=384, on the Y walls
//                   ) . (             (Y=0 and Y=40), radius 12  ->  central gap 16 LU wide
//        Y=0  ─────)   (─────        i.e. "|) (|" seen from above; each pillar is a half-cylinder in
//                                    the channel. Pillars span the full height (Z 0..180).
// The previous extreme-clog family used spheres BIGGER than the slits (a plugged aperture); here
// each sphere (radius 3, d=6) fits through the 16 LU gap on its own (gap/d = 2.67), so any
// stoppage has to come from ARCHING -- several spheres wedging each other across the opening, as grains
// do in a silo hopper -- not from a single oversized obstacle.
//
// POPULATION: 1015 spheres (5 across Y x 7 layers in Z x 29 rows in X, grid pitch X/Y/Z = 7/8/7.52 LU,
// >= 1 LU surface clearance everywhere), densityRatio {0.5,1.0,1.2} = 290/435/290 (1.5 dropped as requested). ALL are created up front, in the
// water and at the surface, upstream of the pillars (block X in [169.5,371.5], 0.5 LU free run to the pillar
// surface) -- no staggered dropping. Density is stratified by height so every sphere starts near its own
// buoyant equilibrium (1.2 low, 1.0 mid-depth, 0.5 in the top two layers -- the top layer sits exactly
// at the waterline Z=49.13, half submerged) instead of triggering a violent buoyancy re-sort at release.
// settlingSteps 2000 (no startInactive): every sphere is held FIXED for the first 2000 steps so
// the free surface can form its contact lines around the surface layer (the same reason the surface-start
// floater scenarios hold -- see FloatingSphereParams::settlingSteps), then all are released at once. Clearance
// >= 1 LU means no contact on the first sub-cycle, so the [RELEASE-OVERLAP] check cannot fire.
//
// FLOW: PID ON at the extreme-clog family's target 0.04 (fixed discharge). Domain, water height, PID gains,
// ModelParameters, Z=180 headroom and the 144-rank/2-node decomposition are copied unchanged from
// clog_measurement_validation_extreme_pidon_2node_gas.prm so results stay comparable to that family.
// Downstream leg wraps periodically to X=0 and back upstream of the block; the block itself is kept
// well clear of the X=0/768 seam.
//
// OPEN CHOICES worth revisiting after the first run: gap/d (change --pillar-radius/--radius), hold vs.
// immediate release (--hold 0), PID off with the calibrated force instead, a no-clog reference with a
// wide gap. Time estimate for 60000 steps: ~2-3 h on 144 ranks (1000 spheres sit on only ~12
// ranks -- DEM load is unbalanced but small; unverified until the first run).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     false;
   // [Claude, 2026-09-21] PID OFF: acceleration_x stays pinned at accelerationXOverride = 5.9e-7, the STEADY force of the clean (no-debris) channel measured in job 4252463 (hopper_clog_cyl_noclog_reference_pidon_30k; mean of the six
   // 2500-step windows 15000-30000, spread 4.8e-7..6.8e-7). Valid here because this sphere hopper has the IDENTICAL channel (768x40x180, liquidHeightFactor 2.0, floorHeightFactor 4.1393, pillars R12 at X=384, same Re/Fr/We,
   // same avgParticleDiameterOverride/unit system) -- only the debris (spheres instead of rods) differs. 'The same fixed force as the clean channel, now with debris' (THESIS_PLAN.md 2026-09-18 convention).
   accelerationXOverride       5.9e-7;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         60000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see the extreme-clog prm's header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // axes ON the Y walls: half of each cylinder lies outside the domain (harmless -- only the part
   // inside the channel can touch a sphere). Z is an arbitrary reference point on the vertical axis.
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

