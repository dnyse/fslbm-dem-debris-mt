// boxes_48x_2x8x3_clog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-30] DOUBLING-IN-X step for the box shape-comparison series, per explicit request
// ("do another two cuboids run double the number in x for one of the jobs"): FORTY-EIGHT boxes,
// 2(Y) x 8(X) x 3(Z), continuing `boxes_24x_2x4x3_clog_gas.prm`'s own 4 rows (X=364/357/350/343) with
// 4 more rows at the SAME 7 LU pitch (X=336/329/322/315) -- exactly the doubling-in-X methodology
// already used for the cylinder/rod series (small_rods_12x -> small_rods_24x -> giant_rods doubling,
// THESIS_PLAN.md), just applied to boxes instead. Everything else -- domain, pillars, PID, physics,
// ModelParameters, per-row Y-column/Z-layer/density pattern -- is IDENTICAL to boxes_24x_2x4x3.
//
// Motivation for going to 48 specifically: the 24-box run (job 4279039) completed cleanly with NO
// crash, but per-floater VTK tracking showed it was NOT simply "nothing interesting happened" --
// 7/8 of the deep/dense layer (Z=10, densityRatio=1.2) jammed permanently right at the pillar gap
// while all 16 boxes from the two lighter layers escaped downstream. Doubling the row count doubles
// the number of deep-layer boxes arriving at that SAME jam site over the run, packing the pile denser
// at the one location where box-box contacts actually accumulate -- the same "increase the density at
// the crash-prone spot" logic the original cylinder doubling series used to go from a clean 12-rod run
// to a crashing 24-rod one.
//
// Option A/B and the (fully reverted) sealed-cell guard: same as boxes_24x_2x4x3 -- absent/off.
// useAnalyticalContactDetection true (SAT for box-box); useTightLayer1/usePureAnalyticalCylinder are
// cylinder-specific no-ops, carried over unchanged for an exact diff against the box-24x/cylinder
// prms. VTK writeFrequency 10000, timesteps 51000, identical to the 24-box run.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingBoxes
{
   // Row 1 (X=364) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 364, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 364, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 364, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 364, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 364, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 364, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 2 (X=357, 7 LU behind row 1) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 357, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 357, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 357, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 357, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 357, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 357, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 3 (X=350, 7 LU behind row 2) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 350, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 350, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 350, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 350, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 350, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 350, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 4 (X=343, 7 LU behind row 3) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 343, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 343, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 343, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 343, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 343, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 343, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 5 (X=336, 7 LU behind row 4) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 336, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 336, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 336, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 336, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 336, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 336, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 6 (X=329, 7 LU behind row 5) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 329, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 329, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 329, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 329, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 329, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 329, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 7 (X=322, 7 LU behind row 6) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 322, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 322, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 322, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 322, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 322, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 322, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 8 (X=315, 7 LU behind row 7) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 315, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 315, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 315, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 315, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 315, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 315, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all eight rows (X 200..500, Z 0..100); the boxes are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 200, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
