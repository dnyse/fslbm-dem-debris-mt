// Source of the smooth analytical curve (not the DEM markers) of the cylinder wall-impact figures (Section 5.2): same
// geometry and protocol as the _translational/_rotational sweeps, but 1 deg steps (91 points, 0-90 deg). The logged
// analyticVel/analyticAngVel are the rigid-body reference and do not depend on useRotationalEffectiveMass; it is
// true here only so that the simulated points are the more accurate ones.
DEMValidation{
    testCase wallImpactCylinder;
    useRotationalEffectiveMass true;
    dt 0.00002;

    cylinderRadius 4.0;
    cylinderLength 5.3;
    density 1.0;
    restitutionCoefficient 0.85;
    frictionCoefficient 0.0;
    poissonsRatio 0.35;
    collisionTime 0.01;

    impactSpeed 1.0;
    tangentialSpeedFraction 0.0;
    tiltStartDeg 0.0;
    tiltEndDeg 90.0;
    tiltStepDeg 1.0;

    toleranceRelError 0.02;
    vtkSpacing 0;
    outputBaseName wall_impact_cylinder_kodam_sweep_fine;
}
