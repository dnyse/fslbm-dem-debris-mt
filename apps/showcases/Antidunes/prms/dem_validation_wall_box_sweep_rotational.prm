// Rotational-effective-mass counterpart of dem_validation_wall_box_sweep_translational.prm: same geometry and 0-90 deg,
// 5 deg sweep with purely normal impact, useRotationalEffectiveMass true. Data source of the cuboid wall-impact
// figures (Section 5.2).
DEMValidation{
    testCase wallImpactBox;
    useRotationalEffectiveMass true;

    boxHalfExtents < 1.0, 2.0, 2.0 >;
    density 1.0;
    restitutionCoefficient 0.6;
    frictionCoefficient 0.0;
    poissonsRatio 0.22;
    collisionTime 0.01;

    impactSpeed 1.0;
    tangentialSpeedFraction 0.0;
    tiltStartDeg 0.0;
    tiltEndDeg 90.0;
    tiltStepDeg 5.0;

    toleranceRelError 0.02;
    vtkSpacing 0;
    outputBaseName wall_impact_box_kodam_sweep_rotational;
}
