// giant_box_drop_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Free-settling test for a floating BOX — the box analogue of giant_sphere_drop_gas.prm.
// One freely-rotating cube (edge 24 LU), NO pillars, released FROM REST above the free
// surface into still-ish water, given a small initial tilt so the buoyancy MOMENT is
// exercised: we observe both where it comes to rest in Z (≈50% submerged) AND what
// orientation it settles into.
//
// What this exercises (new vs. the sphere test):
//   • Centre-of-buoyancy torque (Bogner & Rüde 2013, Fig. 5.4): buoyancy acts at the
//     centroid B of the submerged part, not at the centre of gravity G. With an initial
//     tilt, B shifts horizontally off G → a moment (B−G)×F_buoy. A neutrally-dense cube
//     is typically UNSTABLE upright (metacentre below G), so expect it to rotate toward a
//     corner-/edge-down orientation rather than self-right — watch [BoxBuoyancy] tiltY and
//     |B-G|_horiz, and the "rotation" tensor in the floaterBox VTK.
//
// Same physics caveats as the sphere drop test:
//   • targetMeanVelocityMagnitude is kept at 0.02 and MUST stay > 0 — it is the master
//     velocity scale (zeroing it kills viscosity → relaxationRate 2.0, gravity, surface
//     tension, dt). The 50%-submersion equilibrium is set by densityRatio and is
//     independent of the current; read rest depth from Z, not X (the box advects
//     downstream in the periodic X while it settles/rotates).
//
// Output: the box is written to vtk-out/floaterBox*  (edgeLength + 3x3 rotation + velocity).
//   ParaView: Glyph (Box, Scale Array=edgeLength, Scale by Components) + Tensor Glyph using
//   "rotation" to render the oriented solid.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;    // master velocity scale — must stay > 0 (see header)
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // Cube: edgeLength = 2*halfExtents = 24 LU. Circumscribed half-diagonal ≈ 20.8 LU, so the
      // y-extent stays clear of the NoSlip walls (centre y=30 in a 60-wide domain → ≈9 LU margin
      // even when fully rotated). Centre at (30,30,100): bottom at z=88, ≈32 LU above the surface
      // (z≈56). Held fixed for settlingSteps, then released from rest to free-fall and settle.
      position            < 30, 30, 100 >;
      halfExtents         < 12, 12, 12 >;
      densityRatio        0.5;
      settlingSteps       500;
      initialTiltAngleDeg 15;   // seed a tilt about the Y-axis so the buoyancy moment is non-zero
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   // false = uniform all-interface reconstruction (no fill=1 over-promotion band) — the path
   //         that never drifted/NaN'd. Set true to use Bogner per-cell state selection instead.
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
