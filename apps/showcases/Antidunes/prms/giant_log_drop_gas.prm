// giant_log_drop_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Free-settling RIGHTING test for the giant floating LOG — the log analogue of
// giant_box_drop_gas.prm (which drops the cube). One freely-rotating log
// (edgeLength 12×36×12, halfExtents <6,18,6>, 1:3:1 ratio), NO pillars, released
// FROM REST above the free surface with a deliberate initial tilt, so we can watch
// the lowered-COM righting torque pull it back upright IN ISOLATION (no flow/pillar
// forces muddying the picture). Compare against giant_box_two_pillars_gas.prm, which
// runs the same log but with the pillars + advecting flow.
//
// What this exercises:
//   • Centre-of-buoyancy vs. centre-of-gravity moment. Buoyancy acts at the centroid B
//     of the submerged part; gravity acts at the COM G. As the log rolls about Y, B
//     shifts horizontally → a moment (B−G)×F_buoy, AND the lowered COM swings out →
//     a pendulum moment (G−centroid)×F_grav. Together they set the metacentric height.
//   • A UNIFORM neutrally-dense log rolls about its long (Y) axis (GM<0). Lowering the
//     COM with comOffsetZ makes GM>0 → the seeded tilt self-rights instead of capsizing.
//     Watch [BoxBuoyancy] tiltY → 0, |B-G|_horiz, and comOffsetZ in the log.
//
// Physics caveats (same as the cube/sphere drop tests):
//   • targetMeanVelocityMagnitude is kept at 0.02 and MUST stay > 0 — it is the master
//     velocity scale (zeroing it kills viscosity → relaxationRate 2.0, gravity, surface
//     tension, dt). The 50%-submersion equilibrium is set by densityRatio and is
//     independent of the current; read rest depth from Z, not X (the log advects
//     downstream in the periodic X while it settles/rotates).
//
// Output: the log is written to vtk-out/floaterBox* (edgeLength + 3x3 rotation + velocity).
//   ParaView: Glyph (Box, Scale Array=edgeLength, Scale by Components) + Tensor Glyph using
//   "rotation" to render the oriented solid.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;    // master velocity scale — must stay > 0 (see header)
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // GIANT log: edgeLength 12×36×12 (halfExtents 6×18×6), 1:3:1 ratio. Rotation about Y
      // leaves the y-extent at ±18 → y∈[12,48] in the 60-wide domain → ≈12 LU clear of the
      // NoSlip N/S walls. Centre (30,30,100): bottom ≈ z=93, ≈37 LU above the surface (z≈56).
      // Held fixed for settlingSteps, then released from rest to free-fall and settle.
      position             < 30, 30, 100 >;
      halfExtents          < 6, 18, 6 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  15;   // big seed about Y so the righting (or rolling) is unmistakable
      // Lower the centre of mass below the centroid so the log self-rights instead of rolling.
      // Half-submerged, rolling about Y: draft d=6 → KB=3, BM=L²/(12d)=12²/72=2, KG=6 (uniform) →
      // GM = KB+BM−KG = −1 (rolls). comOffsetZ=−3 drops the COM 3 LU → KG=3 → GM = +2 (stable):
      // the seeded 15° tilt damps back to upright. Set to 0 to recover the rolling instability.
      comOffsetZ           -3;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
