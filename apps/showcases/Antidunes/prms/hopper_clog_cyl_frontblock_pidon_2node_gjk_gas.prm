// HOPPER GAP, 406 RODS, GJK/EPA-ONLY CONTACTS (uncapped PID).
// Channel 768 x 40 x 180, periodic in x (<64, 20, 30> blocks = 144 ranks / 2 nodes), water level z = 49.13, PID-driven
// flow (target mean velocity 0.04, maxActuatingVariable 1e-3, effectively uncapped). Two cylindrical pillars R 12
// centred on the y walls at x = 384 leave a 16 LU gap, shorter than a rod.
// Floaters: 406 rods R 3, L 18, axis y; 2 across x 7 layers x 29 rows, pitch x/y/z 7/20/7.52 (>= 1 LU surface clearance
// rod-rod / wall / floor), centres x 172..368 (front row 1.04 LU from the pillar surface); densityRatio 1.2 (bottom two
// layers), 1.0 (middle three), 0.5 (top two, the top layer's axis at the waterline). Held fixed for 2000 steps, then
// released together. No contact skin.
// Contacts: useAnalyticalContactDetection false, i.e. GJK/EPA for rod-rod pairs (rod-pillar and rod-wall contacts use
// their closed forms regardless; in short test runs the closed-form rod-rod path aborted while GJK/EPA stayed clean
// with rod-rod penetration <= 0.43 LU); default stiffness
// (collisionTimeFactor 4); friction/restitution 0.5 / 0.5.
// 60000 steps, checkpoints every 5000; probes at x = 336 (inside the rod block) and x = 432, z = 40; fluid VTK every
// 5000 steps, cropped to x 128..640, z 0..100.

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         60000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- derived from U, Fr and the liquid height (useHardcodedUnits false)
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // axes on the y walls: half of each pillar lies outside the domain (harmless); z is a reference point on the axis
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   FloatingCylinder { position < 368.00, 10.00, 4.00 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 2000; }
   FloatingCylinder { position < 368.00, 10.00, 11.52 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 2000; }
   FloatingCylinder { position < 368.00, 10.00, 19.04 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1; settlingSteps 2000; }
   FloatingCylinder { position < 368.00, 10.00, 26.56 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1; settlingSteps 2000; }
