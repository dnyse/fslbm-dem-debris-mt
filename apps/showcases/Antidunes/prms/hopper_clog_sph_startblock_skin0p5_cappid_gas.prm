// GENERATED by gen_hopper_stress_prms.py (--sphere-startblock-only) -- HOPPER GAP, DRIFTING SPHERES: the drifting-rods
// start block with every rod replaced by 5 spheres R 3 across the channel (y = 4, 12, ..., 36).
// Channel 768 x 40 x 180, periodic in x (<64, 20, 30> blocks = 144 ranks / 2 nodes), water level z = 49.13, PID-driven
// flow (target mean velocity 0.04, cap maxActuatingVariable 2.65e-6 = 5.0 a_ref of the clean hopper, a_ref = 5.31e-7).
// Two cylindrical pillars R 12 centred on the y walls at x = 384 leave a 16 LU gap, shorter than a rod (L 18).
// Floaters: 1015 spheres R 3, 5 across (y = 4, 12, ..., 36) in
// 29 rows x 7 layers, pitch x/z 8/7.52, centres x 8..232, i.e. 140 LU upstream of the pillar faces (x = 372), so the
// upstream probes (x = 336) start in clean water; densityRatio 1.2 / 1.0 / 0.5 in the bottom two / middle three / top
// two layers. All floaters are held fixed for 500 steps, then released together.
// Contacts: friction/restitution 0.5 / 0.5; spheres have no contact skin (sphere-sphere pairs get the lubrication
// correction). guardCurvatureInputs and wallOuterGhostLayer on.
// Probes at x = 336 / 432, z = 20 (centre y = 20, pillar y = 6), with discharge and blockage ratio.
// 150000 steps; fluid (whole channel) and floater VTK at 17 snapshot steps from 0 to 149000.
// Base: hopper_clog_cyl_frontblock_pidon_2node_skin0p5_curvguard_cappid_gas.prm (block at the pillars, 100000 steps).

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // cap = 5.0 a_ref of the clean hopper, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         150000;  // base prm: 100000
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- derived from U, Fr and the liquid height (useHardcodedUnits false)
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // axes on the y walls: half of each pillar lies outside the domain (harmless); z is a reference point on the axis
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

