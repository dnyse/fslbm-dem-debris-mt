// boxes_24x_2x4x3_clog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-30] SHAPE-COMPARISON companion to `small_rods_24x_2x4x3_clog_gas.prm`, per
// explicit request ("run this one of the free directory with cylinders and on the other free one
// with cubes"): IDENTICAL scenario -- same domain, pillars, PID, physics, ModelParameters, and all
// 24 body positions/densities -- with the 24 FloatingCylinders replaced by 24 FloatingBoxes of the
// same footprint (halfExtents <3,9,3> = edgeLength 6x18x6, matching the rod's radius-3/length-18
// bounding box exactly, long axis along Y as the rods were), no initial tilt seed (the rods started
// with axis exactly along Y and no tilt either, so this is a like-for-like shape swap, not a new
// perturbation). Same purpose as the rod run: does the same densely-packed-body-at-a-pillar-gap
// configuration reproduce the STALE-PARTICLE-IDX cross-rank ghost-ownership desync (THESIS_PLAN.md,
// "keep doubling in X" series) with box-box contact instead of cylinder-cylinder -- boxes only ever
// touch via point/edge/face contacts (SAT), never the rod's line-contact wedge geometry, so this
// tests whether the desync is contact-detection-path-specific or a general dense-body-pile effect.
//
// Option A/B (seedStreamPdfCloneOnFirstUse / repairDegenerateObstaclePdfs) both absent -> default
// false, matching the rod run exactly. No sealed-cell guard (closeSealedCellsMinNeighbours unset ->
// 0/off; the guard code from the ghost-ownership investigation was reverted in full, nothing to
// disable). useAnalyticalContactDetection true (SAT for box-box); usePureAnalyticalCylinder/
// useTightLayer1 carried over unchanged from the rod prm (cylinder-specific, no-ops with zero
// cylinders present). VTK writeFrequency 10000, timesteps 51000, identical to the rod run.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingBoxes
{
   // Row 1 (X=364) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 364, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 364, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 364, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 364, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 364, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 364, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 2 (X=357, 7 LU behind row 1) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 357, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 357, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 357, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 357, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 357, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 357, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 3 (X=350, 7 LU behind row 2) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 350, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 350, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 350, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 350, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 350, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 350, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }

   // Row 4 (X=343, 7 LU behind row 3) -- both Y columns, deep/mid/shallow.
   FloatingBox { position < 343, 10, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 343, 10, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 343, 10, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
   FloatingBox { position < 343, 30, 10 >; halfExtents < 3, 9, 3 >; densityRatio 1.2; settlingSteps 500; }
   FloatingBox { position < 343, 30, 25 >; halfExtents < 3, 9, 3 >; densityRatio 1.0; settlingSteps 500; }
   FloatingBox { position < 343, 30, 45 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all four rows (X 250..500, Z 0..100); the boxes are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
