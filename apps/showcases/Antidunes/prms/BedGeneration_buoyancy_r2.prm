BedGeneration{
    // Scaling-reference bed for the R=2 level of the MEM vs. analytical buoyancy comparison. The SI values
    // (domainSize_SI, diameter_SI) are physical and the same at every resolution level; only the
    // Antidunes-side domainSize/cellsPerBlock change (R=2: <96,96,192>/<32,32,24>), and outFileName.
    //
    // With domainSize[0] = 96: scalingFactor = 96/0.017409318 = 5514.29, dx_SI = 1.8135e-4 m (half of R=1),
    // avgParticleDiameter = 16.0 LU for the nominal diameter_SI; the lattice gravity scales as dx_SI^3 (1/8 of R=1).
    domainSize_SI < 0.017409318, 0.017409318, 0.034818636 >;
    blocks < 3, 2, 12 >;
    diameter_SI 0.0029015530199227404;
    gravity_SI 9.81;
    densityFluid_SI 1000;
    densityParticle_SI 2550;
    generationSpacing_SI 0.0034818636239;
    initialVelocity_SI 1;
    dt_SI 5e-5;
    frictionCoefficient 0.5;
    restitutionCoefficient 0.1;
    collisionTime_SI 5e-4;
    poissonsRatio 0.22;
    timeSteps 10000;
    visSpacing 100;
    outFileName spheres_out_buoyancy_r2.dat;
    denseBottomLayer False;
    bottomLayerOffsetFactor 1.0;
}
