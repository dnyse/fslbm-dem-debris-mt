// bogner_righting_scan2_s32_a22p5_gas.prm   (GENERATED by gen_bogner_righting_scan_prm.py -- edit the script, not this file)
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-19] FIXED-HEEL RIGHTING-MOMENT SCAN, heel 22.5 deg, s = 32 (Bogner 2017 Sec. 5.3.2 protocol, cube section 2s x s x s = 32x64x32).
// Purpose: measure the raw MEM torque on a HELD box and compare rho = 0.75 with rho = 0.25. Ideal theory: M_{1-rho}(alpha) = +M_rho(alpha), i.e. the rho=0.25 and rho=0.75 torque curves are IDENTICAL (checked on the ideal numbers in the
// generator). See gen_bogner_righting_scan_prm.py's docstring. NOT RUN YET.
//  * basin 260x80x80, lower half liquid, initial free surface at Z = 40.5 (fill level is initialised half a cell above the nominal 40); X and Y periodic; tau = 1/1.9, g = 0.000375.
//  * 2 boxes rho 0.75 / 0.25 at X = 65.0, 195.0, ALL at heel 22.5 deg about Y, each held (position AND rotation pinned in every axis) at the heave where its submerged
//    cross-section area equals rho*s^2: Z = 33.109, 47.891 for rho 0.75, 0.25 (ideal geometry, waterline 40.5).
//  * MEM-only buoyancy (useMemOnlyBuoyancy + useBognerThreePhaseMEM); useAnalyticBoxBuoyancy explicitly OFF (no analytic buoyancy).
//  * 40000 steps, then the floater-history state CSV (raw MEM hydroForce/hydroTorque of the local copy of each box) is logged for steps 39000..39300 only -- the CSV has blown the home
//    quota before, so the window is short and the fluid has 39000 steps to settle (acoustic damping is slow at tau=0.526).
//  * Domain 260x80x80 / cellsPerBlock <20,16,40> = 13x5x2 = 130 processes.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 20, 16, 40 >;
   periodicity                   < 1, 1, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             100000000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <260, 80, 80>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              40000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;          // Bogner's tau = 1/1.9
   gravityOverride        0.000375;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 16;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 65.0000, 40, 33.1090 >;
      halfExtents          < 16, 32, 16 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  22.5;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 1 >;   // held at the Archimedes heave for this rho and heel
      pinRotation          true;
      pinRotationAxes      < 1, 1, 1 >;   // held at the heel angle
   }
   FloatingBox
   {
      position             < 195.0000, 40, 47.8910 >;
      halfExtents          < 16, 32, 16 >;
      densityRatio         0.25;
      settlingSteps        0;
      initialTiltAngleDeg  22.5;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 1 >;   // held at the Archimedes heave for this rho and heel
      pinRotation          true;
      pinRotationAxes      < 1, 1, 1 >;   // held at the heel angle
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;   // explicitly OFF

   logFloaterHistory             true;    // per-rank floater-history/rank_<N>_state.csv (raw MEM hydroForce/hydroTorque), WINDOWED below
   floaterHistoryBaseFolder      floater-history;
   logFloaterHistoryStartStep    39000;
   logFloaterHistoryEndStep      39300;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       20000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 40, 0 >;  max < 260, 41, 80 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
