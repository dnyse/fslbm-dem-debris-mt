// test_bridge_v1_raisedwater_spheres_logjam_floaterlog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// SPHERE + LOWERED-WATER MIRROR of test_bridge_v1_raisedwater_logjam_floaterlog_gas.prm
// (job 4135755, confirmed clean: 1611 tunnel-contact rows, 100% above the springing line,
// spread across all 3 arches, 0 crash indicators). Two changes from that confirmed-good run:
//
//   - SHAPE: FloatingBox (halfExtents<6,1,1.5>) -> FloatingSphere (radius 3), same 9
//     positions/settlingSteps -- mirrors the earlier box-vs-sphere shape control pairing from
//     this session (spheres are isotropic, so ComputeTunnelContacts's containment math for
//     them was always exact even before the exact-corner fix; this run instead checks the
//     now-fixed springing-line constraint against a sphere specifically, complementing the
//     box-shaped confirmation).
//   - WATER LEVEL LOWERED SLIGHTLY: liquidHeightFactor 3.2 -> 3.0 (absoluteLiquidHeight
//     ~58.73 -> ~57.13, using this project's own formula, avgParticleDiameter=8.00194,
//     floorHeightFactor=4.1393 unchanged). The 3.2 run put the surface ~2.7 LU above the
//     springing line, submerging roughly half the width of each 5-radius outer arch opening
//     (semicircle chord width at height h above the springing line is 2*sqrt(r^2-(r-h)^2);
//     at h=2.7, r=5 that's ~8.9 LU out of a 10 LU max span) -- genuine interaction, but with
//     the free-surface flow itself significantly obstructed through the smaller arches. This
//     run's ~57.13 sits only ~1.1 LU above the springing line (chord width ~6.3 LU at the
//     outer arches, central arch barely touched at all with 10 LU of radius), still solidly
//     above the springing line for real upper-semicircle contact, but leaving a substantially
//     larger open-air cross-section for water to keep flowing freely through every opening.
//   - Spawn height 60 -> 59 (just ~1.9 LU above the new, slightly lower waterline, same
//     gentle-drop-in intent as before).
//
// Everything else (piers, arches/ArchTunnels, restitutionCoefficient=0.5,
// targetMeanVelocityMagnitude=0.01, timesteps=30000, logFloaterHistory=true, domain,
// cellsPerBlock, Re/Fr/We, model parameters, VTK) is verbatim from
// test_bridge_v1_raisedwater_logjam_floaterlog_gas.prm -- see that file's own header, and
// test_bridge_v1_lowwater_logjam_floaterlog_gas.prm before it, for the full derivation of
// everything not changed here.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 3.0;  // lowered slightly from the raisedwater base's 3.2 -- see this file's own header; absoluteLiquidHeight~57.13
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// ComputeTunnelContacts only engages the UPPER semicircle (Z >= center[2] = the springing line,
// 56) -- confirmed clean on both the box raisedwater run (job 4135755) and the lowwater run
// (job 4134882, 0 spurious contacts).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; }  // right arch
}

// Same 9 upstream aim points/settlingSteps as the box variant, but FloatingSphere radius 3
// instead of FloatingBox -- see this file's own header for why.
FloatingSpheres
{
   // Row 1 (X=15): aimed at left arch / pier1 / central arch / pier2 / right arch
   FloatingSphere { position < 15, 5,  59 >; radius 3; densityRatio 0.6; settlingSteps 5000;  startInactive true; }  // -> left arch
   FloatingSphere { position < 15, 17, 59 >; radius 3; densityRatio 0.6; settlingSteps 7000;  startInactive true; }  // -> pier1
   FloatingSphere { position < 15, 30, 59 >; radius 3; densityRatio 0.6; settlingSteps 9000;  startInactive true; }  // -> central arch
   FloatingSphere { position < 15, 43, 59 >; radius 3; densityRatio 0.6; settlingSteps 11000; startInactive true; }  // -> pier2
   FloatingSphere { position < 15, 55, 59 >; radius 3; densityRatio 0.6; settlingSteps 13000; startInactive true; }  // -> right arch

   // Row 2 (X=22): offset to the gaps between row 1's targets
   FloatingSphere { position < 22, 11, 59 >; radius 3; densityRatio 0.6; settlingSteps 6000;  startInactive true; }  // -> left arch/pier1 boundary
   FloatingSphere { position < 22, 24, 59 >; radius 3; densityRatio 0.6; settlingSteps 8000;  startInactive true; }  // -> central arch (left side)
   FloatingSphere { position < 22, 36, 59 >; radius 3; densityRatio 0.6; settlingSteps 10000; startInactive true; }  // -> central arch (right side)
   FloatingSphere { position < 22, 49, 59 >; radius 3; densityRatio 0.6; settlingSteps 15000; startInactive true; }  // -> pier2/right arch boundary
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   // Explicit even though both already default to true (SimulationParams.h) -- an earlier bridge
   // run (mixed_75k) sank every floater to the domain floor regardless of density with
   // useBognerThreePhaseMEM=false (the pre-fix default), so this scenario keeps them explicit per
   // the lesson in test_bridge_v1_sphere_drip_lowwater_gas.prm's own header.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // Per-subcycle position/velocity/force/torque/hydroForce/density CSV log for every floater --
   // only 9 floaters here so unfiltered logging for the full run is cheap. See this file's own
   // header for why (verifying ComputeTunnelContacts's post-fix behaviour for a sphere under a
   // genuine, less-obstructed arch interaction).
   logFloaterHistory              true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // Left arch (wall-to-pier1 span, Y=0..10, width 10 -> radius 5): same construction as
   // the central arch, sized to its own span so the opening is a true semicircular
   // half-pipe (full width at the springing line Z=56, point at the crown Z=61).
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 0, 56 >; max < 67, 10, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 5, 56 >; max < 67, 5, 56 >; radius 5; }
      }
      NoSlip{}
   }

   // Central arch (pier1-to-pier2 span, Y=20..40, width 20 -> radius 10): full width at
   // Z=56, crown at Z=66.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 20, 56 >; max < 67, 40, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 30, 56 >; max < 67, 30, 56 >; radius 10; }
      }
      NoSlip{}
   }

   // Right arch (pier2-to-wall span, Y=50..60, width 10 -> radius 5): mirrors the left arch.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 50, 56 >; max < 67, 60, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 55, 56 >; max < 67, 55, 56 >; radius 5; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
