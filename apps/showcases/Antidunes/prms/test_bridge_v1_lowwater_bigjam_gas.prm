   FloatingBox { position < 15, 17, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  10000; startInactive true; }
   FloatingBox { position < 15, 17, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  13000; startInactive true; }
