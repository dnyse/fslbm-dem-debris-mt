   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  26000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  29000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  32000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  35000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  38000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  41000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  44000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  47000; startInactive true; }
   FloatingBox { position < 15, 5, 70 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  50000; startInactive true; }
