// Sphere variant of dem_validation_rotating_drum.prm -- same Kodam et al. (2010) Fig. 11 / Section 3.4
// protocol and real-SI-unit parameters, but shape=sphere instead of cylinder. Spheres are orientation-
// invariant (no random-orientation spawn noise) and use the simplest, most thoroughly-tested contact
// pair in this engine, so this run is both a between-shapes comparison point and a control against the
// cylinder run's settle-phase energy-monotonicity instability (see that investigation's notes in
// DEMValidationScenarios.h): does releasing 250 bodies into the drum all at once still show large
// checkpoint-to-checkpoint energy spikes when contact geometry is as simple as it gets?
//
// See dem_validation_rotating_drum.prm for the full value-by-value Kodam citation list -- everything
// here is identical except `shape` and `outputBaseName`.
DEMValidation{
    testCase rotatingDrum;

    shape sphere;

    numParticles 250;
    sphereRadius 0.0039916;
    boxHalfExtents < 0.0032172, 0.0032172, 0.0032172 >;
    cylinderRadius 0.004;
    cylinderLength 0.0053;
    density 1163.66;

    restitutionCoefficient 0.85;
    frictionCoefficient 0.5;
    poissonsRatio 0.35;
    collisionTime 1.0e-4;
    gravity 9.81;

    drumRadius 0.050;
    drumHalfLength 0.028;
    numWallSegments 32;
    rpm 25.0;

    settleSteps 400000;
    tumbleRevolutions 3;
    numSnapshots 10;
    numRadialBins 24;

    vtkSpacing 2000;
    outputBaseName rotating_drum_sphere;
}
