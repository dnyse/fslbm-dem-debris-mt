// test_bridge_v1_raisedwater_logjam_floaterlog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// RAISED-WATER VARIANT of test_bridge_v1_lowwater_logjam_floaterlog_gas.prm: same 9 staggered
// log releases, same piers/arches, same restitution=0.5/timesteps=30000, but with the water
// level raised so the logs actually reach the real (upper-semicircle) arch structure, instead
// of passing underneath it entirely.
//
// WHY: the lowwater variant's own confirmed result (job 4134882, after both the effR-vs-exact-
// corner fix and the springing-line semicircle fix to ComputeTunnelContacts) was that NO
// floater ever reached above Z=55 (their own spawn height) across the whole 30000-step run --
// meaning in that scenario the logs float entirely below the springing line (Z=56) and never
// touch the arch at all, by design (0 tunnel-contact rows logged). That confirmed the fix
// removed the spurious phantom-wall contacts below the springing line, but it can't by itself
// confirm the fix is CORRECT for a genuine, above-the-springing-line interaction, since none
// ever occurred. This variant raises the water level specifically to force that interaction so
// the (now-corrected) upper-semicircle containment logic actually gets exercised and can be
// checked against real contact data.
//
// WATER LEVEL: liquidHeightFactor 2.0 -> 3.2. Using this project's own formula
// (absoluteLiquidHeight = avgParticleDiameter*liquidHeightFactor + avgParticleDiameter*
// floorHeightFactor, avgParticleDiameter=8.00194, floorHeightFactor=4.1393 -- all unchanged
// from every other bridge variant): factor 3.2 -> absoluteLiquidHeight ~58.73. For reference,
// the bridge's own un-modified "base" scenario (test_bridge_v1_gas.prm, factor 2.862) sits at
// ~56.02 -- almost exactly the springing line itself. This variant's ~58.73 puts the surface
// ~2.7 LU above the springing line: solidly inside the left/right arches' own solid zone
// (springing line 56 -> crown 61) and well inside the central arch's larger zone (56 -> 66),
// without overtopping the deck (top at 76, still ~17 LU of freeboard). A log floating at this
// surface (density 0.6, ~1.8 LU draft, so its own top surface sits ~1.5-2 LU above the
// waterline) should have its upper corners genuinely poking into the arch's real solid
// material when it reaches the bridge -- exactly what's needed to exercise
// ComputeTunnelContacts's containment force for real, rather than the lowwater variant's
// confirmed-zero-contact case.
//
// SPAWN HEIGHT: raised from Z=55 to Z=60 (just ~1.3 LU above the new waterline ~58.73, same
// "small gentle drop-in rather than a violent splash" intent as the lowwater base's own
// Z=55-just-above-49.1 spacing). Everything else about the 9 logs (X/Y positions, settlingSteps,
// halfExtents, densityRatio) is unchanged.
//
// Everything else (domain, cellsPerBlock, piers, arches, PID target velocity, Re/Fr/We, model
// parameters, VTK) is verbatim from test_bridge_v1_lowwater_logjam_floaterlog_gas.prm -- see
// that file's own header, and test_bridge_v1_lowwater_gas.prm before it, for the full
// derivation of everything not changed here.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 3.2;  // raised-water variant -- see this file's own header; absoluteLiquidHeight~58.73
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// xMin/xMax DELIBERATELY set to the piers' own straight-box span (61..67, i.e. pier x_center +-
// x_half), NOT the deck's outer X-span (56..72, what this used to be) -- recesses each arch
// collar's flat leading/trailing face behind the piers' rounded end-caps, so the round nose
// visibly sticks out past the deck edge instead of the deck being flush with the nose tip. Mirrors
// the same recess applied to the real-scale bridge (pont_ferroviere_rue_goffontaine_realscale_gas.prm)
// after 3D-voxel review there; the LBM BodyBC arch boxes below use the same 61..67 span, so DEM and
// fluid geometry never diverge. Not mesa_pd bodies -- consumed directly by ParticleKernels.h's
// ComputeTunnelContacts (see its class comment for why: DoubleCast can't give CylindricalBoundary a
// second, inside-out interpretation, since the pillars above already claim the outside-solid one).
// ComputeTunnelContacts only engages the UPPER semicircle (Z >= center[2], i.e. Z >= the springing
// line here) -- see its own class comment for the confirmed 97%-of-contacts-were-spurious bug this
// fixed.
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; }  // right arch
}

// Log-jam debris: 2 upstream rows, staggered release (startInactive + settlingSteps). Same X/Y
// positions/settlingSteps/sizing as the lowwater variant -- see this file's own header for why
// the spawn Z is raised to 60 (just above the new, higher waterline).
FloatingBoxes
{
   // Row 1 (X=15): aimed at left arch / pier1 / central arch / pier2 / right arch
   FloatingBox { position < 15, 5,  60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 5000;  startInactive true; }  // -> left arch
   FloatingBox { position < 15, 17, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 7000;  startInactive true; }  // -> pier1
   FloatingBox { position < 15, 30, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 9000;  startInactive true; }  // -> central arch
   FloatingBox { position < 15, 43, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 11000; startInactive true; }  // -> pier2
   FloatingBox { position < 15, 55, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 13000; startInactive true; }  // -> right arch

   // Row 2 (X=22): offset to the gaps between row 1's targets
   FloatingBox { position < 22, 11, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 6000;  startInactive true; }  // -> left arch/pier1 boundary
   FloatingBox { position < 22, 24, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 8000;  startInactive true; }  // -> central arch (left side)
   FloatingBox { position < 22, 36, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 10000; startInactive true; }  // -> central arch (right side)
   FloatingBox { position < 22, 49, 60 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 15000; startInactive true; }  // -> pier2/right arch boundary
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   // Explicit even though both already default to true (SimulationParams.h) -- an earlier bridge
   // run (mixed_75k) sank every floater to the domain floor regardless of density with
   // useBognerThreePhaseMEM=false (the pre-fix default), so this scenario keeps them explicit per
   // the lesson in test_bridge_v1_sphere_drip_lowwater_gas.prm's own header.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // Per-subcycle position/velocity/force/torque/hydroForce/density CSV log for every floater
   // (rank_<N>.csv contact/lubrication pairs, rank_<N>_state.csv world-state) -- only 9 floaters
   // here so unfiltered logging for the full run is cheap. See this file's own header for why
   // (verifying ComputeTunnelContacts's post-fix upper-semicircle behaviour against a genuine
   // arch interaction).
   logFloaterHistory              true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // Left arch (wall-to-pier1 span, Y=0..10, width 10 -> radius 5): same construction as
   // the central arch, sized to its own span so the opening is a true semicircular
   // half-pipe (full width at the springing line Z=56, point at the crown Z=61).
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 0, 56 >; max < 67, 10, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 5, 56 >; max < 67, 5, 56 >; radius 5; }
      }
      NoSlip{}
   }

   // Central arch (pier1-to-pier2 span, Y=20..40, width 20 -> radius 10): full width at
   // Z=56, crown at Z=66.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 20, 56 >; max < 67, 40, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 30, 56 >; max < 67, 30, 56 >; radius 10; }
      }
      NoSlip{}
   }

   // Right arch (pier2-to-wall span, Y=50..60, width 10 -> radius 5): mirrors the left arch.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 50, 56 >; max < 67, 60, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 55, 56 >; max < 67, 55, 56 >; radius 5; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
