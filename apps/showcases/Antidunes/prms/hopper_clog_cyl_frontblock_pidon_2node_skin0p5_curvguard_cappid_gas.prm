// HOPPER GAP, 406 RODS AT THE PILLARS, CAPPED PID.
// Channel 768 x 40 x 180, periodic in x (<64, 20, 30> blocks = 144 ranks / 2 nodes), water level z = 49.13, PID-driven
// flow (target mean velocity 0.04). Two cylindrical pillars R 12 centred on the y walls at x = 384 leave a 16 LU gap.
// Floaters: 406 rods R 3, L 18, axis y: a rod is longer than the gap and has to rotate towards the flow to pass it.
// 2 across x 7 layers x 29 rows, pitch x/y/z 8/20/7.52, centres x 144..368 (front row 1.04 LU from the pillar surface);
// densityRatio 1.2 (bottom two layers), 1.0 (middle three), 0.5 (top two; the top layer's axis sits at the waterline).
// All rods are held fixed for 2000 steps (settlingSteps) and then released together.
// Contacts: analytical Cylinder x Cylinder (Kodam + Guo hybrid, GJK/EPA fallback), friction/restitution 0.5 / 0.5.
// cylinderContactSkin 0.5: rod-rod contact starts at a surface gap of 2*skin = 1, rod-wall/pillar at 0.5. The x/z pitch
// 8/7.52 leaves rod-rod gaps of 2/1.52 > 2*skin (x pitch 7 would give exactly 1.0, which [RELEASE-OVERLAP] rejects).
// guardCurvatureInputs true: the FD curvature skips uninitialised/non-finite neighbour normals.
// PID cap maxActuatingVariable 2.65e-6 = 5.0 a_ref of the clean hopper (a_ref = 5.31e-7): a tight jam can then hold
// back at most (k - 1) a_ref L_x / g ~ 28 LU of head, about the freeboard 0.5 h0 = 24.6.
// Probes at x = 336 (inside the rod block, not usable as a clog signal) and x = 432, z = 40; discharge and wet area.
// 100000 steps; fluid (whole channel) and floater VTK at 14 snapshot steps up to 99000.

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // cap = 5.0 a_ref of the clean hopper, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- derived from U, Re and Fr (useHardcodedUnits false)
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // axes on the y walls: half of each pillar lies outside the domain (harmless); z is a reference point on the axis
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   FloatingCylinder { position < 368.00, 10.00, 4.00 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 2000; }
   FloatingCylinder { position < 368.00, 10.00, 11.52 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 2000; }
   FloatingCylinder { position < 368.00, 10.00, 19.04 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1; settlingSteps 2000; }
