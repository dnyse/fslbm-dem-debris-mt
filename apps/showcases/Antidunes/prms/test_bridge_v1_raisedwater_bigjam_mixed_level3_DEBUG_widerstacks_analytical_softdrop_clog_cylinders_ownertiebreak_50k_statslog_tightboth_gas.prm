// No FloatingBoxes block at all (converted to FloatingCylinders above) -- parsing
// (SimulationParams.h parseFloatingBoxes, cfg->getBlocks(..., 0, 1)) treats a missing block as zero
// boxes, same as an empty block would.

ModelParameters
{
   useAnalyticalContactDetection true;  // Cylinder x Cylinder -> Kodam+Guo hybrid analytic+GJK-fallback
                                        // (see usePureAnalyticalCylinder below); Cylinder x
                                        // CylindricalBoundary (piers/arches) is analytic regardless
                                        // (this showcase's own SolidCylinderContactDetection override).
   usePureAnalyticalCylinder     false; // (DEFAULT) explicit for clarity -- keep the hybrid GJK/EPA
                                        // safety net for cylinder-cylinder pairs the analytical
                                        // Kodam+Guo dispatch flags as uncertain, rather than trusting
                                        // the closed-form result alone. See this file's own header.
   useTightLayer1                true;  // ADDED (absent, i.e. false, in the base/statslog file) -- the
                                        // ONLY difference from that file: the cheap "definitely too far
                                        // apart to touch" pre-filter (Cylinder x Cylinder AND, newly,
                                        // Box x Box) uses each shape's own tight, orientation-aware
                                        // bound (capsule/segment-distance for cylinders, single-axis
                                        // projection for boxes) instead of a circumscribing-sphere-sum
                                        // reject. See PaperAnalyticalContacts.h's
                                        // closestDistanceSqBetweenSegments / boxesDefinitelySeparatedAlongCenterLine.
   useTightTier1                 true;  // ADDED (absent, i.e. false, in the base/statslog file) -- STACKED
                                        // with useTightLayer1 above (unlike the two isolated comparison
                                        // runs, which each left the other at its default false): once
                                        // useTightLayer1 has already cut the pairs reaching the dispatch
                                        // down to a small remainder, useTightTier1 additionally lets most
                                        // of THAT remainder's dispatch-gap cases resolve cheaply too,
                                        // instead of every one of them needing a real GJK/EPA call. See
                                        // cylinderCylinderResultIsUncertain's own useTightTier1 comment.
   useArchTunnelAsMesaPDObject   true;  // arches as real mesa_pd CylindricalBoundary containment
                                        // bodies -- Sphere/Box x CylindricalBoundary is analytic
                                        // regardless (this showcase's own SolidCylinderContactDetection
                                        // override), same as the base file.
   useContactFilterOwnerTiebreak true;  // ADDED (absent, i.e. false, in the base file) -- relevant here
                                        // because the hybrid cylinder-cylinder path above can still
                                        // fall through to GJK for uncertain pairs; same rationale as
                                        // test_bridge_v1_toy_trunk_first_staggered_gas.prm's own use.
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   logFloaterHistory              false;
   useHydrodynamicForceTimeAveraging true; // default (rolling 0.5*(F(t)+F(t-dt)) average, Ladd 1994 /
                                            // Watanabe et al. 2023 Eq.48-49) -- flip to false to A/B-test
                                            // whether this damping is load-bearing for the STALE-PARTICLE-IDX
                                            // crash family, or masking a different problem.
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
   // NEW (SimulationParams.h/ParticleKernels.h, added this session): print+reset the
   // [ContactDetectionStats] cylinder-cylinder sub-case/GJK-fallback tallies every
   // performanceLogFrequency steps instead of only once at the very end -- see this file's own
   // header. Each printed line covers only the 5000 steps since the previous one.
   logContactDetectionStatsPeriodically true;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // Left arch (wall-to-pier1 span, Y=0..10, width 10 -> radius 5): same construction as
   // the central arch, sized to its own span so the opening is a true semicircular
   // half-pipe (full width at the springing line Z=56, point at the crown Z=61).
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 0, 56 >; max < 67, 10, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 5, 56 >; max < 67, 5, 56 >; radius 5; }
      }
      NoSlip{}
   }

   // Central arch (pier1-to-pier2 span, Y=20..40, width 20 -> radius 10): full width at
   // Z=56, crown at Z=66.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 20, 56 >; max < 67, 40, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 30, 56 >; max < 67, 30, 56 >; radius 10; }
      }
      NoSlip{}
   }

   // Right arch (pier2-to-wall span, Y=50..60, width 10 -> radius 5): mirrors the left arch.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 50, 56 >; max < 67, 60, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 55, 56 >; max < 67, 55, 56 >; radius 5; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      // Z bound tightened from 150 to 90 to match this file's own reduced domainSize.z (was
      // harmlessly stale/oversized before, just clipped at the actual domain boundary).
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 90 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 90 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 90 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
