// DropTest_kodam_packing_gas.prm  (auto-generated by gen_kodam_packing_prm.py)
// ─────────────────────────────────────────────────────────────────────────────
// Local recreation of Kodam et al. (2010) Part II Sec. 3.3 "Static packing in a cylinder":
// 250 cylinders (R=4, L=5.3 LU=mm, L/D=0.6625, matching Kodam's real 8.0/5.3mm exactly),
// dropped in waves of up to 9 (one per reused spawn column) into a square, area-matched stand-in
// for Kodam's real 50.6mm-diameter circular container. friction/restitution taken directly from Kodam's
// Table 1 (0.5/0.85). Gravity and wave timing REUSE THE EXACT PROVEN-STABLE VALUES from the existing
// DropTest_cylinders_250_gas.prm -- see this script's own module docstring for why a faster "demo
// speed" gravity was tried and found to cause the particle count to collapse (contact-model
// instability at the resulting impact velocity), and why strict one-at-a-time release was dropped
// in favour of the already-validated batched-wave schedule. 1 LU = 1 mm.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 15, 15, 160 >;  // 3x3x1 = 9 processes
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <45, 45, 160>;
   wavePeriods        1;      // unused -- required by parser
   liquidHeightFactor 2.5;    // unused -- required by parser
   floorHeightFactor  4.1393; // unused -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50500;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   2.1371500584054327e-05;  // EXACT value from the proven DropTest_cylinders_250_gas.prm
                                              // ("true g_SI=9.81"); confirmed empirically stable this session.
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read -- overrides below bypass it
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                1.0;
   fixingHeightFactor          1.5;
   frictionCoefficient         0.5;  // Kodam Table 1
   restitutionCoefficient      0.85; // Kodam Table 1
   numSubCycles                20;
   useLubricationCorrection    false;
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8.001943372119138;   // EXACT value from the proven file (gives 1 LU ~ 1mm to 0.02%)
   dxSIOverride                0.000362694127490625; // EXACT value from the proven file
}

