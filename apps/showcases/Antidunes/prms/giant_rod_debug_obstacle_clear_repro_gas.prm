// giant_rod_debug_obstacle_clear_repro_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] MINIMAL, DETERMINISTIC REPRODUCTION of the small-rod job's (4268750) later
// crash, per explicit request ("extract these situations and replicate it in a smaller simulation").
// Adapted from the already-validated `giant_rod_clog_gas.prm` (single rod, jams against the pillar
// early and stays put -- run successfully many times this session) rather than a brand-new minimal
// local scenario: a from-scratch local single-rod scenario (single_rod_tumble_gas.prm's own domain)
// currently fails during initial setup for reasons confirmed UNRELATED to this investigation (a
// pre-existing `field::isFlag(domain_)` assertion in `BoundaryHandling.h:1203`, reproduced with the
// UNMODIFIED single_rod_tumble_gas.prm too) -- flagged separately, not chased here.
//
// This keeps everything from giant_rod_clog_gas.prm identical (same domain/pillars/rod/PID) except:
// shortened to 6000 timesteps (the rod jams against the pillar within ~1000-2000 steps and stays
// there, per this session's own prior runs -- no need for the full 50000), denser VTK
// (writeFrequency 100, safe at this short duration/single rod), and the variable under test:
// `debugForceObstacleClearAtStep 3000` (ModelParameters, ParticleKernels.h's own
// [DEBUG-FORCE-OBSTACLE-CLEAR] hook) -- well after the rod has settled into its jammed, stable
// position, deliberately applies the exact clear-and-reset sequence the reverted STALE-PARTICLE-IDX
// guard used (remove obstacle flag, reset PDFs to quiescent equilibrium, fill=1, particleField_ to
// invalid) to this rod's own CURRENT, perfectly-valid obstacle cells. If
// DEGENERATE-FILL-RECONSTRUCTION/LOW-RHO/a reynoldsNumber-nan abort appears shortly after step 3000,
// that confirms the mechanism is the abrupt clear itself, independent of the rare cross-rank desync
// that originally triggered it.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             0;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         6000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   FloatingCylinder { position < 364, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;

   // The variable under test -- see SimulationParams.h's own doc comment for the full derivation.
   debugForceObstacleClearAtStep 3000;

   // [Claude, 2026-09-27] Per explicit request, after the first repro run's floater-history window
   // (set on the earlier resume jobs, not this one -- this run originally had NO floater-history at
   // all) turned out too narrow on a DIFFERENT job to catch its own crash: this time, log from well
   // before the step-3000 trigger (to capture genuinely normal pre-trigger state) through well past
   // the observed post-trigger cascade (first run's crash landed ~step 3100-3200; this window keeps
   // a full 1000-step margin past that in case timing shifts slightly).
   logFloaterHistory             true;
   floaterHistoryBaseFolder      floater-history;
   logFloaterHistoryStartStep    2500;
   logFloaterHistoryEndStep      4500;
}

EvaluationParameters
{
   performanceLogFrequency 1000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars (X 250..500, Z 0..100); the rod is unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       100;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
