// sphere_density_showcase_bogner_domain_matched_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// BUOYANCY SHOWCASE (sphere), BOGNER THREE-PHASE MEM variant, GRAVITY + DOMAIN
// MATCHED TO BOGNER'S OWN VALIDATION (thesis §5.3.3 "Equilibration of floating
// cubes", reproducing Bogner & Rude 2013's density test). Same buoyancy model
// as sphere_density_showcase_bogner_gas.prm (useBognerThreePhaseMEM +
// useMemOnlyBuoyancy, both true), but this run additionally overrides gravity
// and reshapes the domain to match the exact numbers Bogner validated the
// method against, instead of Antidunes' own Fr-derived antidune-flow scaling:
//
//   Bogner §5.3.3: "domain of 130x40x40 cells ... lattice viscosity
//   tau=1/1.9=0.526 ... g=7.5e-4"
//
//   gravityOverride        7.5e-4;   // NEW override, was 7.02618e-06 (~107x smaller)
//   relaxationRateOverride 1.9;      // was 1.99743 -> viscosity 0.00877 (~41x larger)
//
// WHY THIS MATTERS: the previous bogner-mode run (job 3905990) converged to a
// STABLE but systematically ~8-12% under-submerged equilibrium at all three
// densities. Gravity there was ~100x weaker (in lattice units) than what
// Bogner himself validated the exact same three-phase MEM force formula
// against, with ~40x less viscous damping too. A fixed absolute force residual
// in the fill-weighted MEM computation (contact-ring sampling, discretization,
// etc.) that is negligible against Bogner's g=7.5e-4 restoring force becomes a
// much larger *relative* error against a ~100x weaker restoring force. This
// run isolates that variable: same buoyancy model, same geometry topology
// (three same-size spheres side by side, densityRatio 0.25/0.5/0.75), but
// gravity and viscosity now match the regime the method was actually
// validated in.
//
// DOMAIN CAVEAT: domainSize[0]/domainSize[1] is NOT a free choice here --
// Utility.h::getAvgDiameterScalingFactor hard-asserts that this ratio matches
// spheres_out.dat's fixed generation ratio (0.32/0.15 SI = 2.13333), computed
// from BedGeneration.prm's domainSize_SI, regardless of the fact that the bed
// itself is unused here (useParticleBed false, three explicit FloatingSpheres
// instead). Bogner's 130x40 (ratio 3.25) is INCOMPATIBLE with that fixed
// ratio and would abort at startup with "Generated bed with copies and
// simulation domain do not match!". The closest compatible (X,Y) below
// Bogner's own footprint is <96, 45> (same 2.13333 ratio, keeps
// avgParticleDiameter meaningful) -- Z is unconstrained by that check and is
// set to exactly Bogner's 40. Resulting cross-section area (96*45=4320) is
// ~83% of Bogner's own (130*40=5200), the closest achievable without
// regenerating a new bed file for a custom ratio.
//
// Sphere radius reduced 12 -> 8 (diameter 16) to match Bogner's own cube side
// length s=16 exactly, and to fit comfortably in the smaller, ratio-locked
// domain footprint.
//
// Layout (domain centreline y=22.5; absoluteLiquidHeight ~20.0, half of Z=40,
// matching Bogner's "lower half filled with liquid"):
//   • densityRatio 0.25: position (16, 22.5, 20)
//   • densityRatio 0.50: position (48, 22.5, 20)
//   • densityRatio 0.75: position (80, 22.5, 20)
//   32 LU apart, radius 8 -> 16 LU clearance between neighbours; 8 LU
//   clearance to the X walls and ~14.5 LU to the N/S (Y) walls.
//
// Domain: <96, 45, 40> / cellsPerBlock <16, 15, 10> = 6x3x4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 10 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 45, 40>;
   wavePeriods        1;
   liquidHeightFactor 3.3227;   // -> liquidHeight ~19.941 with avgParticleDiameter ~6.0015 (see header)
   floorHeightFactor  0.01;     // -> floorHeight ~0.060 (kept nonzero only to satisfy the != 0 assertion)
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              30000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants valid while U = 0
   relaxationRateOverride 1.9;         // NEW: matches Bogner's tau=1/1.9=0.526 (was 1.99743)
   gravityOverride        7.5e-4;      // NEW: matches Bogner's g (was 7.02618e-06)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      position     < 16, 22.5, 20 >;
      radius       8;
      densityRatio 0.25;
      settlingSteps 0;
      pinPosition  true;
      pinAxes      < 1, 1, 0 >;
      pinRotation  true;
   }
   FloatingSphere
   {
      position     < 48, 22.5, 20 >;
      radius       8;
      densityRatio 0.5;
      settlingSteps 0;
      pinPosition  true;
      pinAxes      < 1, 1, 0 >;
      pinRotation  true;
   }
   FloatingSphere
   {
      position     < 80, 22.5, 20 >;
      radius       8;
      densityRatio 0.75;
      settlingSteps 0;
      pinPosition  true;
      pinAxes      < 1, 1, 0 >;
      pinRotation  true;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // no rhoHydStat subtraction at all (see sphere_density_showcase_bogner_gas.prm)
   useMemOnlyBuoyancy             true;   // no separate vSub*g channel (see sphere_density_showcase_bogner_gas.prm)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for each sphere
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 22, 0 >;  max < 96, 23, 40 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 45, 40 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 96, 45, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
