   FloatingBox { position < 15, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 104000; startInactive true; }
   FloatingBox { position < 15, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 113000; startInactive true; }
   FloatingBox { position < 15, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 122000; startInactive true; }
   FloatingBox { position < 15, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 131000; startInactive true; }

   // (40,55) -> right arch: 15 spawn-separated logs, 9000-step waves
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps   5000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  14000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  23000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  32000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  41000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  50000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  59000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  68000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  77000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  86000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps  95000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 104000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 113000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 122000; startInactive true; }
   FloatingBox { position < 40, 55, 87 >; halfExtents < 6, 1, 1.5 >; densityRatio 0.6; settlingSteps 131000; startInactive true; }

}

// FloatingCylinders intentionally removed (see this file's own header) -- this is the ONLY
// structural change from the base widerstacks file. No FloatingCylinders block at all: parsing
// (SimulationParams.h parseFloatingCylinders, cfg->getBlocks(..., 0, 1)) treats a missing block as
// zero cylinders, same as an empty block would.

ModelParameters
{
   useAnalyticalContactDetection true;  // Box x Box -> boxBoxSAT (analytic) UNLESS useSpheroBoxContact
                                        // below overrides Box x Box specifically -- see file header.
   useMultiPointBoxContact       false; // TURNED OFF this rerun -- superseded by useSpheroBoxContact
                                        // below, see file header. Was true in the multipoint/overlapcap
                                        // ancestor runs (jobs 4201656/4202194).
   useBoxOverlapCap              false; // TURNED OFF this rerun -- same reason as useMultiPointBoxContact
                                        // above. Was true (0.3 fraction) in job 4202194.
   useSpheroBoxContact           true;  // ADDED this rerun -- see file header. Box x Box treated as a
                                        // genuine rounded box (spherosimplex): mesa_pd's own
                                        // GJK::doGJKmargin/EPA::doEPAmargin run directly on the two
                                        // sharp boxes with margin=spheroBoxRadius. Validated locally as
                                        // the best-performing Box x Box mitigation this session (9/9 PASS
                                        // at both e=1.00 and e=0.30 on the multiPointEdgeCases battery,
                                        // best/tied-best on the real job-4199585 incident replay).
   spheroBoxRadius               0.05;  // DEFAULT value, explicit here for clarity.
   useSpheroBoxAnalytical        false; // OFF this rerun -- GJK/EPA path specifically, NOT the Eberly
                                        // closed-form alternative (that gets its own separate rerun).
   useTightLayer1                true;  // ADDED (absent, i.e. false, in the base file) -- Box x Box
                                        // single-axis Layer 1 pre-filter ahead of boxBoxSAT, this
                                        // session. See SimulationParams.h's useTightLayer1 doc comment.
                                        // NOTE: only applies to boxBoxSAT; irrelevant here since
                                        // useSpheroBoxContact routes Box x Box to GJK/EPA instead, but
                                        // left true/unchanged from the ancestor run for minimal diff.
   useContactFilterOwnerTiebreak true;  // ADDED (absent, i.e. false, in the base file) -- matches the
                                        // cylinder sibling's own use of this flag.
   useArchTunnelAsMesaPDObject   true;  // MOOT this rerun -- the ArchTunnels block below is removed
                                        // entirely (see file header), so simParams->archTunnels is
                                        // empty and this flag gates a loop over zero entries either
                                        // way. Left at the base file's own value rather than flipped,
                                        // to make clear it's not what's disabling arch DEM contact.
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // TURNED OFF this rerun. First attempt (job 4211765) widened this to the full run [0,250000] on the
   // theory that a flying-floater recurrence's step wasn't predictable -- but per-step per-uid CSV
   // logging over the whole run generated 136GB in just 49000 steps and blew the disk quota
   // ("Disk quota exceeded" on vtk-out/particles/simulation_step_49000, not a physics failure at all).
   // Logging is OFF entirely for this rerun; re-enable with a bounded window only if a real failure
   // recurs and its approximate step is known.
   logFloaterHistory              false;
   logFloaterHistoryStartStep     0;
   logFloaterHistoryEndStep       10000;
   logContactAnomalies            false;
   contactAnomalyStartStep        50000;
   contactAnomalyEndStep          60000;
   useHydrodynamicForceTimeAveraging true; // default (rolling 0.5*(F(t)+F(t-dt)) average, Ladd 1994 /
                                            // Watanabe et al. 2023 Eq.48-49) -- flip to false to A/B-test
                                            // whether this damping is load-bearing for the STALE-PARTICLE-IDX
                                            // crash family, or masking a different problem.
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
   // ADDED for this run: print+reset [ContactDetectionStats] (including the NEW
   // boxTightLayer1CheaplyProvedSeparated counter) every performanceLogFrequency (5000) steps instead
   // of only once at the end -- see EvaluationParams::logContactDetectionStatsPeriodically.
   logContactDetectionStatsPeriodically true;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // NO arch BodyBC blocks here (left/central/right all deliberately removed -- see this
   // file's own header). The deck/arch volume between and around the piers, above the deck
   // base, has no NoSlip boundary in this variant -- open flow, open passage for floaters.
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      // Z bound tightened from 150 to 90 to match this file's own reduced domainSize.z (was
      // harmlessly stale/oversized before, just clipped at the actual domain boundary).
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 90 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 90 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 90 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
