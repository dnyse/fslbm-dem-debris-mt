// small_rods_48x_2x8x3_clog_skin0p5_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-10-01] DOUBLED-IN-X SKIN TEST: `small_rods_24x_2x4x3_clog_skin0p5_gas.prm`
// (job 4282267: cylinderContactSkin 0.5, sealed-cell guard OFF, row pitch widened 7->8 LU to
// clear the skin's own 1.0 LU rod-rod threshold) completed CLEAN -- full 51000 steps, exit 0, all
// 24 rods still reporting at the final step, zero STALE-PARTICLE-IDX/GHOST-VANISHED/
// MEM-GARBAGE-LINK/RELEASE-OVERLAP/NaN markers anywhere in the log. Per explicit follow-up
// ("double the number of floaters in x"), this doubles the population the same way the
// fixes-OFF baseline series did it (`small_rods_48x_2x8x3_clog_gas.prm`, below): 8 rows in X
// instead of 4 -- 2(Y) x 8(X) x 3(Z) = 48 rods -- same geometry/densities/contact-mode as 4282267,
// extended upstream at the SAME WIDENED 8 LU pitch (not the original series' 7 LU): 364 (front,
// unchanged) / 356 / 348 / 340 / 332 / 324 / 316 / 308.
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] FORTY-EIGHT ORIGINAL-SIZE RODS, 2(Y) x 8(X) x 3(Z), per explicit request
// ("keep doubling them in x until into our old issues again") -- second doubling step in this
// series, applied to `small_rods_24x_2x4x3_clog_gas.prm` (job 4268494, in progress at the time this
// was written: ~8/24 stuck in floor-piles from the deep-release layer, ~15/24 escaped downstream,
// same ~1/3-stuck ratio as the 12-rod scenario, now confirmed at double the population). Same rod
// geometry (radius 3, length 18, 1:3 ratio, axis Y), same 2 Y-columns (Y=10, Y=30) and same 3
// Z-layer densities (1.2/1.0/0.5, heavy-low/light-high) as every scenario in this series, but 8
// rows in X instead of 4 -- 2(Y) x 8(X) x 3(Z) = 48 rods.
//
// X rows continue the SAME 7 LU pitch used throughout this series (364, 357, 350, 343 from the
// 24-rod scenario, extended upstream by four more rows at the same spacing): 364, 357, 350, 343,
// 336, 329, 322, 315. The purpose of this specific doubling step (per explicit request) is to keep
// packing more rods into the same channel/pillar geometry until the crowding reproduces one of this
// session's earlier-diagnosed crash mechanisms (MEM-GARBAGE-LINK / NAN-LINK / DRY-LINK / LOW-RHO /
// SEALED-CLOSE / STALE-PARTICLE-IDX) -- fixes intentionally left OFF throughout, so if/when a
// diagnostic fires, this is a genuine, undefended reproduction, not a near-miss. (NOTE: superseded
// by the 2026-10-01 skin variant above for this specific file -- this is the ORIGINAL, no-skin,
// 7 LU-pitch baseline's own header, kept for provenance; THESIS_PLAN.md has no recorded outcome
// for this exact file/pitch, so its own result -- crashed, clean, or never actually submitted --
// is unknown as of 2026-10-01 and not something this skin variant depends on either way.)
//
// All three of this session's 2026-09-25 crash-mitigation fixes (Option A/B, SimpleBB.h guard)
// remain DISABLED. VTK writeFrequency 10000, timesteps 51000 (same as every prior scenario in this
// series).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

