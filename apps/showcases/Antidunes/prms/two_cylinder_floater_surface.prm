BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two cylinder pillars — same geometry as two_cylinder_floater.prm.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // "On the surface" start: sphere centre at the free surface (absoluteLiquidHeight ≈ 56).
      // densityRatio=0.5 → equilibrium at half-submerged → centre at z=56.
      //
      // Problem without settlingSteps: the contact circle (radius=8 at z=56) exists from t=0.
      // In the first ~12 steps the FSLBM mass-transport at the contact line causes fill-level
      // drift → some contact-circle interface cells convert to gas → PDF reconstruction fails
      // → NaN cascade.
      //
      // Fix: settlingSteps=500 holds the sphere FIXED for 500 LBM steps so the FSLBM can
      // establish a stable fill-level / normal field around the stationary contact line before
      // the sphere is released to float freely.  During settling the sphere generates correct
      // hydrodynamic forces (SimpleBB still runs) but does not move (no velocity Verlet).
      position     < 15, 30, 56 >;
      radius       8;
      densityRatio 0.5;
      settlingSteps 500;
   }
}

ModelParameters
{
   // OnlyMissingMin-3-largest: Bogner (2017) §4.2.1 fix for underdetermined free-surface BC at
   // contact-line cells. At a contact-line interface cell where the sphere occupies many D3Q27
   // directions, fewer than 3 gas-facing links may remain → the FSK boundary condition is
   // underdetermined (too few equations for ρ, u_x, u_y, u_z). OnlyMissingMin guarantees at
   // least 3 reconstructed PDFs: when gas-facing links are insufficient it additionally
   // overwrites the fluid-side PDF with the largest |n·c_i| (most aligned to interface normal).
   // waLBerla implements this explicitly citing Bogner §4.2.1 in PdfReconstructionModel.h.
   pdfReconstructionModel        OnlyMissingMin-3-largest;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >; max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;  max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;  max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
