// cylinder_sedimentation_showcase_analytical_9cylinders_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// CYLINDER CONVERSION of box_sedimentation_showcase_analytical_gas.prm (v6): identical
// domain/physics/layout/densities/timing, only the 9 FloatingBoxes are replaced with
// FloatingCylinders of matching footprint. NOT the same file as the pre-existing
// cylinder_sedimentation_showcase_analytical_gas.prm (a much denser, unrelated 100-log
// 5x4x5 grid) -- this is a direct shape-swap of the SMALL, already-clean 9-box v6
// layout, done to see whether the same "single Y position per column, no Y-neighbour
// contacts, gravity-driven Z-stacking only" geometry that finally ran clean for boxes
// (after v1-v5's ContactHistoryNotification/NaN-quaternion crash history -- see the box
// file's own header for the full account) also runs clean for cylinders, and to
// exercise cylinderCylinderContact's analytical path (Kodam et al. 2010 + Guo et al.
// 2012, PaperAnalyticalContacts.h) on genuine Z-stacked end-on contacts. Unlike Box-Box
// (trusted directly, no fallback gate), Cylinder-Cylinder is a HYBRID:
// cylinderCylinderResultIsUncertain() gates every analytical result and falls back to
// GJK/EPA for cases its own taxonomy can misjudge -- see
// ModelParameters.useAnalyticalContactDetection (SimulationParams.h) and
// ParticleKernels.h's SolidCylinderContactDetection Cylinder x Cylinder overload.
//
// GEOMETRY CONVERSION: each box (halfExtents <3.5, 7, 3.5>, i.e. a 7x14x7 LU box with a
// 7x7 X/Z cross-section and 14 LU Y-length) becomes a cylinder with radius 3.5
// (matching the box's 7 LU X/Z cross-section as the cylinder's 7 LU diameter) and
// length 14 (matching the box's full 14 LU Y-extent), axis <0,1,0> (same Y-elongation
// as the box). This preserves the box version's exact Z-clearance math unchanged: 12 LU
// Z-spacing between stacked rows against a 7 LU vertical footprint (box's Z-edge /
// cylinder's diameter, identical either way) = 5 LU clearance per pair, same as the box
// file's own header states. Positions, densities, X-column spacing (32/64/96), single Y
// position (30, no Y-neighbour contacts), and Z-stack spacing (64/76/88) are all
// unchanged from the box file, only the shape type and its two size parameters differ.
//
// PARTICLE IMPACT AND SEDIMENTATION AT A FREE SURFACE -- CYLINDER variant of the v6
// box layout.
//
// Layout: X = 32/64/96 (3 columns, densities 0.5/1.0/2.0), Y = 30 (domain centre,
// single position, no Y-neighbours), Z = 64/76/88 (3 rows, spacing 12, 5 LU clearance
// against the 7 LU diameter). 9 cylinders total. Domain and process count unchanged:
// <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4x3x6 = 72 processes.
//
// Densities: each of the 3 X-columns is a single, uniform density (all 3 stacked rows
// in a column share it) -- 0.5 (light) at x=32, 1.0 (neutral) at x=64, 2.0 (heavy) at
// x=96, matching the same light/neutral/heavy convention as the box file. Cylinders are
// free to translate and rotate (no pinning, no initial tilt); they fall and settle into
// contact under gravity, isolated to one column per density.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   // ---- column x=32, densityRatio 0.5 (light) ----
   FloatingCylinder { position < 32, 30, 64 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 0; }
   FloatingCylinder { position < 32, 30, 76 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 0; }
   FloatingCylinder { position < 32, 30, 88 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 0; }

   // ---- column x=64, densityRatio 1.0 (neutral) ----
   FloatingCylinder { position < 64, 30, 64 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCylinder { position < 64, 30, 76 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 0; }
   FloatingCylinder { position < 64, 30, 88 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 0; }

   // ---- column x=96, densityRatio 2.0 (heavy) ----
   FloatingCylinder { position < 96, 30, 64 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 0; }
   FloatingCylinder { position < 96, 30, 76 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 0; }
   FloatingCylinder { position < 96, 30, 88 >; radius 3.5; length 14; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 0; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticalContactDetection true;  // see header note -- Cylinder x Cylinder hybrid path
   // Explicit (matches SimulationParams.h's own default as of the buoyancy-flag fix, stated here so
   // this file's behaviour doesn't silently change if that default is ever revisited): this scenario
   // mixes densityRatio 0.5/1.0/2.0 (light/neutral/heavy) columns specifically to see them separate by
   // buoyancy -- without this pairing the light column gets NO net buoyant support at all and sinks
   // like the heavy one, defeating the whole point of the test.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h)
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
