// sphere_impact_sedimentation_block_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// REPLICATION of Bogner (2017 dissertation), Fig 5.11 "Particle impact and
// sedimentation at a free surface": a densely packed 10x10x10 (1000-sphere)
// cubic block, three densities (ratio 0.5/1/2, well mixed not layered),
// released together above a walled tank of quiescent liquid. Unlike the other
// sphere_sedimentation_* showcases (spheres spread far apart, individually
// settling), this is a SINGLE coherent falling mass, testing the coupled
// impact/plunge/sinking dynamics of a dense granular cloud through a free
// surface, matching the published benchmark's geometry.
//
// TANK: fully walled (periodicity <0,0,0>), not periodic like the other
// showcases -- NoSlip auto-added on all 4 lateral faces by setupBoundaryHandling
// (SetupStages.h:665-675) purely from periodicity being off, plus the usual
// explicit T/B NoSlip Border blocks below.
//
// GEOMETRY (all LU): sphere radius 3 (diameter 6), spheres touching
// (spacing = diameter), 10x10x10 block = 60x60x60 LU cube, centred in X/Y
// (domain 150x141, block occupies x in [45,105] / y in [40.5,100.5] -- ~40-45
// LU clearance to each lateral wall). Z layout: water [0,120], 30 LU air gap,
// block [150,210], 30 LU clearance to the ceiling -- domainSize Z = 240.
//
// Y IS NOT A FREE PARAMETER: Utility.h:144 asserts domainSize[1] ==
// uint_c(scalingFactor * generationDomainSize_SI[1] * bedCopiesInY), the same
// scalingFactor X's dx_SI is derived from -- Y is hard-locked to X via the bed
// file's own SI aspect ratio (generationDomainSize_SI = <0.046424848318763846,
// 0.021870455887667655, ...>), it cannot be picked independently. Hit this the
// hard way (job 3999345 aborted at t=0.074s, WALBERLA_CHECK_EQUAL: computed 70
// vs the naively-chosen domainSize[1]=150). With domainSize[0]=150,
// bedCopiesInX=1, scalingFactor=3231.03; bedCopiesInY=2 forces
// domainSize[1]=141 (bedCopiesInY=1 -> 70, =3 -> 211) -- 141 chosen as the
// closest fit to a roughly-square tank cross-section.
//
// GRAVITY: real Earth gravity g_SI = 9.81 m/s^2, re-derived for THIS domain
// (domainSize[0]=150, same BedGeneration.prm/spheres_out.dat bed file as every
// other run this session -- generationDomainSize_SI[0]=0.046424848318763846,
// diameter_SI=0.0029015530199227404, bedCopiesInX=1). Depends only on
// domainSize[0]/bedCopiesInX, NOT on bedCopiesInY -- unaffected by the Y fix
// above:
//   dx_SI = generationDomainSize_SI[0]/domainSize[0] = 0.000309498988791759
//   dt_SI = (viscosity/viscosity_SI)*dx_SI^2 = 2.0468720127529563e-05
//     (viscosity=0.000214026 fixed by useHardcodedUnits, viscosity_SI=1.0016e-6)
//   gravityOverride = 9.81*dt_SI^2/dx_SI = 1.3279788205258077e-05
// avgParticleDiameter (bed-file scale anchor, unrelated to the FloatingSphere
// radius above) = domainSize[0]/16 = 9.375 LU -- confirmed via
// diameter_SI/dx_SI. liquidHeightFactor/floorHeightFactor chosen so
// absoluteLiquidHeight = avgParticleDiameter*(sum factors) = 120 exactly
// (sum=12.8; floorHeightFactor kept tiny-but-nonzero per
// WALBERLA_CHECK_FLOAT_UNEQUAL(floorHeight,0.0) in ComputedParams).
//
// Estimated free-fall time to impact (30 LU gap): ~2126 steps. First
// exploratory run (job 3999350, 20000 steps) reached this and settled
// cleanly; timesteps below is now raised to 100000 for a full run.
//
// DENSITY MIX (v2): 334/333/333 spheres at ratio 2/1/0.5, assigned via
// cycle[(i+j+k) % 3] over the 10x10x10 grid indices -- a diagonal-plane
// weave, REPLACING the v1 seeded-random shuffle. Chosen after closely
// re-examining the figure: the visible faces show a periodic diagonal
// banding (checkered red/gray near the top, transitioning through solid
// red into green-dominant with red fleck near the bottom), not uncorrelated
// speckle -- (i+j+k)%3 is the natural pattern that produces exactly that
// diagonal weave. Caveat: only 2 of 6 faces are visible in the source photo
// (occlusion + lighting), so this is the best-inferred structured match, not
// a verified per-sphere ground truth. Color<->density mapping (red=2,
// gray=1, green=0.5) IS confirmed directly from the other panels' captions.
//
// staticReferenceHeightOverride intentionally OMITTED (unlike the other
// sedimentation showcases, which override it with a value measured for THEIR
// domain/geometry): default disabled means H = absoluteLiquidHeight = 120,
// which is already the correct static reference for this domain -- reusing
// another run's override here would be silently wrong.
//
// FloatingSphere block count (1000) required raising the hardcoded parse cap
// in SimulationParams.h (parseFloatingSpheres: getBlocks("FloatingSphere", ...,
// 0, 100) -> 0, 10000) -- job 3999337 aborted immediately (every rank) with
// "You requested at least 0 and at most 100 Config::Blocks ... but there are
// 1000" before this fix.
//
// Domain: <150, 141, 240> / cellsPerBlock <50, 47, 30> = 3x3x8 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 50, 47, 30 >;
   periodicity                   < 0, 0, 0 >;   // fully walled tank -- matches the figure's glass box
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <150, 141, 240>;
   wavePeriods        1;
   liquidHeightFactor 12.7;
   floorHeightFactor  0.1;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // quiescent liquid — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   1.3279788205258077e-05;  // solved for g_SI = 9.81 m/s^2, see header derivation
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 2;  // forced -- see header's "Y IS NOT A FREE PARAMETER" note (Utility.h:144)
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      position     < 48, 43.5, 153 >;
      radius       3;
      densityRatio 2;
      settlingSteps 0;
   }
   FloatingSphere
   {
      position     < 48, 43.5, 159 >;
      radius       3;
      densityRatio 1;
      settlingSteps 0;
   }
