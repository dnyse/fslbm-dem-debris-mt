// static_h_sweep_h180_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// STATIC-H SENSITIVITY SWEEP -- EXTREME OVERSHOOT (H forced to the domain TOP, z=180).
// Identical to static_h_sweep_default_gas.prm / the validated sphere_stillwater_gas.prm
// (floating SPHERE, radius 12, densityRatio 0.5, starting already at 50% submersion in quiescent water (no drop)) except
// the MEM's STATIC reference height H (SimpleBB's rhoHydStat, normally absoluteLiquidHeight
// ~56.02) is forced all the way up to 180 via ModelParameters.staticReferenceHeightOverride
// -- H ~124 LU too HIGH, IDENTICAL to sphere_drop_static_h_top_gas.prm's own ablation (same
// ΔH=124, same ρ_hyd derivation: Δρ=3·|a_z|·ΔH≈2.6e-3, expected extra DOWNWARD force
// Δp·A_proj ≈0.27 at half submersion, ~13x the sphere's own weight). That file predicted
// the sphere gets "slammed under" the moment it touches the waterline, possibly
// hovering fully submerged or banging up/down across the surface rather than settling to a
// clean equilibrium submersion% -- this run reproduces that exact prediction as the far end
// of this sweep (h1 / h44 / h48 / default / h64 / h68 / h180 / dynamic), for direct
// side-by-side comparison against the milder h64/h68 overshoots.
//
//   • targetMeanVelocityMagnitude 0  → no driving flow (still water).
//   • useHardcodedUnits true → viscosity / relaxationRate / gravity / surfaceTension
//     keep their reference values instead of being derived from U (which is 0 here).
//     Without this, U=0 would zero viscosity, gravity and surface tension.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         25000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   // Single sphere (radius 12), centred, starts ALREADY at 50% submersion (centre z=56, right
   // at the undisturbed waterline absoluteLiquidHeight~56.02 -- no drop/fall phase). settlingSteps
   // 0: force calc (whatever H this variant uses) is live from t=0, so any deviation from 50%
   // submersion visible over the run is purely the H-mismatch effect, not settling dynamics.
   // pinPosition true; pinAxes <1,1,0>: X/Y translation held at the starting position every
   // DEM sub-cycle, Z left genuinely free -- the sphere can only move up/down, isolating the
   // vertical submersion-equilibrium response from any lateral drift.
   FloatingSphere { position < 64, 30, 56 >; radius 12; densityRatio 0.5; settlingSteps 0; pinPosition true; pinAxes <1,1,0>; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;

   // H forced to 180 (domain top, ~124 LU above the correct absoluteLiquidHeight ~56.02)
   // -- extreme overshoot ablation, identical to sphere_drop_static_h_top_gas.prm. See header.
   staticReferenceHeightOverride 180;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
