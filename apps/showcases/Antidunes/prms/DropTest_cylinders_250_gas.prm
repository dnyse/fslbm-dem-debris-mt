// DropTest_cylinders_250_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Cylinder version of DropTest_250_gas.prm (see its header for the set-up and the gravity calibration): every block
// is identical except FloatingBoxes -> FloatingCylinders, with the same 250 spawn positions and settlingSteps.
// Cylinders: radius 1, length 12, densityRatio 0.6, axis <1, 0, 0> (set explicitly; FloatingCylinderParams defaults
// to world Y), i.e. along the box's 12-long X dimension and inside its footprint, so the box spacing stays valid.
// Cylinder x Cylinder contacts: closed form (Kodam/Guo) with GJK/EPA fallback for results flagged uncertain.
//
// Lineage: the first 25 of the 100 waves per column of DropTest_cylinders_gas.prm (1000 cylinders).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 10, 30 >;  // 2 x 3 x 6 = 36 processes
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <32, 30, 180>;
   wavePeriods        1;      // unused (antidune sinusoidal-fill init, never called here) -- required by parser
   liquidHeightFactor 2.5;    // unused (no fluid) -- required by parser
   floorHeightFactor  4.1393; // unused (no fluid) -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   // Unused -- setupSimState() (which constructs the PIDController) is never called by DropTest.cpp.
   // Block is required only because SimulationParams' constructor unconditionally parses it.
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         46000; // last release 36000 + 10000-step settling tail
   Re                3100;    // no fluid; Re/Fr/We kept identical to the realgravity precedent so that
   Fr                1.31;    // dt_SI, and with it the gravityOverride calibration, is the same
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   2.1371500584054327e-05;  // true g = 9.81 m/s^2, see header
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read (the two overrides below bypass it)
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                2.55;  // unused (no bed particles created) -- required by parser
   fixingHeightFactor          1.5;   // unused -- required by parser
   frictionCoefficient         0.5;
   restitutionCoefficient      0.3;
   numSubCycles                20;
   useLubricationCorrection    false; // no fluid
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8.001943372119138;   // as in the realgravity precedent; collision time = factor * this
   dxSIOverride                0.000362694127490625; // as in the realgravity precedent (gravity calibration)
}

// No Pillars / CylinderPillars / ArchTunnels: the container is the 6 domain walls created in setupParticles
// (SetupStages_drop_test.h).

// 25 waves of 10: one floater per spawn column (X in {8, 24}, Y in {3, 9, 15, 21, 27}) at z = 170, near the ceiling,
// a new wave every 1500 steps (settlingSteps 0, 1500, ..., 36000; all but the first wave startInactive). In 1500
// steps a released floater falls 0.5 g t^2 = 24 LU, clear of the next release at the same point; 500 steps (2.7 LU,
// less than the 3 LU box height) triggered [RELEASE-OVERLAP] (ParticleKernels.h).
FloatingCylinders
{
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 0; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 1500; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 3000; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 4500; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 6000; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 7500; startInactive true; }
