ModelParameters
{
   useAnalyticalContactDetection true;  // Cylinder x Cylinder: closed form, GJK/EPA fallback
   useTightLayer1                true;
   useContactFilterOwnerTiebreak true;
   pdfReconstructionModel        OnlyMissing;              // unused (no fluid) -- required by parser
   pdfRefillingModel             EquilibriumRefilling;     // unused -- required by parser
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid; // unused -- required by parser
   curvatureModel                FiniteDifferenceMethod;   // unused -- required by parser
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;  // REQUIRED true: gates off the fluid-dependent submerged-volume code
                                        // (computeSubmergedVolumes); gravity is plain density-weighted mass*g
   logFloaterHistory              false; // FloaterHistoryLogger is not wired into DropTest.cpp
   logFloaterHistoryStartStep     0;
   logFloaterHistoryEndStep       10000;
   logContactAnomalies            false;
   contactAnomalyStartStep        0;
   contactAnomalyEndStep          10000;
   useHydrodynamicForceTimeAveraging true; // unused (no hydrodynamic force)
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
   logContactDetectionStatsPeriodically true;
}

VTK
{
   // No fluid field is written (no LBM fields), but VTKParams (SimulationParams.h) reads writeFrequency and
   // baseFolder from this "fluid_field" sub-block, and DropTest.cpp uses them for its floater VTK output
   // (floaterBox, floaterCylinder, floater, floaterCapsule): writeFrequency is the real floater output frequency.
   fluid_field
   {
      writeFrequency       200;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
