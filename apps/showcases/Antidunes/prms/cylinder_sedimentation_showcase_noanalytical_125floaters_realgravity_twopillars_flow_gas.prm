   FloatingCylinder { position < 100, 78, 127 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
   FloatingCylinder { position < 100, 78, 138 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
   FloatingCylinder { position < 100, 100, 94 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
   FloatingCylinder { position < 100, 100, 105 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
   FloatingCylinder { position < 100, 100, 116 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
   FloatingCylinder { position < 100, 100, 127 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
   FloatingCylinder { position < 100, 100, 138 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 20000; startInactive true; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticalContactDetection false; // OFF -- pure GJK/EPA for every Cylinder x Cylinder pair
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // X periodic (see BlockForestParameters); Y now walled for the pillars; Z floor/ceiling as before.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 138, 50, 0 >;  max < 138, 50, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 138, 110, 0 >; max < 138, 110, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;   max < 160, 160, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
