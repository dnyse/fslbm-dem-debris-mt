// cylinder_sedimentation_showcase_noanalytical_125floaters_realgravity_twopillars_flow_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// CYLINDER sibling of box_sedimentation_showcase_analytical_125floaters_realgravity_twopillars_flow_gas.prm
// (job 4112794, completed cleanly, full 120000 steps, no crash, floaters never exceeded Z=63 after
// release -- see that run's own comparison against the collapsed-plane density05 1000-floater
// experiments, which DO show floaters launched to Z=170+ via an oversized MEM/hydrodynamic
// "phantom lift" force at first water contact). This variant tests whether that phantom-lift
// mechanism is shape-agnostic (SimpleBB.h's force computation has zero shape-type branching --
// confirmed by direct code inspection) by swapping every FloatingBox (halfExtents <3,9,3>) for a
// FloatingCylinder of comparable scale (radius 3, length 18, axis <0,1,0>), and setting
// useAnalyticalContactDetection false (pure GJK/EPA for every Cylinder x Cylinder pair, matching
// the existing *_noanalytical_* convention). Everything else -- domain, pillars, density mix
// (0.5/0.75/1.0/1.5/2.0), release schedule (20000 dormant + 100000 post-release), timesteps
// 120000 -- is identical to the known-good box baseline, for a clean, controlled comparison.
//
// Two-pillars/flow conversion of box_sedimentation_showcase_analytical_125floaters_realgravity_gas.prm
// (job 4104656, completed cleanly, full 100000 steps, still water). Same 125-box (5x5x5) grid, same
// per-column densities (0.5/0.75/1.0/1.5/2.0), same real g_SI=9.81 gravity (gravityOverride unchanged),
// same avgParticleDiameterOverride/dxSIOverride scaling. On top of that:
//
//  - TWO CylinderPillars added, following this project's established "two pillars slitpass" pattern
//    (see ten_cuboids_two_pillars_slitpass_gas.prm / thousand_cuboids_two_pillars_slitpass_gas.prm):
//    radius 12, centered at X=138 (same X as every existing two-pillar scenario in this domain-width
//    family), Y=50 and Y=110 (splitting the 160-wide domain into a 36 LU centre slit + two 38 LU side
//    passages). periodicity switched from <1,1,0> to <1,0,0> -- Y needs real N/S walls for the pillars
//    to mean anything (X stays periodic so the PID-driven current can recirculate), matching every
//    other two-pillar scenario's own periodicity convention.
//
//  - Flow: targetMeanVelocityMagnitude raised from 0 (still water) to 0.01, matching every other
//    "two pillars slitpass" scenario's own halved-current convention in this codebase. Gains/ramp
//    limits unchanged (already tuned for 0.01 elsewhere).
//
//  - Floaters raised in Z: rows shifted from 64/75/86/97/108 to 94/105/116/127/138 (+30 LU) so they
//    start well above the still-water surface (absoluteLiquidHeight=56.024, unchanged) with more
//    freeboard for the now-active current to entrain them as they fall, rather than dropping straight
//    onto the surface before the flow field has any lateral effect. Top row (138+halfExtent 3=141)
//    keeps 39 LU clearance under the domain ceiling (Z=180).
//
//  - Floaters moved entirely to the LEFT of (upstream of) the pillars: X columns compressed from
//    16/48/80/112/144 (spacing 32, spanning the whole domain -- column 144 would have sat inside the
//    pillars' own footprint at X=126-150) to 12/34/56/78/100 (spacing 22), the rightmost column ending
//    at 100+halfExtent 3=103, a full 23 LU clear of the pillar footprint's near edge (X=126).
//
//  - Release schedule: all 125 floaters get startInactive true + settlingSteps 20000 (per explicit
//    request: "drop them after 20k time steps") -- dormant (excluded from fluid mapping and DEM contact
//    entirely, not just FIXED) until step 20000, giving the flow field 20000 steps to fully develop
//    before any floater enters the simulation. timesteps raised to 120000 (20000 dormant + 100000
//    post-release, matching the original still-water file's own 100000-step observation window).
//
// Domain/decomposition unchanged: <160, 160, 180> / cellsPerBlock <40, 40, 20> = 4x4x9 = 144 processes.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 40, 40, 20 >;
   periodicity                   < 1, 0, 0 >;   // X periodic (current recirculates); Y walled for the pillars; Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <160, 160, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;     // was 0 (still water) -- real streamwise current now
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         120000;             // 20000 dormant + 100000 post-release
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;               // unchanged from the still-water source file
   gravityOverride   2.1371500584054327e-05;  // true g_SI=9.81 m/s^2 -- unchanged, see source file header
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
   avgParticleDiameterOverride 8.001943372119138;  // unchanged, see source file header
   dxSIOverride                0.000362694127490625;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 138, 50, 90 >;
      radius 12;
   }
   CylinderPillar
   {
      center < 138, 110, 90 >;
      radius 12;
   }
}

