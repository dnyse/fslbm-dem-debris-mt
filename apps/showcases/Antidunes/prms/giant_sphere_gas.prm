// giant_sphere_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// One giant floating sphere (radius 20 LU, diameter = 40 LU ≈ 2/3 domain width)
// placed with its bottom at the free surface and released to sink to equilibrium.
//
// Physics:
//   • densityRatio=0.5 → equilibrium at half-submerged, centre at z≈56 LU.
//   • Starting at z=76 (bottom at z=56 = surface, 0% submerged) avoids the
//     contact-line NaN that occurred when starting 9 LU above the surface
//     (sphere entered surface at v≈0.013 LU/step → full contact ring formed
//     simultaneously → CurvatureSweep invalid normals → NaN at step ~2000).
//   • settlingSteps=500: contact line at z=56 establishes while sphere is fixed;
//     on release the sphere sinks slowly to the 50% equilibrium depth.
//
// Placement:
//   • position (30, 30, 76): centred in Y (y=30 ± 20 → y=[10,50], 10 LU from
//     each NoSlip wall), starts left-of-centre in X (X is periodic).
//   • XY distance to pillar 1 (64,15,r=8): sqrt(34²+15²) ≈ 37.2 > r+8=28 ✓
//   • XY distance to pillar 2 (64,45,r=8): sqrt(34²+15²) ≈ 37.2 > 28 ✓
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Cylinder pillars — same geometry as two_cylinder_floater_gas.prm.
// Both pillars clear the sphere (XY clearance ≈ 37 LU > r_sphere+r_pillar=28).
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // Giant sphere: radius=20 LU (diameter=40 LU ≈ 2/3 of the 60 LU domain width).
      // Centre at (30,30,76): bottom at z=56 = absoluteLiquidHeight, 0% submerged.
      // Starting with the bottom exactly at the surface rather than 9 LU above it
      // prevents the sphere from crashing into the surface at speed (v≈0.013 LU/step
      // after falling 9 LU), which caused simultaneous contact-circle formation over
      // the full sphere cap → CurvatureSweep invalid normals → NaN at step ~2000.
      // settlingSteps=500: contact line establishes at z=56 while sphere is held fixed,
      // then sphere released to sink gradually to equilibrium at z≈56 (50% submerged).
      // Y extent [10,50] — 10 LU clearance from each NoSlip wall.
      position     < 30, 30, 76 >;
      radius       20;
      densityRatio 0.5;
      settlingSteps 500;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
