// test_bridge_v1_raisedwater_bigjam_mixed_level3_DEBUG_widerstacks_nogjk_lowerwater_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// EVEN-LOWER-WATER variant of test_bridge_v1_raisedwater_bigjam_mixed_level3_DEBUG_widerstacks_nogjk_lowwater_gas.prm
// (job 4167764, COMPLETED cleanly at 100000 steps). That run measured (real eval data,
// eval/avgDataSlices/fillSlice_*.txt, clean open-water band X=50-60 just upstream of the bridge):
// baseline ~52.3 LU, an early transient spike to 55.53 LU by step 5000, then a settled plateau of
// ~53.7-54.5 LU for the remainder of the 100000-step run -- it NEVER reached the arch springing
// line (56 LU), so it stayed safely low but never actually tested the arch-edge squeeze-through
// goal. ONLY change here: liquidHeightFactor 2.0 -> 1.0, giving absoluteLiquidHeight~41.1 instead
// of ~49.1 (~8 LU per unit of liquidHeightFactor, from the established 2.0/2.9/4.0 -> 49.1/56.33/
// 65.12 sequence) -- a further ~8 LU lower starting point, on the reasoning that the prior run's
// transient spike (+3.3 LU) and plateau offset (+1.5-2.2 LU above baseline) should scale down
// similarly from a lower start, keeping this run comfortably clear of the springing line for now
// while we build up more data points on how the pile-up/spike magnitude actually depends on the
// starting level. Everything else (domain, piers, arches, box/sphere spawn points and timing,
// numSubCycles, maxOverlap clamp, no floating cylinders, useAnalyticalContactDetection,
// useArchTunnelAsMesaPDObject) is byte-identical to the lowwater file.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 90>;
   wavePeriods        1;
   liquidHeightFactor 1.0;  // EVEN-LOWER-WATER variant -- see this file's own header; absoluteLiquidHeight~41.1, well below the springing line (56)
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.3; // wet/waterlogged wood-wood -- these are floating logs, soaked, not dry timber
   numSubCycles 40; // unchanged from the base widerstacks file -- see that file's own header for the
                     // 10->20->30->40 history.
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// xMin/xMax DELIBERATELY set to the piers' own straight-box span (61..67).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; deckTopZ 76; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; deckTopZ 76; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; deckTopZ 76; }  // right arch
}

