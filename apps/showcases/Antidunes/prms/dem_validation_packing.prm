// DEM dry-run validation: mixed sphere+box+cylinder bed, gravity-settled into a bounded container
// (analogous to Kodam et al. 2010 Part II Test 3's 250-cylinder packing test, generalised to a MIXED
// shape bed -- the "between shapes" comparison, not just within one shape). Measures bulk solid
// fraction against the random-packing literature ordering (Jiao, Stillinger & Torquato 2010: sphere
// ~0.64 < cylinder ~0.72 < cube ~0.78 as maximally-jammed upper bounds -- see DEMValidationScenarios.h
// for the full citation and the reasoning for why a gravity-poured bed sits below these maxima).
DEMValidation{
    testCase packing;

    numPerShape 30;
    sphereRadius 1.0;
    boxHalfExtents < 0.9, 0.9, 0.9 >;
    cylinderRadius 0.8;
    cylinderLength 1.6;
    density 1.0;

    restitutionCoefficient 0.3;
    frictionCoefficient 0.5;
    poissonsRatio 0.22;
    collisionTime 0.01;
    gravity 9.81;

    // 8x8, not 20x20: 90 particles of ~1.5-2 unit footprint (~360 sq units total) need a floor small
    // enough to force them into a genuinely multi-layer PACKED BED (what the RCP literature values
    // below describe) rather than spreading into one sparse layer across a too-large floor, which reads
    // as an artificially low "packing fraction" that has nothing to do with how densely the shapes
    // themselves pack (confirmed empirically: containerSizeX/Y=20 measured bulkSolidFraction~0.23,
    // implausibly below even loose-sphere RCP, because the bed was a single thin layer, not a pile).
    containerSizeX 8.0;
    containerSizeY 8.0;

    maxSteps 50000;
    vtkSpacing 500;
    outputBaseName packing;
}
