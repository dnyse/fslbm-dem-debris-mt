// sphere_impact_sedimentation_block_atsurface_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// VARIANT of sphere_impact_sedimentation_block_gas.prm (the Bogner Fig 5.11
// replication) testing whether the block "punching through" the free surface
// (seen in the 30-LU-drop version, job 3999350/4000080) is an artifact of the
// ~2126-step free-fall building up real impact velocity/momentum, rather than
// something the block would do if simply placed at rest right at the water
// line. Bogner's own figure (a) shows the block hovering with SOME visible
// gap above the surface, but it's plausible that gap is much smaller than our
// 30 LU guess -- this run isolates drop height as the one changed variable.
//
// ONLY CHANGE from the base file: block bottom now at waterSurface+0.5 (was
// waterSurface+30) -- i.e. released essentially AT the surface, not dropped
// from height. Everything else (domain, walls, gravity, density weave,
// avgParticleDiameter/absoluteLiquidHeight derivation) is byte-identical to
// the base file; see that file's header for the full derivation. timesteps
// reduced to 20000 (this is a fast diagnostic, not the full run).
//
// GEOMETRY (all LU): sphere radius 3 (diameter 6), spheres touching
// (spacing = diameter), 10x10x10 block = 60x60x60 LU cube, centred in X/Y
// (domain 150x141, block occupies x in [45,105] / y in [40.5,100.5]). Z
// layout: water [0,120], 0.5 LU gap, block [120.5,180.5], 59.5 LU clearance
// to the ceiling (domainSize Z kept at 240, unchanged from the base file --
// just leaves more empty headroom above the block than before).
//
// Y IS NOT A FREE PARAMETER: Utility.h:144 asserts domainSize[1] ==
// uint_c(scalingFactor * generationDomainSize_SI[1] * bedCopiesInY) -- see the
// base file's header for the full explanation. domainSize[1]=141 with
// bedCopiesInY=2, unchanged.
//
// GRAVITY: real Earth gravity g_SI = 9.81 m/s^2, unchanged from the base file
// (depends only on domainSize[0]/bedCopiesInX, both unchanged):
//   gravityOverride = 1.3279788205258077e-05
//
// DENSITY MIX: same diagonal-plane weave as the base file --
// cycle[(i+j+k) % 3] over ratio 2/1/0.5 (red/gray/green), 334/333/333 split.
//
// staticReferenceHeightOverride intentionally OMITTED (H = absoluteLiquidHeight
// = 120 is already correct for this domain).
//
// Domain: <150, 141, 240> / cellsPerBlock <50, 47, 30> = 3x3x8 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 50, 47, 30 >;
   periodicity                   < 0, 0, 0 >;   // fully walled tank -- matches the figure's glass box
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <150, 141, 240>;
   wavePeriods        1;
   liquidHeightFactor 12.7;
   floorHeightFactor  0.1;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // quiescent liquid — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         20000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   1.3279788205258077e-05;  // solved for g_SI = 9.81 m/s^2, see header derivation
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 2;  // forced -- see header's "Y IS NOT A FREE PARAMETER" note (Utility.h:144)
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
