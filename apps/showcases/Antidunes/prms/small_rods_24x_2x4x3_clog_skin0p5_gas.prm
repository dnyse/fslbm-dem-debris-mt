// small_rods_24x_2x4x3_clog_skin0p5_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-10-01] SKIN-ONLY TEST: identical to `small_rods_24x_2x4x3_clog_gas.prm` below
// (which FAILED as job 4279038 -- invalid-quaternion NaN cascade, step 18420, the same
// cross-rank ghost-ownership desync mechanism documented for this hopper scenario throughout
// THESIS_PLAN.md) with `cylinderContactSkin 0.5` added to ModelParameters (rod-contact skin,
// cd1b991b). The sealed-cell guard (closeSealedCellsMinNeighbours) is already absent/off in the
// base file -- per explicit instruction, run with the skin alone and the guard off, so a clean
// result tells us the skin alone fixes it, not skin+guard together.
// This hopper run is also the first real test of the skin's rod-wall/rod-pillar coverage (the
// skin's own free-rod validation only exercised rod-rod contacts). Caveat carried over from the
// skin's own writeup: the skin makes a rod behave like diameter 7 instead of 6 in contact, so the
// 16 LU pillar gap narrows from ~2.7 to ~2.3 rod diameters -- not directly comparable to earlier
// hopper runs' contact geometry, only to 4279038 itself (same population/contact-mode baseline).
//
// FIRST ATTEMPT (job 4282206) FAILED in 97s via a fatal [RELEASE-OVERLAP] abort at release
// (mainStep=501, ParticleKernels.h:2442): the base scenario's 7 LU row pitch (rod diameter 6)
// leaves adjacent rows exactly 1.0 LU apart surface-to-surface -- precisely the skin's own
// rod-rod contact threshold (2x0.5). At release this registered as a genuine skin contact
// (penetration ~0, i.e. the intended "just touching" behaviour, not an insertion bug), which
// collided with a PRE-EXISTING, unconditional debug safety check from the earlier "flying
// floater" investigation that fatally aborts on ANY real contact between two freshly-released
// floaters -- it can't tell "released already overlapping" (the bug it was built to catch) apart
// from "released exactly at the skin's own touching boundary" (expected now that the skin
// exists). Per explicit follow-up instruction ("increase the gap between the floaters, make them
// a bit smaller if necessary"), FIXED by widening the row pitch 7->8 LU (gap 1.0->2.0 LU, 2x the
// skin threshold) rather than shrinking the rods -- keeps rod physics identical to 4279038, only
// shifts the X positions of rows 2-4 upstream by 1 LU each (row 1 stays anchored at the pillars):
// 364 (unchanged) / 356 / 348 / 340 (was 364/357/350/343).
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] TWENTY-FOUR ORIGINAL-SIZE RODS, 2(Y) x 4(X) x 3(Z), per explicit request
// ("double the number of cylinder in both simulations in x dimension") applied to
// `small_rods_12x_2x2x3_clog_gas.prm` (which completed as job 4268353 -- see THESIS_PLAN.md for its
// outcome: outcome split exactly by initial release depth, 4/12 stuck in two floor-piles from the
// Z=10 layer, 8/12 escaped downstream from the Z=25/45 layers, regardless of row or Y-column). Same
// rod geometry (radius 3, length 18, 1:3 ratio, axis Y), same 2 Y-columns (Y=10, Y=30) and same 3
// Z-layers/densities (1.2/1.0/0.5, heavy-low/light-high) as that scenario, but 4 rows in X instead
// of 2 -- 2(Y) x 4(X) x 3(Z) = 24 rods.
//
// X rows continue the SAME 7 LU pitch already used between the original two rows (364, 357 --
// matching the production 210-rod population's own row pitch): 364 (front, at the pillars,
// unchanged), 357, 350, 343 (two more rows extending upstream at the same spacing).
//
// All three of this session's 2026-09-25 crash-mitigation fixes (Option A/B, SimpleBB.h guard) are
// DISABLED, matching every other scenario in this rod-clog series. VTK writeFrequency 10000,
// timesteps 51000 (same as the 12-rod run).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // Row 1 (X=364) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 364, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 2 (X=356, 8 LU behind row 1 -- widened from 7, see file header) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 356, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 356, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 356, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 356, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 356, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 356, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 3 (X=348, 8 LU behind row 2 -- widened from 7, see file header) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 348, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 348, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 348, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 348, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 348, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 348, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 4 (X=340, 8 LU behind row 3 -- widened from 7, see file header) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 340, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 340, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 340, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 340, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 340, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 340, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;
   cylinderContactSkin           0.5;   // [Claude, 2026-10-01] rod contact skin in LU (cd1b991b): rod-rod contact starts at a surface gap of 1.0, rod-wall/pillar at 0.5. Sealed-cell guard stays OFF (not set below) so this isolates the skin alone.

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all four rows (X 250..500, Z 0..100); the rods are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
