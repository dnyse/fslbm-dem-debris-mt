// giant_rod_clog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] GIANT SINGLE-ROD CLOG SCENARIO, per explicit request ("run the hopper case
// with one giant cylinder release it in water close to hopper and long axis should be in y and it
// should clog... The length should be 90% of the y domain... Scale the radius also so we still have
// 1:3 ratio... Only release 1 closed to hopper pillars").
//
// Same channel/pillars/PID/domain as the production hopper-clog scenario (two cylindrical pillars
// on the Y walls, X=384, radius 12, central gap 16 LU) -- but instead of 210 small rods, exactly
// ONE giant rod: length = 0.9*domainY = 0.9*40 = 36 LU (spans Y=[2,38], leaving only 1 LU clearance
// to each Y wall), radius scaled to keep the production 1:3 diameter:length ratio -> diameter=12,
// radius=6. This rod is far longer than both the 16 LU pillar gap AND the 40 LU channel width
// itself -- it geometrically CANNOT pass between or around the pillars in any orientation, so a jam
// is essentially guaranteed once it reaches them, not merely likely.
//
// Released already submerged in the water (not dropped from above), close to the pillars: position
// X=364 (20 LU upstream of the pillar centre at X=384) -- at this X, since the rod's finite Y-extent
// [2,38] already comes within 2 LU of each pillar's own axis position (Y=0/Y=40), the closest
// rod-surface-to-pillar-surface clearance works out to sqrt((384-364)^2 + 2^2) - (6+12) ~= 2.1 LU:
// close enough to reach and jam the gap almost immediately once the flow picks it up, without
// starting in contact at t=0. Held fixed for a short settle (500 steps) then released.
//
// All three of this session's 2026-09-25 crash-mitigation fixes (Option A/B, SimpleBB.h guard) are
// DISABLED for this run (per explicit request) -- a genuine baseline for whether the giant-rod jam
// itself is stable without them, run on a mirror checkout with all three reverted.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // radius 6, length 36 (1:3 ratio, matching production), axis Y, close to the pillars, released
   // already submerged (Z=30, well below the Z=49.13 water surface), held 500 steps then free.
   // densityRatio 1.0 was NOT neutrally buoyant for this rod (empirically: F_buoy+grav_z=-0.237,
   // sank to the floor and stuck there via friction, job 4268239) -- lowered to 0.75 per request.
   FloatingCylinder { position < 364, 20, 30 >; radius 6; length 36; axis < 0, 1, 0 >; densityRatio 0.75; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars (X 250..500, Z 0..100); the rod is unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       2000;  // [Claude, 2026-09-26] raised further per request (50 -> 200 -> 2000) --
                                   // the first attempt (job 4268239) wrote 139G before finishing (~33000
                                   // steps), blowing the /home/hpc quota. 2000 gives only 25 dumps over the
                                   // full 50000-step run.
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
