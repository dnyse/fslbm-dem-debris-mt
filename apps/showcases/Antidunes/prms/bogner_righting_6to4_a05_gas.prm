// bogner_righting_6to4_a05_gas.prm — Bogner&Rüde 2013 Fig 5.6 righting-moment validation.
// 6:4 cuboid (b=24 x, h=16 z, length=2h=32 y), FIXED half-immersed, heeled 5° about y.
// Reads [BoxRightingMoment] M_y/GZ vs heelDeg; sweep a=0..30° and compare to the ideal curve.
// ─────────────────────────────────────────────────────────────────────────────
// STILL-WATER settle test: one floating CUBE (edge 26, halfExtents <13,13,13>, densityRatio 0.5)
// started EDGE-DOWN (its stable orientation) just above the surface — no flow, no pillars;
// X periodic, Y NoSlip walls. It settles into the half-submerged edge-down equilibrium in place.
//
//   • targetMeanVelocityMagnitude 0  → no driving flow (still water).
//   • useHardcodedUnits true → viscosity / relaxationRate / gravity / surfaceTension
//     keep their reference values instead of being derived from U (which is 0 here).
//   • Started edge-down (initialTiltAngleDeg 45): a uniform half-submerged cube is UNSTABLE face-up
//     (GM<0) and STABLE edge-down (GM≈+0.24·L). Starting at the stable orientation avoids the
//     tumble-from-face-up that otherwise self-propels the cube across the tank. comOffsetZ 0.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // Bogner 6:4 cuboid: halfExtents <12,16,8> → width b=24 (x), length 2h=32 (y), height h=16 (z).
      // FIXED (settlingSteps ≫ timesteps) and half-immersed (centre z=56 ≈ still-water surface), heeled
      // 5° about the longitudinal y-axis. Read [BoxRightingMoment] M_y/GZ at this angle;
      // sweep a=0..30° to trace the stability curve and compare to the ideal. comOffsetZ 0 → uniform.
      position             < 64, 30, 56 >;
      halfExtents          < 12, 16, 8 >;
      densityRatio         0.5;
      settlingSteps        100000000;
      initialTiltAngleDeg  5;
      comOffsetZ           0;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticBoxBuoyancy        true;   // exact clip → righting moment vs ideal
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
