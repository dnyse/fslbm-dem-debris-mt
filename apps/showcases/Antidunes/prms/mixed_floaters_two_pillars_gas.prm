// mixed_floaters_two_pillars_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// ALL-SHAPE interaction test: one floating SPHERE + two floating BOXES + one floating
// CYLINDER (log) released upstream of two cylinder pillars and swept downstream together.
// This exercises every newly enabled contact pair in one run:
//   • Cylinder×CylindricalBoundary — the log jams across the pillar gap (analytic solid contact)
//   • Box×Box                      — the two boxes collide with each other (GJK/EPA)
//   • Box×Cylinder, Sphere×Cylinder, Sphere×Box — the drift pile-up behind the jammed log
//   • Box×CylindricalBoundary, Sphere×CylindricalBoundary — contacts with the piers
//
// Staging (flow is +X, pillars at x=64): boxes start closest (x=40) and reach the piers
// first; the log (x=30) follows and jams across the 14-LU gap; the sphere (x=18) piles up
// behind. Boxes at y=24/36 straddle the gap centreline so they hit both a pier AND each other.
//
// Watch: [BoxBuoyancy] (shape=BOX / shape=CYLINDER), [FloaterBuoyancy] (sphere), and the
// per-floater [BoxForces]/[CylForces]/[FloaterForces] breakdowns; F_contact≠0 marks the jams.
//
// Cylinder pillars: (64,15,90) r=8 and (64,45,90) r=8 → gap 14 LU between surfaces.
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // Trailing sphere: r=5 < 14-LU gap, so alone it would pass — instead it piles up
      // against the jammed log/boxes (Sphere×Cylinder + Sphere×Box contacts).
      position       < 18, 30, 58 >;
      radius         5;
      densityRatio   0.5;
      settlingSteps  500;
   }
}

FloatingBoxes
{
   FloatingBox
   {
      // Box pair straddling the gap centreline: y-extents [18,30] and [30,42] — they meet at
      // y=30 while drifting (Box×Box) and each also hits its pier (Box×CylindricalBoundary).
      position             < 40, 24, 59 >;
      halfExtents          < 3, 6, 3 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  5;
   }
   FloatingBox
   {
      position             < 40, 36, 59 >;
      halfExtents          < 3, 6, 3 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  -5;
   }
}

FloatingCylinders
{
   FloatingCylinder
   {
      // Log: radius 3, length 18, axis along Y. Long axis > 14-LU gap → jams across both piers.
      position             < 30, 30, 59 >;
      radius               3;
      length               18;
      axis                 < 0, 1, 0 >;
      densityRatio         0.5;
      settlingSteps        500;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
