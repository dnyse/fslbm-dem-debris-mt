// box_two_pillars_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// SMALLER-box clogging comparison to giant_box_two_pillars_gas.prm: same scenario
// (log placed clearing two cylinder pillars, bottom at the surface, settle-and-release,
// then swept downstream to clog against the piers) but with the ORIGINAL log size
// (edgeLength 6×18×6, halfExtents <3,9,3>, 1:3:1 ratio) instead of the giant 12×36×12.
//
// Why smaller: the giant box's cross-section (half-extent 6) and 18-LU half-length let
// it reach/envelop the thin pillar axis (radius 8) and is rammed in 8× harder by the
// full-volume driving force. This log's cross-section (half-extent 3 < pillar radius 8)
// cannot envelop the axis — it contacts the pillar SURFACE cleanly. Its long axis (18)
// still exceeds the 14-LU pillar gap, so it jams across both piers = clogging.
//
// Physics:
//   • densityRatio=0.5 → ~50% submerged. Bottom at surface (centre z=59, hz=3).
//   • settlingSteps=500, then released; GM<0 → rolls; 5° tilt seed.
//
// Cylinder pillars (same as giant_box_two_pillars / giant_sphere):
//   Pillar 1: center (64, 15, 90), r=8  →  surface at y=23
//   Pillar 2: center (64, 45, 90), r=8  →  surface at y=37  (gap 14 LU)
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingBoxes
{
   FloatingBox
   {
      // Log: edgeLength 6×18×6 (halfExtents 3×9×3), 1:3:1 ratio. Centre (30,30,59):
      // bottom at z=56 = surface. Long axis (Ly=18) > 14-LU pillar gap → jams across both
      // piers when swept downstream. initialTiltAngleDeg=5 about Y seeds the rolling instability.
      position             < 30, 30, 59 >;
      halfExtents          < 3, 9, 3 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  5;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
