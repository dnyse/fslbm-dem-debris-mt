// pont_ferroviere_rue_goffontaine_realscale_reconstruction_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// DEBRIS SCENARIO 1/3 -- "Reconstruction": pre-formed jam placed directly at the recorded footprint,
// built on top of pont_ferroviere_rue_goffontaine_realscale_gas.prm's validated bridge geometry (see
// that file's own header for the full geometry/resolution derivation -- unchanged here). Derived from
// pont_ferroviere_rue_goffontaine.md record #30071's Accumulation/Main-debris-content fields:
//   - Total volume 60 m^3, composition natural wood 40% / building rubble 40% / anthropogenic wood 20%.
//   - "Main trunk presence: Yes" -> one distinguished large key-log (9m x 0.5m dia cylinder, 1.77 m^3).
//   - Carpet: 10m streamwise x 12m cross-stream x 1m tall, "Location at structure: Left bank" -> placed
//     immediately upstream of the piers' leading face (X=1212), spanning Y=[0,396] LU (12m, flush
//     against the left abutment), covering all of opening 1 (the "left bank side" opening) and
//     spilling slightly onto pier 1's upstream nose -- matching a real raft piling wider than the
//     single gap it ultimately blocks.
// GENERATED by gen_pont_ferroviere_debris.py (this dir) -- 192 pieces total (100 cylinders: 1 main
// trunk + 99 secondary natural-wood logs; 92 boxes: 42 anthropogenic-wood + 50 rubble), each piece at
// its own distinct (X,Y,Z) within the footprint (grid+jitter, seeded on the record ID for
// reproducibility) so no shared-spawn-point staggering is needed -- a short uniform settlingSteps
// (2000-7000, de-synchronised across pieces) just lets FSLBM's fill-level field stabilise around each
// piece before release, then the whole jam is observed near-immediately at its recorded configuration
// (unlike the genesis scenarios below, this is NOT testing formation dynamics, only the STEADY-STATE
// hydraulic/mechanical consequence of the recorded jam: does it reproduce a comparable backwater rise
// to the record's max water elevation 116.49m, and is it mechanically stable under the flow or does it
// wash out).
// timesteps bumped 50000->60000 (vs the base file) to give the settled jam room to reach a hydraulic
// steady state after the last piece releases (t=7000) and be observed for ~50000 steps after that.
//
// SIMPLIFICATIONS (in addition to the base file's own, unchanged, list):
//   - Piece sizes/shapes are NOT independently sourced from the record (which gives only aggregate
//     volume + composition percentages, no individual piece dimensions) -- they are engineering
//     judgement calls sized to land close to each category's target volume with a tractable piece
//     count, and to stay chunky enough to avoid thin-body DEM contact degeneracy (the ARCH-ENVELOP
//     postmortem's lesson). See gen_pont_ferroviere_debris.py's own per-class comments.
//   - Rubble (densityRatio 2.3, real concrete/brick density) is placed at the base of the mat but,
//     being denser than water, will physically settle toward the bed in this DEM model rather than
//     stay suspended within the recorded 1m-tall SURFACE carpet -- there is no wood-rubble
//     entrainment/binding mechanism in this codebase. Kept at real density anyway (not fudged toward
//     neutral buoyancy) so the run honestly shows whether the sunken rubble still contributes to
//     blockage under the wood raft, or washes downstream past the piers along the bed.
//   - The 20-degree bank skew and the arch's assumed-semicircular shape are unchanged simplifications
//     from the base file (not re-derived here).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 112, 44, 54 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <2688, 1056, 432>;
   wavePeriods        1;
   liquidHeightFactor 0.280234;
   floorHeightFactor  0.405302;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         60000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out_pont_ferroviere.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only). Radius 33 LU = 2 m real pier
// width. center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 1212, 348.15, 173.6 >; radius 33; }
   CylinderPillar { center < 1476, 348.15, 173.6 >; radius 33; }
   CylinderPillar { center < 1212, 707.85, 173.6 >; radius 33; }
   CylinderPillar { center < 1476, 707.85, 173.6 >; radius 33; }
}

Pillars
{
   Pillar { center < 1344, 348.15, 173.6 >; halfExtents < 132, 33, 173.6 >; }
   Pillar { center < 1344, 707.85, 173.6 >; halfExtents < 132, 33, 173.6 >; }
}

// One entry per real opening (all three 8.9 m -> radius 146.85 LU). xMin/xMax DELIBERATELY set to
// the piers' own straight-box span (1212..1476, i.e. pier x_center +- x_half), NOT the deck's full
// 10 m streamwise width (1179..1509, what this used to be) -- recesses each arch collar's flat
// leading/trailing face behind the piers' rounded nose, so the nose visibly sticks out past the
// deck edge instead of the deck being flush with the nose tip. Tuned/verified offline in
// bridge_layout_optimizer.py / bridge_voxel_view.py / bridge_voxel_render_full.py (3D voxel review
// at true 1 LU simulation resolution). The LBM BodyBC arch boxes below are updated to the SAME
// span, so the DEM contact geometry (what floaters actually collide with) never diverges from
// what's actually painted solid in the fluid.
ArchTunnels
{
   ArchTunnel { center < 0, 168.3, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 1 (left bank side)
   ArchTunnel { center < 0, 528.0, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 2 (centre)
   ArchTunnel { center < 0, 887.7, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 3 (right bank side)
}

