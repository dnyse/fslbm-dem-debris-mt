// small_rods_24x_2x4x3_clog_resume_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] RESUME of `small_rods_24x_2x4x3_clog_gas.prm` (job 4268494), per explicit
// request ("let both from the crashed continue via their last checkpoint"). Job 4268494 hit a fatal
// STALE-PARTICLE-IDX abort at step 22196/51000 (see THESIS_PLAN.md) -- a cross-rank ghost-ownership
// desync, confirmed via code trace to require no anomalous displacement (an ordinary mid-step ghost
// drop, unluckily timed against the once-per-main-step fluid-obstacle-mapping refresh, is
// sufficient). This resumes from that job's last snapshot (step 20000, snapshotFrequency 5000 --
// the only checkpoint written before the crash), copied to
// `resume_snapshots/small_rods_24x_from_4268494/` on this mirror so the sbatch script's own
// leftover-output rescue logic (which only touches $BIN_DIR/{vtk-out,eval,snapshots}) doesn't sweep
// it away. Same population/physics/fixes-off state as the original -- purpose is to see whether the
// desync reproduces again shortly after resuming (confirming a robust, reproducible instability at
// this rod-count/rank-count regime) or whether the run manages to continue further this time.
// `loadSnapshot true` + an absolute `snapshotBaseFolder` pointing at the copied snapshot; new
// checkpoints during this resumed run will overwrite that copy going forward (the ORIGINAL crash
// snapshot under the job's own archive folder is untouched).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  true;
   storeSnapshot                 true;
   // [Claude, 2026-09-27] Narrowed from 5000 to 50, per explicit request ("get closer via checkpoint
   // to this failure"): every natural resume of this scenario has crashed somewhere in the step
   // 21999-22264 range (STALE-PARTICLE-IDX, same two floaters/four ranks each time -- see
   // THESIS_PLAN.md), but the only checkpoint ever available was the one at step 20000 (the boundary
   // BEFORE the crash region), forcing every repro attempt to replay ~2000+ steps from scratch. This
   // writes a new checkpoint every 50 steps instead, so once this run crashes again the folder below
   // will hold a checkpoint within <=50 steps of the actual failure -- close enough to resume directly
   // into the crash window without replaying the whole run. NOTE: checkpoint files use FIXED names
   // (blockForest.file, pdfField.file, etc., see SimulationObjects.h) -- each new write OVERWRITES the
   // previous one in this same folder, so only the LATEST checkpoint survives at any time (by design,
   // not a bug); the ORIGINAL step-20000 checkpoint was backed up first, to
   // resume_snapshots/small_rods_24x_from_4268494_BACKUP_step20000_20260927/, before this change.
   snapshotFrequency             50;
   snapshotBaseFolder            /home/hpc/iwia/iwia148h/mt-dennys-mirror2/apps/showcases/Antidunes/resume_snapshots/small_rods_24x_from_4268494;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         51000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;

   // [Claude, 2026-09-27] Per explicit request ("our post debug sweep should catch that density
   // should be around 1"): the watch-cube trace on job 4271129 showed a LIQUID cell drain
   // 0.744->0.013 over 10 steps with NOTHING firing, because this window was never actually set
   // (defaults to 0/0 = off) despite BuildTimeloop.h's addAfterTimeStepDiagnosticSweep already
   // calling checkPdfNaN (which reads these) every step. Using this codebase's own suggested
   // defaults (see checkPdfNaN's doc comment: "physical rho ~ 1; typical values 0.1 and 1.9"),
   // restricted to liquid cells only so routine interface/gas fluctuations don't flood the log.
   // Would have caught this exact drain at step 22010 (rho=0.013, already below 0.1) -- one step
   // before the catastrophic jump -- instead of only being visible via a hardcoded watch-cell trace.
   densityPrecursorLow        0.1;
   densityPrecursorHigh       1.9;
   densityPrecursorLiquidOnly true;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // Row 1 (X=364) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 364, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 2 (X=357, 7 LU behind row 1) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 357, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 357, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 357, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 357, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 357, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 357, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 3 (X=350, 7 LU behind row 2) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 350, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 350, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 350, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 350, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 350, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 350, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 4 (X=343, 7 LU behind row 3) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 343, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 343, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 343, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 343, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 343, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 343, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   // [Claude, 2026-09-27] Per explicit request ("add to our additional sweep... rerun and analyze"):
   // activates BuildTimeloop.h's addAfterTimeStepDiagnosticSweep, which now also traces the
   // [MEM-GARBAGE-LINK] collapse cell (608.5,18.5,30.5) and its full 26-neighbour cube every step,
   // zero-threshold (see that function's own doc comment). Resuming from the step-22001 checkpoint
   // (11 steps from the known crash at 22012), so no From/ToStep window needed -- the whole run is
   // already inside the window of interest.
   diagnosticSweepEnabled        true;

   // [Claude, 2026-09-26] Per explicit request ("try to log the cylinders positional data per time
   // step"): windowed around the known crash step (original 4268494 crashed at 22196, first resume
   // 4268637 re-crashed at 21999 -- same checkpoint, same population, so this rerun should land in
   // the same neighborhood again) -- gives per-SUB-CYCLE position/velocity/ownership for every
   // floater, not just the coarse every-100-step CylForces log, without paying that cost for the
   // whole run (see logFloaterHistoryStartStep/EndStep's own doc comments, SimulationParams.h).
   logFloaterHistory             true;
   floaterHistoryBaseFolder      floater-history;
   // [Claude, 2026-09-27] Widened per explicit request ("reproduce the error again from the
   // original checkpoint, no forced activation... confirm the stale id is the issue"): prior
   // natural (unforced) recurrences of this exact crash landed anywhere from step 21999 to 22584
   // across different resume attempts -- this window keeps a wide margin on both sides so a
   // genuine, unforced re-crash is fully captured regardless of exactly where it lands this time.
   logFloaterHistoryStartStep    20500;
   logFloaterHistoryEndStep      24000;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all four rows (X 250..500, Z 0..100); the rods are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
