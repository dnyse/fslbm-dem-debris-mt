// bogner_exact_3box_s16_seed5_rho075_pinxy_omega1p9_50k_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] Direct test of the wobble-instability hypothesis (THESIS_PLAN.md): job 4255656
// (this exact scenario -- rho=0.75, seed5, omega=1.9, fully free 6-DOF, 100k steps) was found to
// develop a real, growing out-of-plane wobble (arccos(R(1,1)) rotation-matrix metric) starting from
// exactly zero and climbing to 16deg by step 98000, with the SAME onset-of-growth pattern seen
// independently in job 4262237 (rho=0.7665, Pass-3) immediately preceding its own catastrophic
// tiltY destabilisation. This run tests whether REMOVING the channels that let that wobble grow --
// pin X/Y translation (only Z/heave free) and pin pitch/yaw rotation (only Y/roll free) -- restores
// clean settling near the theoretical 26.565deg equilibrium, the way the earlier fully-roll-only
// control (job 4253988) already did.
// Byte-identical to bogner_exact_3box_s16_seed5_rho075_nopin_omega1p9_100k_torque_gas.prm EXCEPT:
//  * pinPosition true; pinAxes <1,1,0> (X,Y pinned, Z free to find its own draft)
//  * pinRotation true; pinRotationAxes <1,0,1> (pitch/yaw pinned, Y/roll free)
//  * timesteps 50000 (half length; this question doesn't need the full 100k to answer)
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;          // Bogner's tau = 1/1.9 = 0.526; lower omega = more viscous damping (Bogner's own value)
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 20, 16 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  10;  // seed heel about the free Y axis (Bogner: 2.86; previous pinxy attempt used 5deg and stalled near its own seed, see THESIS_PLAN.md)
      comOffsetZ           0;
      pinPosition          true;         // X,Y pinned, Z free (pinAxes below)
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;         // pitch/yaw pinned, roll (Y) free (pinRotationAxes below)
      pinRotationAxes      < 1, 0, 1 >;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;   // explicitly OFF: no analytic buoyancy in this experiment
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }

      // one mid-width plane (the boxes' cross-section is in X-Z)
      CellBB_filter_0 { min < 0, 20, 0 >;  max < 130, 21, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
