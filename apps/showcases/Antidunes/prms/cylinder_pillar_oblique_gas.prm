// cylinder_pillar_oblique_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Cylinder×CylindricalBoundary OBLIQUE-CONTACT test — part of the floater/pillar
// interaction test suite (see also: cylinder_pillar_gap_pass_gas.prm, sphere_pillar_*,
// box_pillar_*). Every existing log/pillar run has the log axis exactly along Y
// (perpendicular to the pillar's Z-axis) — the simplest case for the
// SolidCylinderContactDetection fixed-point iteration, since the closest-point
// search reduces to a single perpendicular offset. This run yaws the log's axis
// 45° in the horizontal (X-Y) plane so neither cylinder's axis is aligned with the
// other or with any world axis: the two axis LINES are skew in 3D, which is the
// general case the fixed-point iteration has to converge on (as opposed to being
// handed a trivial closest-point by symmetry).
//
// Geometry (absoluteLiquidHeight = 56.024):
//   • Pillar: center (64, 30, 90), radius 8, axis along Z (vertical, spans the domain).
//   • Log: radius 3, length 16, axis <1,1,0> (normalised to 45° in the X-Y plane,
//     still lying flat/horizontal so it floats normally), densityRatio 0.5 → centre
//     at z=56 (50% submerged, circularly symmetric). Start (30, 24, 56): offset in Y
//     so the log's leading end (the +axis direction, trailing toward larger x,y as
//     the whole body drifts +X) sweeps toward the pillar at an angle rather than
//     straight-on.
//   • Expected outcome: the log's leading region contacts the pillar surface at an
//     oblique angle; contactPoint/contactNormal from the fixed-point iteration should
//     match the true closest point between the (skew) log-axis segment and the
//     pillar's axis line — the hardest case flagged when this contact model was
//     unit-tested (see tests/showcases_antidunes/ if present, or ParticleKernels.h
//     SolidCylinderContactDetection).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 64, 30, 90 >;
      radius 8;
   }
}

FloatingCylinders
{
   FloatingCylinder
   {
      // Log yawed 45° in the X-Y plane (axis <1,1,0>, normalised on parse): its axis
      // line is skew to the pillar's vertical axis, exercising the general
      // fixed-point closest-point iteration rather than a perpendicular special case.
      position             < 30, 24, 56 >;
      radius               3;
      length               16;
      axis                 < 1, 1, 0 >;
      densityRatio         0.5;
      settlingSteps        500;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 30, 0 >; max < 64, 30, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
