// DEM validation "dropper case" showcase: a single, visually clean cylinder-wall oblique impact for a
// thesis figure -- reuses dem_validation_wall_cylinder.prm's own parameters (same geometry/material,
// see that file's own header for the full derivation and Kodam et al. (2010) Part II citation), but at
// a SINGLE tilt (45deg, the middle of the 30-75deg "single-clean-corner-contact" regime that file's
// own comment identifies as the analytical model's valid range) instead of a sweep, with VTK output
// enabled for an animation. Cluster-only per explicit instruction -- see
// jobs/run_24_dem_validation_dropper_case.sbatch.
DEMValidation{
    testCase wallImpactCylinder;

    cylinderRadius 1.0;
    cylinderLength 4.0;
    density 1.0;
    restitutionCoefficient 0.85;
    frictionCoefficient 0.3;
    poissonsRatio 0.22;
    collisionTime 0.01;

    impactSpeed 1.0;
    tiltStartDeg 45.0;
    tiltEndDeg 45.0;
    tiltStepDeg 15.0;

    toleranceRelError 0.3;
    // ~10200 total steps (200*(collisionTime/dt+1), dt=collisionTime/50 default) -- spacing 20 gives
    // ~510 VTK frames, enough for a smooth bounce animation without an excessive frame count.
    vtkSpacing 20;
    outputBaseName dropper_case_cylinder;
}
