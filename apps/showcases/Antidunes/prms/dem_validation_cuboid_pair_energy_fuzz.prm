// [Claude, 2026-10-01] Energy conservation of oblique elastic cuboid-cuboid collisions (e = 1, mu = 0, no gravity), 12 x 2 x 3
// cuboids as in the drop tests; modes gjk (GJK/EPA) and sat (boxBoxSAT, the production path). See runCuboidPairEnergyFuzz
// (DEMValidationScenarios.h). With the former SAT contact point (env ANTIDUNES_SAT_FORMER_POINT): mean 373 %, max x98.
DEMValidation{
    testCase cuboidPairEnergyFuzz;
    cuboidHalfExtents < 6, 1, 1.5 >;
    density 1.0;
    poissonsRatio 0.22;
    collisionTime 0.01;
    approachSpeed 1.0;
    numCollisions 200;
    modes gjk,sat;
    toleranceRelError 0.02;
    seed 4242;
}
