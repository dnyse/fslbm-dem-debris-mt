ModelParameters
{
   useAnalyticalContactDetection true;  // Box x Box -> boxBoxSAT (analytic) UNLESS useSpheroBoxContact
                                        // below overrides Box x Box specifically.
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useSpheroBoxContact           false; // [Claude, 2026-09-23] SAT variant: pure boxBoxSAT analytic (no sphero-rounding), per explicit request  // matches the bridge scenario's own spherobox_gjk/noarches runs,
                                        // for direct comparability -- see file header.
   spheroBoxRadius               0.05;
   useSpheroBoxAnalytical        false;
   useTightLayer1                true;
   useContactFilterOwnerTiebreak true;
   pdfReconstructionModel        OnlyMissing;              // unused (no fluid) -- required by parser
   pdfRefillingModel             EquilibriumRefilling;     // unused -- required by parser
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid; // unused -- required by parser
   curvatureModel                FiniteDifferenceMethod;   // unused -- required by parser
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;  // REQUIRED true -- keeps AddExternalForces' fluid-field-dependent
                                        // submerged-volume code path (computeSubmergedVolumes) fully
                                        // gated off; gravity becomes plain density-weighted mass*g.
   logFloaterHistory              false; // FloaterHistoryLogger not wired into DropTest.cpp this version
   logFloaterHistoryStartStep     0;
   logFloaterHistoryEndStep       10000;
   logContactAnomalies            false;
   contactAnomalyStartStep        0;
   contactAnomalyEndStep          10000;
   useHydrodynamicForceTimeAveraging true; // unused (no hydro force ever set) -- inert
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
   logContactDetectionStatsPeriodically true;
}

VTK
{
   // NOTE: fluid_field VTK is never actually written (DropTest.cpp has no LBM fields and never calls
   // BuildTimeloop.h::addBeforeTimeStepVTKOutput) -- but VTKParams' constructor (SimulationParams.h)
   // unconditionally reads simParams->vtk.writeFrequency/baseFolder/etc. FROM this "fluid_field"
   // sub-block regardless of block name, and DropTest.cpp reuses those same parsed values directly
   // for its own floaterBox writer's frequency/folder. writeFrequency is therefore the REAL,
   // load-bearing floaterBox VTK frequency here, ramped up relative to production given the tiny
   // domain and lack of any actual fluid-field VTK cost.
   fluid_field
   {
      writeFrequency       200;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
