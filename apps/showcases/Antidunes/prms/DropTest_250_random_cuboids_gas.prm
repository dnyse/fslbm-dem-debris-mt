   useHardcodedUnits true;
   gravityOverride   2.1371500584054327e-05;  // true g_SI = 9.81 m/s^2 -- see file header derivation
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read -- avgParticleDiameterOverride/dxSIOverride below bypass it
