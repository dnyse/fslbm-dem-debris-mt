// sphere_stillwater_bognerboxgravity_3xsphere_d075_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FREE-FLOATING SPHERE, STILL WATER, BOGNER'S BOX-EXPERIMENT GRAVITY, BOGNER BUOYANCY,
// SPHERE RADIUS 3x THE ORIGINAL FAMILY (8 -> 24 LU).
//
// Same 3x-geometry change as sphere_stillwater_realgravity981_3xsphere_gas.prm (see that
// file's header for the full domain/Y-lock/Z-headroom derivation) -- domain <96,45,40> ->
// <96,135,120>, cellsPerBlock <16,15,10> -> <16,45,30> (still 6x3x4=72 processes),
// liquidHeightFactor 3.3227 -> 9.9681, bedCopiesInY 1 -> 3, sphere radius 8 -> 24, position
// <48,22.5,20> -> <48,67.5,60>. domainSize[0]/bedCopiesInX are UNCHANGED (96/1), so dx_SI is
// identical to the rest of the sphere_stillwater_* family -- irrelevant here anyway, since
// gravityOverride/relaxationRateOverride below are Bogner & Rude (2013)'s own fixed LU values
// (thesis Sec. 5.3.3, unscaled -- his own box-experiment domain height already matched this
// family's original Z=40, same Eq. 10 stability margin he validated), not SI-derived.
//
// densityRatio 0.5 here; see the _d025/_d075 siblings for the other two densities.
// timesteps 50000 (up from the original family's 30000, per this run's own request).
// Domain: <96, 135, 120> / cellsPerBlock <16, 45, 30> = 6×3×4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 45, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 135, 120>;
   wavePeriods        1;
   liquidHeightFactor 9.9681;
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   relaxationRateOverride 1.9;         // Bogner & Rude 2013's tau=1/1.9=0.526
   gravityOverride        7.5e-4;      // Bogner & Rude 2013's own g
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 3;   // scaling-math lever only (useParticleBed false) -- see sibling file's header
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      position     < 48, 67.5, 60 >;
      radius       24;
      densityRatio 0.75;
      settlingSteps 0;
      pinPosition  false;
      pinRotation  false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 67, 0 >;   max < 96, 68, 120 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 135, 120 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 96, 135, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
