// small_rods_24x_2x4x3_clog_resume_fluidbox_nofreeze_verify_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-27] Per explicit request ("don't freeze, run from earlier checkpoint then"):
// companion to small_rods_24x_2x4x3_clog_resume_fluidbox_verify_gas.prm with useObstaclePdfFreeze
// FALSE (reconstruction-only, the pre-fix behaviour) and the fluid-box/floater-history windows
// widened all the way back to the checkpoint's own start step (20001, the earliest backup
// available -- confirmed via simState.file) instead of the narrow 21800..22050 window used for the
// freeze-ON run. Motivation (THESIS_PLAN.md 2026-09-27): the freeze-ON run showed a tracked cell's
// PDF get "locked in" at a wrong value outside its own save/restore bracket, then explode further at
// reconstruction -- this run checks whether the SAME box, watched from as far back as possible
// WITHOUT the freeze, shows a materially different (or the same) evolution: does removing the
// freeze let a bad cell self-correct via ordinary collide, or does the same wholesale-region
// corruption still happen regardless of freeze state?
// Same box as the freeze-ON run (covers every crash-relevant position seen this session):
// X 590-625, Y 8-30, Z 15-50. storeSnapshot false: observe-only, no new checkpoints written.
//
// [Claude, 2026-09-27] EXTENDED per explicit request ("keep it running then from the last
// checkpoint"): job 4271533 (this prm, timesteps=22200) completed cleanly with a flat, non-
// escalating MEM-GARBAGE-LINK rate throughout -- but a DIFFERENT freeze=false run (job 4271396,
// no box logger) crashed at step 22257, past the old 22200 cutoff. There is no NEW checkpoint to
// resume from (storeSnapshot was false, by design, to leave the shared backup untouched) -- this
// re-runs from the SAME step-20001 checkpoint with timesteps/windows extended to 22400 (200 steps
// past 4271396's own crash step) to see whether THIS trajectory also eventually crashes, and
// whether the same escalating-MEM-GARBAGE-LINK precursor pattern (or a "clean" sudden one) precedes
// it. Given this codebase's own established run-to-run non-determinism, this will NOT retrace the
// same trajectory as 4271533 step-for-step past wherever the two runs' histories first diverge --
// it is a fresh continuation attempt from the same starting point, not a literal resume of 4271533.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  true;
   storeSnapshot                 false;
   // Required by the parser even though storeSnapshot=false means it's never actually used to
   // write anything -- any value is fine.
   snapshotFrequency             50;
   snapshotBaseFolder            /home/hpc/iwia/iwia148h/mt-dennys-mirror2/apps/showcases/Antidunes/resume_snapshots/small_rods_24x_from_4268494_BACKUP_step20000_20260927;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         22400;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;

   densityPrecursorLow        0.1;
   densityPrecursorHigh       1.9;
   densityPrecursorLiquidOnly true;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // Row 1 (X=364) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 364, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 364, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 2 (X=357, 7 LU behind row 1) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 357, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 357, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 357, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 357, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 357, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 357, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 3 (X=350, 7 LU behind row 2) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 350, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 350, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 350, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 350, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 350, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 350, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }

   // Row 4 (X=343, 7 LU behind row 3) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 343, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 343, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 343, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
   FloatingCylinder { position < 343, 30, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 343, 30, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 500; }
   FloatingCylinder { position < 343, 30, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
}

ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   diagnosticSweepEnabled        true;

   // [Claude, 2026-09-27] THE VARIABLE UNDER TEST per explicit request ("don't freeze"):
   // reconstruction-only, the pre-fix behaviour.
   useObstaclePdfFreeze          false;

   logFloaterHistory             true;
   floaterHistoryBaseFolder      floater-history;
   logFloaterHistoryStartStep    20001;
   logFloaterHistoryEndStep      22400;

   // Same box as the freeze-ON run, widened window back to the checkpoint's own start step per
   // explicit request ("run from earlier checkpoint").
   logFluidBoxHistory            true;
   fluidBoxHistoryBaseFolder     fluid-box-history;
   fluidBoxMin                   < 590, 8, 15 >;
   fluidBoxMax                   < 625, 30, 50 >;
   logFluidBoxHistoryStartStep   20001;
   logFluidBoxHistoryEndStep     22400;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all four rows (X 250..500, Z 0..100); the rods are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 250, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
