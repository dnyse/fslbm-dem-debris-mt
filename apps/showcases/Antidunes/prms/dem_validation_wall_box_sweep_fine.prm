// Source of the smooth analytical curve (not the DEM markers) of the cuboid wall-impact figures (Section 5.2): same
// geometry and protocol as the _translational/_rotational sweeps, but 1 deg steps (91 points, 0-90 deg). The per-tilt
// analytical reference does not depend on useRotationalEffectiveMass, so one fine sweep suffices.
DEMValidation{
    testCase wallImpactBox;
    useRotationalEffectiveMass true;

    boxHalfExtents < 1.0, 2.0, 2.0 >;
    density 1.0;
    restitutionCoefficient 0.6;
    frictionCoefficient 0.0;
    poissonsRatio 0.22;
    collisionTime 0.01;

    impactSpeed 1.0;
    tangentialSpeedFraction 0.0;
    tiltStartDeg 0.0;
    tiltEndDeg 90.0;
    tiltStepDeg 1.0;

    toleranceRelError 0.02;
    vtkSpacing 0;
    outputBaseName wall_impact_box_kodam_sweep_fine;
}
