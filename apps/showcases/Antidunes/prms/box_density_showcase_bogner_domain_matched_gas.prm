// box_density_showcase_bogner_domain_matched_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// BUOYANCY SHOWCASE (box), BOGNER THREE-PHASE MEM variant, GRAVITY + DOMAIN
// MATCHED TO BOGNER'S OWN VALIDATION regime -- the side-by-side combined
// counterpart to sphere_density_showcase_bogner_domain_matched_gas.prm and
// cylinder_density_showcase_bogner_domain_matched_gas.prm: all THREE densities
// (0.25 / 0.5 / 0.75) in ONE domain/run instead of the three separate
// box_density_0{25,50,75}_bogner_domain_matched_gas.prm files. This is the
// most direct reproduction of Bogner & Rude (2013) Sec. 3.3.1 / Fig. 11 (three
// checkerboard boxes side by side in one basin) as a single showcase run.
//
//   1. ModelParameters: useBognerThreePhaseMEM + useMemOnlyBuoyancy both true.
//   2. PhysicsParameters: gravityOverride 7.5e-4, relaxationRateOverride 1.9 --
//      matches Bogner's own thesis Sec. 3.3.1 values (g=7.5e-4, tau=1/1.9=0.526)
//      exactly (verified against the actual paper, arXiv:1201.0351).
//   3. Domain reused VERBATIM from the per-density Bogner-domain-matched box
//      runs: <128, 60, 54>, X/Y kept at the ORIGINAL scale so avgParticleDiameter
//      (and box halfExtents 8x16x8) stay unchanged, Z shrunk to 54 (see those
//      files' headers for the full clearance derivation). This is exactly the
//      same domain box_density_showcase_gas.prm (the non-Bogner, real-gravity
//      combined version) already uses in X/Y (128x60); only Z differs (54 vs
//      180) for the same reason the per-density files shrunk it.
//
// LAYOUT (X positions/spacing copied directly from box_density_showcase_gas.prm,
// the pre-existing non-Bogner combined showcase -- same geometry, same
// clearances, just gravity/model/domain-Z changed):
//   • densityRatio 0.25: position (32, 30, 27)
//   • densityRatio 0.50: position (64, 30, 27)
//   • densityRatio 0.75: position (96, 30, 27)
//   32 LU apart in X; even fully rolled to 45 deg corner-down, the X-Z
//   cross-section's half-diagonal is 8*sqrt(2)~=11.3 LU, so worst-case
//   clearance between neighbours is 32 - 2*11.3 ~= 9.4 LU -- still clear.
//
// SEED HEEL -- reverted to Bogner's own literal 2.86 deg seed (was bumped to 5 deg earlier
// this session as an untested middle ground; see below for why 2.86 deg is now the better-
// justified choice instead).
//
// HISTORY: at the small 2.86 deg seed, densityRatio 0.25 sustained a real heel (converging
// toward -20 to -22 deg, undershooting Bogner's -26.565 deg prediction), but 0.5 and 0.75 both
// decayed straight back to ~0 deg upright and stayed there. A follow-up single-box run for 0.5
// with a 10 deg seed instead (box_density_050_bogner_domain_matched_bigheel_gas.prm) DID reach
// and hold Bogner's predicted 45 deg heel cleanly.
//
// WHY 2.86 deg AGAIN NOW: at the time of that history, useBognerBuoyancy=true (now renamed
// useMemOnlyBuoyancy) only ever bypassed the FORCE term -- computeSubmergedVolumesBox() (and
// therefore the analytic vSub/cbOff-derived righting torque) ran UNCONDITIONALLY every step,
// regardless of this flag. So every run above -- including the 2.86 deg failures -- had that
// extra analytic righting torque active on top of the raw MEM torque the whole time. Per
// Bogner's own theory (Fig. 7-9), upright is an UNSTABLE equilibrium for a symmetric rho=0.5
// cube -- any perturbation should eventually grow away from it under the raw MEM torque alone,
// not decay back. The observed decay-to-upright at 2.86 deg is therefore suspected to have been
// caused by that extra analytic torque adding a spurious restoring component (plane-fit noise is
// worst exactly at small tilt, where the submerged/emerged wedge is thinnest), not by 2.86 deg
// being an inherently insufficient perturbation.
//
// useMemOnlyBuoyancy now defaults to true AND skips computeSubmergedVolumesBox() entirely (no
// vSub, no cbOff, no righting torque at all -- torque is the raw MEM/hydrodynamic torque only,
// matching Bogner's Eq. 18 exactly), so this file's runtime behaviour actually changed even
// though useMemOnlyBuoyancy was already explicitly true in it before. With the suspected source
// of the spurious restoring torque now gone, Bogner's own literal 2.86 deg seed is the more
// faithful and better-justified choice -- UNTESTED under this exact code path. If 0.5/0.75 still
// settle upright at 2.86 deg even now, that would point elsewhere (e.g. the pinAxes<1,1,0>
// translation-pinning removing a real damping channel, flagged separately in changes.md) rather
// than the righting torque, and 10 deg remains a known-safe fallback (bump initialTiltAngleDeg
// back up if so). Also note: an unstable equilibrium diverges slowly from a very small initial
// perturbation before visibly accelerating away -- if 2.86 deg starts moving in the right
// direction but doesn't visibly reach 45 deg within timesteps=50000, that may just need more
// steps rather than a bigger seed.
//
// Domain: <128, 60, 54> / cellsPerBlock <32, 20, 9> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 9 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 54>;
   wavePeriods        1;
   liquidHeightFactor 1.68709;
   floorHeightFactor  1.68709;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants (surfaceTension) valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526
   gravityOverride        7.5e-4;      // matches Bogner's g
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // densityRatio 0.25 -> Fekken-predicted stable heel: 26.565 deg from upright.
      position             < 32, 30, 27 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.25;
      settlingSteps        0;
      initialTiltAngleDeg  2.86;   // Bogner's own literal seed heel, about the free Y axis (see header)
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation           true;
      pinRotationAxes      < 1, 0, 1 >;   // free roll about Y (XZ plane); pin pitch (X) and yaw (Z)
   }
   FloatingBox
   {
      // densityRatio 0.5 -> Fekken-predicted stable heel: 45 deg (marginal case). See header:
      // this 2.86 deg seed previously decayed to upright, but that was WITH the analytic
      // righting torque still active (now skipped by default) -- untested since that fix.
      position             < 64, 30, 27 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.5;
      settlingSteps        0;
      initialTiltAngleDeg  2.86;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation           true;
      pinRotationAxes      < 1, 0, 1 >;
   }
   FloatingBox
   {
      // densityRatio 0.75 -> Fekken-predicted stable heel: 26.565 deg from upright.
      position             < 96, 30, 27 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  2.86;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation           true;
      pinRotationAxes      < 1, 0, 1 >;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // no rhoHydStat subtraction at all (see header)
   useMemOnlyBuoyancy             true;   // (default) skips computeSubmergedVolumesBox() entirely -- no vSub,
                                          // no cbOff, no righting torque; force+torque are raw MEM only (see header)
   // NOTE: the three lines below are currently INERT with useMemOnlyBuoyancy=true, since
   // computeSubmergedVolumesBox() (the function they all configure) never runs in that mode.
   // Left set for when useMemOnlyBuoyancy=false is used instead (e.g. to A/B against this run).
   useAnalyticBoxBuoyancy        true;   // exact clip drives vSub/cbOff -> plane export + righting torque match it exactly
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for each box
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 45 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 45 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 45 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
