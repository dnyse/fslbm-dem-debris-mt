BedGeneration{
    // Thesis item 1b (MEM vs. analytical buoyancy comparison, THESIS_PLAN.md) -- scaling-reference bed
    // for the R=4 resolution level. See BedGeneration_buoyancy_r1.prm's own header for the full
    // derivation/rationale -- deliberately identical domainSize_SI/diameter_SI to R=1/R=2 (genuine
    // physical quantities, independent of lattice resolution); only the Antidunes-side domainSize/
    // cellsPerBlock (R=4: <192,192,384>/<64,64,48>) and this file's own outFileName differ.
    //
    // Predicted scalingFactor = 192/0.017409318 = 11030.35 (4x of R=1), predicted avgDiameter(LU) =
    // 32.0 (4x), predicted dx_SI = 0.00009066 (1/4x), predicted gravityOverride ≈ 3.33905e-07 (1/64x,
    // gravityOverride ∝ dx_SI^3). To be confirmed against the real generated
    // spheres_out_buoyancy_r4.dat, same as R=1/R=2.
    domainSize_SI < 0.017409318, 0.017409318, 0.034818636 >;
    blocks < 3, 2, 12 >;
    diameter_SI 0.0029015530199227404;
    gravity_SI 9.81;
    densityFluid_SI 1000;
    densityParticle_SI 2550;
    generationSpacing_SI 0.0034818636239;
    initialVelocity_SI 1;
    dt_SI 5e-5;
    frictionCoefficient 0.5;
    restitutionCoefficient 0.1;
    collisionTime_SI 5e-4;
    poissonsRatio 0.22;
    timeSteps 10000;
    visSpacing 100;
    outFileName spheres_out_buoyancy_r4.dat;
    denseBottomLayer False;
    bottomLayerOffsetFactor 1.0;
}
