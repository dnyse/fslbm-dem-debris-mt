// box_stability_curve_heel45_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// STABILITY CURVE (Bogner & Rude 2013, Fig. 5.4/5.5 methodology): one member of the
// box_stability_curve_heel{00,05,10,15,20,25,30,35,40,45}_gas.prm sweep. Same box
// geometry/domain as box_density_050_refined_gas.prm (Fekken [2004] cuboid, densityRatio
// 0.5 -- the b:h=4:4 SQUARE cross-section case, matching Fig. 5.5's "b:h=4:4" curve
// exactly), refined 1.5x resolution, shortened domain -- but instead of releasing the box
// from a small seed heel and letting it roll FREELY to its own stable equilibrium
// (box_density_050_refined_gas.prm's pinRotationAxes <1,0,1>), THIS file HOLDS the box at
// a FIXED heel angle (pinRotationAxes <1,1,1> -- ALL rotation pinned, zeroing angular
// velocity about every axis each DEM sub-cycle, so initialTiltAngleDeg never changes) while
// leaving Z translation free (pinAxes <1,1,0>) to find the buoyant depth AT that fixed
// angle. This is exactly the ParticleKernels.h [BoxRightingMoment] log's own documented
// intent (see the comment directly above that log line): "For a FIXED box held at heel a
// this is one point on the stability curve M(a); sweep a in [0,30] ... and compare to the
// ideal analytic curve." Once V_sub/Z has settled at this fixed angle, the logged
// [BoxRightingMoment] M_y/GZ is one (heelDeg, torque) point on the stability curve --
// collect all 10 sweep members' settled values to build the full Torque-vs-Heeling-Angle
// curve (Fig. 5.5-style plot).
//
// heelDeg = 45: one of the 10 sweep points (00/05/10/15/20/25/30/35/40/45) building the
// full Torque-vs-Heeling-Angle curve. Fekken predicts the box's OWN stable equilibrium at 45
deg for this densityRatio-0.5 marginal case -- expect M_y (the restoring torque) to trend
toward zero as heelDeg approaches 45, and to have the opposite sign on either side of it.
//
// timesteps 25000 (much shorter than box_density_050_refined_gas.prm's 300000): this sweep
// only needs Z-translation to settle at a FIXED angle, not the full free-rotation dynamics
// to converge to a self-found equilibrium -- a much faster process.
//
// Domain: <192, 90, 96> / cellsPerBlock <48, 30, 16> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 48, 30, 16 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <192, 90, 96>;
   wavePeriods        1;
   liquidHeightFactor 1.875;
   floorHeightFactor  1.625;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         25000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // 1x2x1 cuboid (halfExtents 12x24x12), long edge on Y (horizontal), densityRatio 0.5
      // (b:h=4:4 square cross-section, Fig. 5.5's cube case). HELD at heelDeg=45 the whole
      // run (pinRotationAxes <1,1,1>) -- Z free to find the buoyant depth at this angle.
      position             < 96, 45, 42 >;
      halfExtents          < 12, 24, 12 >;
      densityRatio         0.5;
      settlingSteps        0;
      initialTiltAngleDeg  45;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation           true;
      pinRotationAxes      < 1, 1, 1 >;   // ALL rotation pinned -- holds initialTiltAngleDeg fixed
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticBoxBuoyancy        true;   // exact clip drives the force -> plane export matches it exactly
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the box
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 44.25, 0 >;  max < 192, 45.75, 80 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;      max < 1.5, 90, 80 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;      max < 192, 90, 80 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
