// clog_measurement_validation_sanity_clog_pidoff_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Thesis item 3 (THESIS_PLAN.md): validates the new ClogMeasurementEvaluator (Evaluators.h) and the
// new PIDParameters.enabled constant-forcing flag (Forcing.h), NOT yet item 4's real clogging
// scenarios -- this is a cheap sanity check that the tool correctly distinguishes a clogged vs. open
// channel, on the smallest setup that can actually produce an unambiguous clog.
//
// SANITY-CLOG, PID DISABLED (constant-forcing/fixed-hydraulic-gradient mode): identical to the PID-enabled sanity-clog file above except PIDParameters.enabled=false -- acceleration[0] stays pinned at its setupSimState-computed initial value for the whole run (Forcing.h's ForcingAdjuster). Expect the same clog signal on clogUpstream*/avgParticleTransportRate, but with meanVelocity now visibly dropping as the blockage develops (since nothing compensates), and acceleration[0] logged as bit-for-bit constant throughout -- this pair is what actually validates the new PIDParameters.enabled flag end-to-end.
//
// [Claude, 2026-09-14]: first release moved from t=5000 to t=20000, timesteps extended 35000 -> 56500
// -- same fix and rationale as the PID-on file's own header comment (flow not spun up by t=5000, per
// THESIS_PLAN.md item 3's meanVelocity_x check).
//
// Domain <384, 40, 90>: X elongated to 3x the widest existing two-pillar toy domain (160,
// box_sedimentation_showcase_analytical_125floaters_realgravity_twopillars_flow_gas.prm) so the
// piers' backwater bump has room to decay before wrapping back around through the periodic X
// boundary and contaminating the upstream probe, and so upstream spheres have real queueing room to
// accumulate into a jam rather than bouncing off the piers once. periodicity <1,0,0> (X periodic for
// the recirculating current, Y walled for the piers, matching every existing two-pillar scenario).
//
// Two CylinderPillars, radius 6, at Y=11/29 (spacing 18) -- gap =
// 18 - 2*6 = 6 LU, deliberately SMALLER than one sphere's own diameter
// (8.001943372119138 LU, avgParticleDiameterOverride below) so a single sphere physically cannot pass
// through -- guarantees a clog as soon as debris reaches the gap (the existing *_slitpass_gas.prm
// family deliberately does the OPPOSITE -- a pass-through gap wider than a floater -- so this is a
// new, deliberately-narrower geometry, not a reuse of that family's own gap sizing).
//
// liquidHeightFactor 2.0 (lower than the ~2.862 toy default) reuses this project's own precedented
// "low-water" convention (test_bridge_v1_lowwater_bigjam_gas.prm) -- less freeboard means floaters
// can't simply glide over/around the pier gap with excess vertical room, which a production-scale
// run this session found let debris slip past almost without clogging at the standard freeboard.
// domainSize.z halved to 90 to match (same pairing that file's own header uses), which is also a
// direct performance win (fewer Z cells per rank).
//
// targetMeanVelocityMagnitude 0.04 is roughly double the highest value used in this project's other
// toy/showcase scenarios (0.005-0.02) -- deliberately higher so the flow actually drives spheres into
// the gap hard enough to jam rather than settling gently against the piers. useHardcodedUnits=false
// (NOT true) is required at this non-standard target velocity: thousand_cuboids_two_pillars_
// slitpass_gas.prm's own header documents a real physics bug from exactly this combination --
// useHardcodedUnits=true freezes viscosity/gravity/surfaceTension at values calibrated for a
// DIFFERENT specific target velocity, silently mismatching gravity/We/Fr (they scale with U^2) to
// this scenario's own actual target. false lets them be dynamically re-derived correctly.
//
// avgParticleDiameterOverride/dxSIOverride reuse this project's own established floater-only-scenario
// shortcut (SimulationParams.h; same exact values already used in
// box_sedimentation_showcase_analytical_125floaters_realgravity_twopillars_flow_gas.prm) rather than
// generating a new BedGeneration file -- appropriate here since useParticleBed=false means no real
// bed is ever placed, only the SI scaling constants matter, and this is a cheap tool-sanity-check
// scenario (not a resolution/physics comparison needing a freshly generated bed like item 1b's own).
//
// ClogMeasurement probes: upstream X=140 (between the release zone ~X=80-110 and the piers at
// X=192, so it reads the true backed-up water level, not the individual spheres' own local
// splash) and downstream X=250 (58 LU past the piers). Both far from the periodic seam either way
// (140 and 250 from a seam effectively at X=0/384, plus 384-250+140=274 LU around the OTHER way --
// both far larger than the ~50-150 LU local disturbance scale expected here).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <384, 40, 90>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     false;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         56500;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see file header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 192, 11, 45 >; radius 6; }
   CylinderPillar { center < 192, 29, 45 >; radius 6; }
}
FloatingSpheres
{
   FloatingSphere { position < 80, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 20000; startInactive true; }
   FloatingSphere { position < 90, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 21500; startInactive true; }
   FloatingSphere { position < 100, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 23000; startInactive true; }
   FloatingSphere { position < 110, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 24500; startInactive true; }
   FloatingSphere { position < 80, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 26000; startInactive true; }
   FloatingSphere { position < 90, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 27500; startInactive true; }
   FloatingSphere { position < 100, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 29000; startInactive true; }
   FloatingSphere { position < 110, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 30500; startInactive true; }
   FloatingSphere { position < 80, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 32000; startInactive true; }
   FloatingSphere { position < 90, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 33500; startInactive true; }
   FloatingSphere { position < 100, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 35000; startInactive true; }
   FloatingSphere { position < 110, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 36500; startInactive true; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 140, 20, 40 >;
      downstreamPos      < 250, 20, 40 >;
      probeHalfWidthXY   2;

      // Second probe pair at the pillar's own Y (=11, the left CylinderPillar's own centre --
      // matching that pillar's X=192, radius=6 footprint) instead of the gap centreline (Y=20) --
      // per Schalko, Follett & Nepf (2023), Water Resources Research, a lateral-gap logjam study
      // found real lateral variation (~7.5%) in water depth between a partial-width obstruction's
      // own blocked-flow region and the open gap beside it; the pillar-face location is where the
      // strongest backwater pile-up is actually expected. Same X/Z as the gap probes for a direct,
      // like-for-like comparison -- only Y differs.
      pillarUpstreamPos    < 140, 11, 40 >;
      pillarDownstreamPos  < 250, 11, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // [Claude, 2026-09-17]: added BodyBC entries for the CylinderPillars above -- traced every single
   // usage of simParams->cylinderPillars in this codebase (BuildTimeloop.h's own disabled #if 0 VTK
   // block; SetupStages.h's bed-generation exclusion check; SetupStages.h's own createCylinder DEM
   // rigid-body creation) and confirmed NONE of them ever touch the LBM flag field/boundary handling --
   // CylinderPillars only gives the pillar DEM contact physics (floaters bounce off it), it does NOT by
   // itself make the fluid see it as solid. The actual fluid-blocking NoSlip classification comes
   // exclusively from here, via setupBoundaryHandling's initFromConfig(BoundaryParameters) (see that
   // function's own "CellInterval pillar defined in Antidunes.prm" comment) -- confirmed against
   // nine_stacked_release_pillar_gas.prm, which declares BOTH CylinderPillars (contact) AND matching
   // BodyBC (fluid) for its own two pillars; this file previously had only the former.
   BodyBC { shape Cylinder; min < 192, 11, 0 >; max < 192, 11, 90 >; radius 6; NoSlip{} }
   BodyBC { shape Cylinder; min < 192, 29, 0 >; max < 192, 29, 90 >; radius 6; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// [Claude, 2026-09-16]: writeFrequency dropped from disabled (1e10) to timesteps/5 so this run
// produces exactly 6 sparse VTK dumps (steps 0, 11300, ..., 56500) -- fluid_field, sphere, and
// cylinder_pillar VTK all share this same simParams->vtk.writeFrequency (see BuildTimeloop.h), so
// one setting gives synchronized fluid+floater+pillar snapshots for thesis figures, cheaply.
VTK
{
   fluid_field
   {
      writeFrequency       11300;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // [Claude, 2026-09-17]: without this, gas AND obstacle cells (the pillars) retain
      // whatever stale PDF-derived velocity/density last happened to be there (never updated by
      // the solver, since "the PDF values in these cells are not important" -- VtkWriter.h's own
      // comment), rendering as salt-and-pepper noise across the free-surface/gas region AND
      // making the pillars indistinguishable from the noisy fluid in ParaView -- found directly
      // from a screenshot showing exactly this on the completed extreme pidoff/pidon runs
      // (jobs 4240981/4240982), which never had this line, unlike every other scenario prm in
      // this project (e.g. nine_stacked_release_pillar_gas.prm).
      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
