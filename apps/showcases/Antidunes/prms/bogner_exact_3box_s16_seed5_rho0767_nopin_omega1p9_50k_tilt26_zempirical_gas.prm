// bogner_exact_3box_s16_seed5_rho0767_nopin_omega1p9_50k_tilt26_zempirical_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] Follow-up to the step-444 deterministic-crash investigation (THESIS_PLAN.md):
// releasing the box AT EXACTLY the theoretical equilibrium (26.565deg, zero seed transient) crashes
// 7/7 times with normal VTK output (writeFrequency 2000 or any value that doesn't land a write on
// EVERY step from 401-443), and only survives with genuine every-step VTK output. This tests whether
// that instability is specific to the EXACT 26.565deg release, or whether angles close to it (but not
// exactly on it) hit the same thing: seeded at 26deg here (near, not exact). Same density (0.7665),
// same omega (1.9), normal VTK (writeFrequency 2000, mid-width plane) -- run alongside the 25deg
// sibling on another checkout.
//  * Everything else byte-identical to the tilt26p565 50k prm this is copied from: basin 130x40x40,
//    ONE box halfExtents<8,16,8> at rho=0.7665, tau=1/1.9, gravityOverride 0.00075, fully free 6-DOF.
//  * Domain 130x40x40 / cellsPerBlock <10,8,40> = 13x5x1 = 65 processes; 50000 timesteps, VTK every 2000.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;          // Bogner's tau = 1/1.9 = 0.526; lower omega = more viscous damping (Bogner's own value)
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 20, 16.6328 >;   // [Claude, 2026-09-24] EMPIRICAL start: this is exactly where job 4261350 (released at the pure geometric ideal, z_centre=16.1659) ended up at step 50000 (tiltY there was 26.5646deg, essentially the theoretical target) -- testing whether starting AT this empirically-observed point holds steady, or whether it is itself just one point along a continuing orbit rather than a genuine stable equilibrium.
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.7665;
      settlingSteps        0;
      initialTiltAngleDeg  26;   // near, but not exactly at, the theoretical 26.565deg equilibrium
      comOffsetZ           0;
      pinPosition          false;         // fully free (6 DOF)
      pinRotation          false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;   // explicitly OFF: no analytic buoyancy in this experiment
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   dataSliceFrequency      500;   // avoid the job 4255656 vault file-count quota bug
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
         density;
      }

      // one mid-width plane (the boxes' cross-section is in X-Z)
      CellBB_filter_0 { min < 0, 20, 0 >;  max < 130, 21, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
