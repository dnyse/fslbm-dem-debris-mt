// cuboid_stillwater_realgravity981_3xsphere_hires_d050_diag_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-17] DIAGNOSTIC RESUME for job 4240983's own crash: a quaternion-normalization
// assertion failure (Quaternion.h:241, r*r+i*i+j*j+k*k=-nan) on the box floater at step ~91960/100000,
// preceded by a [DRY-LINK] non-finite pdf_old at cell (2,0,10) (local) starting at step 91739 --
// the FIRST sign of any corruption anywhere in the whole 91739-step log, with no earlier LOW-RHO,
// DRY-LINK, or precursor warning of any kind. This is the same unexplained-first-occurrence NaN class
// already investigated at length for the extreme-clog scenario (THESIS_PLAN.md, 2026-09-14 entries):
// [DRY-LINK] firing is a pre-existing, intentional SimpleBB.h safety guard (not itself a bug) that
// correctly skips a non-finite obstacle-link PDF read rather than propagating it -- the real question
// is why the underlying interface cell's own PDFs went non-finite in the first place, one level
// upstream of this guard.
//
// Rather than re-running 91739 steps from scratch, this resumes job 4240983's own last checkpoint
// (t=90000, snapshotFrequency=10000, still on disk in build/apps/showcases/Antidunes/snapshots/ since
// the job crashed before its own archive-move step ran) with denseNanScanEnabled bracketing the known
// crash window (91000-92500, with margin on both sides of the 91739/91960 events) plus both
// precursor thresholds, following the exact same diagnostic pattern already established and verified
// for the d025 family's own "diag" resume (cuboid_stillwater_realgravity981_3xsphere_hires_d025_diag_gas.prm).
// storeSnapshot left OFF so this diagnostic run cannot disturb that checkpoint. Otherwise
// byte-for-byte identical to cuboid_stillwater_realgravity981_3xsphere_hires_gas.prm (the d050 file).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 17, 42, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  true;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <119, 168, 150>;
   wavePeriods        1;
   liquidHeightFactor 9.9681;
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              92500;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // keep physical constants valid while U = 0; viscosity=0.000214026 fixed
   gravityOverride        2.6596472613474883e-05;  // solved for g_SI = 9.81 m/s^2 at this resolution's dx_SI/dt_SI (see header)
   denseNanScanEnabled    true;
   denseNanScanFromStep   91000;
   denseNanScanToStep     92500;
   lowRhoPrecursorThreshold 0.1;
   highVelocityPrecursorThreshold 0.4;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 3;   // scaling-math lever only (useParticleBed false) -- see sphere sibling's header
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // densityRatio 0.5 -> Archimedes equilibrium: 50% submerged.
      position             < 59.5, 84, 75 >;
      halfExtents          < 18.59375, 37.1875, 18.59375 >;
      densityRatio         0.5;
      settlingSteps        0;
      initialTiltAngleDeg  5;
      comOffsetZ           0;
      pinPosition          false;   // fully free
      pinRotation          false;   // fully free
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       0;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         density;
         fill_level;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 84, 0 >;   max < 119, 85, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 168, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 119, 168, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
