// cuboid_stillwater_realgravity981_3xsphere_d075_pass3_gas.prm
// PASS-3 VARIANT of cuboid_stillwater_realgravity981_3xsphere_d075_gas.prm -- identical in every
// other respect (smaller 30x60x30 s x 2s x s shape already in place here, same real-gravity
// g_SI=9.81 that originally crashed at step 18000 with the OLD 48x60x48 shape, same domain
// <96,135,120>). The only change: usePass3Reresolution true.
//
// Context: the reproducibility "asis" rerun of this exact config (job 4038344) already used
// this smaller shape at Pass 3 OFF and completed cleanly (no [LOW-RHO]) -- so this run is not
// expected to reproduce a crash either. Its purpose is to check whether enabling Pass 3
// (re-resolving FormerMO cells that fell back to interface on Pass 2 due to same-pass
// neighbour ambiguity -- PdfReconstructionManager.h, usePass3Reresolution, SimulationParams.h:439)
// changes anything about the settling trajectory or reconstruction diagnostics
// ([FORMERMO-CONVERT]/[PASS3-...] log lines) relative to the Pass-3-off baseline.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 45, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 135, 120>;
   wavePeriods        1;
   liquidHeightFactor 9.9681;
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // keep physical constants valid while U = 0; viscosity=0.000214026 fixed
   gravityOverride        5.06585e-05;  // solved for g_SI = 9.81 m/s^2 (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 3;   // scaling-math lever only (useParticleBed false) -- see sphere sibling's header
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // densityRatio 0.75 -> Archimedes equilibrium: 75% submerged.
      position             < 48, 67.5, 60 >;
      halfExtents          < 15, 30, 15 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  5;
      comOffsetZ           0;
      pinPosition          false;   // fully free
      pinRotation          false;   // fully free
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
   usePass3Reresolution           true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 67, 0 >;   max < 96, 68, 120 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 135, 120 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 96, 135, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
