// DropTest_hopper_cyl_repro_gjk_gas.prm  (assembled by Claude to reproduce job 4255679's crash mechanism locally)
// ─────────────────────────────────────────────────────────────────────────────
// Fluid-free (DropTest.cpp) local reproduction of job 4255679 (antidunes-hopper-clog-cyl-halfrows-gjk-noguards-60k):
// the SAME rod geometry (r=3, L=18), Z-layer/density stratification, Y-column spacing, and pillar/gap geometry as
// the real hopper (gen_hopper_clog_cyl_prm.py, exact same algorithm/spacing, just --rows 4 instead of 29 and a
// smaller domain X/Z so it fits a single local rank), the SAME contact-model settings (useAnalyticalContactDetection
// false = GJK/EPA only, useTightLayer1 true, useRotationalEffectiveMass true, useContactFilterOwnerTiebreak true,
// collisionTimeFactor default 4, avgParticleDiameterOverride/numSubCycles identical), and the SAME real gravity
// value (5.82575e-05, read directly from the crashed run's own archived eval/computedParams.txt) and simultaneous
// mass release (ALL 56 rods share settlingSteps=200 -- the real run also released all 210 rods at the SAME step,
// 2000, not staggered; this is the key difference from the earlier "wave release" hopper scenarios and a likely
// contributor to the violent, chaotic multi-body impact this test is trying to reproduce).
//
// Deliberate deviations from the real run (all disclosed): (1) only 4 of 29 rows (56 of 210 rods) -- a small local
// slice near one pillar, not the whole channel; (2) hold=200 steps instead of 2000 (irrelevant to the post-release
// dynamics, just less wasted wall-clock before release); (3) each rod's initial axis is given a small random tilt
// (<=2 deg, seed 20260923; an earlier <=6 deg attempt ate enough of the generator's own clearance margin to trigger
// a hard [RELEASE-OVERLAP] abort at step 201, so this was reduced) instead of being perfectly axis-aligned -- a
// real pile is never perfectly ordered, and
// this session's own earlier CylinderTippingRodJamTest.cpp/RodSpinSubstepResolutionTest.cpp analysis (of the exact
// two culprit UIDs from job 4255679's own [CylForces]/[CylTorque] log) already showed GJK/EPA tracks the true
// overlap correctly and that a genuinely bursty (non-uniform) rotation, not a smooth topple, is needed to explain
// the observed force spike -- small initial-angle diversity is what would plausibly seed that kind of asymmetric,
// bursty collapse in a real multi-body drop; (4) no fluid (DropTest is DEM-only) -- the real run's MEM hydrodynamic
// drag/added-mass and PID-driven cross-flow are absent, so this can only test the DEM/contact side of the
// mechanism, not confirm or rule out a fluid contribution.
//
// Diagnostics enabled at FINE granularity (evaluationFrequency 10, not the real run's 100) specifically so a fast
// rotation burst, if one occurs, is actually caught in the [CylForces]/[CylTorque] log this time, plus
// logFloaterHistory (full per-step position/quaternion CSV, NOT enabled in the real crashed run) and
// logContactAnomalies, so a repro -- if it happens -- leaves the exact quaternion trace the real crash lacked.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 70, 40, 70 >;  // 2x1x1 = 2 processes
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             500;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <140, 40, 70>;
   wavePeriods        1;      // unused -- required by parser
   liquidHeightFactor 2.5;    // unused -- required by parser
   floorHeightFactor  4.1393; // unused -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         3000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   5.82575e-05;  // EXACT value from job 4255679's own archived eval/computedParams.txt
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                1.0;             // unused -- per-rod densityRatio set individually below
   fixingHeightFactor          1.5;
   frictionCoefficient         0.5;   // matches the real hopper prm
   restitutionCoefficient      0.5;   // matches the real hopper prm
   numSubCycles                10;    // matches the real hopper prm exactly
   useLubricationCorrection    true;  // matches the real hopper prm
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8.001943372119138;   // EXACT value from the real hopper prm
   dxSIOverride                0.000362694127490625; // EXACT value from the real hopper prm
}

CylinderPillars
{
   // axes ON the Y walls: half of each cylinder lies outside the domain (harmless). Z is an arbitrary reference point on the vertical axis.
   CylinderPillar { center < 70, 0, 45 >; radius 12; }
   CylinderPillar { center < 70, 40, 45 >; radius 12; }
}
