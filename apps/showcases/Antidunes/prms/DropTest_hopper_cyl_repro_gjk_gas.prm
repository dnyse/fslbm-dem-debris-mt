ModelParameters
{
   useAnalyticalContactDetection false;   // Cylinder x Cylinder: GJK/EPA ONLY -- matches job 4255679 exactly
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;  // REQUIRED true -- see DropTest.cpp's own header comment

   // [Claude] logFloaterHistory=true/logContactAnomalies=true crashed at step 0 with "BlockData access
   // type violation" (IBlock.h:101) in this DropTest-only prm -- an untested code path (the proven
   // DropTest_kodam_packing_gas.prm keeps both false too), not something this investigation should
   // spend time debugging. Falling back to both false; fine per-step diagnosis instead comes from
   // evaluationFrequency=10 below (CylForces/CylTorque/tiltY every 10 steps, not the real run's 100).
   logFloaterHistory              false;
   logFloaterHistoryStartStep     0;
   logFloaterHistoryEndStep       3000;
   logContactAnomalies            false;
   contactAnomalyStartStep        0;
   contactAnomalyEndStep          3000;
   useHydrodynamicForceTimeAveraging true;
}

EvaluationParameters
{
   performanceLogFrequency 500;
   evaluationFrequency     10;
   baseFolderName          eval;
   logContactDetectionStatsPeriodically true;
}

VTK
{
   fluid_field
   {
      writeFrequency       500;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
