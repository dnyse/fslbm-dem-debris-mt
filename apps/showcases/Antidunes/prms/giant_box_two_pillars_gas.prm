// giant_box_two_pillars_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// The giant_sphere_gas scenario with the sphere SWAPPED for the giant box:
// one giant floating log (edgeLength 12×36×12, halfExtents <6,18,6>, 1:3:1 ratio,
// the box analog of the giant sphere) placed with its bottom at the free surface
// and released to settle, with the two cylinder pillars positioned to clear it.
//
// Physics:
//   • densityRatio=0.5 → equilibrium at half-submerged (centre ≈ z=56).
//   • Starting with the bottom exactly at the surface (centre z=62, hz=6) rather
//     than dropping from height avoids slamming the surface at speed (the contact-
//     line NaN seen with the giant sphere).
//   • settlingSteps=500: contact line establishes while the box is held fixed,
//     then it is released to settle to the 50% equilibrium depth.
//   • GM<0 (roll about Y) → the log rolls; initialTiltAngleDeg=5 seeds it.
//
// Placement:
//   • position (30, 30, 62): centred in Y (y=[12,48], ≈12 LU from each NoSlip
//     wall when axis-aligned), left-of-centre in X (X is periodic).
//   • At the start the box (max x≈36) is far upstream of the pillars (faces at
//     x=56); it drifts downstream with the driven flow toward them.
//   • Circumscribed half-diagonal ≈ 19.9 LU ≈ giant-sphere radius 20.
//   • Body spans 2+ blocks (block min dim = 20) → setup auto-selects SyncGhostOwners.
//
// Cylinder pillars — same geometry as the giant_sphere case:
//   Pillar 1: center (64, 15, 90), r=8
//   Pillar 2: center (64, 45, 90), r=8
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Cylinder pillars — same geometry as the giant_sphere case.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingBoxes
{
   FloatingBox
   {
      // GIANT log: edgeLength 12×36×12 (halfExtents 6×18×6), 1:3:1 ratio, the box analog
      // of the giant sphere (radius 20). Centre (30,30,62): bottom at z=56 = surface, 0%
      // submerged at t=0; released after settlingSteps to settle to 50% submerged.
      // initialTiltAngleDeg=5 about Y seeds the rolling instability (GM<0).
      position             < 30, 30, 62 >;
      halfExtents          < 6, 18, 6 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  5;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
