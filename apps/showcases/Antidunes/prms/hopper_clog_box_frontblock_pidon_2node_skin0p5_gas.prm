ModelParameters
{
   useAnalyticalContactDetection true;   // Box x Box: exact SAT
   usePureAnalyticalCylinder     false;  // no-op (no cylinders present); kept for an exact diff against the cylinder prm
   useContactFilterOwnerTiebreak true;   // one rank accepts each boundary-straddling contact (min owner rank)
   boxContactSkin                0.5;   // [Claude, 2026-10-01] box contact skin in LU (box analog of cylinderContactSkin, cd1b991b): box-box contact starts at a surface gap of 1, box-wall/pillar at 0.5. Sealed-cell guard stays off (not set below).

   // Experimental contact/buoyancy fixes: same baseline as the cylinder hopper
   useTightTier1                 false;
   useTightLayer1                true;   // no-op for Box x Box (cylinder-specific pre-filter); kept for an exact diff
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;   // same as the cylinder hopper (generalised effective mass incl. rotational inertia)
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // Fluid-blocking counterparts of the CylinderPillars (full height); Y walls get NoSlip automatically (non-periodic Y).
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// [Claude, 2026-10-01] DISCRETE snapshot steps (per explicit request: "use the custom vtk output
// timesteps do 500 1000 2000 4000 8000 16000 32000 49000 for the total 50000 timesteps"): the
// uniform fluid_field block's writeFrequency is set to 0 (disabled) and superseded by the
// fluid_field_snapshots mechanism below (SimulationParams.h VTKParams::snapshotsEnabled, gated in
// VtkWriter.h's addVTKOutput), which fires ONLY on the exact listed steps. Per-box/pillar point
// data (createVTKOutput_PointData calls in BuildTimeloop.h) now ALSO follows this same step list
// (addSnapshotAwareVTKWrite, added 2026-10-01) rather than needing a separate mechanism -- both the
// fluid field and every floater/pillar VTK writer dump at exactly these 8 steps, nothing in between.
// Fluid cropped to X 128..640, Z 0..100 (boxes/pillars unfiltered).
VTK
{
   fluid_field
   {
      writeFrequency       0;             // superseded by fluid_field_snapshots below (discrete steps, not uniform)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 128, 0, 0 >;  max < 640, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   fluid_field_snapshots
   {
      writeFrequency       1;   // unused by the gating logic itself, required by vtk::initializeVTKOutput
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "500,1000,2000,4000,8000,16000,32000,49000";

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 128, 0, 0 >;  max < 640, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
