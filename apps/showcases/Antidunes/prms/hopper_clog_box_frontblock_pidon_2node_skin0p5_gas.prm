// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-10-01] SKIN-ADAPTED PRODUCTION RUN: boxContactSkin 0.5 added (box analog of cd1b991b's cylinderContactSkin, box-box contact threshold a surface gap of 1 LU, box-wall/pillar 0.5 LU), sealed-cell guard left off, run alongside the same skin fix applied to the cylinder version of this exact hopper (hopper_clog_cyl_frontblock_pidon_2node_skin0p5_gas.prm). The original/default --pitch=7.0 placed adjacent rows exactly 1.0 LU apart surface-to-surface -- precisely 2*skin -- which the pre-existing [RELEASE-OVERLAP] release-time guard mistook for an insertion-overlap bug in the cylinder version (job 4282206, failed in 97s); the box version shares the same row geometry so the same fix applies pre-emptively here. Regenerated with --pitch 8.0 instead (real box-box gap now 1.52 LU, comfortably above 2*skin=1); every clearance (box-box, box-Ywall, box-floor, box-pillar) is asserted against its own skin threshold by this script (see the --skin argparse help and the asserts right after minsep/pillar_gap above). Box geometry/count/densities are otherwise byte-for-byte identical to the un-skinned 406-box original -- only the row pitch changed, same approach as the cylinder version (widen the gap, don't shrink the boxes, per explicit instruction).
// hopper_clog_box_frontblock_pidon_2node_skin0p5_gas.prm   (GENERATED by gen_hopper_clog_box_prm.py -- edit the script, not this file)
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-30] "HOPPER" CLOGGING SETUP, BOX VERSION -- shape-comparison companion of
// gen_hopper_clog_cyl_prm.py's own cylinder hopper (the crash chased at length in THESIS_PLAN.md,
// section 5 / the doubling-in-X ghost-ownership desync investigation). IDENTICAL channel, pillars,
// PID, population grid (positions/densities/counts) and ModelParameters to the cylinder version;
// every FloatingCylinder is replaced 1:1 by a FloatingBox of the SAME bounding footprint
// (halfExtents <3,9,3>). Two cylindrical pillars centred on the Y walls (X=384,
// radius 12, central gap 16 LU) -- but the debris are CUBOIDS, half-extents <3,9,3>
// (6x18x6 full size, the sphere's 6 LU cross-section), LONG AXIS ALONG Y (across
// the channel), released together from a block pressed against the pillars.
//
// KEY GEOMETRIC FACT: the box's Y-extent 18 is LONGER than the 16 LU gap. A box lying along Y
// therefore cannot pass the gap broadside: it has to rotate towards the flow -- same constraint as the cylinder version.
//
// POPULATION: 406 boxes = 2 across Y x 7 layers x 29 rows in X (pitch X/Y/Z = 8/20/7.52,
// >= 1 LU surface clearance box-box / wall / floor, checked via exact AABB distance). densityRatio {0.5,1.0,1.2} =
// 116/174/116, stratified by height exactly as the cylinder version (1.2 low, 1.0 mid, 0.5 in the
// top two layers; the top layer's centre sits at the waterline Z=49.13, half submerged).
// Block X in [141.0,371.0], front row 1.04 LU (surface to pillar surface) from the pillar cylinders.
// All boxes are held FIXED for 2000 steps (settlingSteps, no startInactive) and then released together.
//
// CONTACT MODEL: useAnalyticalContactDetection true (Box x Box = SAT, exact for convex polyhedra) +
// useContactFilterOwnerTiebreak true; every experimental contact/buoyancy fix explicitly OFF, matching
// the cylinder hopper's own baseline (useRotationalEffectiveMass true, useTightLayer1 true -- the
// latter is a cylinder-specific pre-filter, a no-op with zero cylinders present, kept only for an
// exact side-by-side diff against the cylinder prm). Friction/restitution as in the cylinder hopper
// (0.5 / 0.5). FLOW/UNITS: identical (PID on, target 0.04, water Z=49.13, Z=180 headroom,
// <768,40,180> / <64,20,30> = 144 ranks / 2 nodes).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
