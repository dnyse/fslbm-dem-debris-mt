// cylinder_stillwater_analytic_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Direct A/B partner of cylinder_stillwater_gas.prm — IDENTICAL scenario (one floating cylinder,
// radius 7, length 44, axis along Y, densityRatio 0.5, started partly submerged at t=0, no flow,
// no pillars), single variable changed: useAnalyticBoxBuoyancy true.
//
// cylinder_stillwater_gas.prm (12³ Cartesian-grid sampling clip, the only method available for
// cylinders until now) showed a spurious, unphysical roll drift: tiltY grew from a 0° seed to a peak
// of about -4.9° (75000 steps, partial-start) and, in the drop-from-above variant with 100000 steps,
// to a peak of about -19.9° before partially recovering — for a truly axisymmetric body that should
// have NO preferred roll angle about its own axis. The suspected cause: the fixed axis-aligned sample
// grid is not rotationally invariant when clipped to a circle, so vSub/the buoyancy-centre offset pick
// up a small orientation-dependent bias that compounds via the righting-moment feedback.
//
// clipCylinderAnalytic() (ParticleKernels.h) replaces that sampling grid with a closed-form disk∩plane
// volume + centroid (same role as clipBoxAnalytic for boxes, exact for any plane tilt, no sampling) —
// exact for any plane orientation, and by construction has NO grid-alignment dependence, so it should
// be immune to this specific bias. useAnalyticBoxBuoyancy true selects it for BOTH the box and cylinder
// path (despite the flag's name — see ParticleKernels.h comments).
//
// Watch [BoxBuoyancy] shape=CYLINDER method=ANALYTIC, tiltY (should stay near 0°, not drift), and
// submersion (should converge to ~50%, matching densityRatio 0.5) — compare directly against the
// method=SAMPLING baseline run.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         75000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // True log: radius 7, length 44, axis along Y (spanwise). Centre (64,30,62): partly
      // submerged at t=0 (surface z≈56) → settles gently to the half-submerged equilibrium.
      // No tilt seed needed — the circular cross-section is roll-neutral.
      position             < 64, 30, 62 >;
      radius               7;
      length               44;
      axis                 < 0, 1, 0 >;
      densityRatio         0.5;
      settlingSteps        0;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticBoxBuoyancy        true;   // the fix under test — exact disk∩plane clip, box AND cylinder
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
