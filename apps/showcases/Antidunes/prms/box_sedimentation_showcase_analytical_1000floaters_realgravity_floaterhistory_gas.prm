// box_sedimentation_showcase_analytical_1000floaters_realgravity_floaterhistory_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// DIAGNOSTIC VARIANT of box_sedimentation_showcase_analytical_1000floaters_realgravity_gas.prm,
// identical scenario otherwise. This scenario reproducibly crashes (jobs 4106364, 4112811, same
// signature both times: a [LOW-RHO] rho->NaN cascade in FSLBM interface cells around t~650-840s
// that feeds a NaN hydrodynamic force/torque into a floater, aborting on the invalid-quaternion
// assertion). Turned on here: ModelParameters.logFloaterHistory (per-rank floater-history/
// rank_<N>.csv + rank_<N>_state.csv, the latter now carrying a fluidDensity column sampled at
// each floater's position, see ParticleKernels.h's sampleFluidDensityAt) and VTK "density" (fluid
// density field, same quantity, viewable in ParaView) added to the fluid_field writers -- both
// aimed at seeing whether the density collapse is spatially/temporally correlated with a specific
// floater's position, or purely an FSLBM-internal instability. writeFrequency left at the
// original 1000 (NOT lowered) -- an earlier attempt at writeFrequency 100 combined with
// logFloaterHistory's per-subcycle CSV blew the 100GB home quota (48GB from floater-history alone
// by step 3100) before reaching the crash window at all; the per-subcycle state CSV already gives
// far finer time resolution than any sane VTK frequency could for this scenario's ~23-step-wide
// cascade, so VTK's job here is spatial context near a dump, not catching the event live.
//
// GENUINE 10x10x10 GRID (1000 floaters) sibling of
// box_sedimentation_showcase_analytical_125floaters_realgravity_gas.prm, same box size
// (halfExtents <3, 9, 3>), same real Y-neighbour-contact design (not the single-Y-position v6
// approach), same true g_SI=9.81 gravity. Domain scaled up proportionally in X and Y (160,160 ->
// 320,320) to give the same 32 LU column/row spacing for 10 positions each instead of 5; Z is
// UNCHANGED (180) since 10 rows at the same 11 LU spacing (64..163) still fit with 14 LU headroom
// to the ceiling. cellsPerBlock scaled proportionally too (40,40,20 -> 80,80,20), so the process
// count stays IDENTICAL at 144 (4x4x9) -- no new node/core budget needed versus the 125-floater run.
//
// SCALING: same avgParticleDiameterOverride/dxSIOverride as the 125-floater file (both decoupled
// from domain size by design -- see that file's own header for the full derivation) --
// avgParticleDiameter=8.001943372119138, dx_SI=0.000362694127490625, giving the identical
// liquidHeight=22.9016, floorHeight=33.1224, absoluteLiquidHeight=56.024 as every sibling in this
// family.
//
// GRAVITY: true g_SI=9.81 m/s^2, gravityOverride=2.1371500584054327e-05 -- IDENTICAL value to the
// 125-floater file (same dx_SI/dt_SI, since domain height Z and the override scaling didn't
// change). Eq. 10 (Buick & Greated 2000) incompressibility check: domainHeight(180) *
// gravityOverride = 0.00385, still far under the required <<1/3 -- stable.
//
// GEOMETRY: X = 16/48/80/112/144/176/208/240/272/304 (10 columns, spacing 32, same convention as
// the 125-floater file), Y = same 10 values (same spacing), Z = 64/75/86/97/108/119/130/141/152/163
// (10 rows, spacing 11, same clearance convention -- top row's box edge sits at Z=166, 14 LU below
// the domain ceiling at 180). 10x10x10 = 1000 boxes total.
//
// Densities: 5 distinct values, each assigned to TWO columns (columns 1&6, 2&7, 3&8, 4&9, 5&10) for
// statistical redundancy -- 0.5, 0.75, 1.0, 1.5, 2.0 -- rather than spreading into 10 distinct
// values; each density gets 2 columns x 10 Y-positions x 10 Z-rows = 200 floaters.
//
// Domain: <320, 320, 180> / cellsPerBlock <80, 80, 20> = 4x4x9 = 144 processes (2 nodes, multinode
// partition, IDENTICAL resource footprint to the 125-floater run).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 80, 80, 20 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <320, 320, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;               // keep fixed reference viscosity/relaxationRate; only gravity overridden below
   gravityOverride   2.1371500584054327e-05;  // true g_SI=9.81 m/s^2 -- see header derivation
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
   avgParticleDiameterOverride 8.001943372119138;  // see header -- matches the family's own scale
   dxSIOverride                0.000362694127490625;
}

