   FloatingBox { position < 304, 272, 141 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
   FloatingBox { position < 304, 272, 152 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
   FloatingBox { position < 304, 272, 163 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
   FloatingBox { position < 304, 304, 64 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
   FloatingBox { position < 304, 304, 75 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
   FloatingBox { position < 304, 304, 86 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
