}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticalContactDetection true;  // see header note
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   logFloaterHistory             true;  // diagnostic run: per-rank floater-history/rank_<N>.csv +
                                         // rank_<N>_state.csv (state CSV now carries a fluidDensity
                                         // column, sampled at each floater's position) -- see this
                                         // scenario's repeated [LOW-RHO]/quaternion-abort crash
                                         // (jobs 4106364, 4112811). VTK writeFrequency lowered to 100
                                         // and "density" added to fluid_field writers (alongside
                                         // velocity/mapped_flag) for the same investigation, viewable
                                         // in ParaView.
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
         density;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;   max < 320, 320, 175 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   // Windowed higher-frequency dump around the expected blow-up window. This scenario's crash step
   // has landed at 3315, 3404, 3535, 3607, 4204 across five separate reproductions (see
   // SimulationParams.h's VTKParams::denseEnabled doc comment for the mechanism) -- bracket that
   // range with margin (3000-4500) rather than the full run. Only ACTUALLY invoked while
   // currentMainStep is inside [denseFromStep, denseToStep) -- writeFrequency 100 here means "every
   // 100 steps within that 1500-step window" (15 dumps), not "every 100 steps for the whole run" --
   // the earlier writeFrequency-100-for-the-whole-run attempt blew the 100GB home quota (48GB from
   // logFloaterHistory's CSVs alone by step 3100) before even reaching this window.
   fluid_field_dense
   {
      writeFrequency       100;
      denseFromStep        3000;
      denseToStep          4500;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
         density;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;   max < 320, 320, 175 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
