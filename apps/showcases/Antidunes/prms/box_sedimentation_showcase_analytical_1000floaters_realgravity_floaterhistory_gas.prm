   FloatingBox { position < 304, 272, 108 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
   FloatingBox { position < 304, 272, 119 >; halfExtents < 3, 9, 3 >; densityRatio 2; settlingSteps 0; }
