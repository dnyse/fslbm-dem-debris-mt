// mixed_shape_sedimentation_showcase_45floaters_fastcurrent_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// PARTICLE IMPACT AND SEDIMENTATION AT A FREE SURFACE -- 5-COLUMN density arrangement,
// FAST-CURRENT variant, WITH the two CylinderPillars kept. Extends
// mixed_shape_sedimentation_showcase_pillars_27floaters_fastcurrent_gas.prm (3 density
// columns, X=16/48/80, densityRatio [0.5,1.0,2.0], plus two pillars at X=112) to 5
// columns / 45 floaters (not quite double 27, per the requested layout), EQUALLY spaced
// (step 20) and entirely within X=0-96 -- i.e. before the pillar block -- so the pillars
// stay at their original X=112/Y=15,45/radius 8 untouched:
//
//   X=8    densityRatio 1.0   (light blue)
//   X=28   densityRatio 0.5   (dark blue)
//   X=48   densityRatio 2.0   (red)             <- re-centred here, was X=80 in the base file
//   X=68   densityRatio 0.5   (dark blue)
//   X=88   densityRatio 1.0   (light blue)
//   pillars: X=112, Y=15/45, radius 8            <- unchanged from the base file
//
// i.e. light/dark/red/dark/light, a palindrome around the red (2.0) centre column.
//
// PROCESS COUNT / DOMAIN: kept identical to the base file (domain <128,60,180>,
// cellsPerBlock <32,20,30>, 4x3x6 = 72 processes) -- NOT grown, by explicit choice, to
// fit 5 columns + pillars into the same 4-block width the base file used for 3 columns
// + pillars.
//
// SEAM CLEARANCE (cellsPerBlock.x=32 -> seams at x=0/32/64/96/128, see the base file's
// own header for why this matters -- the mesa_pd::mpi::ContactFilter rank-boundary race,
// jobs 3854234/3854357): X=48 (red) keeps the base file's original 16 LU clearance
// (unchanged block-centre position, just relabelled from X=80 to X=48 to make room).
// The 4 other columns get only 8 LU (X=28, X=68 sit 4 LU from the nearest seam; X=8,
// X=88 sit 8 LU from theirs) -- tighter than the original 16 LU, but the SAME or better
// than this exact file's own already-accepted Z-clearance (Z=64/88 sit only 4 and 2 LU
// from their seams, see below), so this isn't a new class of risk, just the same
// accepted risk level applied more broadly. PILLARS are exempt from this concern
// entirely -- they're GLOBAL | NON_COMMUNICATING (see base file's own header), so their
// X=112 needs no seam clearance, only geometric clearance from the nearest floater
// column (X=88, 24 LU away -- comfortably clear of the pillar's radius-8 footprint).
//
// This variant is deliberately left AS-IS with no other code or geometry changes --
// the point of this run is to find out empirically whether it crashes (and if so,
// whether it's the tighter X seam clearance, the floater count, or something else)
// before touching anything further.
//
// Everything else (shapes, settlingSteps, targetMeanVelocityMagnitude, walled Y,
// timesteps) is identical to the base 27-floater fastcurrent file -- see that file's
// own header for the full crash-isolation history this family of prms traces back to.
//
// Shapes (unchanged from the base file):
//   sphere:   radius 4.5                        (diameter 9)
//   box:      halfExtents <3.5, 7, 3.5>         (Z-depth 7, Y-depth 14)
//   cylinder: radius 4.5, length 9, axis <0,1,0> (diameter 9, Y-length 9)
// All floaters are free to translate and rotate (no pinning, no initial tilt), and
// every one has settlingSteps 10000: each is held FIXED in place until step 10000,
// then released to fall and settle under gravity and buoyancy -- lets the fast
// current establish before any floater starts moving/interacting with it.
//
// Known residual risk, inherited unchanged from the base file: Z=64 and Z=88 sit
// only 4 and 2 LU respectively from the Z-block boundaries at 60/90
// (cellsPerBlock.z=30 -> seams at 0/30/60/90/120/150/180); only Z=76 has generous
// (14 LU) clearance. Flagged, not fixed (same reasoning as every earlier version).
//
// timesteps 100000 (standard full-length run for this project's showcases).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4x3x6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;   // X periodic, Y WALLED (see BoundaryParameters N/S
                                                 // NoSlip below) -- a non-periodic face with no
                                                 // boundary condition leaves its PDFs undefined -> NaN
                                                 // (documented pitfall in SetupStages.h's
                                                 // setupBoundaryHandling), so the N/S Border entries
                                                 // below are mandatory, not optional.
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;    // doubled from the project default 0.005 (see base
                                         // 27-floater fastcurrent file's header) -- a genuine
                                         // x-direction current, not still water. 1/4 of the
                                         // U=0.02 reference tied to the hardcoded viscosity/
                                         // gravity/surfaceTension below -- since
                                         // useHardcodedUnits=true, those stay fixed regardless
                                         // of this value; raising it only tells the PID to
                                         // drive/hold a real mean flow instead of damping
                                         // toward zero. PID output is applied purely along X
                                         // (Forcing.h: (*acceleration_)[0] = newForceX), the
                                         // only periodic direction here (periodicity <1,0,0>).
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two static cylinder pillars, unchanged from the base 27-floater fastcurrent file --
// see that file's own header for the full rationale (GLOBAL | INFINITE | FIXED |
// NON_COMMUNICATING DEM contact body, matching BodyBC entries below carve them into
// the LBM flag field). Nearest floater column is X=88, 24 LU away -- clear of the
// radius-8 pillar footprint.
CylinderPillars
{
   CylinderPillar { center < 112, 15, 90 >; radius 8; }
   CylinderPillar { center < 112, 45, 90 >; radius 8; }
}

// 5 density-column grid, EQUALLY spaced (step 20): X-anchor -> densityRatio is
// [1.0, 0.5, 2.0, 0.5, 1.0][ai] for ai in {0,1,2,3,4} -> X = {8, 28, 48, 68, 88};
// ci in {0,1,2} -> Y-replicate = {10,30,50}; Z = 64 sphere / 76 box / 88 cylinder
// (unchanged). 5 columns x 3 replicates x 3 shapes = 45 floaters total. See header
// for the per-column seam-clearance breakdown.

FloatingSpheres
{
   FloatingSphere { position < 8, 10, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 10000; }
   FloatingSphere { position < 8, 30, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 10000; }
   FloatingSphere { position < 8, 50, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 10000; }
   FloatingSphere { position < 28, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 10000; }
   FloatingSphere { position < 28, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 10000; }
   FloatingSphere { position < 28, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 10000; }
   FloatingSphere { position < 48, 10, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 10000; }
   FloatingSphere { position < 48, 30, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 10000; }
   FloatingSphere { position < 48, 50, 64 >; radius 4.5; densityRatio 2.0; settlingSteps 10000; }
   FloatingSphere { position < 68, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 10000; }
   FloatingSphere { position < 68, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 10000; }
   FloatingSphere { position < 68, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 10000; }
   FloatingSphere { position < 88, 10, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 10000; }
   FloatingSphere { position < 88, 30, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 10000; }
   FloatingSphere { position < 88, 50, 64 >; radius 4.5; densityRatio 1.0; settlingSteps 10000; }
}

FloatingBoxes
{
   FloatingBox { position < 8, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingBox { position < 8, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingBox { position < 8, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingBox { position < 28, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingBox { position < 28, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingBox { position < 28, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingBox { position < 48, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 10000; }
   FloatingBox { position < 48, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 10000; }
   FloatingBox { position < 48, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 10000; }
   FloatingBox { position < 68, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingBox { position < 68, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingBox { position < 68, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingBox { position < 88, 10, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingBox { position < 88, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingBox { position < 88, 50, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 10000; }
}

FloatingCylinders
{
   FloatingCylinder { position < 8, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingCylinder { position < 8, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingCylinder { position < 8, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingCylinder { position < 28, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingCylinder { position < 28, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingCylinder { position < 28, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingCylinder { position < 48, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 10000; }
   FloatingCylinder { position < 48, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 10000; }
   FloatingCylinder { position < 48, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 2.0; settlingSteps 10000; }
   FloatingCylinder { position < 68, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingCylinder { position < 68, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingCylinder { position < 68, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 10000; }
   FloatingCylinder { position < 88, 10, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingCylinder { position < 88, 30, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 10000; }
   FloatingCylinder { position < 88, 50, 88 >; radius 4.5; length 9; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 10000; }
}
ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Z (top/bottom) and Y (N/S) walls — only X stays periodic (see BlockForestParameters).
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   // Carves the two pillars into the LBM flag field (fluid excluded / NoSlip) -- a
   // SEPARATE mechanism from CylinderPillars above, which only creates the mesa_pd DEM
   // contact body. Unchanged from the base 27-floater fastcurrent file.
   BodyBC { shape Cylinder; min < 112, 15, 0 >; max < 112, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 112, 45, 0 >; max < 112, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h)
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
