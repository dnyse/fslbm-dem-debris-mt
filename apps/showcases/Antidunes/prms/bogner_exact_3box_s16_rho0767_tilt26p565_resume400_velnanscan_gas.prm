// bogner_exact_3box_s16_rho0767_tilt26p565_resume400_velnanscan_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] Continuation of the 26.565deg-seed rho=0.7665 case for the FULL 50000 steps,
// resuming from the same step_400 checkpoint used by the hot-spot diagnostic (job 4261250). That
// diagnostic run (widened VTK region, writeFrequency=1, timesteps=450) did NOT reproduce the
// deterministic step-444 crash seen in the three prior continuous runs (4260975/4261005/4261093) --
// see THESIS_PLAN.md: a ~9e-6 discrepancy in tiltY at step 441 vs. the original run indicates the
// checkpoint round-trip is not perfectly bit-identical (different MPI reduction order on a freshly
// loaded process), and that tiny difference was enough to dodge whatever knife-edge instability
// caused the crash. This run drops back to NORMAL logging (no keepAllSnapshots, no widened VTK
// region, no writeFrequency=1) and lets the resumed trajectory run the full remaining ~49,600 steps
// to see where it actually settles, now that the immediate crash has been avoided.
//  * loadSnapshot true (same staged step_400 checkpoint, ~/resume_staging_step400/), storeSnapshot
//    true with normal snapshotFrequency 10000 (periodic safety checkpoints during the rest of the run).
//  * timesteps 50000 (beginTimeStep=401 per simState.file).
//  * VTK reverted to the ORIGINAL mid-width Y=20-21 plane filter, writeFrequency 2000 -- not the
//    diagnostic hot-spot region/per-step dump.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  true;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              500;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;
   gravityOverride        0.00075;
   denseNanScanEnabled    true;   // [Claude, 2026-09-24] REQUIRED: checkPdfNaN (incl. the new VEL-NaN-SCAN check) is only ever called when watchNow (t%1000==0, hardcoded) or this+the window below is true -- neither of our normal prms ever set this, so the scanner never actually ran near step 444 in any prior crash
   denseNanScanFromStep   430;
   denseNanScanToStep     446;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 20, 16 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.7665;
      settlingSteps        0;
      initialTiltAngleDeg  26.565;
      comOffsetZ           0;
      pinPosition          false;
      pinRotation          false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   dataSliceFrequency      500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
         density;
      }

      // reverted to the original mid-width plane (NOT the hot-spot diagnostic region)
      CellBB_filter_0 { min < 0, 20, 0 >;  max < 130, 21, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
