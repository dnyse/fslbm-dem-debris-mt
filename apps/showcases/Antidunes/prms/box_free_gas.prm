// box_free_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Free-floating log: 2:2:6 aspect ratio (Lx=6, Lz=6, Ly=18), same geometry
// as the pillar case, no constraints.  Starts far upstream and sweeps the
// full 128-LU periodic domain (~6 400 steps per pass at v=0.02).
//
// Stability analysis (Scribanti, tilt about Y-axis — rolling):
//   Box 6 × 18 × 6 LU  (halfExtents <3, 9, 3>),  ρ_P / ρ_f = 0.5
//   Draft at equilibrium:  d = hz = 3 LU  (50 % submerged)
//   KB  = d/2  = 1.5 LU,   KG  = hz = 3 LU
//   BM  = Lx² / (12·d)  =  36 / 36  =  1.0 LU
//   GM  = 1.5 + 1.0 − 3.0  =  −0.5 LU  < 0
//   → UNSTABLE; log rolls to ~45° stable equilibrium.
//   τ ≈ 11 000 steps; reaches 45° from 5° in ~24 000 steps.
//
//   Tilt about X-axis (inclination of long axis):
//   BM  = Ly² / (12·d)  =  324 / 36  =  9.0 LU
//   GM  = 1.5 + 9.0 − 3.0  =  +7.5 LU  > 0  → STABLE (long axis stays horizontal)
//
// Starting position:
//   Centre at (10, 30, 56): far upstream; box sweeps full domain each ~6 400 steps.
//   z=56 = absoluteLiquidHeight → 50 % submerged = equilibrium.
//   initialTiltAngleDeg=5 about Y seeds the rolling instability.
//   settlingSteps=300: contact line stabilises at x=10 before release.
//
// Geometry:
//   halfExtents <3, 9, 3>  →  edgeLength 6 × 18 × 6
//   Y extent [21, 39]: 21 LU clearance from each NoSlip wall (y=0 and y=60)
//   X extent [7, 13] at t=0; periodic, wraps continuously.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // GIANT free-floating log: edgeLength 12×36×12 (halfExtents 6×18×6), same 1:3:1 ratio as the
      // original 6×18×6 log, scaled ×2 to match the giant sphere. Circumscribed half-diagonal
      // ≈ 19.9 LU ≈ the giant sphere's radius (20), so centre y=30 in the 60-wide channel keeps
      // ≈10 LU wall clearance even when fully rotated. Body spans 2+ blocks (block min dim = 20)
      // → setup auto-selects SyncGhostOwners, same as the giant sphere.
      // Centre at (10, 30, 56): starts upstream, sweeps the full periodic domain.
      // z=56 = absoluteLiquidHeight → 50 % submerged = equilibrium (densityRatio 0.5).
      // GM < 0 → rolls; initialTiltAngleDeg=5 about Y seeds the rolling instability.
      position             < 10, 30, 56 >;
      halfExtents          < 6, 18, 6 >;
      densityRatio         0.5;
      settlingSteps        300;
      initialTiltAngleDeg  5;   // 5° about Y seeds the rolling instability
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   // false = uniform all-interface reconstruction (no fill=1 over-promotion band) — the path
   //         that never drifted/NaN'd. Set true to use Bogner per-cell state selection instead.
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (y=29-30), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
