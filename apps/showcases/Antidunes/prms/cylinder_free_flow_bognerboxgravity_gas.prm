// cylinder_free_flow_bognerboxgravity_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FREE-FLOATING CYLINDER (LONG AXIS ALONG X), BOGNER'S BOX-EXPERIMENT GRAVITY,
// BOGNER BUOYANCY, WITH FLOW.
//
// Direct sibling of cylinder_dynamic_gravity_bogner_gas.prm -- identical in
// every other respect -- except gravity and viscosity are OVERRIDDEN to
// Bogner & Rude (2013)'s own validated floating-cube values (thesis
// Sec. 5.3.3), exactly as in sphere_free_flow_bognerboxgravity_gas.prm:
//   gravityOverride        7.5e-4;   // was dynamically computed, ~1.169e-5
//   relaxationRateOverride 1.9;      // was dynamically computed, ~1.998 (tau=1/1.9=0.526)
// Domain height (40) already matches Bogner's own box-experiment domain, so
// his g is used unscaled at the same Eq. 10 stability margin he himself
// validated it at.
//
// Same cylinder geometry as the dynamic-gravity sibling: radius 8, length 32,
// axis <1,0,0> (long axis along X, parallel to the flow), densityRatio 0.5,
// fully free (pinPosition/pinRotation both false).
//
// timesteps 50000. VTK fluid_field writeFrequency 1000.
//
// Domain: <96, 45, 40> / cellsPerBlock <16, 15, 10> = 6×3×4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 10 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 45, 40>;
   wavePeriods        1;
   liquidHeightFactor 3.3227;    // -> liquidHeight ~19.941 (same as sibling run)
   floorHeightFactor  0.01;      // -> floorHeight ~0.060 (kept nonzero only to satisfy the != 0 assertion)
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;    // real mean flow active (E1), matches Antidunes_bogner.prm
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;       // E1 (only used to compute surfaceTension via We; viscosity/gravity below are overridden)
   Fr                     1.31;       // E1
   We                     15.6188;    // E1
   relaxationRateOverride 1.9;        // Bogner & Rude 2013's tau=1/1.9=0.526 (floating-cube validation)
   gravityOverride        7.5e-4;     // Bogner & Rude 2013's own g -- domain height already matches (40), no rescale needed
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // densityRatio 0.5 -> Archimedes equilibrium: 50% submerged.
      position     < 48, 22.5, 20 >;
      radius       8;
      length       32;
      axis         < 1, 0, 0 >;   // long axis along X -- parallel to the flow, not spanwise
      densityRatio 0.5;
      settlingSteps 0;
      pinPosition  false;   // fully free: drifts with the flow, no axis held
      pinRotation  false;   // fully free: can pitch/yaw/roll under hydrodynamic torque
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the cylinder
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 22, 0 >;  max < 96, 23, 40 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 45, 40 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 96, 45, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
