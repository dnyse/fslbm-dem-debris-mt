// box_sedimentation_showcase_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// PARTICLE IMPACT AND SEDIMENTATION AT A FREE SURFACE -- CUBOID variant, v6.
//
// v1 (5x4x5 grid, 100 identical 9-LU cubes) crashed -- WALBERLA_CHECK "entry
// already present" in mesa_pd's ContactHistoryNotification.h -- traced (via
// the archived VTK data, antidunes-box-sedimentation-showcase_20260721_203317)
// to ~90 of 100 cubes in simultaneous near-contact, 92-95% of them near a rank
// boundary at any time: mesa_pd::mpi::ContactFilter's position-based
// contact-ownership rule can have two ranks independently accept the same
// box-box contact when their GJK/EPA-derived contact points disagree near a
// boundary, silently double-applying the force before the duplicate-history
// check aborts.
//
// v2 cut this to 9 cubes (3 rows x 3 columns, single Y position per column,
// halfExtents <3.5,7,3.5>). v3 briefly tried thin sticks. v4 introduced
// Y-neighbour contacts for the first time (3(X) x 2(Y) x 3(Z) = 18 boxes,
// Y-positions 22/38, only 2 LU clearance) and crashed differently -- a NaN
// rotation quaternion (core/math/Quaternion.h) at 174 sec, i.e. an unbounded
// angular velocity, not v1's duplicate-history assertion. v5 widened the
// Y-clearance to 10 LU (Y-positions 18/42) on the theory that the tight
// clearance itself caused a violent glancing collision -- but v5 crashed
// AGAIN with the identical NaN-quaternion signature, at almost the same early
// time (179 sec), now on two ADJACENT ranks simultaneously (66 and 67, same
// reported instant). That recurrence despite the clearance fix, plus two
// adjacent ranks failing identically at the same moment -- exactly the
// signature of a contact straddling their shared boundary -- points instead
// at the SAME still-unpatched ContactFilter race from v1: a double-applied
// force large enough to blow up a particle's angular velocity to NaN within
// a single DEM sub-cycle can crash on the quaternion assertion before
// ReduceContactHistory's once-per-outer-step duplicate check ever runs, which
// would explain why no amount of geometry/spacing tuning removed it.
//
// This version (v6) is a controlled test of that theory from the other
// direction: it returns to EXACTLY v2's layout (single Y position per column,
// no Y-neighbour contacts at all -- only gravity-driven Z-stacking within a
// column, which never crashed in this file's history) while keeping v4/v5's
// box shape (halfExtents <3.5,7,3.5>). If this configuration runs cleanly, it
// isolates the Y-neighbour contact type specifically as necessary for the
// crash (still consistent with the ContactFilter race, just apparently
// requiring that particular contact geometry/timing to trigger); if it
// crashes too, that would point squarely back at the underlying mesa_pd race
// regardless of contact type, independent of any further showcase-level
// tuning.
//
// Layout: X = 32/64/96 (3 columns, densities 0.5/1.0/2.0), Y = 30 (domain
// centre, single position, no Y-neighbours), Z = 64/76/88 (3 rows, spacing 12,
// 5 LU clearance against the 7 LU Z-edge). 9 boxes total. Domain and process
// count unchanged throughout: <128, 60, 180> / cellsPerBlock <32, 20, 30> =
// 4x3x6 = 72 processes.
//
// Densities: each of the 3 X-columns is a single, uniform density (all 3
// stacked rows in a column share it) -- 0.5 (light) at x=32, 1.0 (neutral) at
// x=64, 2.0 (heavy) at x=96, matching the left-to-right light/neutral/heavy
// convention already used in box_density_showcase_gas.prm. Boxes are free to
// translate and rotate (no pinning, no initial tilt); they fall and settle
// into contact under gravity, isolated to one column per density.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   // ---- column x=32, densityRatio 0.5 (light) ----
   FloatingBox { position < 32, 30, 64 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 0; }
   FloatingBox { position < 32, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 0; }
   FloatingBox { position < 32, 30, 88 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 0.5; settlingSteps 0; }

   // ---- column x=64, densityRatio 1.0 (neutral) ----
   FloatingBox { position < 64, 30, 64 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 0; }
   FloatingBox { position < 64, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 0; }
   FloatingBox { position < 64, 30, 88 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 1.0; settlingSteps 0; }

   // ---- column x=96, densityRatio 2.0 (heavy) ----
   FloatingBox { position < 96, 30, 64 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 0; }
   FloatingBox { position < 96, 30, 76 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 0; }
   FloatingBox { position < 96, 30, 88 >; halfExtents < 3.5, 7, 3.5 >; densityRatio 2.0; settlingSteps 0; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h)
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
