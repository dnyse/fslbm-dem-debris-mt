// sphere_stillwater_100spheres_bogner_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// 100 SPHERES (mixed densities 0.5/1.0/2.0, 5x4x5 grid, spacing 12) dropped into
// STILL WATER, using Bogner & Rude (2013)'s HARDCODED viscosity (tau=1/1.9) with
// gravity RESCALED from his raw g=7.5e-4 to fit this domain's height (see GRAVITY
// RESCALING below).
//
// GRAVITY RESCALING -- CRASH HISTORY: the first version of this file used Bogner's
// raw g=7.5e-4 unchanged (job 3922030). It crashed at step 2804/100000 (~4 min in):
// a particle's rotation quaternion went NaN (WALBERLA_CHECK in Quaternion.h:241),
// preceded by a [MEM-WATCH] large-force warning on a particle already sitting on the
// floor (pos z~4.4). Root cause: Bogner's incompressibility bound (Eq. 10 of
// arXiv:1201.0351, citing Buick & Greated 2000, (lx,ly,lz)*a << cs^2=1/3) is
// satisfied at only a ~9.0% margin in HIS OWN 40-cell-tall domain (40*7.5e-4=0.03),
// but this file kept the full <128,60,180> domain (needed for drop height -- the
// sphere grid spans z=64 to z=112) while reusing his g unchanged, giving
// 180*7.5e-4=0.135, a ~40% margin -- nowhere near "<<" cs^2, and unstable in
// practice. Unlike the single-floater *_bogner_domain_matched_gas.prm files (which
// fixed this by SHRINKING the domain to 54), this file can't shrink the domain
// without losing the drop height the test is built around, so instead gravity is
// rescaled to preserve Bogner's own validated 9.0% margin at this domain's actual
// height: g_corrected = g_bogner * (lz_bogner / lz_ours) = 7.5e-4 * (40/180) =
// 1.66667e-4 -- verified: 180*1.66667e-4 = 0.03, same margin Bogner's own box test
// ran at. tau=1/1.9 (viscosity) is untouched -- Eq. 10 only constrains gravity vs.
// domain height, not viscosity. Side benefit: ~4.5x weaker gravity means spheres
// won't slam into the floor in ~2800 steps like the crashed run did -- settling
// should now spread out over a meaningful fraction of the 100000-step budget.
//
// GEOMETRY -- reused VERBATIM from sphere_sedimentation_showcase_gas.prm (the
// "100 spheres, still water" showcase run under this project's own computed
// physics): radius 4.5 LU, 5(X) x 4(Y) x 5(Z) grid, spacing 12 LU, densities
// assigned via densities[(i+j+k) % 3] over the grid indices (genuine 3D mixing,
// not flattened-index columns). No pillars, no flow forcing, X/Y periodic (no
// side walls, only Z floor/ceiling). See that file's header for the full sizing
// rationale (radius/spacing chosen so buoyant "muscle", ~r^3, dominates ambient
// dynamic-force noise).
//
// staticReferenceHeightOverride (61.26, present in the computed-gravity version)
// is DELIBERATELY DROPPED here: that value was empirically measured as the
// end-of-run waterline under this project's own ~7e-6 computed gravity -- it has
// no bearing under Bogner's ~107x larger gravity (7.5e-4), which settles to a
// completely different equilibrium waterline. Left at the model's own default
// (live-tracked reference height) rather than carrying over a stale, wrong-regime
// constant.
//
// BOGNER HARDCODED VALUES -- IMPORTANT CAVEAT (same as
// mixed_shape_stillwater_81floaters_bogner_gas.prm): g=7.5e-4 and tau=1/1.9=0.526
// are the values Bogner & Rude (2013) used ONLY for their single three-cube
// rotational-equilibrium test (Sec. 3.3.1, arXiv:1201.0351). Their paper contains
// no multi-body/swarm scenario resembling this 100-sphere grid -- checked directly
// against the paper's own section list (free-advection single-sphere test at a
// DIFFERENT gravity, g=1e-5, Sec. 3.2.1; floating-cube equilibrium at g=7.5e-4,
// Sec. 3.3.1; nothing else with rigid bodies). This run applies his validated
// single-object constants to a scenario he never tested.
//
// ModelParameters: useBognerThreePhaseMEM + useMemOnlyBuoyancy both true (matching
// every other *_bogner_*_gas.prm file) -- buoyancy support and torque come solely
// from the raw MEM/hydrodynamic force+torque (no separate vSub/cbOff righting-torque
// machinery), matching Bogner's Eq. 18 exactly.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              100000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants (surfaceTension) valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526
   gravityOverride        1.66667e-4;  // Bogner's g=7.5e-4 rescaled by 40/180 (this domain's height vs
                                       // his) to preserve his own ~9.0% Eq. 10 margin — see header
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 40, 12, 64 >;  radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 52, 12, 64 >;  radius 4.5; densityRatio 1; settlingSteps 0; }
   FloatingSphere { position < 64, 12, 64 >;  radius 4.5; densityRatio 2; settlingSteps 0; }
   FloatingSphere { position < 76, 12, 64 >;  radius 4.5; densityRatio 0.5; settlingSteps 0; }
