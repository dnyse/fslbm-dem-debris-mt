// bogner3_r025_cyl_s32_eqfull_vtk_ypin_gas.prm -- floating cylinder in the s=32 cuboid basin, densityRatio 0.25,
// whole-domain VTK. Cylinder radius 16, length 64 (the cuboid's cross-section and y-extent), axis along Y. Released
// with its centre on the still-water level 60.0746, the same start and size for all three densities (not at
// equilibrium). Pinned: y translation (pinAxes <0,1,0>; with periodic y the cylinder otherwise slides along its axis)
// and pitch/yaw (pinRotationAxes <1,0,1>); roll about Y, heave and x translation free.
// Basin and units as bogner3_r075_deep_s32_100k_gas.prm (<192,90,120>, bedCopiesInX/Y = 2, gravityOverride
// 5.06585e-05 = g_SI 9.81 m/s^2, water viscosity, surface tension from We), but periodic in x and y (no N/S walls)
// and FormerMO fill seeding as before 2026-10-01 (seedSkipObstacleNeighbours false).
// 101000 steps. VTK of the whole domain (velocity, fill_level, mapped_flag) at the fluid_field_snapshots steps
// (0 ... 99999). Eval and water height every 250 steps, density column 99000-100999.
// Derived from bogner3_r025_cyl_s32_101k_vtk_freesharedstart_gas.prm (fully free cylinder, same start).
BlockForestParameters
{
   cellsPerBlock                 < 32, 15, 15 >;
   periodicity                   < 1, 1, 0 >;   // periodic in x and y
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             50000;
   snapshotBaseFolder            snapshots_b3_r025_cyl_s32_101k_vtk_free_eqfull_pxy_ypin;
}

DomainParameters
{
   domainSize         <192, 90, 120>;
   wavePeriods        1;
   liquidHeightFactor 10.0;   // nominal (doubled basin)
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              101000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // physical constants valid while U = 0; viscosity 0.000214026 (LU)
   gravityOverride        5.06585e-05;  // g_SI = 9.81 m/s^2 at this dx_SI/dt_SI (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 2;   // doubled with domainSize, so avgParticleDiameter (6.00146), dx_SI and dt_SI keep their s=16
   bedCopiesInY 2;   // values (getAvgDiameterScalingFactor, Utility.h); with 1 copy gravityOverride would not be 9.81
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // cylinder, axis along Y, radius 16, length 64 (= the cuboid's y-extent), centre on the still-water level
      position             < 96, 45, 60.0746 >;
      radius               16.000;
      length               64;
      densityRatio         0.25;
      settlingSteps        0;
      pinPosition          true;
      pinAxes              < 0, 1, 0 >;   // y only
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
}
ModelParameters
{
   seedSkipObstacleNeighbours false;   // FormerMO fill seeding as before 2026-10-01
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   repairDegenerateObstaclePdfs  false;   // Option B (obstacle-cell repair guard) OFF
   seedStreamPdfCloneOnFirstUse  false;   // Option A (scratch PDF clone seeding) OFF

   logDensityColumn              true;
   densityColumnBaseFolder       density-column;
   densityColumnX                5;
   densityColumnY                45;
   logDensityColumnStartStep     99000;
   logDensityColumnEndStep       100999;

   // fill-integrated water height on a 12 x 3 grid of columns (x = 8, 24, ..., 184; y = 15, 45, 75) every 250 steps
   // over the whole run
   logWaterHeight                true;
   waterHeightBaseFolder         water-height;
   waterHeightGridX              12;
   waterHeightGridY              3;
   waterHeightEveryNSteps        250;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     250;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   // whole domain, velocity + fill_level + mapped_flag, only at the fluid_field_snapshots steps
   fluid_field
   {
      writeFrequency       0;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }
      before_functions { gas_cell_zero_setter; }
   }
   fluid_field_snapshots
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "0,250,500,1000,2000,4000,8000,12000,16000,20000,24000,28000,32000,36000,40000,50000,60000,70000,80000,90000,99999";
      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }
      before_functions { gas_cell_zero_setter; }
   }
   domain_decomposition
   {
      writeFrequency             0;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
