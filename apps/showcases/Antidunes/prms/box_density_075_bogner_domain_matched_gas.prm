// box_density_075_bogner_domain_matched_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FEKKEN [2004] FLOATING-CUBE EQUILIBRATION — densityRatio 0.75, BOGNER
// THREE-PHASE MEM + GRAVITY/VISCOSITY/DOMAIN MATCHED TO BOGNER'S OWN THESIS
// VALIDATION (Sec. 5.3.3), analogous to prms/sphere_density_showcase_bogner_domain_matched_gas.prm
// but for the box heel-angle test instead of the sphere depth test. Direct
// A/B partner of box_density_075_refined_gas.prm (same Fekken benchmark:
// cuboid free to rotate ONLY about its longitudinal Y axis, released from a
// small 2.86 deg seed heel, predicted to settle at 26.565 deg from upright),
// with THREE things changed:
//
//   1. ModelParameters: useBognerThreePhaseMEM + useMemOnlyBuoyancy both true
//      (Bogner & Rude 2013's original three-phase MEM force, no rhoHydStat
//      subtraction, no separate analytic vSub*g force channel). NOTE: the
//      righting-moment TORQUE (ParticleKernels.h ~line 782-794) is applied
//      UNCONDITIONALLY from cbOff/vSub regardless of useMemOnlyBuoyancy -- only
//      the vertical FORCE term differs between the two models. So this test
//      still meaningfully measures heel angle in Bogner mode: buoyant support
//      for holding the box at the right DEPTH now comes from the MEM force,
//      but the self-righting ROTATION physics is unaffected and identical to
//      the baseline.
//   2. PhysicsParameters: gravityOverride 7.5e-4, relaxationRateOverride 1.9 --
//      matches Bogner's own thesis Sec. 5.3.3 values (g=7.5e-4, tau=1/1.9=0.526)
//      exactly, instead of this project's own Fr-derived antidune-flow gravity
//      (~100x weaker). See commit 963e5ce9 / prms/sphere_density_showcase_bogner_domain_matched_gas.prm
//      for why this matters: the isolated sphere test showed the pure Bogner
//      force is ~8-12% biased at the real E1 gravity scale but accurate to
//      <1% once matched to the regime it was actually validated in.
//   3. Domain SHRUNK IN Z ONLY, to <128,60,54> -- X and Y are kept at the
//      ORIGINAL (unshrunk) 128/60, unlike the sphere gravity-matched test's
//      <96,45,*> footprint. Reason: avgParticleDiameter is derived from
//      domainSize[0] (Utility.h::getAvgDiameterScalingFactor), so shrinking X
//      would shrink it too and force rescaling halfExtents away from the
//      validated 8x16x8 Fekken geometry -- keeping X=128 keeps
//      avgParticleDiameter at the original 8.00194 exactly, so halfExtents
//      stays 8x16x8, unchanged. (Also: with X=128 fixed, cellsPerBlock.x=32
//      and cellsPerBlock.y=20 are unchanged from the refined/baseline files,
//      which forces exactly 6 Z-blocks to keep 4x3x6=72 processes --
//      domainSize.z must be a multiple of 6. The closest such multiple to
//      Bogner's own Z=40 that still leaves safe swing clearance for the box's
//      XZ half-diagonal (sqrt(8^2+8^2)~=11.31 LU) is 54 -- domainSize.z=36/42
//      were tried first and rejected: at this avgParticleDiameter, the box's
//      required headroom doesn't fit without either running the water surface
//      into the floor or the box's swing arc clipping the ceiling.)
//      liquidHeightFactor/floorHeightFactor set to 1.68709/1.68709 (equal
//      split) so absoluteLiquidHeight = 8.00194*3.37418 ~= 27.0, dead centre
//      of the new Z=54 domain -- leaves ~15.7 LU clearance above and below
//      the box's full 45 deg-heel swing radius (11.31 LU), comfortably more
//      than the bare minimum.
//
// Domain: <128, 60, 54> / cellsPerBlock <32, 20, 9> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 9 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 54>;
   wavePeriods        1;
   liquidHeightFactor 1.68709;
   floorHeightFactor  1.68709;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              300000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants (surfaceTension) valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526
   gravityOverride        7.5e-4;      // matches Bogner's g
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // 1x2x1 cuboid (halfExtents 8x16x8 -> edges 16x32x16, UNCHANGED from the
      // refined/baseline Fekken geometry -- see header for why X/Y are kept at the
      // original scale). densityRatio 0.75 -> Fekken-predicted stable heel: 26.565 deg
      // from upright.
      position             < 64, 30, 27.0 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  2.86;   // small seed heel (Fekken), about the free Y axis
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation           true;
      pinRotationAxes      < 1, 0, 1 >;   // free roll about Y (XZ plane); pin pitch (X) and yaw (Z)
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // no rhoHydStat subtraction at all (see header)
   useMemOnlyBuoyancy             true;   // no separate vSub*g force channel -- righting torque unaffected (see header)
   useAnalyticBoxBuoyancy        true;   // exact clip drives vSub/cbOff -> plane export + righting torque match it exactly
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the box
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 45 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 45 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 45 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
