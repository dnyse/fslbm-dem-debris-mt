// [Claude, 2026-10-03] CLEAN HOPPER REFERENCE H0: small_rods_192x_2x32x3_clog_skin0p5_curvguard_gas.prm with the
// FloatingCylinders block removed (same channel, wall pillars, PID uncapped), 30000 steps, flowRateEnabled true.
// Gives the hopper layout's own clean converged force a_ref (mean acceleration_x once meanVelocity has settled) and
// Q_ref for the capped-PID test (small_rods_192x_..._cappid_gas.prm).
// [Claude, 2026-10-02] CURVATURE-GUARD TEST: guardCurvatureInputs true added (new prm switch, off by default -- skips a curvature neighbour that is neither liquid/interface/gas/obstacle or whose normal isn't finite, sets curvature 0 if nothing usable is left, logs each case as [CURVATURE-GUARD]). Verified a true no-op on valid inputs elsewhere (box_pair_repro_gas.prm: 5828 force/position lines identical on/off, guard never fires). VTK switched to the discrete snapshot schedule 500/1000/2000/4000/8000/16000/32000/49000 (fluid_field_snapshots, same mechanism as the production hopper reruns) instead of the uniform every-10000-steps cadence. Also adds denseNanScanEnabled for steps 8900-9100, bracketing this run's own actual crash step (9069, job 4284164).
// ─────────────────────────────────────────────────────────────────────────────
// small_rods_192x_2x32x3_clog_skin0p5_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-10-01] DOUBLING-IN-X continues after the clean 48-rod skin test (job 4282396:
// full 51000 steps, exit 0, zero crash markers -- confirmed by direct log inspection, same result
// as the 24-rod test 4282267). Per explicit request ("we know the 48 cylinder works, then on two
// new freed directory run the 96 and the 192 version with the skin activated"), this is the next
// doubling step: 32 rows in X instead of 8 -- 2(Y) x 32(X) x 3(Z) = 192 rods --
// same geometry/densities/contact-mode/cylinderContactSkin 0.5/sealed-cell-guard-off as 4282267
// and 4282396, extended upstream at the SAME WIDENED 8 LU pitch: 364 (front, unchanged) down to
// 116 (32 rows total). No fixes besides the skin (Option A/B, SimpleBB.h
// guard all OFF), matching every other scenario in this series. VTK writeFrequency 10000,
// timesteps 51000 (same as every prior scenario in this series).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   denseNanScanEnabled           true;   // [Claude, 2026-10-02] pinpoint the first NaN near this run's own crash step
   denseNanScanFromStep          8900;
   denseNanScanToStep            9100;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

// [Claude, 2026-10-03] FloatingCylinders removed: clean reference


ModelParameters
{
   useAnalyticalContactDetection true;
   usePureAnalyticalCylinder     false;
   useContactFilterOwnerTiebreak true;
   useCapsuleShapeForCylinders   false;
   cylinderContactSkin           0.5;   // [Claude, 2026-10-01] rod contact skin in LU (cd1b991b), same as the clean 4282267 (24-rod) run. Sealed-cell guard stays OFF (not set below).
   guardCurvatureInputs          true;   // [Claude, 2026-10-02] off by default; see file header

   useTightTier1                 false;
   useTightLayer1                true;
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 40 >;
      downstreamPos     < 432, 20, 40 >;
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 40 >;
      pillarDownstreamPos  < 432, 6, 40 >;
      flowRateEnabled      true;   // [Claude, 2026-10-03] discharge Q and wet area A at x=336/432 (primary metric of the capped-PID test)
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid cropped near the pillars and all eight rows (X 250..500, Z 0..100); the rods are unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       0;             // superseded by fluid_field_snapshots below (discrete steps, not uniform)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 100, 0, 0 >;  max < 500, 40, 100 >; }   // [Claude, 2026-10-01] widened from 250 to cover all 32 rows down to X=116

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   fluid_field_snapshots
   {
      writeFrequency       1;   // unused by the gating logic itself, required by vtk::initializeVTKOutput
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "500,1000,2000,4000,8000,16000,32000,49000";

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 100, 0, 0 >;  max < 500, 40, 100 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
