// box_density_showcase_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// BUOYANCY SHOWCASE (box): three identical 1x2x1 cuboids (halfExtents <8,16,8> ->
// edges 16 x 32 x 16), LONG edge along Y -- lying flat on the water surface with
// its long axis horizontal, matching the floating-cylinder logs' own default axis
// convention (axis <0,1,0>) rather than standing the long edge upright. Differ
// only in densityRatio (0.25 / 0.5 / 0.75); pinned in X,Y so each settles straight
// down/up in place without lateral drift.
//
// ROTATION is pinned per-axis (pinRotation true, pinRotationAxes <1,0,1>): only
// rotation about the world Y-axis is free (roll, within the XZ plane -- rolling
// the square X-Z cross-section toward a corner-down "diamond" orientation, a
// genuine small-angle stability effect since the submerged waterplane shape
// changes with roll angle even though the cross-section's mass distribution is
// symmetric). Pitch (X) and yaw (Z) are suppressed, so the only dynamics visible
// are: (a) each density's own buoyant DEPTH, and (b) each density's own
// equilibrium ROLL angle -- without any incidental pitch/yaw noise confusing the
// comparison.
//
// Layout (domain centreline y=30; absoluteLiquidHeight ~56.024):
//   • densityRatio 0.25: position (32, 30, 56)
//   • densityRatio 0.50: position (64, 30, 56)
//   • densityRatio 0.75: position (96, 30, 56)
//   32 LU apart in X; box footprint is 16 (X) x 32 (Y) (halfExtents x=8, y=16).
//   X-neighbour clearance: even fully rolled to the 45 deg corner-down extreme,
//   the X-Z cross-section's half-diagonal is 8*sqrt(2)~=11.3 LU, so worst-case
//   clearance between neighbours is 32 - 2*11.3 ~= 9.4 LU -- still clear. The
//   Y-extent (span y=[14,46], half-length 16, unaffected by roll about Y) leaves
//   14 LU to each N/S wall -- also clear.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         400000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // 1x2x1 cuboid (halfExtents 8x16x8 -> edges 16x32x16), long edge on Y (horizontal).
      position             < 32, 30, 56 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.25;
      settlingSteps        0;
      initialTiltAngleDeg  0;   // stays flat until buoyancy/torque rolls it (Y free below)
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;   // free roll about Y (XZ plane); pin pitch (X) and yaw (Z)
   }
   FloatingBox
   {
      position             < 64, 30, 56 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.5;
      settlingSteps        0;
      initialTiltAngleDeg  0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
   FloatingBox
   {
      position             < 96, 30, 56 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticBoxBuoyancy        true;   // exact clip drives the force -> plane export matches it exactly
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for each box
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
