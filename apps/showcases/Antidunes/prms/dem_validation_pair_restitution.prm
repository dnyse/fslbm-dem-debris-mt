// DEM dry-run validation: central, face-aligned, no-lever-arm head-on collision for all 6 shape-pair
// combinations of {sphere, box, cylinder}, vs. the textbook v_rel_after = -e*v_rel_before (which the
// general rigid-body-impact solver collapses to exactly when r x n = 0 on both bodies -- see
// AnalyticalSolutions.h::twoBodyHeadOnRestitution). Box/cylinder-cylinder pairs specifically exercise
// the GJK/EPA fallback path in ComputeContacts (no analytic overload for those pairs in production).
// No gravity -- isolates the normal-direction spring-dashpot calibration from any trajectory effects.
DEMValidation{
    testCase pairRestitution;

    sphereRadius 1.0;
    boxHalfExtents < 1.0, 2.0, 2.0 >;
    cylinderRadius 1.0;
    cylinderLength 6.0;
    density 1.0;

    restitutionCoefficient 0.7;
    frictionCoefficient 0.0;
    poissonsRatio 0.22;
    collisionTime 0.01;

    approachSpeed 1.0;
    // Just enough gap that no pair starts in contact (cylinderLength 6.0 is the largest reach, ~3 from
    // centre) -- not 20 (needlessly re-simulates tens of thousands of steps of untouched free flight
    // before the bodies are anywhere near each other; this DEM has no gravity/acceleration phase to
    // wait out, so a small approach distance is exactly as valid a test as a large one, just faster).
    initialSeparation 8.0;

    toleranceRelError 0.1;
    vtkSpacing 0;
    outputBaseName pair_restitution;
}
