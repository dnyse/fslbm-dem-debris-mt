// Energy conservation of oblique cylinder-cylinder collisions under each detection mode (gjk / hybrid / pure /
// refined), e = 1, mu = 0, no gravity; see runCylinderPairEnergyFuzz (DEMValidationPairEnergy.h).
DEMValidation{
    testCase cylinderPairEnergyFuzz;
    cylinderRadius 1.0;
    cylinderLength 3.0;
    density 1.0;
    poissonsRatio 0.22;
    collisionTime 0.01;
    approachSpeed 1.0;
    numCollisions 100;   // 88 of the 100 collisions complete; these give the values of tab:contact-behaviour
    toleranceRelError 0.02;
    seed 4242;
}
