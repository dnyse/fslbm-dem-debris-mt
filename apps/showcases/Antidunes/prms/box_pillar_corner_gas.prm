// box_pillar_corner_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Box×CylindricalBoundary ROTATED-CONTACT test — part of the floater/pillar
// interaction test suite (see also: box_pillar_glance_gas.prm, box_pillar_gap_pass_gas.prm,
// sphere_pillar_*, cylinder_pillar_*).
//
// initialTiltAngleDeg is a rotation about the world Y-axis, which leaves the box's
// Y-extent unchanged — so a Y-offset glance test (box_pillar_glance_gas.prm) can
// never actually exercise the rotated corner/edge branch of the contact code: the
// nearest feature is still the flat +Y face regardless of tilt. To genuinely put a
// CORNER first, this test tilts the box 45° about Y and drives it HEAD-ON (Δy=0,
// centred on the pillar) so the diagonal corner it presents in +X is what the
// downstream drift brings into contact — the box's effective X-reach grows from
// halfExtents.x=3 to the face diagonal (3·√2≈4.24) at 45°.
//
// Geometry (absoluteLiquidHeight = 56.024):
//   • Pillar: center (64, 30, 90), radius 8.
//   • Box: cube halfExtents <3,3,3>, densityRatio 0.5 → centre at z=56 (50%
//     submerged). Start (30, 30, 56), centred in Y on the pillar (head-on),
//     initialTiltAngleDeg=45 (about Y) so a corner leads the approach.
//   • Expected outcome: corner-first contact near x≈64 (F_contact, contact normal
//     pointing back along -X/radially from the pillar axis, not axis-aligned);
//     the box should be deflected/rotated around the pillar rather than penetrate.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 64, 30, 90 >;
      radius 8;
   }
}

FloatingBoxes
{
   FloatingBox
   {
      // Cube halfExtents <3,3,3>, tilted 45° about Y, centred head-on (Δy=0) on the
      // pillar: a corner (not a face) leads into the pillar as the box drifts +X.
      position             < 30, 30, 56 >;
      halfExtents          < 3, 3, 3 >;
      densityRatio         0.5;
      settlingSteps        500;
      initialTiltAngleDeg  45;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 30, 0 >; max < 64, 30, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
