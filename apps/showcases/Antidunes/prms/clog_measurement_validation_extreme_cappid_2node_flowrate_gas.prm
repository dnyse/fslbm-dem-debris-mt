// Centred pillar, extreme scale, capped PID, staggered release; 2-node variant with the flow-rate evaluator.
// Domain <768,40,180>, X periodic, Y walled, NoSlip top and bottom. Z = 180 keeps the backed-up free surface upstream
// of the jam below the ceiling (at Z = 90 it reaches it); the pillar's BodyBC spans the full height.
// Obstacle: one CylinderPillar at (384, 20), radius 12 (diameter 24 = 60 % of the 40 LU width), leaving two 8 LU slits that are
// narrower than the 10 LU sphere diameter, so a single sphere cannot pass.
// Physics: target velocity 0.04 (high enough to drive spheres into the slits), Re 3100, Fr 1.31, We 15.62,
// useHardcodedUnits false so gravity, viscosity and surface tension are derived for this target velocity.
// liquidHeightFactor 2.0 is a low-water setting (waterline 49.13 LU), leaving little freeboard to pass over the jam.
// avgParticleDiameterOverride/dxSIOverride set the SI scaling without a bed file (useParticleBed false).
// Forcing: PID on, maxActuatingVariable capped at 2.65e-6 = k a_ref, with a_ref = 7.80e-7 the converged driving force
// of this layout without a jam (the fixed force of the PID-off runs) and k = 1 + F / (a_ref L_x / g)
// = 1 + 24.56 / 10.28 = 3.4 for a freeboard F = 0.5 h0. The uncapped PID needed ~8.8 a_ref (step 70000) and up to
// ~14 a_ref to hold the target velocity through the jam.
// Floaters: 100 spheres, radius 5, densityRatio cycled 0.5/1.0/1.5 (34/33/33; 1.5 sinks under MEM-only buoyancy).
// Released in 10 batches of 10 (Y 13/27 x X 40..120, step 20) at settlingSteps 20000 + 4000 r, r = 0..9, i.e. after
// the ~20000-step flow spin-up. Release Z 73..75 is 15-17 LU above the worst-case top of a floating sphere
// (waterline 49.13 + radius 5 + 4 LU bounce), and the 4000-step batch gap lets the previous batch drift clear of the
// spawn points (startInactive keeps them dormant until release).
// cellsPerBlock <64,20,30> -> (12, 2, 6) = 144 ranks, 2 nodes. 124750 steps. ClogMeasurement probe pairs at
// X = 280/500 on both slit centrelines (Y = 4 and 36, z = 40) with flow rate; VTK every 24950 steps.

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // capped at 3.4 a_ref, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         124750;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see file header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // radius 12 (diameter 24 = 60 % of the 40 LU width): two 8 LU slits, narrower than the 10 LU sphere diameter
   CylinderPillar { center < 384, 20, 45 >; radius 12; }
}
FloatingSpheres
{
   FloatingSphere { position < 40, 13, 73 >; radius 5; densityRatio 0.5; settlingSteps 20000; startInactive true; }
