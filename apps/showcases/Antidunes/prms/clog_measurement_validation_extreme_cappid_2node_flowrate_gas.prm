ModelParameters
{
   guardCurvatureInputs          true;   // no effect on finite inputs; prevents a NaN-curvature crash
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      // pair 1: centreline of the left slit (Y 0..8)
      upstreamPos       < 280, 4, 40 >;
      downstreamPos      < 500, 4, 40 >;
      probeHalfWidthXY   2;
      flowRateEnabled    true;   // volumetric flow rate + wet area at the probe X planes (Evaluators.h flowRateAt)

      // pair 2: centreline of the right slit (Y 32..40); probeHalfWidthXY 2 keeps both windows 2 LU off wall and pillar
      pillarUpstreamPos    < 280, 36, 40 >;
      pillarDownstreamPos  < 500, 36, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // CylinderPillars only gives DEM contact; this BodyBC makes the pillar solid for the fluid. It must span the full
   // domain height (Z 0..180).
   BodyBC { shape Cylinder; min < 384, 20, 0 >; max < 384, 20, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid_field writeFrequency = timesteps/5: dumps at 0, 24950, 49900, 74850, 99800 (the main loop ends at
// timesteps - 1, so the final state is not written). The floater VTK uses the same writeFrequency.
VTK
{
   fluid_field
   {
      writeFrequency       24950;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      // zero the stale velocity/density in gas and obstacle cells, which otherwise show as noise in ParaView
      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
