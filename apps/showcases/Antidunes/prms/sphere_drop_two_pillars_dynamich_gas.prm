// sphere_drop_two_pillars_dynamich_gas.prm — two-pillar CLOGGING scenario, DYNAMIC MEM reference height ON.
// ─────────────────────────────────────────────────────────────────────────────
// Re-run of the dynamic-H idea (2026-07-01, see changes.md), this time explicitly understood as a
// CLOGGING test rather than a free-floating-equilibrium test: the pillar gap (centres y=15/45, radius 8
// each → clear gap = 30 − 8 − 8 = 14 LU) is NARROWER than the sphere's diameter (radius 10 → 20 LU), so
// the sphere geometrically CANNOT pass between the pillars — it can only wedge/jam against both from the
// upstream side. That's intentional: this models debris/sediment clogging a flow constriction.
//
// What's different from the plain baseline (sphere_drop_two_pillars_gas.prm): the MEM hydrostatic
// reference height H (SimpleBB's rhoHydStat, force-side only — confirmed it never touches the fluid/PDF
// fields) is tracked LIVE instead of held at the flat absoluteLiquidHeight: each step, floaters' fitted
// local waterlines are averaged and EMA-blended (α=0.2) into a shared reference. This cancels the
// uncancelled-pile-up phantom (the open-cap upward lift) AT THE SOURCE, exactly, with no A_proj/taper
// geometry needed — but it is still only a STATIC/offset correction. It cannot remove a genuinely
// velocity-dependent (suction/Venturi) residual, and the earlier free-floating version of this test
// overshot past 50% into a runaway sink once the phantom was cancelled and a downward residual was
// exposed. Here we WANT to see the true (non-phantom-contaminated) hydrodynamic force alongside the real
// mechanical contact force from being wedged against the pillars — [FloaterForces] logs both F_hydro AND
// F_contact+lub every eval step, so we can tell how much of "holding it down" is hydrodynamics vs contact.
//
// Compare against sphere_drop_two_pillars_gas.prm (RUN A, static flat H) in the same job.
// Watch: [DynamicH] H(EMA) converging near the pillar pile-up level; [FloaterForces] F_hydro_z,
// F_contact+lub_z (esp. its sign/magnitude — the wedging-friction hypothesis from phantom.log review),
// and subm% over time.
//
// Geometry (waterline ≈ z=56 flat / piles to ~62-65 at the pillars):
//   • Sphere centre (30,30,78): bottom at z=68, ~5 LU above the free surface at start.
//   • Pillars at (64,15,r=8) and (64,45,r=8).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         60000;   // 30000 held + 30000 free-floating after release
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Cylinder pillars — same geometry as the baseline. Clear gap (30 − 8 − 8 = 14 LU) < sphere diameter
// (20 LU): the sphere cannot pass through, only wedge against both — the clogging scenario under test.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // Normal sphere: radius=10 LU, too large for the 14 LU pillar gap (models a clogging body).
      // densityRatio 0.5. settlingSteps=30000: held FIXED while flow develops and the pillar pile-up
      // forms, then released to drift downstream and jam against the pillars.
      position     < 30, 30, 78 >;
      radius       10;
      densityRatio 0.5;
      settlingSteps 30000;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePhantomForceCorrection     false;  // isolated: dynamic-H alone, not combined with Option A
   useDynamicReferenceHeight     true;   // the fix under test — see file header
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
