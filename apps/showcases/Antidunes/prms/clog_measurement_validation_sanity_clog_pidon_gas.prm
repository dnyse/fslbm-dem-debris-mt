// Sanity check of the ClogMeasurement evaluator (Evaluators.h) and of PIDParameters.enabled (Forcing.h) on the smallest
// setup that produces an unambiguous clog; PID enabled (controlled-flume mode). Counterpart:
// clog_measurement_validation_sanity_clog_pidoff_gas.prm.
// Expected: clogUpstreamElevation/ExcessPressure rise relative to downstream as the jam forms, avgParticleTransportRate
// drops, and the PID raises acceleration[0] to compensate.
// Domain <384,40,90>, X periodic (recirculating current), Y walled, NoSlip top and bottom; cellsPerBlock <64,20,15>
// -> (6, 2, 6) = 72 ranks. X is long enough for the backwater bump to decay before it wraps round to the upstream
// probe, and gives the spheres room to queue into a jam instead of bouncing off the piers once.
// Obstacle: two CylinderPillars at X 192, Y 11/29, radius 6: gap 18 - 2*6 = 6 LU, narrower than the 8 LU sphere
// diameter, so a single sphere cannot pass. The BodyBC entries make them solid for the fluid.
// Floaters: 12 spheres, radius 4, densityRatio 0.25/0.5/0.75 at Z 44/45/46, X 80..110 on the centreline (Y 20),
// released one by one every 1500 steps from 20000 to 36500; the base flow only settles to its target velocity by
// ~15000-20000 steps, so debris enters a spun-up flow.
// Physics: target velocity 0.04 (above the 0.005-0.02 of the other toy scenarios, so the flow drives spheres into the
// gap), Re 3100, Fr 1.31, We 15.62; useHardcodedUnits false so gravity, viscosity and surface tension are derived
// for this target velocity. liquidHeightFactor 2.0 is a low-water setting (waterline 49.13 LU) that leaves little
// freeboard to pass over the gap. avgParticleDiameterOverride/dxSIOverride set the SI scaling without a bed file.
// 56500 steps (last release + ~20000-step tail). Probes: gap centreline (Y 20) and left-pillar face (Y 11), each at
// X = 140 (between release zone and piers) and X = 250 (58 LU downstream), both far from the periodic seam either way.

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <384, 40, 90>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         56500;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see file header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 192, 11, 45 >; radius 6; }
   CylinderPillar { center < 192, 29, 45 >; radius 6; }
}
FloatingSpheres
{
   FloatingSphere { position < 80, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 20000; startInactive true; }
   FloatingSphere { position < 90, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 21500; startInactive true; }
   FloatingSphere { position < 100, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 23000; startInactive true; }
   FloatingSphere { position < 110, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 24500; startInactive true; }
   FloatingSphere { position < 80, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 26000; startInactive true; }
   FloatingSphere { position < 90, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 27500; startInactive true; }
   FloatingSphere { position < 100, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 29000; startInactive true; }
   FloatingSphere { position < 110, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 30500; startInactive true; }
   FloatingSphere { position < 80, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 32000; startInactive true; }
   FloatingSphere { position < 90, 20, 44 >; radius 4; densityRatio 0.25; settlingSteps 33500; startInactive true; }
   FloatingSphere { position < 100, 20, 45 >; radius 4; densityRatio 0.5; settlingSteps 35000; startInactive true; }
   FloatingSphere { position < 110, 20, 46 >; radius 4; densityRatio 0.75; settlingSteps 36500; startInactive true; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 140, 20, 40 >;
      downstreamPos      < 250, 20, 40 >;
      probeHalfWidthXY   2;

      // second pair at the left pillar's Y (11), same X/Z as the gap pair: Schalko, Follett & Nepf (2023, WRR)
      // found ~7.5 % lateral variation in water depth between a partial-width jam and the open gap beside it,
      // and the strongest backwater is expected at the pillar face.
      pillarUpstreamPos    < 140, 11, 40 >;
      pillarDownstreamPos  < 250, 11, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // CylinderPillars only gives DEM contact; these BodyBC make the pillars solid for the fluid (full height Z 0..90).
   BodyBC { shape Cylinder; min < 192, 11, 0 >; max < 192, 11, 90 >; radius 6; NoSlip{} }
   BodyBC { shape Cylinder; min < 192, 29, 0 >; max < 192, 29, 90 >; radius 6; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid_field writeFrequency = timesteps/5: dumps at 0, 11300, 22600, 33900, 45200 (the main loop ends at
// timesteps - 1, so step 56500 is not written). The floater VTK uses the same writeFrequency.
VTK
{
   fluid_field
   {
      writeFrequency       11300;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // zero the stale velocity/density in gas and obstacle cells, which otherwise show as noise in ParaView
      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
