// DEM dry-run validation: Kodam et al. (2010) Part II Fig. 11 / Section 3.4 recreation -- ONE shape
// tumbling inside an ACTUALLY ROTATING drum (polygon-of-planes wall, animated every tumbling step), axis
// horizontal, bounded by two flat endcap walls, rotated at `rpm` after an initial gravity settle with the
// drum stationary. Free-surface snapshots are taken across several drum revolutions and pooled into one
// least-squares line fit to get the dynamic angle of repose (Kodam et al.'s own Fig. 12 method). No
// water/fluid coupling. VTK output enabled -- see vtk-out/rotating_drum/.
//
// Swap the shape by editing the `shape` key below to "sphere", "box", or "cylinder".
//
// EVERY VALUE BELOW IS TAKEN DIRECTLY FROM THE PAPER (real SI units), matching
// dem_validation_packing_single_shape.prm's particle geometry/material exactly (Kodam used the SAME 250
// Plexiglas cylinders for both tests):
//   - cylinderRadius/cylinderLength/density/restitutionCoefficient/frictionCoefficient/poissonsRatio:
//     Table 1, identical to the packing test.
//   - drumRadius/drumHalfLength: Section 3.4, "a Plexiglas drum of 100mm internal diameter and 56mm
//     length" -> radius 0.050m, half-length 0.028m.
//   - rpm: Section 3.4, "rotation speed of 25rpm".
//   - numParticles: Section 3.4, "The drum contained 250 Plexiglas cylinders".
//   - numSnapshots: Section 3.4, "Ten digital photographs of the particle bed were taken at one second
//     intervals" -> 10.
//   - sphereRadius/boxHalfExtents: equal-volume to the cylinder (Kodam only tested the cylinder here) --
//     see dem_validation_packing_single_shape.prm's header note.
// collisionTime is the one parameter NOT literally from the paper -- see that same prm's header note on
// why (this engine's contact law has no direct k/v input, only (restitution, collisionTime, poisson)).
DEMValidation{
    testCase rotatingDrum;

    shape cylinder;   // "sphere" | "box" | "cylinder"

    numParticles 250;         // Kodam et al. Section 3.4: 250 Plexiglas cylinders
    sphereRadius 0.0039916;   // equal-volume sphere
    boxHalfExtents < 0.0032172, 0.0032172, 0.0032172 >;  // equal-volume cube
    cylinderRadius 0.004;     // Table 1
    cylinderLength 0.0053;    // Table 1
    density 1163.66;          // Table 1

    restitutionCoefficient 0.85;  // Table 1
    frictionCoefficient 0.5;      // Table 1
    poissonsRatio 0.35;           // Table 1
    collisionTime 1.0e-4;         // see header note
    gravity 9.81;

    drumRadius 0.050;      // Section 3.4: internal diameter 100mm
    drumHalfLength 0.028;  // Section 3.4: length 56mm
    numWallSegments 32;
    rpm 25.0;              // Section 3.4

    settleSteps 400000;
    tumbleRevolutions 3;
    numSnapshots 10;       // Section 3.4: ten photographs
    numRadialBins 24;

    vtkSpacing 2000;
    outputBaseName rotating_drum;
}
