// GENERATED by gen_hopper_stress_prms.py (--hopper-clean-long-only) -- HOPPER GAP, CLEAN REFERENCE: the drifting-rods
// run (hopper_clog_cyl_startblock_skin0p5_cappid_gas.prm) without floaters; clean a_ref, Q_ref and levels of the
// hopper-gap layout for all hopper runs. 150000 steps, VTK at steps 0 and 149000 only.
// Channel 768 x 40 x 180, periodic in x (<64, 20, 30> blocks = 144 ranks / 2 nodes), water level z = 49.13, PID-driven
// flow (target mean velocity 0.04, cap maxActuatingVariable 2.65e-6 = 5.0 a_ref of the clean hopper, a_ref = 5.31e-7).
// Two cylindrical pillars R 12 centred on the y walls at x = 384 leave a 16 LU gap.
// wallOuterGhostLayer on. Probes at x = 336 / 432, z = 20 (centre y = 20, pillar y = 6); discharge, blockage ratio.
// Base: hopper_clog_cyl_frontblock_pidon_2node_skin0p5_curvguard_cappid_gas.prm (block at the pillars, 100000 steps).

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // cap = 5.0 a_ref of the clean hopper, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         150000;  // base prm: 100000
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- derived from U, Re and Fr (useHardcodedUnits false)
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // axes on the y walls: half of each pillar lies outside the domain (harmless); z is a reference point on the axis
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}



ModelParameters
{
   useAnalyticalContactDetection true;   // Cylinder x Cylinder: analytical Kodam+Guo hybrid
   usePureAnalyticalCylinder     false;  // (default, explicit) keep the GJK/EPA fallback for uncertain pairs
   useContactFilterOwnerTiebreak true;   // one rank accepts each boundary-straddling contact (min owner rank)
   cylinderContactSkin           0.5;   // rod-rod contact from a surface gap of 2*skin = 1, rod-wall/pillar from 0.5
   guardCurvatureInputs          true;   // FD curvature skips uninitialised/non-finite neighbour normals

   // Contact/buoyancy options: tight layer-1 pre-filter and rotational effective mass ON, the rest OFF
   useTightLayer1                true;   // conservative pre-filter ahead of the closed-form contact tests
   useRotationalEffectiveMass    true;   // contact stiffness/damping from the effective mass incl. rotational inertia
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   wallOuterGhostLayer           true;   // outer ghost layer becomes wall too (side-wall NaN-normal fix)
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 20, 20 >;  // z = 20: pressure cell stays submerged downstream
      downstreamPos     < 432, 20, 20 >;  // z = 20: pressure cell stays submerged downstream
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 6, 20 >;  // z = 20: pressure cell stays submerged downstream
      pillarDownstreamPos  < 432, 6, 20 >;  // z = 20: pressure cell stays submerged downstream
      flowRateEnabled      true;   // discharge Q and wet area A at x = 336 / 432
      blockageRatioEnabled true;   // pillar + jam blockage at the probe planes (clog*BlockageRatio columns)
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // Fluid-blocking counterparts of the CylinderPillars (full height); y walls get NoSlip automatically (non-periodic)
   BodyBC { shape Cylinder; min < 384, 0, 0 >;  max < 384, 0, 180 >;  radius 12; NoSlip{} }
   BodyBC { shape Cylinder; min < 384, 40, 0 >; max < 384, 40, 180 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// VTK: the periodic fluid_field output is off (writeFrequency 0); fluid_field_snapshots writes the fluid only at the
// listed steps (VTKParams::snapshotsEnabled, VtkWriter.h), and the floater point-data writers follow the same
// list (addSnapshotAwareVTKWrite, BuildTimeloop.h). Fluid over the whole channel (pillars via mapped_flag).
VTK
{
   fluid_field
   {
      writeFrequency       0;             // superseded by fluid_field_snapshots below (discrete steps, not uniform)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;  max < 768, 40, 180 >; }  // whole channel

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   fluid_field_snapshots
   {
      writeFrequency       1;   // unused by the gating logic itself, required by vtk::initializeVTKOutput
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "0,149000";  // clean reference: start and end only

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;  max < 768, 40, 180 >; }  // whole channel

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
