// cylinder_dynamic_gravity_bogner_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FREE-FLOATING CYLINDER (LONG AXIS ALONG X), DYNAMIC (Fr-derived) GRAVITY,
// BOGNER BUOYANCY, WITH FLOW.
//
// Direct cylinder analogue of sphere_dynamic_gravity_bogner_gas.prm (job
// 3947080): same domain, same real mean flow (targetMeanVelocityMagnitude
// 0.02), same Bogner three-phase MEM buoyancy model, same fully free
// (pinPosition/pinRotation both false) floater, same densityRatio 0.5 -- but
// the floater is now a FloatingCylinder with its long axis aligned with X
// (axis <1,0,0>), i.e. PARALLEL to the mean flow and to the periodic boundary,
// rather than spanwise (the axis <0,1,0> convention used by every other
// cylinder_*.prm in this project, e.g. cylinder_density_showcase_gas.prm,
// cylinder_stillwater_drop_gas.prm). Being fully free (pinRotation false),
// nothing prevents it from yawing away from this orientation over the run --
// whether it stays aligned with the flow or rotates broadside to it is itself
// part of what this run observes.
//
// radius 8 (matches the sphere runs directly), length 32 (aspect ratio 4:1,
// a modest "log" -- long enough to be a genuinely different geometry from the
// sphere, short enough to stay well clear of self-interaction through the
// X-periodic boundary at domain width 96).
//
// gravity is computed the project's own dynamic way -- gravity = (U/Fr)^2 /
// liquidHeight -- no useHardcodedUnits/gravityOverride/relaxationRateOverride.
// See sphere_dynamic_gravity_bogner_gas.prm for the full rationale (same
// domain/liquidHeight, so gravity ~1.169e-5 as before).
//
// timesteps 50000 (per request, up from the sphere runs' 30000).
// VTK fluid_field writeFrequency 1000 (per request, up from 2000).
//
// Domain: <96, 45, 40> / cellsPerBlock <16, 15, 10> = 6×3×4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 10 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 45, 40>;
   wavePeriods        1;
   liquidHeightFactor 3.3227;    // -> liquidHeight ~19.941 (same as sphere runs)
   floorHeightFactor  0.01;      // -> floorHeight ~0.060 (kept nonzero only to satisfy the != 0 assertion)
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;    // real mean flow active (E1), matches Antidunes_bogner.prm
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;       // E1
   Fr                     1.31;       // E1
   We                     15.6188;    // E1
   // no useHardcodedUnits / gravityOverride / relaxationRateOverride -- gravity
   // and relaxationRate are both computed dynamically from Re/Fr/We/liquidHeight
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // densityRatio 0.5 -> Archimedes equilibrium: 50% submerged (independent of orientation
      // for the vertical force balance; orientation only matters for rotational stability).
      position     < 48, 22.5, 20 >;
      radius       8;
      length       32;
      axis         < 1, 0, 0 >;   // long axis along X -- parallel to the flow, not spanwise
      densityRatio 0.5;
      settlingSteps 0;
      pinPosition  false;   // fully free: drifts with the flow, no axis held
      pinRotation  false;   // fully free: can pitch/yaw/roll under hydrodynamic torque
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the cylinder
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 22, 0 >;  max < 96, 23, 40 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 45, 40 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 96, 45, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
