   FloatingCylinder { position < 22, 49, 65 >; radius 1.38; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps  48000; startInactive true; }
}

ModelParameters
{
   useAnalyticalContactDetection true;  // PURE-ANALYTICAL variant: Kodam et al. (+ Guo et al.
                                        // corrections + this session's real edge-edge eq.
                                        // 82-101 implementation) cylinder-cylinder contact,
                                        // no GJK/EPA fallback at all.
   usePureAnalyticalCylinder      true;  // no Tier 1/Tier 2 safety net -- see
                                        // ModelParameters.usePureAnalyticalCylinder's own
                                        // doc comment (SimulationParams.h) for the risk this accepts.
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   // Explicit even though both already default to true (SimulationParams.h) -- an earlier bridge
   // run (mixed_75k) sank every floater to the domain floor regardless of density with
   // useBognerThreePhaseMEM=false (the pre-fix default), so this scenario keeps them explicit per
   // the lesson in test_bridge_v1_sphere_drip_lowwater_gas.prm's own header.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // OFF for this run -- see this file's own header for why (54 floaters x 100000 steps would be
   // an enormous per-subcycle CSV; not needed now that the tunnel-contact bugs it was diagnosing
   // are fixed and confirmed clean).
   logFloaterHistory              false;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // Left arch (wall-to-pier1 span, Y=0..10, width 10 -> radius 5): same construction as
   // the central arch, sized to its own span so the opening is a true semicircular
   // half-pipe (full width at the springing line Z=56, point at the crown Z=61).
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 0, 56 >; max < 67, 10, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 5, 56 >; max < 67, 5, 56 >; radius 5; }
      }
      NoSlip{}
   }

   // Central arch (pier1-to-pier2 span, Y=20..40, width 20 -> radius 10): full width at
   // Z=56, crown at Z=66.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 20, 56 >; max < 67, 40, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 30, 56 >; max < 67, 30, 56 >; radius 10; }
      }
      NoSlip{}
   }

   // Right arch (pier2-to-wall span, Y=50..60, width 10 -> radius 5): mirrors the left arch.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 50, 56 >; max < 67, 60, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 55, 56 >; max < 67, 55, 56 >; radius 5; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      // Z bound tightened from 150 to 90 to match this file's own reduced domainSize.z (was
      // harmlessly stale/oversized before, just clipped at the actual domain boundary).
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 90 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 90 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 90 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
