// test_bridge_v1_lowwater_bigjam_cylinders_pureanalytical_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// CYLINDER-FLOATER VARIANT of test_bridge_v1_lowwater_bigjam_gas.prm (the 108-cuboid-floater
// big-jam scenario, job 4137147 -- confirmed clean 100000-step run before that prm was later
// bumped to 162 floaters / 200000 steps for job 4139454). This file reverts to exactly that
// 108-floater layout (9 upstream aim points x 12 Z-staggered waves each, same positions and
// settlingSteps schedule) but swaps every FloatingBox for a FloatingCylinder of similar size:
// length 12 (matches the box's full X-extent exactly) and radius 1.38 (matches the box's 2x3
// cross-sectional AREA -- pi*r^2 = 6 -> r = sqrt(6/pi) -- rather than either half-extent alone),
// axis <1,0,0> so the cylinder's long axis points along the flow direction like the box did.
//
// FIRST TEST run (50000 steps) confirmed clean: activation, buoyancy, tunnel/pier contact all
// stable through the full release sequence, no launches, after the two fixes below. This is the
// FULL-LENGTH follow-up: timesteps 50000 -> 150000 (max settlingSteps still 48000, so this now
// leaves 102000 tail steps -- enough to actually observe persistent jam behaviour, not just
// correctness/stability of the shape swap).
//
// Two fixes applied before the clean 50k pass (kept here for the record):
//   - numSubCycles 10 -> 20: same DEM-integration-stability fix as the main bigjam prm (job
//     4139454's NaN-quaternion crash) -- see that file's own header for the full derivation.
//   - ComputeTunnelContacts (ParticleKernels.h): Cylinder floaters were STILL using the old
//     isotropic dist+effR arch-tunnel bound (no springing-line awareness, radial reach
//     dominated by the cylinder's 12-LU length rather than its 1.38 radius) -- the exact
//     per-corner/arc-endpoint rigor already applied to Box/Sphere floaters had explicitly NOT
//     been extended to Cylinder ("unused by any current scenario" at the time). Now fixed:
//     exact farthest-point-per-rim (paper_analytical::detail::farthestThetaOnCircleToLine),
//     springing-line-restricted the same way Sphere is.
//
// ANALYTICAL: useAnalyticalContactDetection=true, usePureAnalyticalCylinder=true. Every cylinder-
// cylinder contact goes through the closed-form Kodam/Guo/edge-edge dispatch with NO GJK/EPA
// fallback safety net at all -- this is the fully-analytical extreme, testing the new eq. 82-101
// edge-edge implementation (and the rest of the dispatch chain) under real coupled-physics load.
//
// Everything else (piers, arches, ArchTunnels, targetMeanVelocityMagnitude=0.01, low-water
// liquidHeightFactor=2.0, Re/Fr/We, restitutionCoefficient=0.3 wet-wood, model parameters) is
// verbatim from test_bridge_v1_lowwater_bigjam_gas.prm -- see that file's own header for the
// full derivation chain.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 90>;
   wavePeriods        1;
   liquidHeightFactor 2.0;  // low-water, unchanged -- see lowwater base's header; away-baseline absoluteLiquidHeight~49.1
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         150000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.3; // wet/waterlogged wood-wood -- these are floating logs, soaked, not dry timber
   numSubCycles 20; // 10 -> 20, same fix as the main bigjam prm (job 4139454's crash) -- see that
                     // file's own header for the full derivation.
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// xMin/xMax DELIBERATELY set to the piers' own straight-box span (61..67). Not mesa_pd bodies --
// consumed directly by ParticleKernels.h's ComputeTunnelContacts, which only engages the UPPER
// semicircle (Z >= center[2] = the springing line, 56) -- confirmed clean (0 spurious contacts,
// 100% of real contacts above the springing line) on both the lowwater run (job 4134882) and a
// dedicated raised-water run built specifically to force genuine arch interaction (job 4135755).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; }  // right arch
}

