// box_density_050_bogner_domain_matched_bigheel_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FEKKEN [2004] FLOATING-CUBE EQUILIBRATION — densityRatio 0.5 (the special/marginal case), BOGNER
// THREE-PHASE MEM + GRAVITY/VISCOSITY/DOMAIN MATCHED TO BOGNER & RUDE (2013) SEC. 3.3.1
// (verified against the actual paper, arXiv:1201.0351 -- see conversation), same setup as
// box_density_050_bogner_domain_matched_gas.prm, but with TWO things changed to probe the
// 45 deg heeled branch after that run's 2.86 deg seed decayed straight back to ~0 deg upright
// and stayed there for the full 300k steps:
//
//   1. initialTiltAngleDeg 2.86 -> 10 deg -- a larger seed heel. densityRatio 0.5 is the
//      symmetric/marginal case: 0 deg (upright) and 45 deg (corner-down) are both potential
//      equilibria for a square cross-section, separated by an unstable equilibrium expected
//      around the midpoint (~22.5 deg by symmetry). The small 2.86 deg seed used in the
//      original run sits well inside the upright basin of attraction, so it decayed back to
//      0 regardless of whatever the true 45 deg-branch stability turns out to be. 10 deg is
//      still short of that ~22.5 deg expected barrier, so this checks whether the basin of
//      attraction around upright is smaller than the naive symmetric estimate (i.e. whether
//      10 deg already tips past it) before committing to a seed beyond the barrier.
//   2. timesteps 300000 -> 50000 -- short exploratory run: only need to see which BASIN the
//      trajectory falls into (heel decreasing back toward 0 vs. increasing toward 45), not
//      full convergence. 50k steps was enough for the original run to clearly show its
//      decay trend within the first few thousand steps.
//
// NOTE (open question from the original run, not addressed here): box_density_025's run
// showed a slow, still-incomplete decay after the full 300k steps, plausibly because
// pinPosition/pinAxes<1,1,0> (translation pinned in X,Y) removes the sway-roll damping
// channel a free floating body needs to settle -- flagged in this project's own changes.md
// (2026-07-03) as "NON-PHYSICAL" for an analogous rolling-box test. This run keeps the same
// pinAxes<1,1,0> as the original (isolating the seed-angle question only); if the 45 deg
// branch still isn't reached, that pin is the next thing to revisit.
//
// Domain: <128, 60, 54> / cellsPerBlock <32, 20, 9> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 9 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 54>;
   wavePeriods        1;
   liquidHeightFactor 1.68709;
   floorHeightFactor  1.68709;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants (surfaceTension) valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526
   gravityOverride        7.5e-4;      // matches Bogner's g
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // 1x2x1 cuboid (halfExtents 8x16x8 -> edges 16x32x16, UNCHANGED from the
      // refined/baseline Fekken geometry). densityRatio 0.5 -> Fekken-predicted stable heel:
      // 45 deg from upright (marginal case). Seeded larger than the original 2.86 deg, but
      // still short of the expected ~22.5 deg unstable barrier (see header).
      position             < 64, 30, 27.0 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.5;
      settlingSteps        0;
      initialTiltAngleDeg  10;    // larger seed heel, still below the expected barrier (~22.5 deg)
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation           true;
      pinRotationAxes      < 1, 0, 1 >;   // free roll about Y (XZ plane); pin pitch (X) and yaw (Z)
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // no rhoHydStat subtraction at all (see header)
   useMemOnlyBuoyancy             true;   // no separate vSub*g force channel -- righting torque unaffected (see header)
   useAnalyticBoxBuoyancy        true;   // exact clip drives vSub/cbOff -> plane export + righting torque match it exactly
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the box
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Only Z (top/bottom) walls — X and Y are periodic (see BlockForestParameters),
   // so N/S borders are intentionally omitted; setupBoundaryHandling auto-skips
   // adding walls on periodic faces.
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 45 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 45 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 45 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
