// HOPPER GAP, 192 RODS, CAPPED PID.
// Channel 768 x 40 x 180, periodic in x (<64, 20, 30> blocks = 144 ranks / 2 nodes), PID-driven flow (target mean
// velocity 0.04). Two cylindrical pillars R 12 centred on the y walls at x = 384 leave a 16 LU gap.
// Floaters: 192 rods R 3, L 18, axis y: 2 across (y = 10 / 30) x 32 rows (x = 364 down to 116, pitch 8) x 3 layers
// (z = 10 / 25 / 45, densityRatio 1.2 / 1.0 / 0.5), held fixed for 500 steps. cylinderContactSkin 0.5 (pitch 8
// leaves a rod-rod gap of 2 > 2*skin); guardCurvatureInputs true (FD curvature skips uninitialised/non-finite neighbour
// normals, logged as [CURVATURE-GUARD]; a no-op on valid inputs).
// PID cap maxActuatingVariable 2.65e-6 = k a_ref with a_ref = 7.8e-7 (clean converged force of the centred-pillar
// channel, same domain and flow) and k = 1 + F / (a_ref L_x / g) = 1 + 24.6 / 10.3 = 3.4 for a freeboard F = 0.5 h0
// (h0 = 49.1): the forcing holds the discharge until the backwater would exceed half the water depth, then acts as a
// fixed force. The uncapped run needed a median 1.97e-6 (max 3.31e-6), so the cap binds only at the jam peaks.
// maxRamp stays 1e-4: the integral term accumulates only while |new - current| < maxRamp, so a small maxRamp would
// freeze the integral and leave a steady-state error; at the cap the windup is bounded by maxRamp.
// 100000 steps (~1.7 flow-throughs at the bulk velocity ~0.013); dense NaN scan over steps 8900..9100; discharge, wet
// area at the probes (x = 336 / 432, z = 40); fluid VTK (x 100..500, z 0..100) and floater VTK at 8 snapshot steps.

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // cap = 3.4 a_ref, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   denseNanScanEnabled           true;   // per-step NaN scan around the step where the uncapped series crashed
   denseNanScanFromStep          8900;
   denseNanScanToStep            9100;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

FloatingCylinders
{
   // Row 1 (X=364, 8 LU pitch) -- both Y columns, deep/mid/shallow.
   FloatingCylinder { position < 364, 10, 10 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.2; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 25 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1; settlingSteps 500; }
   FloatingCylinder { position < 364, 10, 45 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 0.5; settlingSteps 500; }
