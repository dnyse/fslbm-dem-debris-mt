// bogner_exact_3box_s16_rho0767_tilt26p565_resume400_to1k_hotspot_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] EXTENDED-RANGE companion to bogner_exact_3box_s16_rho0767_tilt26p565_resume400_hotspot_gas.prm
// (timesteps 400->450). That exact prm has now been run TWICE (jobs 4261250, 4261311): both times it
// ran clean straight through step 444 with NO crash -- a striking contrast with 3 SEPARATE "normal
// VTK" resume attempts (4261297/4261300/4261309) that all crashed at exactly step 444. This is now
// 2-for-2 clean with the widened hot-spot VTK (writeFrequency=1) active vs. 3-for-3 crashing without
// it -- consistent with the extra per-step VTK I/O's MPI collectives perturbing the floating-point
// path just enough to dodge the knife-edge instability at that step. This run extends the window from
// 400 to 1000 steps (was 450) to see whether the box stays stable further out once step 444 is
// dodged, or whether a similar instability eventually reappears somewhere else with more room to run.
//  * loadSnapshot true, storeSnapshot false (do not overwrite the staged checkpoint).
//  * timesteps 1000 (beginTimeStep=401 per step_400/simState.file).
//  * Everything else identical to the resume400_hotspot prm this extends: same widened hot-spot VTK
//    region (X=8,Z=26 / X=0,Z=25 columns, Y=0-8), writeFrequency=1.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  true;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              1000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 20, 16 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.7665;
      settlingSteps        0;
      initialTiltAngleDeg  26.565;
      comOffsetZ           0;
      pinPosition          false;
      pinRotation          false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   dataSliceFrequency      500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
         density;
      }

      // [Claude, 2026-09-24] widened to cover BOTH hot-spot columns (X=8,Z=26) and (X=0,Z=25),
      // Y=0-8, with margin -- NOT the original mid-width Y=20-21 plane.
      CellBB_filter_0 { min < 0, 0, 18 >;  max < 16, 10, 32 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
