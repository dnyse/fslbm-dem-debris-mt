// bogner_righting_scan2_s16_a16p5_gas.prm   (GENERATED by gen_bogner_righting_scan_prm.py -- edit the script, not this file)
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-19] FIXED-HEEL RIGHTING-MOMENT SCAN, heel 16.5 deg, s = 16 (Bogner 2017 Sec. 5.3.2 protocol, cube section 2s x s x s = 16x32x16).
// Purpose: measure the raw MEM torque on a HELD box and compare rho = 0.75 with rho = 0.25. Ideal theory: M_{1-rho}(alpha) = +M_rho(alpha), i.e. the rho=0.25 and rho=0.75 torque curves are IDENTICAL (checked on the ideal numbers in the
// generator). See gen_bogner_righting_scan_prm.py's docstring. NOT RUN YET.
//  * basin 130x40x40, lower half liquid, initial free surface at Z = 20.5 (fill level is initialised half a cell above the nominal 20); X and Y periodic; tau = 1/1.9, g = 0.00075.
//  * 2 boxes rho 0.75 / 0.25 at X = 32.5, 97.5, ALL at heel 16.5 deg about Y, each held (position AND rotation pinned in every axis) at the heave where its submerged
//    cross-section area equals rho*s^2: Z = 16.665, 24.335 for rho 0.75, 0.25 (ideal geometry, waterline 20.5).
//  * MEM-only buoyancy (useMemOnlyBuoyancy + useBognerThreePhaseMEM); useAnalyticBoxBuoyancy explicitly OFF (no analytic buoyancy).
//  * 20000 steps, then the floater-history state CSV (raw MEM hydroForce/hydroTorque of the local copy of each box) is logged for steps 19000..19300 only -- the CSV has blown the home
//    quota before, so the window is short and the fluid has 19000 steps to settle (acoustic damping is slow at tau=0.526).
//  * Domain 130x40x40 / cellsPerBlock <10,8,40> = 13x5x1 = 65 processes.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             100000000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              20000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;          // Bogner's tau = 1/1.9
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 32.5000, 20, 16.6647 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  16.5;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 1 >;   // held at the Archimedes heave for this rho and heel
      pinRotation          true;
      pinRotationAxes      < 1, 1, 1 >;   // held at the heel angle
   }
   FloatingBox
   {
      position             < 97.5000, 20, 24.3353 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.25;
      settlingSteps        0;
      initialTiltAngleDeg  16.5;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 1 >;   // held at the Archimedes heave for this rho and heel
      pinRotation          true;
      pinRotationAxes      < 1, 1, 1 >;   // held at the heel angle
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;   // explicitly OFF

   logFloaterHistory             true;    // per-rank floater-history/rank_<N>_state.csv (raw MEM hydroForce/hydroTorque), WINDOWED below
   floaterHistoryBaseFolder      floater-history;
   logFloaterHistoryStartStep    19000;
   logFloaterHistoryEndStep      19300;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       10000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 20, 0 >;  max < 130, 21, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
