// GENERATED by gen_hopper_stress_prms.py (--centred-startblock-only) -- edit the script.
// Centred pillar, extreme scale, capped PID, start block: as clog_centred_pillar_cappid_current_gas.prm, but the 100
// spheres start as one block at the upstream end of the domain and are all released at step 500, like the hopper
// start blocks, instead of the staggered release.
// Domain <768,40,180>, X periodic, Y walled, NoSlip top and bottom. Z was doubled from 90 to 180 because at Z = 90 the
// backed-up free surface upstream of the jam reached the ceiling; the pillar's BodyBC spans the full height.
// Obstacle: one CylinderPillar at (384, 20), radius 12 (60 % of the 40 LU width), leaving two 8 LU slits that are
// narrower than the 10 LU sphere diameter, so a single sphere cannot pass.
// Physics: target velocity 0.04 (high enough to drive spheres into the slits), Re 3100, Fr 1.31, We 15.62,
// useHardcodedUnits false so gravity, viscosity and surface tension are derived for this target velocity.
// liquidHeightFactor 2.0 is a low-water setting (waterline 49.13 LU), leaving little freeboard to pass over the jam.
// avgParticleDiameterOverride/dxSIOverride set the SI scaling without a bed file (useParticleBed false).
// Forcing: PID on, maxActuatingVariable capped at 2.65e-6 = k a_ref, with a_ref = 7.80e-7 the converged driving force
// of this layout without a jam (the fixed force of the PID-off runs) and k = 1 + F / (a_ref L_x / g)
// = 1 + 24.56 / 10.28 = 3.4 for a freeboard F = 0.5 h0. The uncapped PID needed ~8.8 a_ref (step 70000) and up to
// ~14 a_ref to hold the target velocity through the jam.
// Floaters: 100 spheres, radius 5, 11 rows at X = 13 + 11.5 k (k = 0..10) x 3 across (Y 6.5/20/33.5) x 3 layers sorted
// by density (Z 6: 1.5, Z 18: 1.0, Z 40: 0.5), plus one 0.5 sphere at (139.5, 20, 40): 34/33/33 as in the staggered
// case. Gaps >= 1.5 LU between spheres and walls, 1 LU to the floor; all start submerged and are held fixed until 500.
// cellsPerBlock <64,20,30> -> (12, 2, 6) = 144 ranks, 2 nodes. 150000 steps. ClogMeasurement probe pairs at
// X = 280/500 on both slit centrelines (Y = 4 and 36, z = 20) with flow rate and blockage ratio; VTK only at the
// fluid_field_snapshots steps (the hopper start-block steps).

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // capped at 3.4 a_ref, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         150000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see file header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // radius 12 = 60 % of the 40 LU width: two 8 LU slits, narrower than the 10 LU sphere diameter
   CylinderPillar { center < 384, 20, 45 >; radius 12; }
}
