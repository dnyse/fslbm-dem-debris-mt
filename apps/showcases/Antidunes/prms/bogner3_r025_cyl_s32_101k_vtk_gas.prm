// bogner3_r025_cyl_s32_101k_vtk_gas.prm -- companion to bogner3_r025_cyl_s32_100k_gas.prm, VTK-enabled,
// pitch/yaw NOW PINNED. [Claude, 2026-09-29] (per "in the cylinder case have the tilt x and z pinned and
// activate vtk output"): pinRotation true, pinRotationAxes <1,0,1> added (pins pitch about X and yaw about
// Z, leaves roll about Y free) -- matching the SAME pinning convention as the cuboid family (previously the
// free-cylinder round left ALL rotation free and found an unexplained large roll excursion at rho=0.5; this
// isolates roll alone to test whether that was genuine roll dynamics or pitch/yaw contamination of the
// logged tiltY field). Starting position.z UNCHANGED per-density (68.065), NOT unified across
// densities (per the request's own explicit scoping to "the spheres and cuboids" only). VTK ON
// (via the new discrete fluid_field_snapshots mechanism, steps 0,250,500,1000,2000,4000,8000,16000,32000,64000,100000; corrected CellBB filter for the doubled s=32 domain), 101000 steps (not 100000)
// for the same off-by-one safety margin as the other two companions. Real g_SI=9.81, guard off, single
// continuous run (no resume).
// ---- shared basin/physics header below is copied verbatim from bogner3_r025_cyl_s32_100k_gas.prm ----
// bogner3_r075_cyl_s32_100k_gas.prm -- companion to bogner3_r075_deep_s32_100k_gas.prm (the s=32 free CUBOID), same
// basin/physics/gravity/logging, FloatingBox replaced with a free FloatingCylinder (axis along Y,
// length 64 to match the cuboid's own y-extent = 2*halfExtents.y). [Claude, 2026-09-29] (per "setup
// the equilibrium runs for this but for the cylinder and the sphere again for all 3 densities, they
// can all start from the same z position, adjust the sizes accordingly, run for 100k with the
// waterline measurement etc included like in the cuboid case"): z position is FIXED to the cuboid's
// own already-computed heave z_c=52.085 for rho=0.75 (same basin, same water level WL0=60.0746), and
// the cylinder RADIUS is solved (not z) so the submerged fraction at that fixed z equals rho=0.75
// exactly (circular-segment area formula, bisection, independent of roll about the cylinder's own
// axis since a circular cross-section is rotationally symmetric) -- radius=19.778.
// No pinning at all (per explicit "for these we don't need to pin anything" -- pinPosition/
// pinRotation both default false): fully free 6-DOF float (pitch/yaw about the horizontal axis ARE
// physically meaningful for a cylinder, unlike roll about its own axis, which is trivial by
// symmetry), real g_SI=9.81 (gravityOverride 5.06585e-05, identical unit calibration to the whole
// bogner3_deep_s32 family, bedCopiesInX/Y=2), guard off, single continuous 100000-step run (no
// resume), no VTK, water-height logging on the same 12x3 grid every 250 steps as the cuboid run.
// ---- shared basin/physics header below is copied verbatim from bogner3_r075_deep_s32_100k_gas.prm ----
BlockForestParameters
{
   cellsPerBlock                 < 32, 15, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             50000;
   snapshotBaseFolder            snapshots_b3_r025_cyl_s32_101k_vtk;
}

DomainParameters
{
   domainSize         <192, 90, 120>;
   wavePeriods        1;
   liquidHeightFactor 10.0;   // nominal (doubled basin)
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              101000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // keep physical constants valid while U = 0; viscosity=0.000214026 fixed
   gravityOverride        5.06585e-05;  // solved for g_SI = 9.81 m/s^2 against job 3952542's dx_SI/dt_SI (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 2;   // FIX (2026-09-29): domainSize doubled -> bedCopies must double too, or avgParticleDiameter/dx_SI/dt_SI silently
   bedCopiesInY 2;   // rescale (getAvgDiameterScalingFactor, Utility.h) and gravityOverride no longer means g_SI=9.81. See job 4273521's own
                     // failure (avgParticleDiameter came out 12.0029 instead of 6.00146) and its retraction in THESIS_PLAN.md.
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // free cylinder (axis along Y, length 64 matches the cuboid's y-extent), rho=0.75, radius
      // solved so frac_submerged(19.778, z=52.085) == 0.75 exactly
      position             < 96, 45, 52.085 >;
      radius               19.778;
      length               64;
      densityRatio         0.25;
      settlingSteps        0;
      pinPosition          false;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
}
ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   repairDegenerateObstaclePdfs  false;   // Option B (obstacle-cell repair guard) OFF
   seedStreamPdfCloneOnFirstUse  false;   // Option A (scratch PDF clone seeding) OFF

   logDensityColumn              true;
   densityColumnBaseFolder       density-column;
   densityColumnX                5;
   densityColumnY                45;
   logDensityColumnStartStep     99000;
   logDensityColumnEndStep       100999;

   // fill-integrated water height on a 12 x 3 grid of columns (x = 4, 12, ..., 92; y = 7.5, 22.5, 37.5) every 250 steps over the WHOLE run
   logWaterHeight                true;
   waterHeightBaseFolder         water-height;
   waterHeightGridX              12;
   waterHeightGridY              3;
   waterHeightEveryNSteps        250;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     250;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       0;             // superseded by fluid_field_snapshots below (discrete steps, not uniform)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      // [Claude, 2026-09-29] FIX: these bounds were still sized for the ORIGINAL s=16/18 basin
      // (domainSize <96,45,60>) and silently only covered the front-lower QUARTER of the doubled
      // s=32 basin (<192,90,120>) -- harmless while writeFrequency was 0 (VTK off) in every prior
      // s=32 run. Kept here (though currently unused while fluid_field itself stays off) with the
      // corrected bounds for whenever the uniform block is re-enabled instead of/alongside snapshots.
      CellBB_filter_0 { min < 0, 43, 0 >; max < 192, 47, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   // [Claude, 2026-09-29] DISCRETE snapshot steps (per "implement the option so we can have a
   // discrete set of vtk that we can print instead of every thousand, like at 1k 2k 8k 16k 32k 64k
   // 100k"): new fluid_field_snapshots mechanism (SimulationParams.h VTKParams::snapshotsEnabled,
   // gated in VtkWriter.h's addVTKOutput) fires ONLY on the exact steps listed below -- dense early
   // (catches the fast initial settling transient) and widening spacing later, plus one frame
   // exactly at the intended 100000-step "end" mark. writeFrequency here is unused by the gating
   // logic itself but still required by vtk::initializeVTKOutput to construct the VTKOutput object.
   fluid_field_snapshots
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "0,250,500,1000,2000,4000,8000,16000,32000,64000,100000";

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 43, 0 >; max < 192, 47, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             0;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
