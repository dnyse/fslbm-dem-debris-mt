// sphere_only_81floaters_hardcodedgravity_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// 81 SPHERES (same all-sphere conversion of the proven-clean 81-floater grid
// as sphere_only_81floaters_realgravity981_gas.prm), using the PLAIN
// useHardcodedUnits default -- NO gravityOverride, NO relaxationRateOverride.
// This resolves to gravity=7.02618e-06, relaxationRate=1.99743 (Utility.h /
// SimulationParams.h's hardcoded reference values), which are themselves an
// EARLIER dynamically-computed result: the values the Fr-derived formula
// produces at this project's default config (U=0.02, Re=3100, Fr=1.31,
// We=15.6188), frozen into a constant so still-water (U=0) runs keep valid
// physical constants instead of the Fr-derived formula zeroing them out.
//
// This is the SAME gravity value already confirmed to run cleanly to
// completion in mixed_sed_worked.log (job 3856318, gravity=7.02618e-06
// logged directly) -- the very run this 81-floater layout's geometry was
// itself copied from. Included here as the third point of comparison
// alongside real 9.81 gravity (job 3996951, crashed ~step 9567) and
// Bogner's own gravity+viscosity (sphere_only_81floaters_bognergravity_gas.prm):
// same layout, three different gravity/viscosity regimes, isolating gravity
// magnitude (and the accompanying relaxationRate) as the variable.
//
// timesteps 100000 (unchanged). Domain: <128, 60, 180> / cellsPerBlock
// <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              100000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants valid while U = 0; NO gravityOverride
                                       // here -- uses the built-in hardcoded gravity=7.02618e-06,
                                       // relaxationRate=1.99743 (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 6, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 26, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 26, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
