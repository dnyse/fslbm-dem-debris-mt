// sphere_pillar_glance_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Sphere×CylindricalBoundary GLANCING-CONTACT test — part of the floater/pillar
// interaction test suite (see also: sphere_pillar_gap_pass_gas.prm,
// box_pillar_glance_gas.prm, box_pillar_gap_pass_gas.prm, box_pillar_corner_gas.prm,
// cylinder_pillar_gap_pass_gas.prm, cylinder_pillar_oblique_gas.prm; the JAM/clog
// case for a sphere is already covered by sphere_drop_two_pillars_gas.prm et al.).
//
// ONE pillar (not two): the sphere drifts downstream offset in Y so it clips the
// pillar's side rather than passing centred through a gap. This isolates the basic
// radial Sphere×CylindricalBoundary contact resolution (penetration depth, contact
// normal/point, push-off) from any two-pillar wedging effect.
//
// Geometry (absoluteLiquidHeight = 56.024, confirmed from run logs):
//   • Pillar: center (64, 30, 90), radius 8 → surface spans y=[22, 38].
//   • Sphere: radius 6, densityRatio 0.5 → 50% submerged equilibrium at z=56 (centre
//     on the free surface). Start (30, 18, 56): |Δy| to pillar centre = 12 LU <
//     r_sphere + r_pillar = 14 LU → up to 2 LU of overlap at the moment of closest
//     (x-aligned) approach — a real but shallow glancing hit, not a ram.
//   • Expected outcome: brief nonzero F_contact/penetrationDepth as the sphere
//     passes x≈64, sphere deflected in -Y, then contact clears and the sphere
//     continues downstream (x periodic). No sustained/growing overlap.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         40000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 64, 30, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // radius=6, offset 12 LU from the pillar centreline (< r_sphere+r_pillar=14) →
      // glances the pillar surface instead of a head-on stop.
      position     < 30, 18, 56 >;
      radius       6;
      densityRatio 0.5;
      settlingSteps 500;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 30, 0 >; max < 64, 30, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
