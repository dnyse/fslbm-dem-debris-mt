// pont_ferroviere_rue_goffontaine_realscale_genesis_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// DEBRIS SCENARIO 2/3 -- "Genesis": debris spawned upstream and left free to drift and jam wherever
// the hydraulics/geometry actually push it -- built on top of
// pont_ferroviere_rue_goffontaine_realscale_gas.prm's validated bridge geometry (see that file's own
// header for the full geometry/resolution derivation -- unchanged here). Composition/volume matches
// the record (see pont_ferroviere_rue_goffontaine_realscale_reconstruction_gas.prm's header for the
// full derivation -- unchanged: 60 m^3, 40% natural wood / 40% rubble / 20% anthropogenic wood, one
// main trunk). UNLIKE the reconstruction scenario, spawn positions are NOT pre-biased toward the
// record's own left-bank (opening 1) location -- pieces are spawned in equal thirds at each of the 3
// openings' own Y-centres, upstream of the piers. This tests whether the record's observed left-bank
// concentration is an EMERGENT hydraulic/geometric result, or requires the initial-condition bias that
// scenario 1 imposes directly.
// GENERATED by gen_pont_ferroviere_debris.py (this dir) -- same 192 pieces as the reconstruction
// scenario, now spawned at aim_x = 898.5 (≈313 LU / ~9.5m upstream of the piers' leading face X=1212),
// round-robined across the 3 opening-centre aim points, staged in 400-step waves per aim point
// (startInactive + staggered settlingSteps, same convention as every prior bridge scenario in this
// project -- avoids the step-0 collision/mapping pile-up that sharing one spawn point across many
// pieces would otherwise cause). Last release wave at t=27600.
// TIMING BUDGET: at targetMeanVelocityMagnitude=0.02 LU/step (reused reference regime, NOT an
// independently calibrated real-Vesdre velocity -- see the base file's own header), travel time from
// aim_x to the piers ≈ 313.5/0.02 ≈ 15,700 steps. Last wave released at t=27600 arrives ≈t=43,300;
// timesteps bumped 50000->80000 (vs the base file) to give ~35,000 steps after the last arrival for a
// jam to actually form and hold, or to reveal that it doesn't.
// COST WARNING: this is a LONGER run than the base file's already-expensive 64-node/4608-process/
// ~6-7h-per-50000-steps budget -- at 80000 steps this scales to roughly ~10-11h wall time, on top of
// whatever fix is applied for the base file's own two prior failures (disk-quota-exceeded creating VTK
// output, then a downstream file-open failure at the same likely root cause -- see conversation/job
// history 4075922, 4081060). DO NOT submit this without first validating the base geometry-only run
// completes cleanly at the intended VTK output settings.
//
// SIMPLIFICATIONS: identical list to
// pont_ferroviere_rue_goffontaine_realscale_reconstruction_gas.prm's header (piece sizing, rubble
// buoyancy/entrainment, bank skew, arch shape) -- not repeated here.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 112, 44, 54 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <2688, 1056, 432>;
   wavePeriods        1;
   liquidHeightFactor 0.280234;
   floorHeightFactor  0.405302;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         80000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out_pont_ferroviere.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only). Radius 33 LU = 2 m real pier
// width. center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 1212, 348.15, 173.6 >; radius 33; }
   CylinderPillar { center < 1476, 348.15, 173.6 >; radius 33; }
   CylinderPillar { center < 1212, 707.85, 173.6 >; radius 33; }
   CylinderPillar { center < 1476, 707.85, 173.6 >; radius 33; }
}

Pillars
{
   Pillar { center < 1344, 348.15, 173.6 >; halfExtents < 132, 33, 173.6 >; }
   Pillar { center < 1344, 707.85, 173.6 >; halfExtents < 132, 33, 173.6 >; }
}

// One entry per real opening (all three 8.9 m -> radius 146.85 LU). xMin/xMax DELIBERATELY set to
// the piers' own straight-box span (1212..1476, i.e. pier x_center +- x_half), NOT the deck's full
// 10 m streamwise width (1179..1509, what this used to be) -- recesses each arch collar's flat
// leading/trailing face behind the piers' rounded nose, so the nose visibly sticks out past the
// deck edge instead of the deck being flush with the nose tip. Tuned/verified offline in
// bridge_layout_optimizer.py / bridge_voxel_view.py / bridge_voxel_render_full.py (3D voxel review
// at true 1 LU simulation resolution). The LBM BodyBC arch boxes below are updated to the SAME
// span, so the DEM contact geometry (what floaters actually collide with) never diverges from
// what's actually painted solid in the fluid.
ArchTunnels
{
   ArchTunnel { center < 0, 168.3, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 1 (left bank side)
   ArchTunnel { center < 0, 528.0, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 2 (centre)
   ArchTunnel { center < 0, 887.7, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 3 (right bank side)
}

