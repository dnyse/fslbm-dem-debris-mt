// Data source of the Kodam-style cylinder wall-impact figures (Section 5.2, "Dynamics of a Single Contact":
// dimensionless rebound and angular speed against the impact angle, as Kodam et al. 2010, Part II, Figs. 4-5).
// Same setup as dem_validation_wall_cylinder_kodam_test1.prm (their Table 1 geometry, Sec. 3.1 protocol), widened to
// 0-90 deg in 5 deg steps (19 points). useRotationalEffectiveMass false: the translational-effective-mass series,
// which departs from the analytical curve away from tilt 0, 56.5 and 90 deg. Paired with the _rotational and _fine
// variants in the same figure.
DEMValidation{
    testCase wallImpactCylinder;
    useRotationalEffectiveMass false;
    dt 0.0002;

    cylinderRadius 4.0;
    cylinderLength 5.3;
    density 1.0;
    restitutionCoefficient 0.85;
    frictionCoefficient 0.0;
    poissonsRatio 0.35;
    collisionTime 0.01;

    impactSpeed 1.0;
    tangentialSpeedFraction 0.0;
    tiltStartDeg 0.0;
    tiltEndDeg 90.0;
    tiltStepDeg 5.0;

    toleranceRelError 0.02;
    // expectFail true: translational effective mass at dt = collisionTime/50 is the documented counterexample
    // (the _rotational variant passes); the run exits 0 only if the sweep fails.
    expectFail true;
    vtkSpacing 0;
    outputBaseName wall_impact_cylinder_kodam_sweep_translational;
}
