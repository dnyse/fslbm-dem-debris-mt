// sphere_sedimentation_showcase_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// PARTICLE IMPACT AND SEDIMENTATION AT A FREE SURFACE (100 spheres, v3 --
// column-uniform densities, real 9.81 m/s^2 gravity, Bogner three-phase MEM
// buoyancy). Still water, no pillars, no flow forcing, X and Y periodic (no
// side walls at all, only the Z floor/ceiling).
//
// Sizing: radius 4.5 LU (= 3 x 1.5, up from the original v1 radius-3 test), grid
// spacing scaled proportionally to 12 LU (up from 8) to keep the same relative
// clearance. This directly targets the earlier v1 finding: small (r=3), near-
// neutral spheres had a buoyant force (~r^3) too weak relative to the ambient
// dynamic-force noise and local flow currents (~r^2-ish scaling) to reliably
// reach their correct equilibrium, and some got stuck sinking or trapped near
// gas pockets/denser neighbours for the entire run. A 1.5x bigger radius gives
// ~3.4x more buoyant "muscle" (volume, r^3) against roughly the same-order
// ambient noise -- expected to settle far more decisively and reach the correct
// equilibrium depths within the same timestep budget.
//
// Densities: only 3 classes -- 0.5 (light), 1.0 (neutral), 2.0 (heavy) -- a
// wider, cleaner spread than v1's 5 closely-packed values, so each class's
// equilibrium behaviour is easy to tell apart. v3 CHANGE: assigned via
// densities[i % 3] over the X grid index i ONLY (not (i+j+k) % 3 as in v2) --
// every sphere sharing an X position now shares the same density, so a YZ
// slice at fixed X is density-uniform, deliberately reversing v2's explicit
// "avoid uniform-density columns" choice at the user's request. X=40/76 -> 0.5,
// X=52/88 -> 1, X=64 -> 2.
//
// GRAVITY: gravityOverride solved so the lattice gravity converts back to true
// Earth gravity 9.81 m/s^2 under THIS domain's dx_SI (domainSize[0]=128,
// bedCopiesInX=1, current BedGeneration.prm's domainSize_SI[0]=
// 0.046424848318763846): scalingFactor=128/0.046424848318763846=2757.144,
// dx_SI=1/scalingFactor=0.00036269412749034255, dt_SI=(viscosity/viscosity_SI)*
// dx_SI^2=2.8109509452478946e-05 (viscosity=0.000214026 fixed by
// useHardcodedUnits, viscosity_SI=1.0016e-6), gravityOverride = 9.81 * dt_SI^2 /
// dx_SI = 2.13715005840044e-05. Verified against the sphere_stillwater_
// realgravity981_3xsphere_gas.prm precedent's own logged dx_SI/dt_SI at
// domainSize[0]=96, cross-checked to ~5 significant figures.
//
// BUOYANCY: useBognerThreePhaseMEM true, reproducing Bogner & Rude (2013)'s
// original three-phase MEM force exactly as published (paired with
// useFillWeighting/useMemOnlyBuoyancy, both already true by default).
//
// Grid: 5 (X) x 4 (Y) x 5 (Z) = 100 spheres, spacing 12 LU. Y reduced from 5->4
// (vs. a naive 1.5x scale-up of the v1 5x5x4 layout) specifically to keep safe
// clearance to the periodic Y wrap: at radius 4.5 and spacing 12, a 5-wide Y
// grid would occupy 57 of the domain's 60 LU (only 1.5 LU clearance each side,
// too tight); 4-wide keeps occupied width at 45 LU (15 LU total clearance).
// Verified pairwise: min clearance 3.0 LU across all 4950 pairs, no overlaps.
// X occupied width 57 LU (vs domain 128, periodic -- ample clearance). Bottom
// layer centred at z=64 (absoluteLiquidHeight ~56.024; bottom sphere surface at
// 59.5, ~3.5 LU clear of the water) -- "right above the waterline", same intent
// as v1. Top layer centred at z=112, well clear of the domain ceiling (180).
//
// No pinning of any kind: spheres are free to translate, rotate, and collide
// via the normal sphere-sphere DEM contact path as they fall and separate.
//
// timesteps 50000.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
   gravityOverride   2.13715005840044e-05;  // solved for g_SI = 9.81 m/s^2, see header derivation
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

