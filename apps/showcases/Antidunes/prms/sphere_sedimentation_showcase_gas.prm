// sphere_sedimentation_showcase_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// PARTICLE IMPACT AND SEDIMENTATION AT A FREE SURFACE (100 spheres, mixed
// densities) — v2: LARGER spheres, only 3 density classes (light/neutral/heavy).
// Still water, no pillars, no flow forcing, X and Y periodic (no side walls at
// all, only the Z floor/ceiling).
//
// Sizing: radius 4.5 LU (= 3 x 1.5, up from the original v1 radius-3 test), grid
// spacing scaled proportionally to 12 LU (up from 8) to keep the same relative
// clearance. This directly targets the earlier v1 finding: small (r=3), near-
// neutral spheres had a buoyant force (~r^3) too weak relative to the ambient
// dynamic-force noise and local flow currents (~r^2-ish scaling) to reliably
// reach their correct equilibrium, and some got stuck sinking or trapped near
// gas pockets/denser neighbours for the entire run. A 1.5x bigger radius gives
// ~3.4x more buoyant "muscle" (volume, r^3) against roughly the same-order
// ambient noise -- expected to settle far more decisively and reach the correct
// equilibrium depths within the same timestep budget.
//
// Densities: only 3 classes now -- 0.5 (light, ~2x more buoyant than the
// closest v1 value), 1.0 (neutral), 2.0 (heavy, denser than the densest v1
// value) -- a wider, cleaner spread than v1's 5 closely-packed values, so each
// class's equilibrium behaviour is easy to tell apart. Assigned via
// densities[(i+j+k) % 3] over the (i,j,k) grid indices -- mixing across ALL
// THREE axes, not just flattened index order, specifically to avoid the v1 bug
// where a flat idx%N assignment with grid dims that are multiples of N
// degenerated into uniform-density COLUMNS instead of genuine 3D mixing
// (confirmed fixed here: every X-column contains all three densities).
//
// Grid: 5 (X) x 4 (Y) x 5 (Z) = 100 spheres, spacing 12 LU. Y reduced from 5->4
// (vs. a naive 1.5x scale-up of the v1 5x5x4 layout) specifically to keep safe
// clearance to the periodic Y wrap: at radius 4.5 and spacing 12, a 5-wide Y
// grid would occupy 57 of the domain's 60 LU (only 1.5 LU clearance each side,
// too tight); 4-wide keeps occupied width at 45 LU (15 LU total clearance).
// Verified pairwise: min clearance 3.0 LU across all 4950 pairs, no overlaps.
// X occupied width 57 LU (vs domain 128, periodic -- ample clearance). Bottom
// layer centred at z=64 (absoluteLiquidHeight ~56.024; bottom sphere surface at
// 59.5, ~3.5 LU clear of the water) -- "right above the waterline", same intent
// as v1. Top layer centred at z=112, well clear of the domain ceiling (180).
//
// No pinning of any kind: spheres are free to translate, rotate, and collide
// via the normal sphere-sphere DEM contact path as they fall and separate.
//
// timesteps 100000.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

