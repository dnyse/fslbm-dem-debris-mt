// pinscan_sphere_R12_real_f075_sig0_gas.prm  -- generated by gen_pinned_sphere_scan.py (do not hand-edit)
// [Claude, 2026-09-28] FULLY PINNED sphere r=12 at z=55.716 (nominal submerged fraction 0.75, waterline 59.8831),
// real gravity, still water, 12000 steps. Measures mean MEM F_hydro_z ([FloaterForces], every 250 steps)
// vs rho*g*V_sub to test the g-independent ~2-3% excess-buoyancy hypothesis (THESIS_PLAN.md 1a).
BlockForestParameters
{
   cellsPerBlock                 < 16, 45, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             100000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 135, 120>;
   wavePeriods        1;
   liquidHeightFactor 9.968100;   // nominal
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              12000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // keep physical constants valid while U = 0; viscosity=0.000214026 fixed
   gravityOverride        5.06585e-05;  // solved for g_SI = 9.81 m/s^2 against job 3952542's dx_SI/dt_SI (see header)
   surfaceTensionOverride 0.0;   // surface-tension test: nominal lattice value 0.000849592
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 3;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      position     < 48, 67.5, 55.716 >;
      radius       12;
      densityRatio 0.5;
      settlingSteps 0;
      pinPosition  true;
      pinAxes      < 1, 1, 1 >;
      pinRotation  true;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;

   logDensityColumn              true;
   densityColumnBaseFolder       density-column;
   densityColumnX                5;
   densityColumnY                5;
   logDensityColumnStartStep     10000;
   logDensityColumnEndStep       11999;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     250;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       100000000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 67, 0 >;   max < 96, 68, 120 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 135, 120 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 96, 135, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
