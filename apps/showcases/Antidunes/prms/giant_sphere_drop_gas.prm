// giant_sphere_drop_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Free-settling test: ONE floating sphere (radius 15 LU), NO pillars, dropped from
// rest just above the free surface into STILL water, to observe where it comes to
// rest and verify the 50%-submerged buoyancy equilibrium.
//
// Differences vs. giant_sphere_gas.prm:
//   • No CylinderPillars / no Cylinder BodyBC  → clean, obstacle-free tank.
//   • X AND Y periodic (no side walls) → no wall interaction with the floater.
//   • Sphere RELEASED FROM REST (own velocity = 0) from a LOW drop point:
//     centre z = 80 → bottom at z=65, i.e. ~9 LU above the surface (≈ z=56) → gentle
//     entry (a high drop from z=100 with r=20 plunged deep and broke the free-surface
//     reconstruction → NaN). Held fixed for settlingSteps while the hydrostatic column
//     relaxes, then released to settle.
//
// IMPORTANT — why targetMeanVelocityMagnitude is NOT set to 0:
//   U = targetMeanVelocityMagnitude is the MASTER velocity scale of the whole
//   non-dimensionalisation, not just the channel-flow speed. ComputedParams derives
//   EVERYTHING from it (SimulationParams.h:337-345):
//       viscosity      = U·h/Re            → U=0 ⇒ 0  ⇒ relaxationRate = 2.0 (τ=0.5,
//                                            zero viscosity, LBM blows up instantly)
//       gravity        = (U/Fr)²/h         → U=0 ⇒ 0  ⇒ the sphere NEVER FALLS
//       surfaceTension = U²·h/We           → U=0 ⇒ 0
//       dt_SI          = (viscosity/ν_SI)·dx² → U=0 ⇒ 0
//   Gravity is applied vertically (−z) to the particle via the acceleration field
//   (SetupStages.h:123), so it is tied to U. Hence U is kept at 0.02.
//   The 50%-submerged equilibrium is set by densityRatio alone and is INDEPENDENT
//   of the current magnitude, so this still cleanly answers "where does it rest".
//   The sphere will advect downstream in the periodic X while it settles in Z; read
//   the rest depth from Z (maxParticlePos_z / vtk), not X.
//
//   NOTE: a higher drop means a faster impact (v grows ~sqrt(drop height)). The
//   contact-line NaN that this used to trigger is now avoided by the Bogner
//   hasUnknown→interface fallback + D3Q27 gas check + SimpleBB dry-link guard.
//   Raise/lower the z below to make the drop more/less aggressive.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;   // X and Y periodic (no side walls); only top/bottom are walls
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;        // master velocity scale: gravity = (U/Fr)²/h. 1e-6 made
                                            // g ≈ 2.5e-14 → sphere frozen mid-air; 0.02 → real g ≈ 1e-5.
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      // Sphere: radius=15 LU (a bit smaller than 20 → gentler plunge / smaller entrained cavity).
      // Centre at (30,30,80): bottom at z=65, i.e. ~9 LU above the surface (z≈56) → a low, gentle
      // drop. Held fixed for settlingSteps, then released to settle to the 50%-submerged equilibrium.
      // Y is periodic now, so no wall-clearance constraint.
      position     < 30, 30, 80 >;
      radius       15;
      densityRatio 0.5;
      settlingSteps 500;    // brief hold for the hydrostatic column to relax before release
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // N/S (y) borders removed: Y is now periodic (see BlockForestParameters.periodicity).
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}