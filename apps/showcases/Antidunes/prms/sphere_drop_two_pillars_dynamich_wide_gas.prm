// sphere_drop_two_pillars_dynamich_wide_gas.prm — dynamic-H retry with a WIDE ambient plane-fit net.
// ─────────────────────────────────────────────────────────────────────────────
// Same two-pillar CLOGGING scenario as sphere_drop_two_pillars_dynamich_gas.prm (pillar gap
// 30 − 8 − 8 = 14 LU is NARROWER than the sphere's 20 LU diameter — the sphere geometrically cannot
// pass between the pillars, it can only wedge/jam against both from the upstream side). TWO changes
// vs that run, both aimed at the "dynamic-H self-pollution" failure found in dynamic.log:
//
//   1. floaterPlaneFitRadiusFactor raised from the 1.8 default (planeLatR = 18 LU for this r=10
//      sphere) to 5.0 (planeLatR = 50 LU). The earlier run showed H(EMA) diving from 61.0 to 50.9
//      between steps 51000-57000 in lock-step with the sphere's own descent — the "ambient" ring was
//      reading the sphere's own wake, not an independent reference. A 50 LU reach should sit well
//      outside the sphere's local wake/crater and any pillar-wake recirculation, while still being
//      local enough to represent the pillar-adjacent pile-up rather than a whole-domain average.
//      (Runtime note: this widens the per-floater plane-fit search box substantially — expect a
//      measurable but not prohibitive slowdown for this single-floater scenario.)
//   2. timesteps raised from 60000 to 100000 (still 30000 held + now 70000 free-floating, vs 30000
//      before) to give the wedge equilibrium much more time to damp out and actually settle, rather
//      than being cut off mid-oscillation.
//
// This is a wedge/clogging geometry, NOT a free-floating-equilibrium test — with the gap narrower
// than the sphere, it can never reach an unobstructed 50%-submerged floating state; the expected
// "success" outcome is a STABLE wedge submersion (buoyancy + gravity + pillar contact all balanced,
// no runaway toward 100%/floor), roughly in the same submersion band the phantom-force-correction fix
// converged to for the same base scenario (~70-75%), not a literal 50%.
//
// Compare [DynamicH] H(EMA) here against the narrow-net run in dynamic.log — watch whether H stays
// close to the flat/pillar-pile-up baseline (~56-64) through the steps 51000-57000 window instead of
// diving with the sphere, and whether subm%/pos settle rather than keep oscillating past step 60000.
//
// Geometry (waterline ≈ z=56 flat / piles to ~62-65 at the pillars):
//   • Sphere centre (30,30,78): bottom at z=68, ~5 LU above the free surface at start.
//   • Pillars at (64,15,r=8) and (64,45,r=8).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;   // 30000 held + 70000 free-floating after release (was 30000+30000)
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Cylinder pillars — same geometry as the baseline. Clear gap (30 − 8 − 8 = 14 LU) < sphere diameter
// (20 LU): the sphere cannot pass through, only wedge against both — the clogging scenario under test.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // Normal sphere: radius=10 LU, too large for the 14 LU pillar gap (models a clogging body).
      // densityRatio 0.5. settlingSteps=30000: held FIXED while flow develops and the pillar pile-up
      // forms, then released to drift downstream and jam against the pillars.
      position     < 30, 30, 78 >;
      radius       10;
      densityRatio 0.5;
      settlingSteps 30000;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePhantomForceCorrection     false;  // isolated: dynamic-H alone, not combined with Option A
   useDynamicReferenceHeight     true;   // the fix under test — see file header
   floaterPlaneFitRadiusFactor   5.0;    // WIDE ambient net (default 1.8) — the change under test
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
