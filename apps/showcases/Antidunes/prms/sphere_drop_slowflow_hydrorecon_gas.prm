// sphere_drop_slowflow_hydrorecon_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FIX TEST for the dynamic (FormerMO) phantom. IDENTICAL to sphere_drop_slowflow_nopillars_gas.prm
// (the (a) baseline) EXCEPT  useHydrostaticReconstruction true  in ModelParameters: each cell
// uncovered by the moving sphere is re-seeded to the depth-consistent hydrostatic density
// ρ_hyd(z) = 1 + 3·a_z·(z − H) instead of the EquilibriumReconstructor's fill-blind unweighted mean.
//
// This SUPERSEDES the earlier fill-weighted (Σφρ/Σφ) attempt, which was a confirmed no-op: the
// waterline interface cells have NEGATIVE fill drift, so Σφ ≈ 0 and ρ_W collapsed. ρ_hyd(z) uses no
// φ at all and so is immune to that drift. A/B this against the baseline:
//   • F_hydro_z at low submersion should drop toward 0 (the over-density lift removed),
//   • the settled submersion should move from ~43% toward the physical ~50%,
//   • [RECON-DENSITY-CHECK] should fire far less (it now reads the corrected density).
//
// ── original baseline header ──
// Phantom-force CONTROL run (scenario 2). Same sphere, same relative drop height,
// same release delay as sphere_drop_two_pillars_gas.prm, but:
//   • NO pillars                       → removes the "dammed surface" phantom source
//                                        (the pillar water-hump the flat hydrostatic
//                                        reference under-counts).
//   • Reduced fluid speed              → targetMeanVelocityMagnitude 0.02 → 0.005,
//                                        so we test whether the phantom lift survives
//                                        with much weaker flow / wake.
//   • useHardcodedUnits true           → viscosity / gravity / surface tension stay
//                                        at the reference values (the U=0.02 numbers),
//                                        so REDUCING the velocity target does NOT
//                                        rescale gravity. The drop physics is therefore
//                                        IDENTICAL to scenario 1 — only the flow differs.
//
// Hydro-force submersion scaling is still DISABLED in ParticleKernels.h, so the raw
// MEM force (phantom included) reaches the sphere. Watch [FloaterForces] F_hydro_z at
// low submersion and [FORMERMO-UNKNOWNS] for the unknown counts, exactly as scenario 1.
//
// Geometry (waterline ≈ z=63):
//   • Sphere centre (30,30,78): bottom z=68, ~5 LU above the surface (same as scenario 1).
//   • Held FIXED for 30000 steps, then released ("dropped").
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.005;   // reduced flow (scenario 1 used 0.02)
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         60000;   // 30000 held + 30000 free-floating after release (same as scenario 1)
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;     // keep gravity/viscosity/surfaceTension fixed while the velocity target drops
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// No CylinderPillars block — this control run has a clean, obstacle-free tank.

FloatingSpheres
{
   FloatingSphere
   {
      // Same as scenario 1: radius 10, centre (30,30,78) (bottom z=68 ≈ 5 LU above the
      // z≈63 surface), densityRatio 0.5. settlingSteps 30000: identical release delay.
      position     < 30, 30, 78 >;
      radius       10;
      densityRatio 0.5;
      settlingSteps 30000;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useHydrostaticReconstruction  true;   // THE FIX under test (baseline run leaves this false)
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   // No BodyBC cylinders — pillars removed.
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
