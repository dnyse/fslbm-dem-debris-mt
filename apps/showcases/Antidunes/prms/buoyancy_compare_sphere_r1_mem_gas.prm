// buoyancy_compare_sphere_r1_mem_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Thesis item 1b (THESIS_PLAN.md): MEM hydrostatic buoyancy vs. analytical-subtraction comparison.
// MEM method: useMemOnlyBuoyancy=true, useBognerThreePhaseMEM=true (both default, explicit for clarity).
//
// Shape: sphere, resolution level R=1 (domainSize/floater size scaled by R, cellsPerBlock FIXED,
// numBlocks/processes scaled by R^3 instead -- see below) from the
// R=1 baseline; physical scenario identical across R). Both useMemOnlyBuoyancy/useBognerThreePhaseMEM set together per file header Finding 1.
//
// Domain: <48,48,96> / cellsPerBlock <16,16,12> = 3x3x8 = 72 processes
// (1 node(s) @ 72 cores each, `singlenode` partition). cellsPerBlock is FIXED at <16,16,12>
// across every resolution level (not scaled with R) -- numBlocks/process count grows as R^3 instead,
// so each rank's own workload stays roughly constant across resolutions (confirmed necessary: R=1
// took ~76s end-to-end; scaling cellsPerBlock with R on a fixed 72 ranks would have made R=4 take
// ~1000x longer). periodicity <1,1,0> (X AND Y periodic -- no production-scale footprint needed,
// just one floater rising in undisturbed still water; cross-section ~3x the floater's own diameter,
// the minimum avoiding self-image interaction). liquidHeightFactor raised to 6 (from the production
// value 2.862) for a generous liquid column so the floater has real room to rise. Floater centered
// at <24,24,41.5> (X,Y = domain center; Z = floor + ~1.05x its own half-extent, just clear of
// the solid floor). targetMeanVelocityMagnitude=0 -- water genuinely at rest, no flow forcing at all.
//
// inFileName references the REAL generated bed (BedGeneration_buoyancy_r1.prm, cluster job) --
// avgParticleDiameter/dx_SI are read naturally from its header via
// Utility.h::getAvgDiameterScalingFactor, NOT an override (per explicit instruction). Confirmed from
// the real generated file (245 spheres, avg diameter_SI=0.00289997651976604, identical across all
// three resolutions since it's a genuine physical/SI quantity): gravityOverride below is computed
// from the confirmed dx_SI at this resolution (dt_SI = viscosity_LU/viscosity_SI * dx_SI^2,
// viscosity_LU=0.000214026 under useHardcodedUnits=true; gravityOverride = 9.81*dt_SI^2/dx_SI).
//
// `timesteps` below is calibrated (not guessed) -- see THESIS_PLAN.md's own Approach step 4: the R=1
// calibration run (job 4222985) measured the real breach step (sphere top reaching the waterline) at
// ≈3790; final timesteps = 2600 at R=1 (≈70% margin below that), scaled by R^2 for R=2/4 (dt_SI
// shrinks as 1/R^2, so the same PHYSICAL time budget needs R^2 more lattice steps).
// IMPORTANT: the log's own `subm=` field CANNOT detect a breach in either arm of this comparison
// (see THESIS_PLAN.md's own Approach step 4 for why) -- verify via `pos.z` directly against the
// known waterline height instead.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 16, 12 >;
   periodicity                   < 1, 1, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <48, 48, 96>;
   wavePeriods        1;
   liquidHeightFactor 6;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water, no flow forcing at all
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         2600;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   gravityOverride   2.137150014e-05;   // true g_SI=9.81 m/s^2 -- see file header derivation
}

ParticleParameters
{
   inFileName spheres_out_buoyancy_r1.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 24, 24, 41.5 >; radius 8; densityRatio 0.5; settlingSteps 0; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;   // MEM method -- see file header
   useMemOnlyBuoyancy            true;   // MEM method -- see file header
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     10;           // fine-grained position/velocity tracking
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       10000000000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
