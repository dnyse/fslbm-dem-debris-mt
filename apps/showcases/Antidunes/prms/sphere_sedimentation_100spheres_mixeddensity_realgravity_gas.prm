// sphere_sedimentation_100spheres_mixeddensity_realgravity_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// PARTICLE IMPACT AND SEDIMENTATION AT A FREE SURFACE -- MIXED-DENSITY VARIANT
// (100 spheres, real 9.81 m/s^2 gravity, Bogner three-phase MEM buoyancy).
// Same domain, radius, spacing, and positions as
// sphere_sedimentation_showcase_gas.prm (v3, column-uniform densities) --
// this run REVERTS to the v2 3D-mixed density scheme (densities[(i+j+k)%3]
// over X/Y/Z grid indices, avoiding uniform-density columns/rows) instead of
// v3's densities[i%3] column-uniform scheme.
//
// Rationale: the v3 crash (job 3996320, real gravity, ~step 9524/50000: NaN
// hydrodynamic force -> quaternion assertion failure near first water
// impact) happens with entire X-columns of spheres sharing one density,
// meaning e.g. all X=64 spheres (densityRatio 2, heaviest) fall and impact
// together, is a locally concentrated, coherent high-density impact front.
// Mixing densities per-sphere breaks up that spatial coherence -- adjacent
// spheres now differ in density/buoyancy/fall behaviour, so the impact at
// any given point in the domain is less synchronized and less locally
// severe, testing whether that coherence (not the gravity value itself) was
// driving the instability.
//
// GRAVITY: identical gravityOverride to the column-uniform 100-sphere real-
// gravity run -- same domain <128,60,180>, same bed file, same dx_SI/dt_SI
// derivation. gravityOverride = 2.13715005840044e-05 (solved for
// g_SI = 9.81 m/s^2).
//
// timesteps 30000 (reduced from 50000).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
   gravityOverride   2.13715005840044e-05;  // solved for g_SI = 9.81 m/s^2, see header derivation
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

