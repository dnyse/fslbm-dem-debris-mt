// two_cylinder_floater_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// ONE normal-sized floating SPHERE (radius 8 LU, densityRatio 0.5) released upstream
// of TWO cylinder pillars and swept downstream by the +X flow into them — the
// single-body clogging analog of twenty_floaters_pillar_gas.prm.
//
//   • X periodic, Y NoSlip walls; flow advects in +X at U = 0.02.
//   • Pillars at (64,15,90) and (64,45,90), r=8 → inter-pillar gap y∈[23,37] (14 LU).
//   • Sphere starts at (15,30,58): upstream (x=15), centred on the gap (y=30), ~2 LU
//     above the free surface (z≈56) → ~half submerged. Diameter 16 > the 14-LU gap →
//     it jams between the piers after ~2500 steps of drift.
//   • settlingSteps 0: starts ~half submerged (no gas→liquid plunge) → released from t=0.
//   • densityRatio 0.5 → 50%-submerged equilibrium.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two cylinder pillars — same geometry as two_cylinder_floater.prm.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      // Normal sphere r=8, densityRatio 0.5. Start (15,30,58): upstream of the pillars
      // (x=15), centred on the inter-pillar gap (y=30), ~2 LU above the surface (z≈56) →
      // ~half submerged. Starts near equilibrium (no plunge), so settlingSteps 0: released
      // from t=0 to drift in +X and jam in the 14-LU gap (sphere diameter 16 > gap).
      // V_sub via the wide-disk plane-fit.
      position     < 15, 30, 58 >;
      radius       8;
      densityRatio 0.5;
      settlingSteps 0;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >; max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;  max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;  max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
