// twenty_floaters_pillar_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Clogging test: 20 SMALL floating spheres (radius 3–4 LU, densityRatio 0.5)
// released UPSTREAM (low X) of the two cylinder pillars and swept downstream by
// the +X flow into the piers, where they jam / pile up (debris clogging).
//
// Flow & geometry:
//   • X is periodic, flow advects in +X at U = 0.02.  Pillars sit at x = 64.
//     "Upstream" = low X, so the spheres start in x ∈ [6, 42] (well left of the
//     pillar surface at x ≈ 56) and drift right into them over ~1500–3000 steps.
//   • Pillar 1 (64,15,90) r=8 → footprint y ∈ [7,23]; Pillar 2 (64,45,90) r=8 →
//     footprint y ∈ [37,53]; the gap between them is y ∈ [23,37] (14 LU).
//   • Spheres are seeded across the full width (y = 10,24,36,50): the y=10/50
//     columns ram the pillar bodies, the y=24/36 columns funnel into the narrow
//     gap (diameter 6–8 ≈ half the 14-LU gap) → jamming / arch formation.
//
// Placement (gentle, avoids the contact-line NaN of a hard plunge):
//   • All centres at z = 58, ~2 LU above the free surface (z ≈ 56) → ~half
//     submerged immediately, only a tiny settle to the 50% equilibrium.
//   • settlingSteps = 200: contact lines establish while the spheres are fixed,
//     then all 20 release together and start drifting downstream.
//   • 5 X-rows × 4 Y-columns = 20, radius alternates 3/4 (kept small).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two cylinder pillars — same geometry as ten_floaters_gas.prm / box_pillar_gas.prm.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   // ── X-row 1 (x=6) ─────────────────────────────────────────────────────────
   FloatingSphere { position < 6, 10, 58 >;  radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 6, 24, 58 >;  radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 6, 36, 58 >;  radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 6, 50, 58 >;  radius 4; densityRatio 0.5; settlingSteps 200; }

   // ── X-row 2 (x=15) ────────────────────────────────────────────────────────
   FloatingSphere { position < 15, 10, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 15, 24, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 15, 36, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 15, 50, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }

   // ── X-row 3 (x=24) ────────────────────────────────────────────────────────
   FloatingSphere { position < 24, 10, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 24, 24, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 24, 36, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 24, 50, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }

   // ── X-row 4 (x=33) ────────────────────────────────────────────────────────
   FloatingSphere { position < 33, 10, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 33, 24, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 33, 36, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 33, 50, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }

   // ── X-row 5 (x=42) ────────────────────────────────────────────────────────
   FloatingSphere { position < 42, 10, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 42, 24, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 42, 36, 58 >; radius 3; densityRatio 0.5; settlingSteps 200; }
   FloatingSphere { position < 42, 50, 58 >; radius 4; densityRatio 0.5; settlingSteps 200; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
