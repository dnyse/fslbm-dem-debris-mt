// ten_floaters_uniform_pillar_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Clogging test: 10 UNIFORM floating spheres (radius 8 LU, densityRatio 0.5 — all the
// same size as the single sphere in two_cylinder_floater_gas.prm) released UPSTREAM
// (low X) of the two cylinder pillars and swept downstream by the +X flow into them.
// The 10-sphere uniform analog of twenty_floaters_pillar_gas.prm (which used 20 small,
// mixed-radius spheres) and the multi-body analog of two_cylinder_floater_gas.prm.
//
// Flow & geometry:
//   • X periodic, flow advects in +X at U = 0.02.  Pillars at x = 64.
//   • Pillar 1 (64,15,90) r=8 → footprint y∈[7,23]; Pillar 2 (64,45,90) r=8 →
//     footprint y∈[37,53]; inter-pillar gap y∈[23,37] (14 LU).  A sphere diameter is
//     16 > 14 → cannot pass the gap → jams (single-body version did exactly this).
//
// Placement (staggered hex field, all centres ≥16 LU apart and clear of the pillars):
//   • 4 X-rows at x = 6, 20, 34, 48 (rows 2 & 4 offset in Y), spanning the upstream
//     stretch x∈[6,48] (sphere surfaces reach x≤56, the pillar upstream face).
//   • All centres at z = 58, ~2 LU above the free surface (z≈56) → ~half submerged.
//   • settlingSteps 0: they start near equilibrium (no gas→liquid plunge), so no fixed
//     settling phase is needed — released to drift from t=0 as the flow ramps up.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two cylinder pillars — same geometry as twenty_floaters / two_cylinder_floater.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

FloatingSpheres
{
   // ── X-row 1 (x=6) ─────────────────────────────────────────────────────────
   FloatingSphere { position < 6, 10, 58 >;  radius 8; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 27, 58 >;  radius 8; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 44, 58 >;  radius 8; densityRatio 0.5; settlingSteps 0; }

   // ── X-row 2 (x=20, offset in Y) ──────────────────────────────────────────
   FloatingSphere { position < 20, 18, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 20, 35, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }

   // ── X-row 3 (x=34) ─────────────────────────────────────────────────────────
   FloatingSphere { position < 34, 10, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 34, 27, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 34, 44, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }

   // ── X-row 4 (x=48, offset in Y — closest to the piers) ─────────────────────
   FloatingSphere { position < 48, 18, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 48, 35, 58 >; radius 8; densityRatio 0.5; settlingSteps 0; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
