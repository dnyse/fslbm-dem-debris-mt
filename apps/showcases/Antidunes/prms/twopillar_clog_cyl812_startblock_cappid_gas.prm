ModelParameters
{
   useAnalyticalContactDetection true;   // Cylinder x Cylinder: analytical Kodam+Guo hybrid
   usePureAnalyticalCylinder     false;  // (default, explicit) keep the GJK/EPA fallback for uncertain pairs
   useContactFilterOwnerTiebreak true;   // one rank accepts each boundary-straddling contact (min owner rank)
   cylinderContactSkin           0.5;   // [Claude, 2026-10-01] rod contact skin in LU (cd1b991b): rod-rod contact starts at a surface gap of 1, rod-wall/pillar at 0.5. Sealed-cell guard stays off (not set below).
   guardCurvatureInputs          true;   // [Claude, 2026-10-02] confirmed fix for the 192-rod crash family (job 4284164->4284594); see file header

   // Experimental contact/buoyancy fixes: ALL explicitly OFF
   useTightTier1                 false;
   useTightLayer1                true;   // [Claude, 2026-09-20] ON by user request (capsule/segment-distance pre-filter for Cylinder x Cylinder, identical rejections to the always-on capsule bound but before the analytic dispatch)
   skipTier1                     false;
   useRoundedBoxCorners          false;
   useMultiPointBoxContact       false;
   useBoxOverlapCap              false;
   useAxisHysteresis             false;
   useContactManifold            false;
   useRotationalEffectiveMass    true;   // [Claude, 2026-09-20] ON for rods (user request): contact stiffness/damping from the generalised effective mass incl. rotational inertia at the contact point (exact for spheres, matters for rod rim/edge contacts)
   useSpheroBoxContact           false;
   useSpheroBoxAnalytical        false;
   useFraigeBoxContactModel      false;
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;
   useAnalyticBoxBuoyancy        false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   wallOuterGhostLayer           true;   // [Claude, 2026-10-03] side-wall NaN-normal fix (4293137)
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 40, 20 >;  // [Claude, 2026-10-03] z 40 -> 20: pressure cell stays submerged downstream  // [Claude, 2026-10-05] middle slot
      downstreamPos     < 432, 40, 20 >;  // [Claude, 2026-10-03] z 40 -> 20: pressure cell stays submerged downstream  // [Claude, 2026-10-05] middle slot
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 25, 20 >;  // [Claude, 2026-10-03] z 40 -> 20: pressure cell stays submerged downstream  // [Claude, 2026-10-05] in line with pillar 1
      pillarDownstreamPos  < 432, 25, 20 >;  // [Claude, 2026-10-03] z 40 -> 20: pressure cell stays submerged downstream  // [Claude, 2026-10-05] in line with pillar 1
      flowRateEnabled      true;   // [Claude, 2026-10-03] discharge Q and wet area A at x=336/432
      blockageRatioEnabled true;   // [Claude, 2026-10-03] pillar + jam blockage at the probe planes (clog*BlockageRatio columns)
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // Fluid-blocking counterparts of the CylinderPillars (full height); Y walls get NoSlip automatically (non-periodic Y).
   BodyBC { shape Cylinder; min < 384, 25, 0 >;  max < 384, 25, 180 >;  radius 5; NoSlip{} }  // [Claude, 2026-10-05] TWO PILLARS
   BodyBC { shape Cylinder; min < 384, 55, 0 >;  max < 384, 55, 180 >;  radius 5; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// [Claude, 2026-10-01] DISCRETE snapshot steps (per explicit request: "use the custom vtk output
// timesteps do 500 1000 2000 4000 8000 16000 32000 49000 for the total 50000 timesteps"): the
// uniform fluid_field block's writeFrequency is set to 0 (disabled) and superseded by the
// fluid_field_snapshots mechanism below (SimulationParams.h VTKParams::snapshotsEnabled, gated in
// VtkWriter.h's addVTKOutput), which fires ONLY on the exact listed steps. Per-rod/floater point
// data (createVTKOutput_PointData calls in BuildTimeloop.h) now ALSO follows this same step list
// (addSnapshotAwareVTKWrite, added 2026-10-01) rather than needing a separate mechanism -- both the
// fluid field and every floater/pillar VTK writer dump at exactly these 8 steps, nothing in between.
// Fluid cropped to X 128..640, Z 0..100 (rods/pillars unfiltered).
VTK
{
   fluid_field
   {
      writeFrequency       0;             // superseded by fluid_field_snapshots below (discrete steps, not uniform)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;  max < 768, 80, 180 >; }  // [Claude, 2026-10-03] whole channel (4284723 crashed downstream of the crop)

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   fluid_field_snapshots
   {
      writeFrequency       1;   // unused by the gating logic itself, required by vtk::initializeVTKOutput
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "0,500,1000,2000,4000,8000,12000,16000,20000,24000,32000,48000,64000,80000,99000,120000,149000";  // [Claude, 2026-10-03] denser around the jam; 120000 and 149000 added for the 150000-step run

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;  max < 768, 80, 180 >; }  // [Claude, 2026-10-03] whole channel (4284723 crashed downstream of the crop)

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
