// GENERATED by gen_hopper_stress_prms.py (--two-pillars-only) -- TWO PILLARS, 812 DRIFTING RODS: the drifting-rods
// start block mirrored across a channel of twice the width (see make_two_pillars in the generator).
// Release at step 500, VTK at step 0, wallOuterGhostLayer true, probes at z = 20.
// Channel 768 x 80 x 180, periodic in x (<64, 20, 30> blocks = 288 ranks), water level z = 49.13, PID-driven flow
// (target mean velocity 0.04, cap maxActuatingVariable 2.65e-6 as in the hopper runs). Two full pillars R 5 at
// (384, 25) and (384, 55) leave three 20 LU slots (y 0..20, 30..50, 60..80), each longer than a rod (19 LU with skin).
// Floaters: 812 rods R 3, L 18, axis y, 4 across (y = 10 / 30 / 50 / 70, rod-rod gap in y 2, wall gap 1) in
// 29 rows x 7 layers, pitch x/z 8/7.52, centres x 8..232, i.e. 147 LU upstream of the pillar faces (x = 379), so the
// upstream probes (x = 336) start in clean water; densityRatio 1.2 / 1.0 / 0.5 in the bottom two / middle three / top
// two layers. All floaters are held fixed for 500 steps, then released together.
// Contacts: analytical Cylinder x Cylinder (Kodam + Guo hybrid, GJK/EPA fallback), friction/restitution 0.5 / 0.5;
// cylinderContactSkin 0.5: rod-rod contact starts at a surface gap of 2*skin = 1 (row pitch 8 leaves 1.52),
// rod-wall/pillar at 0.5. guardCurvatureInputs and wallOuterGhostLayer on.
// Probes at x = 336 / 432, z = 20: centre pair in the middle slot (y = 40), pillar pair in line with pillar 1 (y = 25),
// with discharge and blockage ratio.
// 150000 steps; fluid (whole channel) and floater VTK at 17 snapshot steps from 0 to 149000.
// Base: hopper_clog_cyl_frontblock_pidon_2node_skin0p5_curvguard_cappid_gas.prm (hopper layout).

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 80, 180>;  // two pillars: width 80
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // cap = 5.0 a_ref of the clean hopper, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         150000;  // base prm: 100000
