// eighteen_stacked_release_pillar_bogner_gas_spheresonly.prm
// ─────────────────────────────────────────────────────────────────────────────
// SHAPE-ISOLATION VARIANT of eighteen_stacked_release_pillar_bogner_gas.prm — every geometric
// parameter (18 positions across 2 X-planes × 3 Y-columns × 3 Z-rows, all raised +20 LU per that
// file's Z-RAISE FIX) is IDENTICAL, but all 18 floaters are now FloatingSpheres (radius 8) instead
// of the mixed sphere/box/cylinder Latin-square assignment. Positions that were boxes or cylinders
// in the mixed-shape file simply became spheres at the same <x,y,z>; nothing else moved.
//
// WHY: the mixed-shape run (job 3956749, then again as job 3963620 after the Z-raise) reproducibly
// crashes inside mesa_pd's SyncNextNeighbors ("Received invalid notification type", ParseMessage.h)
// -- a send/receive buffer desync, not a physics blowup (the companion [SYNC-SANITY] diagnostic
// added to ParticleKernels.h found zero NaN/Inf/escaped-particle positions or velocities on either
// run, right up to the crash). The 9-sphere-only version of this scenario
// (nine_stacked_release_pillar_bogner_gas.prm) has run without this failure. The one variable this
// file isolates is shape type: if THIS run (18 spheres, same everything else) completes cleanly,
// the box/cylinder shape-specific code path (most likely their BaseShape::pack/unpack in
// mesa_pd/data/shape/{Box,Cylinder}.h, or their contact-detection notification content -- see
// mesa_pd/mpi/notifications/ParticleGhostCopyNotification.h's polymorphic getBaseShape() packing)
// is implicated; if it crashes anyway, the desync is unrelated to shape type (more likely a
// generic contact/count-dependent race exposed by 18 floaters vs. 9).
//
// Run in parallel with the [PARSE-HISTORY]-instrumented rerun of the mixed-shape original (see
// ParseMessage.h), on a separate cluster mirror clone so the two builds don't race.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes (unchanged)
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Two cylinder pillars — UNCHANGED from nine_stacked_release_pillar_bogner_gas.prm. Not moved.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 15, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 64, 45, 90 >;
      radius 8;
   }
}

// All 18 positions from eighteen_stacked_release_pillar_bogner_gas.prm's Latin square, now every
// one a FloatingSphere (radius 8) regardless of what shape occupied that slot there.
FloatingSpheres
{
   // xi+yi+zi ≡ 0 (mod 3) -- spheres in the mixed-shape file too
   FloatingSphere { position < 9, 12, 86 >;   radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 30, 122 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 48, 104 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 12, 122 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 30, 104 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 48, 86 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }

   // xi+yi+zi ≡ 1 (mod 3) -- boxes in the mixed-shape file, now spheres at the same positions
   FloatingSphere { position < 9, 12, 104 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 30, 86 >;   radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 48, 122 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 12, 86 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 30, 122 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 48, 104 >; radius 8; densityRatio 0.5; settlingSteps 30000; }

   // xi+yi+zi ≡ 2 (mod 3) -- cylinders in the mixed-shape file, now spheres at the same positions
   FloatingSphere { position < 9, 12, 122 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 30, 104 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 9, 48, 86 >;   radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 12, 104 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 30, 86 >;  radius 8; densityRatio 0.5; settlingSteps 30000; }
   FloatingSphere { position < 33, 48, 122 >; radius 8; densityRatio 0.5; settlingSteps 30000; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // Bogner & Rude (2013) three-phase MEM force, no rhoHydStat subtraction
   useMemOnlyBuoyancy             true;   // no separate vSub*g analytic buoyancy channel
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 15, 0 >; max < 64, 15, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 64, 45, 0 >; max < 64, 45, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         density;   // real, live fluid density (=> pressure via p=cs^2*(density-1))
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         combine CellBB_filter_2, liquidInterfaceFilter;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
