// GENERATED by gen_hopper_stress_prms.py (--two-pillars-only) -- TWO PILLARS, CLEAN REFERENCE: the two-pillar channel
// of twopillar_clog_cyl812_startblock_cappid_gas.prm without floaters (a_ref, Q_ref, clean levels of this layout).
// Channel 768 x 80 x 180, periodic in x (<64, 20, 30> blocks = 288 ranks), water level z = 49.13, PID-driven flow
// (target mean velocity 0.04, cap maxActuatingVariable 2.65e-6 as in the hopper runs). Two full pillars R 5 at
// (384, 25) and (384, 55) leave three 20 LU slots (y 0..20, 30..50, 60..80), each longer than a rod (19 LU with skin).
// wallOuterGhostLayer on. Probes at x = 336 / 432, z = 20: centre pair y = 40, pillar pair y = 25.
// 40000 steps; the VTK snapshot list is that of the rod run, so only its steps up to 40000 are written.
// Base: hopper_clog_cyl_frontblock_pidon_2node_skin0p5_curvguard_cappid_gas.prm (hopper layout).

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 80, 180>;  // two pillars: width 80
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        2.65e-6;  // cap = 5.0 a_ref of the clean hopper, see header
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         40000;  // clean reference
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see the extreme-clog prm's header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // two full pillars R 5 at y = 25 / 55. Z is an arbitrary reference point on the vertical axis.
   CylinderPillar { center < 384, 25, 45 >; radius 5; }  // three 20 LU slots
   CylinderPillar { center < 384, 55, 45 >; radius 5; }
}




ModelParameters
{
   useAnalyticalContactDetection true;   // Cylinder x Cylinder: analytical Kodam+Guo hybrid
   usePureAnalyticalCylinder     false;  // (default, explicit) keep the GJK/EPA fallback for uncertain pairs
   useContactFilterOwnerTiebreak true;   // one rank accepts each boundary-straddling contact (min owner rank)
   cylinderContactSkin           0.5;   // rod-rod contact from a surface gap of 2*skin = 1, rod-wall/pillar from 0.5
   guardCurvatureInputs          true;   // FD curvature skips uninitialised/non-finite neighbour normals

   // Contact/buoyancy options: tight layer-1 pre-filter and rotational effective mass ON, the rest OFF
   useTightLayer1                true;   // conservative pre-filter ahead of the closed-form contact tests
   useRotationalEffectiveMass    true;   // contact stiffness/damping from the effective mass incl. rotational inertia
   useFullVolumeAnalyticBuoyancy false;
   usePass3Reresolution          false;

   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   wallOuterGhostLayer           true;   // outer ghost layer becomes wall too (side-wall NaN-normal fix)
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      upstreamPos       < 336, 40, 20 >;  // middle slot; z = 20 keeps the pressure cell submerged
      downstreamPos     < 432, 40, 20 >;  // middle slot; z = 20 keeps the pressure cell submerged
      probeHalfWidthXY  2;

      pillarUpstreamPos    < 336, 25, 20 >;  // in line with pillar 1; z = 20 keeps the cell submerged
      pillarDownstreamPos  < 432, 25, 20 >;  // in line with pillar 1; z = 20 keeps the cell submerged
      flowRateEnabled      true;   // discharge Q and wet area A at x = 336 / 432
      blockageRatioEnabled true;   // pillar + jam blockage at the probe planes (clog*BlockageRatio columns)
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // Fluid-blocking counterparts of the CylinderPillars (full height); y walls get NoSlip automatically (non-periodic)
   BodyBC { shape Cylinder; min < 384, 25, 0 >;  max < 384, 25, 180 >;  radius 5; NoSlip{} }  // two pillars R 5
   BodyBC { shape Cylinder; min < 384, 55, 0 >;  max < 384, 55, 180 >;  radius 5; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// VTK: the periodic fluid_field output is off (writeFrequency 0); fluid_field_snapshots writes the fluid only at the
// listed steps (VTKParams::snapshotsEnabled, VtkWriter.h), and the floater/pillar point-data writers follow the same
// list (addSnapshotAwareVTKWrite, BuildTimeloop.h). Fluid over the whole channel, floaters/pillars unfiltered.
VTK
{
   fluid_field
   {
      writeFrequency       0;             // superseded by fluid_field_snapshots below (discrete steps, not uniform)
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;  max < 768, 80, 180 >; }  // whole channel

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   fluid_field_snapshots
   {
      writeFrequency       1;   // unused by the gating logic itself, required by vtk::initializeVTKOutput
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "0,500,1000,2000,4000,8000,12000,16000,20000,24000,32000,48000,64000,80000,99000,120000,149000";  // rod-run list: steps after 40000 are not reached

      writers
      {
         velocity;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 0, 0 >;  max < 768, 80, 180 >; }  // whole channel

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
