// mixed_sediment_showcase_100floaters_gas.prm   (GENERATED by gen_mixed_sediment_prm.py -- edit the script, not this file)
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-18] THESIS SHOWCASE: MIXED SEDIMENT -- 100 free floaters of all three shapes (34 spheres,
// 33 boxes, 33 cylinders) and three densities (0.5 floats, 1.0 neutral, 1.5 sinks -- Bogner-showcase densities, per request; every shape appears at every density) dropped from rest into
// STILL WATER (targetMeanVelocityMagnitude 0, no forcing) in a CUBE-LIKE domain <120,120,120> (X,Y periodic, floor and
// ceiling walls), g = 9.81 m/s^2. NOT YET RUN -- the first cluster run is the real test.
//
// CONTACT MODEL: useAnalyticalContactDetection true -> Box x Box by the closed-form OBBTree SAT, Cylinder x Cylinder by the
// analytical Kodam+Guo HYBRID (usePureAnalyticalCylinder false: pairs the analytic dispatch flags uncertain fall back to
// GJK/EPA); useContactFilterOwnerTiebreak true -> a contact straddling a rank boundary is accepted by exactly one rank
// (min owner rank), not by two independent geometric tests.
//
// UNITS/GRAVITY: dx_SI = 0.000362694 m (avgParticleDiameterOverride 8.0019 / dxSIOverride -- spheres_out.dat is never opened and
// X=120 does not rescale dx). gravityOverride = g_SI * (nu_LU/nu_SI)^2 * dx^3 = 2.13715005841e-05 LU (9.81 m/s^2 gives 2.13715e-05, the
// value used by the other real-gravity showcases). 120 cells * g = 2.6e-03 << cs^2 = 1/3, so the LBM incompressibility
// bound (Buick & Greated 2000, Bogner Eq. 10) holds with a wide margin. Water depth: liquidHeightFactor 2.862 + floorHeightFactor
// 4.1393 -> waterline Z = 56.02 LU (20.3 mm), ~47% of the cube; the rest is fall height and headroom.
// ModelParameters otherwise the current project set (Bogner three-phase MEM, MEM-only buoyancy, fill weighting).
//
// SHAPES -- aspect ratios taken from the equilibrium (buoyancy) runs: box halfExtents <3.5,7,3.5> = 7x14x7 = 1:2:1, as the equilibrium cuboid
// <15,30,15> (2s x s x s, long axis Y); cylinder radius 4.5, length 11.25, axis Y -> L/D = 1.25, as the equilibrium cylinder
// (r=24, L=60, axis Y -> L/D = 1.25); sphere r=4.5. Volumes: box 686 , cylinder 716, sphere 382 LU^3. Free to translate and
// rotate, no tilt, no pinning.
//
// LAYOUT -- 10 x 10 grid, pitch 12, ONE floater per (X,Y) column (nothing starts above anything else), column centres at 2 + 12 i
// (start centres >= 2 LU (X) / 2 LU (Y) / 4 LU (Z) from the (20, 30, 40) block seams):
//  * two drop heights, Z = 64 / 76, by CHECKERBOARD (i+j)%2. 10 columns per side is even, so the checkerboard is a
//    valid 2-colouring ACROSS the periodic wrap; (i-j)%3 is not (10 % 3 != 0), and equal levels would meet at the seam, where two
//    14-LU-long boxes on a 12-LU pitch would start overlapping. Lowest floater bottom at Z = 59.50 (waterline 56.02).
//  * shape and density: the 9 (shape,density) combinations, 11 copies each plus one extra, shuffled with fixed seed 1, so drop
//    height is independent of density and shape. Counts: shapes 34/33/33; densities
//    34/33/33 for 0.5/1.0/1.5.
//  * initial AABBs of all 100 floaters (X,Y periodic) are disjoint with >= 3.0 LU to spare (checked in the generator, all pairs).
//
// EXPECTED (unverified): 0.5 ends half-submerged at the surface, 1.5 sinks to the floor (terminal velocity ~0.016 LU/step, a few
// thousand steps), 1.0 hangs wherever it comes to rest; shape/density interactions where they meet at the surface and on the floor.
//
// timesteps 100000, VTK every 10000 steps = dumps at 0,10000,...,90000 (the loop is `t != timesteps`, so the final step 100000 itself is not written).
// VTK options as in the extreme-clog prms: before_functions { gas_cell_zero_setter; } (without it gas/obstacle cells show stale
// PDF-derived noise), writers velocity + mapped_flag, plus fill_level for the free surface. Particle output (spheres/boxes/cylinders)
// shares this writeFrequency; the fluid is two mid-plane slices, NOT the full volume.
// Domain <120,120,120> / cellsPerBlock <20,30,40> = 6x4x3 = 72 processes = every core of one singlenode node (the domain stays a cube; only the blocks are not). Snapshots every 10000.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 20, 30, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic -- no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <120, 120, 120>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water -- no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // U = 0: keep the fixed reference viscosity/relaxation rate
   gravityOverride   2.13715005840543e-05;   // g_SI = 9.81 m/s^2 at dx_SI = 0.000362694 m (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

