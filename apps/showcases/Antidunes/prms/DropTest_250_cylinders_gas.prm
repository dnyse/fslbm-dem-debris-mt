// [Claude, 2026-10-01] Copy of DropTest_cylinders_250_gas.prm for the 250-floater drop-test reruns, aligned with
// DropTest_250_sat_gas.prm: snapshots as there, useSpheroBoxContact false (no effect on cylinders).
// DropTest_cylinders_250_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Same as DropTest_cylinders_gas.prm but with the floater count reduced 1000 -> 250 (per explicit
// request, 2026-09-13): same 10-column spawn grid, truncated to the first 25 of 100 waves per
// column, timesteps 158500 -> 46000. See DropTest_250_gas.prm's own header for the box-side
// equivalent and the full motivation.
//
// Original DropTest_cylinders_gas.prm header follows, unchanged (note: floater count/timesteps/
// settlingSteps numbers below describe the ORIGINAL 1000-floater scale, not this file's actual 250):
// ─────────────────────────────────────────────────────────────────────────────
// Cylinder sibling of DropTest_gas.prm (see that file's own header for the full domain/gravity/
// scale derivation, unchanged here) -- every block is IDENTICAL except FloatingBoxes ->
// FloatingCylinders, generated by parsing the box file's own 1000 spawn positions/settlingSteps
// directly (scratchpad/gen_droptest_cylinders.py) rather than hand-transcribing them, so the
// spawn grid/release timing is guaranteed identical to the already-designed, already-spacing-
// checked box scenario. Cylinder radius 1.0, length 12, axis <1,0,0> -- matches the box's own
// long dimension (halfExtents <6,1,1.5>, full length 12 along X; FloatingCylinderParams::axis
// defaults to world Y, so this is set explicitly) and fits within the box's own footprint at
// each spawn point, so the existing spacing stays safe without redesigning the grid.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 10, 30 >;  // HALVED 2026-09-11: (2,3,6)=36 processes, not 72
                                                  // -- diagnosing a multi-rank slowdown (72/12-rank
                                                  // runs both stalled well short of step 1000; see
                                                  // DropTest.cpp's new per-step [StepTiming] log).
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <32, 30, 180>;
   wavePeriods        1;      // unused (antidune sinusoidal-fill init, never called here) -- required by parser
   liquidHeightFactor 2.5;    // unused (no fluid) -- required by parser
   floorHeightFactor  4.1393; // unused (no fluid) -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   // Unused -- setupSimState() (which constructs the PIDController) is never called by DropTest.cpp.
   // Block is required only because SimulationParams' constructor unconditionally parses it.
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         46000; // last wave releases at settlingSteps=148500 (see FloatingBoxes below) + 10000
   Re                3100;    // never dynamically meaningful (no fluid) -- kept identical to the
   Fr                1.31;    // realgravity precedent file so dt_SI (and therefore gravityOverride's
   We                15.6188; // true-9.81 calibration below) matches EXACTLY.
   useHardcodedUnits true;
   gravityOverride   2.1371500584054327e-05;  // true g_SI = 9.81 m/s^2 -- see file header derivation
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read -- avgParticleDiameterOverride/dxSIOverride below bypass it
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                2.55;  // unused (no bed particles created) -- required by parser
   fixingHeightFactor          1.5;   // unused -- required by parser
   frictionCoefficient         0.5;
   restitutionCoefficient      0.3;
   numSubCycles                20;
   useLubricationCorrection    false; // no fluid -- lubrication (thin-film) correction is meaningless here
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8.001943372119138;   // see file header -- matches the realgravity precedent's own scale
   dxSIOverride                0.000362694127490625; // see file header -- true-9.81 gravity calibration
}

// No Pillars / CylinderPillars / ArchTunnels blocks -- this scenario has neither piers nor arches,
// just 6 solid walls (created directly in setupParticles, SetupStages_drop_test.h) and floating boxes.

// Cuboids dropped in staggered waves: 10 spawn columns across the 32x30 cross-section (X in
// {8,24}, Y in {3,9,15,21,27}), using the SAME box size as the actual crashed bridge run
// (halfExtents <6,1,1.5>, full size 12x2x3). 100 waves per column, settlingSteps
// 0,1500,...,148500 -- WIDENED from an initial 500-step attempt (matching the local 200-cuboid
// test's own finding), which deterministically hit [RELEASE-OVERLAP] (ParticleKernels.h) at the
// very first repeat release: the previous wave's box had only fallen ~2.67 LU in 500 steps, not
// enough to clear its own 3-LU height before the next wave spawned at the same point. 1500 steps
// matches the already-proven-safe interval from this session's original 48-cuboid smoke test.
// 10 columns x 100 waves = 1000 floaters total, 10 released together every 1500 steps, spawned
// near the domain ceiling (z=170) so each wave free-falls the full height before joining the pile.
FloatingCylinders
{
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 0; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 1500; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 3000; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 4500; startInactive true; }
   FloatingCylinder { position < 8, 3, 170 >; radius 1.0; length 12; axis < 1, 0, 0 >; densityRatio 0.6; settlingSteps 6000; startInactive true; }
