// bogner3_r075_sphere_s32_101k_vtk_gas.prm -- free floating sphere in the s=32 cuboid basin, densityRatio 0.75, VTK.
// Sphere radius 16 (diameter = the cuboid edge s = 32), fully free (6 DOF, no pins). Released with its centre on the
// still-water level 60.0746, the same start and size for all three densities, i.e. not at equilibrium: the sphere
// settles to its own draft during the run.
// Basin and units as bogner3_r075_deep_s32_100k_gas.prm: <192,90,120>, periodic in x, no-slip N/S/T/B,
// bedCopiesInX/Y = 2, gravityOverride 5.06585e-05 = g_SI 9.81 m/s^2, water viscosity and surface tension from useHardcodedUnits.
// 101000 steps in one run, so that the step-100000 frame is written. VTK slab y 43..47 through the centre at the
// fluid_field_snapshots steps (0 ... 100000). Eval and water height every 250 steps, density column 99000-100999.
BlockForestParameters
{
   cellsPerBlock                 < 32, 15, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             50000;
   snapshotBaseFolder            snapshots_b3_r075_sphere_s32_101k_vtk;
}

DomainParameters
{
   domainSize         <192, 90, 120>;
   wavePeriods        1;
   liquidHeightFactor 10.0;   // nominal (doubled basin)
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              101000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // physical constants valid while U = 0; viscosity 0.000214026 (LU)
   gravityOverride        5.06585e-05;  // g_SI = 9.81 m/s^2 at this dx_SI/dt_SI (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 2;   // doubled with domainSize, so avgParticleDiameter (6.00146), dx_SI and dt_SI keep their s=16
   bedCopiesInY 2;   // values (getAvgDiameterScalingFactor, Utility.h); with 1 copy gravityOverride would not be 9.81
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      // free sphere (6 DOF), radius 16, centre on the still-water level (same start for all densities)
      position             < 96, 45, 60.0746 >;
      radius               16.000;
      densityRatio         0.75;
      settlingSteps        0;
   }
}
ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   repairDegenerateObstaclePdfs  false;   // Option B (obstacle-cell repair guard) OFF
   seedStreamPdfCloneOnFirstUse  false;   // Option A (scratch PDF clone seeding) OFF

   logDensityColumn              true;
   densityColumnBaseFolder       density-column;
   densityColumnX                5;
   densityColumnY                45;
   logDensityColumnStartStep     99000;
   logDensityColumnEndStep       100999;

   // fill-integrated water height on a 12 x 3 grid of columns (x = 8, 24, ..., 184; y = 15, 45, 75) every 250 steps
   // over the whole run
   logWaterHeight                true;
   waterHeightBaseFolder         water-height;
   waterHeightGridX              12;
   waterHeightGridY              3;
   waterHeightEveryNSteps        250;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     250;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       0;             // off; output via fluid_field_snapshots below
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      // slab y 43..47 through the body centre, sized for the <192,90,120> basin
      CellBB_filter_0 { min < 0, 43, 0 >; max < 192, 47, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   // written only at the listed steps (VtkWriter.h, addVTKOutput): dense early for the settling transient, sparse
   // later. writeFrequency is ignored here but required by vtk::initializeVTKOutput; leave it at 1.
   fluid_field_snapshots
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "0,250,500,1000,2000,4000,8000,16000,32000,64000,100000";

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 43, 0 >; max < 192, 47, 120 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             0;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
