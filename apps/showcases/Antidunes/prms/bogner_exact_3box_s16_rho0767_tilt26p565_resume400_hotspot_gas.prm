// bogner_exact_3box_s16_rho0767_tilt26p565_resume400_hotspot_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] DEEP DIVE into the deterministic step-444 crash of the 26.565deg-seed rho=0.7665
// case (jobs 4260975/4261005/4261093, all three FAILED identically). The all-snapshots diagnostic run
// (4261093) saved a full checkpoint at every step from 400 through 443 (snapshots/step_<N>/). This prm
// RESUMES from the step_400 checkpoint (loadSnapshot true) with a WIDENED VTK region covering the two
// hot-spot columns identified from the console log -- (X=8,Z=26) and (X=0,Z=25), both walking through
// Y=0-8, neither anywhere near the box itself (box spans X=[13.67,29.67]) -- instead of the original
// mid-width plane filter. writeFrequency=1 so every single step from 401 to the crash gets a full VTK
// dump of velocity/fill_level/mapped_flag/density in that region, for direct cell-by-cell tracking.
// Since this crash is fully deterministic (3/3 identical), resuming and rerunning should reproduce the
// exact same crash at step 444.
//  * loadSnapshot true, storeSnapshot false (do not overwrite the staged checkpoint).
//  * timesteps 450 (beginTimeStep=401 per step_400/simState.file; crash expected ~444).
//  * Everything else (domain, physics, box definition -- unused when loadSnapshot=true, kept for
//    reference/consistency) identical to the tilt26p565 allsnaps prm this resumes from.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  true;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              450;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 20, 16 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.7665;
      settlingSteps        0;
      initialTiltAngleDeg  26.565;
      comOffsetZ           0;
      pinPosition          false;
      pinRotation          false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   dataSliceFrequency      500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
         density;
      }

      // [Claude, 2026-09-24] widened to cover BOTH hot-spot columns (X=8,Z=26) and (X=0,Z=25),
      // Y=0-8, with margin -- NOT the original mid-width Y=20-21 plane.
      CellBB_filter_0 { min < 0, 0, 18 >;  max < 16, 10, 32 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
