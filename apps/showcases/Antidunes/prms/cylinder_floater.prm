BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;         // never set to 0 -> division by zero, even if you initialize a flat particle bed
   liquidHeightFactor 2.862;     // h_0 / d (water height / avg particle diameter) -> from experiment [E1=2.862, E2=3.1724, E3=3.27586, E4=3.5862]
   floorHeightFactor  4.1393;    // (floor height / avg particle diameter) from domain bottom to sine's average
   initialAmplitude   0;         // defined from minimum peak to maximum peak as by Pascal et al. (2021)
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;       // [E1=3100, E2=3772, E3=4180, E4=4800]
   Fr                1.31;       // [E1=1.31, E2=1.38, E3=1.44, E4=1.45]
   We                15.6188;    // [E1=15.6188, E2=21.48, E3=25.54, E4=30.2493]
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// Cylinder pillar: DEM uses CylindricalBoundary (exterior contact via SolidCylinderContactDetection);
// LBM uses BodyBC with shape Cylinder in BoundaryParameters.
// The cylinder spans the full domain height; end caps are the floor/ceiling NoSlip planes.
CylinderPillars
{
   CylinderPillar
   {
      center < 64, 30, 60 >;   // XY position of the axis; Z is ignored for DEM (infinite along Z)
      radius 10;
   }
}

FloatingSpheres
{
   FloatingSphere
   {
      position     < 15, 30, 42 >;  // fully submerged: top=Z=52 < surface Z≈52.5; bottom=Z=32 > gas region Z<31
      radius       10;               // diameter 20 = gap between cylinder surface and Y wall → sphere lodges in gap
      densityRatio 0.5;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Z walls
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }

   // Y walls (non-periodic Y)
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Cylinder pillar NoSlip: min/max are the axis endpoints (bottom and top of the cylinder).
   BodyBC { shape Cylinder; min < 64, 30, 0 >; max < 64, 30, 120 >; radius 10; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 {
         min < 0, 29, 0 >;
         max < 128, 30, 150 >;
      }

      CellBB_filter_1 {
         min < 0, 0, 0 >;
         max < 1, 60, 150 >;
      }

      CellBB_filter_2 {
         min < 0, 0, 0 >;
         max < 128, 60, 150 >;
      }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions
      {
         gas_cell_zero_setter;
      }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
