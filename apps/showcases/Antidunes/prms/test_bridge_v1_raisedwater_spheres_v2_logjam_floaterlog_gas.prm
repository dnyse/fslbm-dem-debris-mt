// test_bridge_v1_raisedwater_spheres_v2_logjam_floaterlog_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// V2 of test_bridge_v1_raisedwater_spheres_logjam_floaterlog_gas.prm (job 4135949, confirmed
// clean on the tunnel-contact side: 555 rows, 100% above the springing line after the sphere
// arc-endpoint fix). Visual review of that run's VTK output showed the water level was still
// too high -- most of the arch openings looked substantially flooded rather than lightly
// touched. Two changes:
//
//   - WATER LEVEL LOWERED FURTHER: liquidHeightFactor 3.0 -> 2.9 (absoluteLiquidHeight ~57.13
//     -> ~56.33, same project formula, avgParticleDiameter=8.00194, floorHeightFactor=4.1393
//     unchanged). That's only ~0.33 LU above the springing line (56) now, versus the previous
//     run's ~1.13 LU -- a much shallower touch, close to (but still clearly above) the
//     bridge's own unmodified "base" scenario level (test_bridge_v1_gas.prm, factor 2.862,
//     ~56.02, i.e. essentially AT the springing line with ~0 clearance). 2.9 keeps a small but
//     real margin above the springing line so genuine upper-semicircle contact still occurs
//     (unlike the original lowwater run's confirmed-zero-contact case at ~49.1), while leaving
//     nearly the entire arch opening above water for free surface flow, matching what the
//     visual review called for.
//   - SPHERE COUNT DOUBLED: 9 -> 18. Same 9 upstream aim points, now 2 spheres per point
//     instead of 1. SPAWN-SEPARATED IN Z (58 and 65, a single 7 LU offset -- more than the
//     radius-3 sphere's own 6 LU diameter) rather than stacking both at the same coordinate:
//     this applies the lesson learned from the bigjam box run (job 4135900), where logs
//     stacked at an IDENTICAL spawn point could have a later wave activate directly on top of
//     an earlier wave that hadn't drifted away yet (acceleration from rest takes real time --
//     confirmed via that run's own data, only ~3.4 LU of drift in 3000 steps), producing a
//     violent instantaneous-interpenetration launch. Z-staggering makes that geometrically
//     impossible regardless of how slowly a given wave happens to drift, without changing
//     where either sphere ends up floating (buoyancy pulls each down to the same equilibrium
//     height shortly after release regardless of its starting Z). Wave 2's settlingSteps is
//     wave 1's own aim-point offset (5000-15000) plus 6000, giving it plenty of margin beyond
//     wave 1's own release before it goes active.
//
// Everything else (piers, arches/ArchTunnels, restitutionCoefficient=0.5,
// targetMeanVelocityMagnitude=0.01, timesteps=30000, logFloaterHistory=true, domain,
// cellsPerBlock, Re/Fr/We, model parameters, VTK) is verbatim from
// test_bridge_v1_raisedwater_spheres_logjam_floaterlog_gas.prm -- see that file's own header,
// and test_bridge_v1_lowwater_logjam_floaterlog_gas.prm before it, for the full derivation of
// everything not changed here.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.9;  // lowered further -- see this file's own header; absoluteLiquidHeight~56.33
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// ComputeTunnelContacts only engages the UPPER semicircle (Z >= center[2] = the springing line,
// 56) -- confirmed clean on both boxes (job 4135755/4135900) and spheres (job 4135949, sphere
// arc-endpoint fix, 100% of contacts above the springing line).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; }  // right arch
}

// Same 9 upstream aim points as before, now 2 spheres per point (18 total), spawn-separated in
// Z (58/65) instead of stacked at an identical coordinate -- see this file's own header for why.
FloatingSpheres
{
   // (15,5) -> left arch
   FloatingSphere { position < 15, 5, 58 >; radius 3; densityRatio 0.6; settlingSteps   5000; startInactive true; }
   FloatingSphere { position < 15, 5, 65 >; radius 3; densityRatio 0.6; settlingSteps  11000; startInactive true; }

   // (15,17) -> pier1
   FloatingSphere { position < 15, 17, 58 >; radius 3; densityRatio 0.6; settlingSteps   7000; startInactive true; }
   FloatingSphere { position < 15, 17, 65 >; radius 3; densityRatio 0.6; settlingSteps  13000; startInactive true; }

   // (15,30) -> central arch
   FloatingSphere { position < 15, 30, 58 >; radius 3; densityRatio 0.6; settlingSteps   9000; startInactive true; }
   FloatingSphere { position < 15, 30, 65 >; radius 3; densityRatio 0.6; settlingSteps  15000; startInactive true; }

   // (15,43) -> pier2
   FloatingSphere { position < 15, 43, 58 >; radius 3; densityRatio 0.6; settlingSteps  11000; startInactive true; }
   FloatingSphere { position < 15, 43, 65 >; radius 3; densityRatio 0.6; settlingSteps  17000; startInactive true; }

   // (15,55) -> right arch
   FloatingSphere { position < 15, 55, 58 >; radius 3; densityRatio 0.6; settlingSteps  13000; startInactive true; }
   FloatingSphere { position < 15, 55, 65 >; radius 3; densityRatio 0.6; settlingSteps  19000; startInactive true; }

   // (22,11) -> left arch/pier1 boundary
   FloatingSphere { position < 22, 11, 58 >; radius 3; densityRatio 0.6; settlingSteps   6000; startInactive true; }
   FloatingSphere { position < 22, 11, 65 >; radius 3; densityRatio 0.6; settlingSteps  12000; startInactive true; }

   // (22,24) -> central arch (left side)
   FloatingSphere { position < 22, 24, 58 >; radius 3; densityRatio 0.6; settlingSteps   8000; startInactive true; }
   FloatingSphere { position < 22, 24, 65 >; radius 3; densityRatio 0.6; settlingSteps  14000; startInactive true; }

   // (22,36) -> central arch (right side)
   FloatingSphere { position < 22, 36, 58 >; radius 3; densityRatio 0.6; settlingSteps  10000; startInactive true; }
   FloatingSphere { position < 22, 36, 65 >; radius 3; densityRatio 0.6; settlingSteps  16000; startInactive true; }

   // (22,49) -> pier2/right arch boundary
   FloatingSphere { position < 22, 49, 58 >; radius 3; densityRatio 0.6; settlingSteps  15000; startInactive true; }
   FloatingSphere { position < 22, 49, 65 >; radius 3; densityRatio 0.6; settlingSteps  21000; startInactive true; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   // Explicit even though both already default to true (SimulationParams.h) -- an earlier bridge
   // run (mixed_75k) sank every floater to the domain floor regardless of density with
   // useBognerThreePhaseMEM=false (the pre-fix default), so this scenario keeps them explicit per
   // the lesson in test_bridge_v1_sphere_drip_lowwater_gas.prm's own header.
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // 18 floaters here, still cheap enough for unfiltered full-run logging.
   logFloaterHistory              true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 15): stadium shape = two round end-caps + a connecting box. Capped at Z=76
   // (the deck top), NOT the full domain height -- piers stop flush with the top of the bridge
   // instead of poking up into the open air above it.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 15, 0 >; max < 61, 15, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 15, 0 >; max < 67, 15, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 10, 0 >; max < 67, 20, 76 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 45): same stadium shape, same Z=76 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 61, 45, 0 >; max < 61, 45, 76 >; radius 5; }
         second { shape Cylinder; min < 67, 45, 0 >; max < 67, 45, 76 >; radius 5; }
      }
      second { shape Box; min < 61, 40, 0 >; max < 67, 50, 76 >; }
      NoSlip{}
   }

   // Left arch (wall-to-pier1 span, Y=0..10, width 10 -> radius 5): same construction as
   // the central arch, sized to its own span so the opening is a true semicircular
   // half-pipe (full width at the springing line Z=56, point at the crown Z=61).
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 0, 56 >; max < 67, 10, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 5, 56 >; max < 67, 5, 56 >; radius 5; }
      }
      NoSlip{}
   }

   // Central arch (pier1-to-pier2 span, Y=20..40, width 20 -> radius 10): full width at
   // Z=56, crown at Z=66.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 20, 56 >; max < 67, 40, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 30, 56 >; max < 67, 30, 56 >; radius 10; }
      }
      NoSlip{}
   }

   // Right arch (pier2-to-wall span, Y=50..60, width 10 -> radius 5): mirrors the left arch.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 61, 50, 56 >; max < 67, 60, 76 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 61, 55, 56 >; max < 67, 55, 56 >; radius 5; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;  // cell type per timestep: 1=liquid 2=interface 3=gas 4=noSlip 6=freeSlip/UBB
                       // 7=UBB-inflow 8=pressure 9=pressure-outflow 10=outlet (VtkWriter.h) -- lets
                       // the bridge geometry (piers/deck/arches, all NoSlip=4) be isolated directly
                       // in ParaView (Threshold filter on mapped_flag == 4), independent of the water.
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
