// sphere_only_81floaters_realgravity981_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// 81 SPHERES (all-sphere conversion of the proven-clean 81-floater "clean-
// factorial" grid, mixed_shape_stillwater_81floaters_bogner_gas.prm) dropped
// into still water, using TRUE Earth gravity g_SI=9.81 m/s^2 instead of
// Bogner & Rude's own hardcoded regime.
//
// DERIVATION FROM mixed_shape_stillwater_81floaters_bogner_gas.prm: every
// FloatingBox and FloatingCylinder entry converted to a FloatingSphere at the
// SAME position and density (radius 4.5, matching the file's existing
// spheres), so this keeps the exact same 9 X-anchors (6/16/26/38/48/58/70/
// 80/90) x 3 Y-replicates (10/30/50) x 3 Z-levels (64/76/88) = 81 positions
// and the same per-X-anchor density arrangement (6/16/26 -> 0.5, 38/48/58 ->
// 1.0, 70/80/90 -> 2.0), just uniformly spheres instead of mixed shapes.
//
// GRAVITY: gravityOverride = 2.13715005840044e-05, identical derivation and
// value used in sphere_sedimentation_showcase_gas.prm (same domain
// <128,60,180>, domainSize[0]=128, bedCopiesInX=1, so the same dx_SI/dt_SI
// conversion applies): g_SI = gravityOverride * dx_SI / dt_SI^2 = 9.81, using
// dx_SI=0.00036269412749034255, dt_SI=2.8109509452478946e-05 (viscosity
// fixed at 0.000214026 by useHardcodedUnits). NOT Bogner's rescaled gravity
// (1.66667e-4) -- this run specifically tests real-world 9.81 gravity against
// the proven 81-floater layout, to isolate whether the earlier 100-sphere
// crash (job 3996320, step ~9524/50000, NaN hydrodynamic force at a particle
// straddling the free surface) was specific to that dense 100-sphere packing
// or a more general 9.81-gravity + useBognerThreePhaseMEM interaction. The
// concurrently-running Bogner-gravity 81-floater job (3996932) is the
// complementary comparison point (same layout/shape mix, weaker gravity).
//
// BUOYANCY: useBognerThreePhaseMEM true (unchanged from the source file).
// relaxationRate: NOT overridden here (unlike the source file's tau=1/1.9) --
// left at the standard useHardcodedUnits default (1.99743), matching the
// 100-sphere sedimentation showcase's own convention, so this run isolates
// gravity+shape as the only real variables versus that earlier crash.
//
// timesteps 100000 (unchanged from the source file).
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              100000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;                    // keep physical constants valid while U = 0
   gravityOverride        2.13715005840044e-05;    // solved for g_SI = 9.81 m/s^2, see header derivation
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 6, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 26, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 26, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 26, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
