// ten_cuboids_two_pillars_slitpass_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// Reduced-count sibling of thousand_cuboids_two_pillars_slitpass_gas.prm: IDENTICAL in every
// respect (domain, pillars, physics, grid, timing) except only the first 10 of that file's 100
// FloatingBox entries are kept (X=10..50.5, single row Y=7, still deliberately overlapping via the
// 4.5 X-spacing vs 6.0 box edge). Created to get a minimal, non-ASan reproduction of the fluid
// rho->NaN / invalid-quaternion crash after an ASan (RelWithDebInfo) run of the full 100-box
// version confirmed the SimpleBB.h memory-safety bug fix holds (no ASan report this time) but the
// scenario still crashed via the SAME invalid-quaternion assertion at t=1940s/step 10319 -- fluid
// interface cells near block-local (24-25,7-8,15-16) went NaN first, ~319 steps after the single
// release at step 10000, then propagated into two floaters' hydrodynamic force/torque and finally
// their rotation quaternions. 10 floaters (vs 100) should reproduce the same activation-triggered
// instability with far less log volume and wall-clock time to sift through.
//
// Box-shaped sibling of thousand_logs_two_pillars_slitpass_gas.prm (itself a variant of
// thousand_spheres_two_pillars_slitpass_collapsed_gas.prm): same domain, same two pillars, same
// halved mean velocity (0.01), FLOATING BOXES ("cuboids") -- halfExtents <3, 9, 3>, edge lengths
// 6x18x6, long axis along Y. useHardcodedUnits false (properly derived viscosity/gravity/
// surfaceTension from this scenario's actual U=0.01 PID target, not values calibrated for 0.02).
//
// Grid: same pool as the 100-box version -- X spacing 4.5 (narrower than the 6.0 X-edge, single row
// Y=7 kept here) x single Z=76 (above the flat still-water surface at absoluteLiquidHeight=70.03).
//
// Release schedule: unchanged -- 10000-step flow-development warmup, then all 10 floaters activate
// together at step 10000. 30000 total steps leaves 20000 steps after release to observe outcome.
//
// SMALLER PRECURSOR RUN before committing to a long/multi-node run (mirroring
// thousand_spheres_two_pillars_slitpass_collapsed_gas.prm's own 200000-step/144-core run): single
// node (cellsPerBlock <40,25,30>, 4x3x6=72 processes, matching the ORIGINAL single-node
// decomposition, not the collapsed sphere run's 144-core one).
//
// Domain: <160, 75, 180> / cellsPerBlock <40, 25, 30> = 4x3x6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 40, 25, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <160, 75, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed gravity, per request
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 138, 19, 90 >;
      radius 8;
   }
   CylinderPillar
   {
      center < 138, 56, 90 >;
      radius 8;
   }
}

FloatingBoxes
{
   FloatingBox { position < 10.0000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 14.5000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 19.0000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 23.5000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 28.0000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 32.5000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 37.0000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 41.5000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 46.0000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
   FloatingBox { position < 50.5000, 7.0000, 76.0000 >; halfExtents < 3, 9, 3 >; densityRatio 0.5; settlingSteps 10000; startInactive true; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   // Comparison run to the cylinder scenario: switches Box x Box from GJK/EPA to boxBoxSAT
   // (PaperAnalyticalContacts.h), the "trusted directly, no fallback gate" closed-form path (unlike
   // Cylinder x Cylinder, boxBoxSAT is provably symmetric under argument-order swap -- see this
   // file's own header comment). Kept true so this scenario exercises the same analytical-path
   // machinery the cylinder crash investigation used, under otherwise identical density/timing.
   useAnalyticalContactDetection  true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 138, 19, 0 >; max < 138, 19, 180 >; radius 8; NoSlip{} }
   BodyBC { shape Cylinder; min < 138, 56, 0 >; max < 138, 56, 180 >; radius 8; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 37, 0 >;  max < 160, 38, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 75, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 160, 75, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
