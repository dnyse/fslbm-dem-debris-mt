// pinch_test_two_rods_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-25] MINIMAL REPRODUCTION, per explicit request ("create a small test case
// that proves the pinching crash is a real thing"). Isolates the "Class-B sealed-cell" /
// two-different-rods pinch mechanism (THESIS_PLAN.md, job 4255679/4266507/4266571/4266572)
// from the full 210-rod, 144-rank, PID-driven hopper scenario down to its essential geometry:
// TWO static cylinders, at the EXACT production pitch/radius (radius 3, X-pitch 7 -> 1 LU
// surface clearance -- the same spacing that produced job 4266507's real crash cell with 19/26
// obstacle neighbours split between two different rod UIDs), fully submerged in still water,
// single MPI rank, no channel flow, no PID, no DEM motion (both rods held FIXED for the whole
// run via settlingSteps >> timesteps -- per SimulationParams.h/SetupStages.h, FIXED means zero
// invMass/invInertia, i.e. immovable, but still fully live in the DEM contact + MEM force
// pipeline every step -- so the fluid-side pinch mechanism is exercised exactly as in
// production, without the confounding noise of channel turbulence, PID forcing, or particle
// dynamics). Precursor/NaN-scan diagnostics enabled throughout since the domain is tiny.
//
// Domain: <48, 24, 40> / cellsPerBlock <16, 24, 40> = 3x1x1 = 3 processes (mesa_pd requires
// >=3 blocks along any periodic direction when using particles -- confirmed via a failed 1-rank
// attempt: "When using particles, use at least three blocks per periodic direction.").
// Rod A: X=20, Rod B: X=27 (pitch 7, radius 3 each -> 1 LU clearance), both Y=12 Z=15, axis Y.
// Water surface at absoluteLiquidHeight=30 (avgParticleDiameterOverride=1, floorHeightFactor
// 2.5, liquidHeightFactor 27.5 -> floorHeight 2.5, liquidHeight 27.5); rods (Z span [12,18]) are
// fully submerged with ~12.5 LU of water above them and ~9.5 LU of gas headroom above the surface.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 24, 40 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             0;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <48, 24, 40>;
   wavePeriods        1;
   liquidHeightFactor 27.5;
   floorHeightFactor  2.5;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water -- no flow forcing, isolates the pinch itself
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         5000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep viscosity/gravity/surface tension at reference values (U=0 here)
   denseNanScanEnabled true;
   denseNanScanFromStep 0;
   denseNanScanToStep   5000;
   populationPrecursorThreshold 10;
   highVelocityPrecursorThreshold 0.3;
   densityPrecursorLow  0.5;
   densityPrecursorHigh 1.5;
   densityPrecursorLiquidOnly false;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 1.0;
   dxSIOverride                1.0;
   densityRatio 1.0;             // irrelevant -- both rods are FIXED (zero invMass) the whole run
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true; // matches production -- relevant precisely because of the near-touching gap
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   // Held FIXED for the entire run (settlingSteps >> timesteps): immovable, but still fully
   // live in the DEM contact + MEM force pipeline every step -- isolates the static-geometry
   // fluid pinch mechanism without any particle dynamics as a confound.
   FloatingCylinder { position < 20, 12, 15 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 1000000; }
   FloatingCylinder { position < 27, 12, 15 >; radius 3; length 18; axis < 0, 1, 0 >; densityRatio 1.0; settlingSteps 1000000; }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 1000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       50;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
