// bogner_exact_3box_s16_seed5_rho0767_nopin_omega1p9_50k_tilt26p565_pass3_widey_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] Direct test of the periodic-self-image-proximity hypothesis for why the free
// 6-DOF box does not settle at its theoretical 26.565deg equilibrium (see THESIS_PLAN.md "coupled
// roll-translate limit cycle" entries). Byte-identical to
// bogner_exact_3box_s16_seed5_rho0767_nopin_omega1p9_50k_tilt26p565_pass3_gas.prm EXCEPT the domain's Y
// extent is doubled (40 -> 80) and the box re-centred at the new mid-Y (20 -> 40), while keeping the
// SAME 65-rank footprint by using a coarser Y block size (cellsPerBlock <10,8,40> -> <10,16,40>, so
// Y-block count stays 5 = 80/16, same as before = 40/8). This box's long axis is along Y (halfExtents
// <8,16,8> -> full Y length 32), so its periodic self-image gap goes from 40-32=8 LU to 80-32=48 LU, a
// 6x increase. If the box now settles cleanly near 26.565deg (rather than the wide 40-65deg chaotic
// band seen in every prior same-scenario run at the narrower domain), that directly implicates
// periodic self-interaction as a driver of the equilibrium-angle discrepancy; if the outcome is
// unchanged, it rules that mechanism out.
// usePass3Reresolution true carried over (needed to avoid the unrelated step-444 knife-edge crash;
// see THESIS_PLAN.md).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 16, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 80, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              50000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;          // Bogner's tau = 1/1.9 = 0.526; lower omega = more viscous damping (Bogner's own value)
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 40, 16 >;   // Y re-centred to the new domain mid-Y (was 20 for Y=40)
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.7665;   // 0.75 + 2.2% correction, see THESIS_PLAN.md
      settlingSteps        0;
      initialTiltAngleDeg  26.565;   // released AT the theoretical equilibrium -- no transient at all
      comOffsetZ           0;
      pinPosition          false;         // fully free (6 DOF)
      pinRotation          false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;   // explicitly OFF: no analytic buoyancy in this experiment
   usePass3Reresolution          true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   dataSliceFrequency      500;   // avoid the job 4255656 vault file-count quota bug
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
         density;
      }

      // one mid-width plane (the boxes' cross-section is in X-Z); re-centred to the new domain mid-Y
      CellBB_filter_0 { min < 0, 40, 0 >;  max < 130, 41, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
