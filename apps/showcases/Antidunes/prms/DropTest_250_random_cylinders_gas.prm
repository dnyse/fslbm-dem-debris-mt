// Fluid-free, DEM-only cuboid drop test (DropTest.cpp) at real 72-process block-forest scale. Built
// to isolate whether the "flying floater" / contact-normal-chatter / STALE-PARTICLE-IDX desync bug
// chased across this session's Antidunes bridge-scenario cluster jobs (4201656/4202194/4212104/
// 4212265) is a general DEM-contact/parallel-decomposition problem, independent of any fluid
// coupling -- no water, no LBM fields, no hydrodynamic coupling at all, just cuboids dropped under
// gravity into a solid-walled box (walls on ALL 6 sides -- periodicity <0,0,0>), released in
// staggered waves (startInactive + settlingSteps, the same mechanism already used in production
// FloatingBoxes) so the pile builds up gradually along Z (the domain's tall/main-height axis; gravity
// is hardcoded to Z in this codebase's AddExternalForces, see DropTest.cpp's own header comment for
// why Z specifically, not X/Y).
//
// SCALE (per explicit request): 1000 cuboids total, released 10 at a time (one per spawn column)
// every 1500 timesteps -- 100 waves x 10 columns, settlingSteps 0,1500,...,148500 -- then the run
// continues 10000 more steps after the last wave lands/settles (timesteps=158500). 1500 steps (not
// the originally-planned 500) because 500 deterministically hit [RELEASE-OVERLAP] -- see the
// FloatingBoxes block below for the full explanation and the exact 10-column layout.
//
// DOMAIN: <32, 30, 180>, cellsPerBlock <16, 10, 30> -> numBlocks (2, 3, 6) = 36 blocks/processes
// (halved from 72 -- see the cellsPerBlock field's own comment below).
// Cross-section 32x30 (roughly half the production bridge scenario's 128x60 footprint), height
// Z=180 (double the production 90) so Z is unambiguously the long/main-height axis the cuboids fall
// and pile along.
//
// GRAVITY: true g_SI=9.81 m/s^2 (per explicit request). gravityOverride=2.1371500584054327e-05 and
// dxSIOverride=0.000362694127490625 are copied VERBATIM from
// box_sedimentation_showcase_analytical_125floaters_realgravity_gas.prm's own documented derivation
// (= 9.81 * dt_SI^2 / dx_SI, dt_SI = viscosity/viscosity_SI * dx_SI^2, using the same Re/Fr/We/
// useHardcodedUnits below -- dt_SI depends only on those and dx_SI, not on avgParticleDiameter, so
// reusing the same dxSIOverride/Re/Fr/We/useHardcodedUnits reproduces the identical true-9.81
// calibration exactly here too). That file's own header also checked the LBM incompressibility bound
// (Buick & Greated 2000 Eq. 10) at domainHeight=180 -- the SAME height used here -- and found it
// safely satisfied (domainHeight*gravityOverride=0.00385, far under the required <<1/3).
//
// Box x Box contact settings (useSpheroBoxContact etc.) are kept IDENTICAL to the bridge scenario's
// own spherobox_gjk/noarches runs for direct comparability -- if the same chatter/desync failure
// reproduces here, that confirms the root cause is in the DEM/parallel-decomposition layer itself,
// not the fluid coupling or bridge geometry.
//
// NOTE: FloaterHistoryLogger is NOT wired into DropTest.cpp for this first version (kept out to
// minimize scope/risk) -- logFloaterHistory below is inert; VTK (floaterBox only) is the sole output.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 15 >;  // 2 x 2 x 12 = 48 processes
                                                  // -- diagnosing a multi-rank slowdown (72/12-rank
                                                  // runs both stalled well short of step 1000; see
                                                  // DropTest.cpp's new per-step [StepTiming] log).
   periodicity                   < 0, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <32, 30, 180>;
   wavePeriods        1;      // unused (antidune sinusoidal-fill init, never called here) -- required by parser
   liquidHeightFactor 2.5;    // unused (no fluid) -- required by parser
   floorHeightFactor  4.1393; // unused (no fluid) -- required by parser
   initialAmplitude   0;      // unused -- required by parser
}

PIDParameters
{
   // Unused -- setupSimState() (which constructs the PIDController) is never called by DropTest.cpp.
   // Block is required only because SimulationParams' constructor unconditionally parses it.
   targetMeanVelocityMagnitude 0;
   proportionalGain            0;
   derivativeGain              0;
   integralGain                0;
   maxRamp                     0;
   minActuatingVariable        0;
   maxActuatingVariable        0;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         84400;  // last release 74400 + 10000
   Re                3100;    // never dynamically meaningful (no fluid) -- kept identical to the
   Fr                1.31;    // realgravity precedent file so dt_SI (and therefore gravityOverride's
   We                15.6188; // true-9.81 calibration below) matches EXACTLY.
   useHardcodedUnits true;
   gravityOverride   2.1371500584054327e-05;  // true g_SI = 9.81 m/s^2 -- see file header derivation
}

ParticleParameters
{
   inFileName                  spheres_out.dat; // never read -- avgParticleDiameterOverride/dxSIOverride below bypass it
   bedCopiesInX                1;
   bedCopiesInY                1;
   densityRatio                2.55;  // unused (no bed particles created) -- required by parser
   fixingHeightFactor          1.5;   // unused -- required by parser
   frictionCoefficient         0.3;
   restitutionCoefficient      0.25;
   collisionTimeFactor         0.124969648;  // collision time 1 LBM step (= 1/avgParticleDiameterOverride)
   numSubCycles                20;
   useLubricationCorrection    false; // no fluid -- lubrication (thin-film) correction is meaningless here
   useNoSlipParticles          false;
   useParticleBed               false;
   avgParticleDiameterOverride 8.001943372119138;   // see file header -- matches the realgravity precedent's own scale
   dxSIOverride                0.000362694127490625; // see file header -- true-9.81 gravity calibration
}

