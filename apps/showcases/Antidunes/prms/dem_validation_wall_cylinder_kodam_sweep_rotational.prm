// Rotational-effective-mass counterpart of dem_validation_wall_cylinder_kodam_sweep_translational.prm: same geometry
// and 0-90 deg, 5 deg sweep, with useRotationalEffectiveMass true and dt = collisionTime/500, the calibration of
// dem_validation_wall_cylinder_kodam_test1_rotmass.prm. Data source of the cylinder wall-impact figures (Section 5.2).
DEMValidation{
    testCase wallImpactCylinder;
    useRotationalEffectiveMass true;
    dt 0.00002;

    cylinderRadius 4.0;
    cylinderLength 5.3;
    density 1.0;
    restitutionCoefficient 0.85;
    frictionCoefficient 0.0;
    poissonsRatio 0.35;
    collisionTime 0.01;

    impactSpeed 1.0;
    tangentialSpeedFraction 0.0;
    tiltStartDeg 0.0;
    tiltEndDeg 90.0;
    tiltStepDeg 5.0;

    toleranceRelError 0.02;
    vtkSpacing 0;
    outputBaseName wall_impact_cylinder_kodam_sweep_rotational;
}
