// cylinder_density_showcase_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// BUOYANCY SHOWCASE (cylinder/log): three identical logs (radius 8, length 24,
// axis <0,1,0> — the standard spanwise-log orientation used throughout this
// project), differing only in densityRatio (0.25 / 0.5 / 0.75), pinned in X,Y so
// each settles straight down/up to its own buoyant depth without lateral drift.
// No initial tilt is applied here (unlike the box test) — a cylinder floating
// with its axis horizontal is roll-neutral about its own axis, so there is no
// meaningful "heel" perturbation analogous to the box's small-angle test.
//
// Expected equilibrium (Archimedes, uniform-density cylinder): submerged VOLUME
// fraction = densityRatio, i.e. 25% / 50% / 75% of each log ends up below the
// fitted waterline once settled.
//
// Layout (domain centreline y=30; absoluteLiquidHeight ~56.024):
//   • densityRatio 0.25: position (32, 30, 56)
//   • densityRatio 0.50: position (64, 30, 56)
//   • densityRatio 0.75: position (96, 30, 56)
//   32 LU apart in X (radius 8 -> 16 LU clearance between neighbours' X-footprint).
//   Log length 24 (half-length 12) spans y=[18,42], leaving 18 LU clearance to
//   each N/S wall. All clear at t=0.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         75000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      position             < 32, 30, 56 >;
      radius               8;
      length               24;
      axis                 < 0, 1, 0 >;
      densityRatio         0.25;
      settlingSteps        0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
   }
   FloatingCylinder
   {
      position             < 64, 30, 56 >;
      radius               8;
      length               24;
      axis                 < 0, 1, 0 >;
      densityRatio         0.5;
      settlingSteps        0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
   }
   FloatingCylinder
   {
      position             < 96, 30, 56 >;
      radius               8;
      length               24;
      axis                 < 0, 1, 0 >;
      densityRatio         0.75;
      settlingSteps        0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useAnalyticBoxBuoyancy        false;  // cylinders always use point-sampling (no closed-form oblique clip)
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for each log
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
