// cylinder_stillwater_drop_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// STILL-WATER DROP test for the FloatingCylinder (true log): counterpart to
// cylinder_stillwater_gas.prm, but the cylinder starts fully DRY, clear of the water
// (centre z=66, bottom edge at z=59 — the undisturbed waterline sits at z≈56.5, so ≈2.5 LU
// of air gap), instead of already partly submerged at t=0. Radius 7, length 44, axis along Y
// (spanwise, long dimension aligned with the Y axis — the roll-neutral direction), densityRatio
// 0.5. No flow, no pillars; X periodic, Y NoSlip walls.
//
//   • targetMeanVelocityMagnitude 0  → no driving flow (still water).
//   • useHardcodedUnits true → viscosity / relaxationRate / gravity / surfaceTension
//     keep their reference values instead of being derived from U (which is 0 here).
//   • timesteps raised to 100000 (vs 75000 in cylinder_stillwater_gas.prm) to give the drop
//     transient, the impact/splash relaxation, and the settle phase enough room, and to keep
//     watching for the same spurious roll-torque drift ([BoxRightingMoment] tiltY away from the
//     0° seed) over a longer horizon now that clipCylinderAnalytic() is available as an
//     azimuthally-symmetric alternative to the 12³ sampling clip (set useAnalyticBoxBuoyancy
//     true to select it).
//   • Unlike the square box log, the CIRCULAR cross-section has no preferred roll angle
//     (neutral stability about its own axis) — expect it to fall, splash, and settle to ~50%
//     submersion with tiltY staying at its 0° seed, no self-righting or rolling. Watch
//     [BoxBuoyancy] shape=CYLINDER submersion → 50% and [CylForces] for the force breakdown.
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;              // keep physical constants valid while U = 0
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      // True log: radius 7, length 44, axis along Y (spanwise, long dimension on Y). Centre
      // (64,30,66): bottom edge at z=59, clear of the z≈56.5 undisturbed waterline → free-falls,
      // splashes in, and settles to the half-submerged equilibrium (vs cylinder_stillwater_gas.prm,
      // which starts already partly submerged).
      // No tilt seed needed — the circular cross-section is roll-neutral.
      position             < 64, 30, 66 >;
      radius               7;
      length               44;
      axis                 < 0, 1, 0 >;
      densityRatio         0.5;
      settlingSteps        0;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
