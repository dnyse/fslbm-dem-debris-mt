// pont_ferroviere_rue_goffontaine_realscale_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// REAL-SCALE reconstruction of Pont ferroviaire, Rue Goffontaine, Trooz (river Vesdre) -- source:
// pont_ferroviere_rue_goffontaine.md (EPFL/ULiège bridge-clogging database record #30071, July 2021
// flood event). Resolution: ~33 lattice units (LU) per real metre.
//
// RESOLUTION HISTORY: 4 LU/m (v1, 14 cells across the water depth) -> 12 LU/m (v2, 42 cells,
// 54 nodes) -> 20 LU/m (v3, 70 cells, matching thousand_spheres_two_pillars_slitpass_gas.prm's own
// water-depth resolution, 24 nodes) -> this version, ~33 LU/m, targeting the multinode partition's
// full 64-node budget (MaxNodes=64, no special permission needed) at ~6h for 50000 steps. This
// EXCEEDS the original `antidunes` branch's own 81-cell reference resolution (115.8 cells here). A
// wider sweep (50, 100, 3000 LU/m) was explored and rejected as infeasible on this cluster before
// landing here -- see the file history / conversation for the full sweep.
//
// GEOMETRY DERIVATION (real value -> LU):
//   Span ("Length") 31.7 m = 3x8.9m openings + 2x2.0m piers (30.7 m) + ~1.0 m abutment margin
//     (0.65 m/side). At 33 LU/m: domain Y = 1056 LU EXACTLY.
//     Y layout: opening1 [21.45,315.15] center 168.3 | pier1 [315.15,381.15] center 348.15 |
//               opening2 [381.15,674.85] center 528.0 | pier2 [674.85,740.85] center 707.85 |
//               opening3 [740.85,1034.55] center 887.7
//   Opening radius (assumed semicircular arch, radius = half the 8.9 m opening width): 4.45 m =
//     146.85 LU.
//   Deck width ("Width", streamwise) 10 m = 330 LU. domainX was nudged from the "exact" 8.1x-margin
//     value (2673 = 3^5*11 -- an awkward factorization for a 4608-process/64-node decomposition,
//     since 4608=2^9*3^2 shares no factor of 11) to 2688 = 2^7*3*7, dividing cleanly into 24 blocks
//     of 112 cells. This only changes the upstream/downstream flow-development margin by ~0.6% --
//     it does not touch the bridge structure itself. Deck/pier/arch X-span centred in the new
//     domain: [1179,1509] (center 1344).
//   Pier width 2 m = 66 LU (radius 33 LU for the stadium-shape end-caps: box halfExtentX = deck
//     halfwidth - radius = 165-33=132, spanning [1212,1476]; end-cap CylinderPillars at X=1212 and
//     X=1476).
//   Riverbed elevation 113.0 m = Z=0 (this file's floor reference).
//   Deck: upper-face elevation 123.52 m, thickness 2.7 m -> underside elevation 120.82 m.
//     Deck-top height above bed = 10.52 m = 347.16 LU. Deck thickness = 89.1 LU.
//     Clearance (bed to deck underside) = 7.82 m = 258.06 LU.
//     Springing line (deck underside minus the assumed semicircular radius 146.85 LU) = Z=111.21
//     (3.37 m above bed) -- the arch curves from here up to the deck underside at the crown.
//   Free surface: floorHeightFactor/liquidHeightFactor RE-SOLVED for this version (unlike every
//     earlier resolution bump, which just reused the same 0.407576/0.281807 because domainX scaled
//     purely) -- because domainX here was deliberately nudged off the pure geometric scale for
//     decomposition-cleanliness (2688 vs 2673), avgParticleDiameter no longer scales by the exact
//     same factor as the target depth. Re-solved against avgParticleDiameter=168.0 LU (from
//     BedGeneration_pont_ferroviere.prm's scaling): floorHeightFactor=0.405302,
//     liquidHeightFactor=0.280234, giving 168.0*(0.405302+0.280234) = 115.17 LU EXACTLY, matching
//     the real 3.49 m flood depth (max water elevation 116.49 m - riverbed 113.0 m). This still sits
//     comfortably below the deck underside (258.06 LU).
//
// DOMAIN HEIGHT (Z): deck top at Z=347.16 LU; freeboard trimmed to 84.84 LU (2.57 m, close to the
// deck's own height, NOT the ~20m-of-empty-air the very first draft of this file had) -- domainZ=432
// (a clean multiple of 8 for the 64-node decomposition).
//
// SIMPLIFICATIONS / NOT independently re-derived from the record (unchanged from every earlier
// version):
//   - Arch shape assumed semicircular (radius = half opening width) -- no arch rise is given in the
//     record.
//   - The 20-degree skew angle between the bridge and the left bank is NOT modeled -- built
//     perpendicular to the flow (X) axis.
//   - Flow driving (Re/Fr/We, targetMeanVelocityMagnitude) reuses this project's existing reference
//     regime (Re=3100, Fr=1.31, We=15.6188), not an independently derived real-Vesdre-river
//     hydraulic calibration from the 535 m^3/s discharge figure.
//   - No debris/floaters included yet. The record's own debris composition (Natural wood 40%,
//     Building rubble 40%, Anthropogenic wood 20%, 60 m^3 total, a "main trunk" blocked one opening)
//     is available in pont_ferroviere_rue_goffontaine.md if a clogging-reconstruction floater set is
//     wanted later.
//   - useParticleBed=false -- no sediment bed is loaded. BedGeneration_pont_ferroviere.prm still had
//     to be (re-)run for real at this new resolution (see its own header).
//
// Domain: <2688, 1056, 432> / cellsPerBlock <112, 44, 54> = 24x24x8 = 4608 processes = 64 nodes
// (multinode partition, MaxNodes=64 -- this is the full node budget).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 112, 44, 54 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <2688, 1056, 432>;
   wavePeriods        1;
   liquidHeightFactor 0.280234;
   floorHeightFactor  0.405302;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         50000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out_pont_ferroviere.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only). Radius 33 LU = 2 m real pier
// width. center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 1212, 348.15, 173.6 >; radius 33; }
   CylinderPillar { center < 1476, 348.15, 173.6 >; radius 33; }
   CylinderPillar { center < 1212, 707.85, 173.6 >; radius 33; }
   CylinderPillar { center < 1476, 707.85, 173.6 >; radius 33; }
}

Pillars
{
   Pillar { center < 1344, 348.15, 173.6 >; halfExtents < 132, 33, 173.6 >; }
   Pillar { center < 1344, 707.85, 173.6 >; halfExtents < 132, 33, 173.6 >; }
}

// One entry per real opening (all three 8.9 m -> radius 146.85 LU). xMin/xMax DELIBERATELY set to
// the piers' own straight-box span (1212..1476, i.e. pier x_center +- x_half), NOT the deck's full
// 10 m streamwise width (1179..1509, what this used to be) -- recesses each arch collar's flat
// leading/trailing face behind the piers' rounded nose, so the nose visibly sticks out past the
// deck edge instead of the deck being flush with the nose tip. Tuned/verified offline in
// bridge_layout_optimizer.py / bridge_voxel_view.py / bridge_voxel_render_full.py (3D voxel review
// at true 1 LU simulation resolution). The LBM BodyBC arch boxes below are updated to the SAME
// span, so the DEM contact geometry (what floaters actually collide with) never diverges from
// what's actually painted solid in the fluid.
ArchTunnels
{
   ArchTunnel { center < 0, 168.3, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 1 (left bank side)
   ArchTunnel { center < 0, 528.0, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 2 (centre)
   ArchTunnel { center < 0, 887.7, 111.21 >; radius 146.85; xMin 1212; xMax 1476; }  // opening 3 (right bank side)
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }

   // Pier 1 (Y-centre 348.15): stadium shape = two round end-caps + a connecting box. Capped at the
   // deck top (Z=347.16), not the full domain height.
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 1212, 348.15, 0 >; max < 1212, 348.15, 347.16 >; radius 33; }
         second { shape Cylinder; min < 1476, 348.15, 0 >; max < 1476, 348.15, 347.16 >; radius 33; }
      }
      second { shape Box; min < 1212, 315.15, 0 >; max < 1476, 381.15, 347.16 >; }
      NoSlip{}
   }

   // Pier 2 (Y-centre 707.85): same stadium shape, same Z=347.16 cap
   BodyBC
   {
      shape LogicalOR;
      first
      {
         shape LogicalOR;
         first  { shape Cylinder; min < 1212, 707.85, 0 >; max < 1212, 707.85, 347.16 >; radius 33; }
         second { shape Cylinder; min < 1476, 707.85, 0 >; max < 1476, 707.85, 347.16 >; radius 33; }
      }
      second { shape Box; min < 1212, 674.85, 0 >; max < 1476, 740.85, 347.16 >; }
      NoSlip{}
   }

   // Opening 1 (left-bank span, Y=21.45..315.15, width 293.7 -> radius 146.85): semicircular
   // half-pipe, full width at the springing line Z=111.21, point at the crown Z=258.06 (= deck
   // underside). X-span recessed to the piers' own straight-box span (1212..1476), matching the
   // DEM ArchTunnels above exactly -- see that block's own comment for why.
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 1212, 21.45, 111.21 >; max < 1476, 315.15, 347.16 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 1212, 168.3, 111.21 >; max < 1476, 168.3, 111.21 >; radius 146.85; }
      }
      NoSlip{}
   }

   // Opening 2 (centre span, Y=381.15..674.85, width 293.7 -> radius 146.85)
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 1212, 381.15, 111.21 >; max < 1476, 674.85, 347.16 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 1212, 528.0, 111.21 >; max < 1476, 528.0, 111.21 >; radius 146.85; }
      }
      NoSlip{}
   }

   // Opening 3 (right-bank span, Y=740.85..1034.55, width 293.7 -> radius 146.85)
   BodyBC
   {
      shape LogicalAND;
      first { shape Box; min < 1212, 740.85, 111.21 >; max < 1476, 1034.55, 347.16 >; }
      second
      {
         shape LogicalNOT;
         first { shape Cylinder; min < 1212, 887.7, 111.21 >; max < 1476, 887.7, 111.21 >; radius 146.85; }
      }
      NoSlip{}
   }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      // 5000 (not 1000): at 4608 blocks/64 nodes, writeFrequency=1000 would produce ~230,450 files
      // (50 snapshots x 4609) over 50000 steps -- $HPCVAULT is already over its 400,000-file hard
      // quota (236,920 used as of this run's submission), so that would very likely fail the archive
      // step after the run completes. 5000 keeps it to ~46,090 files (10 snapshots), safely inside
      // the remaining headroom.
      writeFrequency       5000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }

      CellBB_filter_0 { min < 0, 519, 0 >;   max < 2688, 537, 432 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;    max < 1, 1056, 432 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;    max < 2688, 1056, 432 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
