// No-clog reference at the extreme scale, PID on (maxActuatingVariable 1e-3), flow-rate evaluator on: the centred-
// pillar layout of the extreme jam runs without floaters, the baseline for the reference-subtracted afflux. The
// spin-up transient of the free surface (up to +-11 LU between the probes) is the same as in the jam runs, so
// subtracting this run isolates the debris effect.
// Domain <768,40,90> (the extreme jam runs use Z = 180), X periodic, Y walled, NoSlip top and bottom;
// cellsPerBlock <64,20,15> -> (12, 2, 6) = 144 ranks, 2 nodes.
// Obstacle: one CylinderPillar at (384, 20), radius 12, leaving two 8 LU slits, as in the jam runs.
// Physics as the jam runs: target velocity 0.04, Re 3100, Fr 1.31, We 15.62, useHardcodedUnits false,
// liquidHeightFactor 2.0, avgParticleDiameterOverride/dxSIOverride.
// 124750 steps, as the jam runs, so the late-time windows line up. ClogMeasurement probe pairs at X = 280/500 on both
// slit centrelines (Y = 4 and 36, z = 40) with flow rate; VTK every 24950 steps.
// Derived from clog_measurement_validation_noclog_reference_extreme_gas.prm (flowRateEnabled added).

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 false;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 90>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         124750;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
   // no gravityOverride -- dynamically computed, see file header
}

ParticleParameters
{
   inFileName spheres_out.dat;   // never opened -- see avgParticleDiameterOverride below
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   // same pillar as the jam runs (radius 12 = 60 % of the width, two 8 LU slits) so the reference subtraction is valid
   CylinderPillar { center < 384, 20, 45 >; radius 12; }
}




ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     100;
   baseFolderName          eval;

   ClogMeasurement
   {
      // pair 1: centreline of the left slit (Y 0..8); pair 2 below: right slit (Y 32..40), as in the jam runs
      upstreamPos       < 280, 4, 40 >;
      downstreamPos      < 500, 4, 40 >;
      probeHalfWidthXY   2;
      flowRateEnabled    true;   // volumetric flow rate + wet area at the probe X planes (Evaluators.h flowRateAt)

      pillarUpstreamPos    < 280, 36, 40 >;
      pillarDownstreamPos  < 500, 36, 40 >;
   }
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   // CylinderPillars only gives DEM contact; this BodyBC makes the pillar solid for the fluid (full height Z 0..90).
   BodyBC { shape Cylinder; min < 384, 20, 0 >; max < 384, 20, 90 >; radius 12; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

// fluid_field writeFrequency = timesteps/5: dumps at 0, 24950, 49900, 74850, 99800 (the main loop ends at
// timesteps - 1, so the final state is not written).
VTK
{
   fluid_field
   {
      writeFrequency       24950;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         mapped_flag;
      }

      // zero the stale velocity/density in gas and obstacle cells, which otherwise show as noise in ParaView
      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
