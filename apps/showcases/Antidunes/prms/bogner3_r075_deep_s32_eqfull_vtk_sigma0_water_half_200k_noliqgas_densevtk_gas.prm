// bogner3_r075_deep_s32_eqfull_vtk_sigma0_water_half_200k_noliqgas_densevtk_gas.prm -- free floating
// cuboid after Bogner (2017) Sec. 5.3.3, densityRatio 0.75, s = 32, with whole-domain VTK.
// Box s x 2s x s = 32 x 64 x 32 cells (halfExtents <16,32,16>, long axis Y), seed heel 2.86 deg about Y.
// _half: released with the centre on the still-water level 60.0746 (half submerged), the same start for all three
// densities, i.e. not at the rho 0.25/0.75 draft. Heave and X/Y translation free, roll about Y only
// (pinRotationAxes <1,0,1>). Periodic in x and y (no N/S walls), no-slip T/B.
// Basin <192,90,120>: the s=16 basin <96,45,60> doubled in every direction (Bogner's own s=16
// basin is 130x40x40), liquidHeightFactor 10 -> still-water level 60.0746. bedCopiesInX/Y = 2 (doubled with the domain) keep
// avgParticleDiameter, dx_SI and dt_SI at the s=16 values (getAvgDiameterScalingFactor, Utility.h, scales with
// domainSize / bedCopies), so gravityOverride 5.06585e-05 is still g_SI = 9.81 m/s^2. cellsPerBlock <32,15,15> ->
// 6x6x8 = 288 processes.
// Viscosity of water (useHardcodedUnits, nu_LU 2.14026e-4, no relaxationRateOverride), as in the sphere/cylinder
// runs.
// _sigma0: surface tension off. _strict: Bogner's classification rule for freed cells applied literally;
// _noliqgas: a freed cell decided liquid that touches gas becomes interface instead.
// seedSkipObstacleNeighbours false (obstacle-flagged interface neighbours count in the FormerMO fill seeding);
// momentum-budget diagnostic on.
// 200000 steps, checkpoint every 50000. VTK of the whole domain (velocity, fill_level, mapped_flag) only at the
// fluid_field_snapshots steps; _densevtk: 3, 4, 5, 6, 17 (the early frames of the sphere/cylinder runs), then
// 1000 ... 199999. Own snapshot folder (a new run, not a resume). Eval and water height every 250 steps, density
// column over the last 2000 steps.
// Derived from bogner3_r075_deep_s32_100k_gas.prm.
BlockForestParameters
{
   cellsPerBlock                 < 32, 15, 15 >;
   periodicity                   < 1, 1, 0 >;   // periodic in x and y
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             50000;
   snapshotBaseFolder            snapshots_b3_r075_s32_100k_eqfull_pxy_sigma0_water_half_200k_noliqgas_densevtk;
}

DomainParameters
{
   domainSize         <192, 90, 120>;
   wavePeriods        1;
   liquidHeightFactor 10.0;   // nominal (doubled basin)
   floorHeightFactor  0.01;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   surfaceTensionOverride 0;   // _sigma0: surface tension (Laplace pressure) off
   enableWetting          false;
   timesteps              200000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;         // physical constants valid while U = 0; viscosity 0.000214026 (LU)
   gravityOverride        5.06585e-05;  // g_SI = 9.81 m/s^2 at this dx_SI/dt_SI (see header)
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 2;   // doubled with domainSize, so avgParticleDiameter (6.00146), dx_SI and dt_SI keep their s=16
   bedCopiesInY 2;   // values (getAvgDiameterScalingFactor, Utility.h); with 1 copy gravityOverride would not be 9.81
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // free box s=32 (32 x 64 x 32), roll about Y only, heave + X/Y translation free, seed heel 2.86 deg
      position             < 96, 45, 60.0746 >;   // _half: centre on the still-water level
      halfExtents          < 16, 32, 16 >;
      densityRatio         0.75;
      settlingSteps        0;
      initialTiltAngleDeg  2.86;
      comOffsetZ           0;
      pinPosition          false;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
}

ModelParameters
{
   seedSkipObstacleNeighbours false;   // obstacle-flagged interface neighbours count in the fill seeding
   strictBognerClassification true;   // _strict: Bogner's freed-cell rule literally
   strictBognerNoLiquidAtGas true;   // _noliqgas: no new liquid next to gas
   logMomentumBudget true;   // [MOMENTUM-BUDGET] diagnostic
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   repairDegenerateObstaclePdfs  false;   // Option B (obstacle-cell repair guard) OFF
   seedStreamPdfCloneOnFirstUse  false;   // Option A (scratch PDF clone seeding) OFF

   logDensityColumn              true;
   densityColumnBaseFolder       density-column;
   densityColumnX                5;
   densityColumnY                45;
   logDensityColumnStartStep     198000;
   logDensityColumnEndStep       199999;

   // fill-integrated water height on a 12 x 3 grid of columns (x = 8, 24, ..., 184; y = 15, 45, 75) every 250 steps
   // over the whole run
   logWaterHeight                true;
   waterHeightBaseFolder         water-height;
   waterHeightGridX              12;
   waterHeightGridY              3;
   waterHeightEveryNSteps        250;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     250;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   // whole domain, velocity + fill_level + mapped_flag, only at the fluid_field_snapshots steps
   fluid_field
   {
      writeFrequency       0;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }
      before_functions { gas_cell_zero_setter; }
   }
   fluid_field_snapshots
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;
      steps "3,4,5,6,17,1000,2000,4000,8000,20000,40000,70000,80000,100000,120000,140000,180000,199999";
      writers
      {
         velocity;
         fill_level;
         mapped_flag;
      }
      before_functions { gas_cell_zero_setter; }
   }
   domain_decomposition
   {
      writeFrequency             0;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
