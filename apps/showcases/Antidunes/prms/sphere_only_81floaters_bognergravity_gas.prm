// sphere_only_81floaters_bognergravity_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// 81 SPHERES (same all-sphere conversion of the proven-clean 81-floater grid
// as sphere_only_81floaters_realgravity981_gas.prm), but using BOGNER'S OWN
// gravity+viscosity pair (gravityOverride=1.66667e-4, relaxationRateOverride=
// 1.9) instead of real 9.81 m/s^2 -- identical physics to the concurrently-
// running mixed_shape_stillwater_81floaters_bogner_gas.prm (job 3996932).
//
// PURPOSE: isolate shape as a variable. Two runs already completed under
// real 9.81 gravity (job 3996320, 100 spheres; job 3996951, this same
// 81-sphere layout) both crashed at nearly the SAME timestep (~9524/50000
// and ~9567/100000 respectively) with a NaN hydrodynamic force at a particle
// near the free surface -- strong evidence the crash is tied to gravity
// magnitude/impact dynamics at first water contact, not to any one packing.
// Job 3996932 (mixed shapes, Bogner's gravity+viscosity) has run stably well
// past that step count. This run tests whether SPHERES SPECIFICALLY are also
// stable under Bogner's gravity+viscosity (expected: yes, if the earlier
// diagnosis is right that gravity+damping is the real variable, not shape).
//
// timesteps 100000 (unchanged). Domain: <128, 60, 180> / cellsPerBlock
// <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic — no side walls, only Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              100000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants (surfaceTension) valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526, same as job 3996932
   gravityOverride        1.66667e-4;  // Bogner's g=7.5e-4 rescaled by 40/180 for this domain height,
                                       // identical to mixed_shape_stillwater_81floaters_bogner_gas.prm
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere { position < 6, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 6, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 30, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 16, 50, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
   FloatingSphere { position < 26, 10, 64 >; radius 4.5; densityRatio 0.5; settlingSteps 0; }
