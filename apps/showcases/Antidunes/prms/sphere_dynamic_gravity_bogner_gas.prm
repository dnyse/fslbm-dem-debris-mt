// sphere_dynamic_gravity_bogner_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FREE-FLOATING SPHERE, DYNAMIC (Fr-derived) GRAVITY, BOGNER BUOYANCY, WITH FLOW.
//
// Unlike sphere_waterlevel_sweep_*_bogner_gas.prm and
// sphere_density_showcase_bogner_domain_matched_gas.prm (both of which use
// gravityOverride/relaxationRateOverride = Bogner's own g=7.5e-4, tau=1.9, and
// still water, targetMeanVelocityMagnitude=0), THIS run uses none of those
// overrides: useHardcodedUnits/gravityOverride/relaxationRateOverride are all
// omitted, so gravity is computed the project's own way --
//   gravity = (U/Fr)^2 / liquidHeight
// (SimulationParams.h ComputedParams, dynamic branch) -- and
// targetMeanVelocityMagnitude is set to 0.02 (this project's standard E1 mean
// flow velocity, matching Antidunes_bogner.prm), so the PID controller is
// actually active and driving a real mean flow via accelerationX, rather than
// being a no-op at U=0.
//
// Re/Fr/We are E1 (matches Antidunes_bogner.prm: Re=3100, Fr=1.31, We=15.6188).
// With this domain's liquidHeight ~19.941 (liquidHeightFactor 3.3227, same as
// the mid water-level-sweep case), the dynamic formula gives
//   gravity = (0.02/1.31)^2 / 19.941 ~= 1.169e-5
// i.e. ~64x smaller than Bogner's own g=7.5e-4, and ~1.7x larger than this
// project's hardcoded reference (7.02618e-06, which was derived at
// liquidHeight ~33.174 for the full antidune domain) -- this run uses whatever
// value the dynamic formula actually produces for THIS domain, not a fixed
// constant.
//
// Buoyancy model: useBognerThreePhaseMEM + useMemOnlyBuoyancy (both true) --
// Bogner & Rude (2013) Eq. 5.9's three-phase MEM force computed directly from
// real boundary-link fluid PDFs, no explicit hydrostatic-density subtraction.
//
// Sphere: single FloatingSphere, densityRatio 0.5 -> Archimedes equilibrium
// predicts 50% submerged, independent of gravity's magnitude (the force
// balance vSub/vFull = rho cancels g -- see project notes) and, per the
// water-level sweep, independent of absolute water depth too. This run tests
// whether that still holds once gravity is dynamically computed AND a real
// mean flow (U=0.02) is superimposed, instead of still water.
//
// pinPosition/pinRotation both false: fully free (per request) -- the sphere
// drifts downstream with the flow (X is periodic, so this is safe), can wander
// laterally in Y (bounded by the NoSlip N/S walls, domain width 45), and can
// roll/tumble freely, on top of the vertical buoyancy motion. Unlike the
// earlier X/Y-pinned version, submersion can no longer be read off from a
// fixed (x, y) column alone -- track the sphere's own z (and, if relevant, its
// distance from the N/S walls) via its logged position instead.
//
// timesteps 30000 (per request).
//
// Domain: <96, 45, 40> / cellsPerBlock <16, 15, 10> = 6×3×4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 10 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 45, 40>;
   wavePeriods        1;
   liquidHeightFactor 3.3227;    // -> liquidHeight ~19.941 (same as water-level-sweep MID)
   floorHeightFactor  0.01;      // -> floorHeight ~0.060 (kept nonzero only to satisfy the != 0 assertion)
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;    // real mean flow active (E1), matches Antidunes_bogner.prm
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              30000;
   Re                     3100;       // E1
   Fr                     1.31;       // E1
   We                     15.6188;    // E1
   // no useHardcodedUnits / gravityOverride / relaxationRateOverride -- gravity
   // and relaxationRate are both computed dynamically from Re/Fr/We/liquidHeight
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingSpheres
{
   FloatingSphere
   {
      // densityRatio 0.5 -> Archimedes equilibrium: 50% submerged.
      position     < 48, 22.5, 20 >;
      radius       8;
      densityRatio 0.5;
      settlingSteps 0;
      pinPosition  false;   // fully free: drifts with the flow, no axis held
      pinRotation  false;   // fully free: rolls/tumbles under hydrodynamic torque
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy             true;
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for the sphere
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       2000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 22, 0 >;  max < 96, 23, 40 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 45, 40 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 96, 45, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
