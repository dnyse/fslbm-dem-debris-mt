// bogner_exact_3box_s16_rho0767_tilt26p565_fresh0_hotspot_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-24] Companion to bogner_exact_3box_s16_rho0767_tilt26p565_resume400_hotspot_gas.prm
// (which RESUMES from the step_400 checkpoint) -- this one runs the IDENTICAL scenario completely
// FRESH from t=0 (loadSnapshot false), with the SAME widened hot-spot VTK region (X=8,Z=26 and
// X=0,Z=25 columns, Y=0-8) at writeFrequency=1, so both a resumed-from-checkpoint attempt and a
// from-scratch attempt can be compared directly against each other -- same physics, same seed, only
// the starting point (checkpoint vs. t=0) differs. Of 4 resume attempts so far, 3 crashed at exactly
// step 444 (reynoldsNumber nan) and 1 (the first widened-VTK diagnostic) ran cleanly past it -- this
// checks whether a from-scratch run shows the same step-444 sensitivity and whether the fine-grained
// VTK trace from t=0 reveals anything the resume-only trace (steps 400+) couldn't.
//  * loadSnapshot false, storeSnapshot true (normal periodic checkpointing, snapshotFrequency 10000).
//  * timesteps 1000 -- safe margin past step 444 without paying for the full 50k run at
//    writeFrequency=1 (would be excessive I/O for a diagnostic run).
//  * Everything else identical to the original tilt26p565 50k prm: basin 130x40x40, ONE box
//    halfExtents<8,16,8> at rho=0.7665, tau=1/1.9, gravityOverride 0.00075, fully free 6-DOF,
//    initialTiltAngleDeg 26.565 (released AT the theoretical equilibrium).
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 10, 8, 40 >;
   periodicity                   < 1, 1, 0 >;   // X and Y periodic, Z floor/ceiling
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <130, 40, 40>;
   wavePeriods        1;
   liquidHeightFactor 1.25;
   floorHeightFactor  1.25;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              1000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;
   relaxationRateOverride 1.9;
   gravityOverride        0.00075;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8;
   dxSIOverride                0.0004;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      position             < 21.6667, 20, 16 >;
      halfExtents          < 8, 16, 8 >;
      densityRatio         0.7665;
      settlingSteps        0;
      initialTiltAngleDeg  26.565;
      comOffsetZ           0;
      pinPosition          false;
      pinRotation          false;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;
   useBognerThreePhaseMEM        true;
   useMemOnlyBuoyancy            true;
   useAnalyticBoxBuoyancy        false;
}

EvaluationParameters
{
   performanceLogFrequency 5000;
   evaluationFrequency     1;
   dataSliceFrequency      500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
         mapped_flag;
         density;
      }

      // same widened hot-spot region as the resume400_hotspot companion prm
      CellBB_filter_0 { min < 0, 0, 18 >;  max < 16, 10, 32 >; }

      inclusion_filters
      {
         CellBB_filter_0;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
