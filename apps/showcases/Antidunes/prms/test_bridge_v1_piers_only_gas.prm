// test_bridge_v1_piers_only_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// FIRST TEST BRIDGE, v1: two round piers + real fluid flow, NO deck, NO arch
// curve, NO floaters/debris yet. Small scale, single block (1 process) for
// fast iteration -- NOT the real bridge dimensions (Pont ferroviere, Rue
// Goffontaine, Trooz -- pier spacing ~8.9m, length ~31.7m, arched openings) --
// this is a topology/setup shakedown before scaling up.
//
// WHY NO ARCH/DECK YET (real architectural constraint, not an oversight):
// checked src/geometry/initializer/BoundaryFromBody.impl.h -- the BodyBC
// mechanism only supports Cylinder, Sphere, Ellipsoid as solid shapes (no
// Box/Plane shape at all), and each BodyBC block purely ADDS solid cells --
// there is no boolean subtraction between shapes, so there's no way to carve a
// curved tunnel out of a solid deck/spandrel mass with the existing machinery.
// A real arch + deck needs new C++ (either a new partial-cylinder-arc Body
// class, reusing this session's polygon-of-planes drum-wall technique adapted
// to LBM boundary flags, or a subtraction-capable initializer) -- a real
// follow-up task, not prm-level work. This v1 is deliberately just the piers
// (Cylinder BodyBC, already fully supported) so we have a running, fluid-
// coupled baseline to build the arch/deck onto once that C++ work is done.
//
// Domain: <64, 30, 90>, cellsPerBlock <64, 30, 90> = 1x1x1 = 1 process (single
// block, no MPI decomposition needed for this small shakedown test).
//
// Scaling: domainSize[0]=64 is exactly half the 128 used by the 100-sphere
// reference runs this session already established avgParticleDiameter=8.00194
// for -- so here (half the resolution) avgParticleDiameter=4.00097,
// liquidHeight=4.00097*2.862=11.45, floorHeight=4.00097*4.1393=16.56, surface
// Z=floorHeight+liquidHeight=28.02 (same liquidHeightFactor/floorHeightFactor
// as those reference runs, 2.862/4.1393).
//
// Piers: radius 4 (half the established radius=8 pillar convention, scaled to
// match this half-resolution domain), centers Y=8 and Y=22 (wall gaps 4 LU
// each, inter-pier gap 6 LU -- no floaters yet so exact margins don't matter
// for this shakedown run). Positioned mid-domain in X (periodic flow
// direction) at X=40.
//
// PID: same modest current (targetMeanVelocityMagnitude 0.02) as the existing
// two-pillar tests, so there's an actual flow past the piers to observe.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 30, 90 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <64, 30, 90>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         10000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar
   {
      center < 40, 8, 45 >;
      radius 4;
   }
   CylinderPillar
   {
      center < 40, 22, 45 >;
      radius 4;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   usePass3Reresolution          true;
}

EvaluationParameters
{
   performanceLogFrequency 2000;
   evaluationFrequency     500;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
   BodyBC { shape Cylinder; min < 40, 8, 0 >;  max < 40, 8, 90 >;  radius 4; NoSlip{} }
   BodyBC { shape Cylinder; min < 40, 22, 0 >; max < 40, 22, 90 >; radius 4; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       500;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
         fill_level;
      }

      CellBB_filter_0 { min < 0, 14, 0 >; max < 64, 15, 90 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;  max < 1, 30, 90 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;  max < 64, 30, 90 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
