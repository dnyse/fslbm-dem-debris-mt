// cylinder_density_showcase_bogner_domain_matched_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// BUOYANCY SHOWCASE (cylinder/log), BOGNER THREE-PHASE MEM variant, GRAVITY +
// DOMAIN MATCHED TO BOGNER'S OWN VALIDATION regime, exactly the same treatment
// as sphere_density_showcase_bogner_domain_matched_gas.prm (job 3908647, which
// converged to within 0.6 percentage points of the target density ratios —
// see that file's header for the full derivation). Same cylinder geometry as
// cylinder_density_showcase_gas.prm (three identical logs, radius 8, length
// 24, axis <0,1,0>, densityRatio 0.25/0.5/0.75, pinned in X,Y), but:
//
//   1. ModelParameters: useBognerThreePhaseMEM + useMemOnlyBuoyancy both true
//      (Bogner & Rude 2013's original three-phase MEM force, no rhoHydStat
//      subtraction, no separate analytic vSub*g force channel).
//   2. PhysicsParameters: gravityOverride 7.5e-4, relaxationRateOverride 1.9 --
//      matches Bogner's own validated regime (g=7.5e-4, tau=1/1.9=0.526)
//      instead of this project's own Fr-derived antidune-flow gravity
//      (~100x weaker).
//   3. Domain reused VERBATIM from the sphere run: <96, 45, 40> /
//      cellsPerBlock <16, 15, 10> = 6x3x4 = 72 processes. Same domain X:Y
//      lock applies here too (Utility.h::getAvgDiameterScalingFactor), so
//      this is the same closest-compatible footprint as the sphere case --
//      no need to re-derive it.
//
// GEOMETRY FIT CHECK (why radius/length did NOT need to change, unlike the
// sphere's radius 12->8 cut): the cylinder test already used radius 8 in the
// original (128,60,180) domain -- coincidentally already matching the radius
// the sphere run had to shrink DOWN to. Only the length (24, along Y) needed a
// clearance check against the new, smaller Y domain (60->45): centred at
// Y=22.5 (half of 45, matching the sphere layout's Y centreline), half-length
// 12 leaves 22.5-12 = 10.5 LU clearance to each N/S wall -- still positive and
// safe (no change needed to radius or length).
//
// Layout (X positions copied directly from the sphere run -- same domain
// footprint, same 32-LU spacing, same clearances):
//   • densityRatio 0.25: position (16, 22.5, 20)
//   • densityRatio 0.50: position (48, 22.5, 20)
//   • densityRatio 0.75: position (80, 22.5, 20)
//   32 LU apart, radius 8 -> 16 LU clearance between neighbours' X-footprint;
//   8 LU clearance to the periodic X boundary (image 96 LU away, no overlap).
//
// Domain: <96, 45, 40> / cellsPerBlock <16, 15, 10> = 6x3x4 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 16, 15, 10 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <96, 45, 40>;
   wavePeriods        1;
   liquidHeightFactor 3.3227;   // -> liquidHeight ~19.941 with avgParticleDiameter ~6.0015 (see sphere file)
   floorHeightFactor  0.01;     // -> floorHeight ~0.060 (kept nonzero only to satisfy the != 0 assertion)
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0;       // still water — no flow forcing
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting          false;
   timesteps              30000;
   Re                     3100;
   Fr                     1.31;
   We                     15.6188;
   useHardcodedUnits      true;        // keep physical constants valid while U = 0
   relaxationRateOverride 1.9;         // matches Bogner's tau=1/1.9=0.526
   gravityOverride        7.5e-4;      // matches Bogner's g
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingCylinders
{
   FloatingCylinder
   {
      position             < 16, 22.5, 20 >;
      radius               8;
      length               24;
      axis                 < 0, 1, 0 >;
      densityRatio         0.25;
      settlingSteps        0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;   // free "roll" about Y — physically inert here (circular
                                          // cross-section), kept only for parity with the box test
   }
   FloatingCylinder
   {
      position             < 48, 22.5, 20 >;
      radius               8;
      length               24;
      axis                 < 0, 1, 0 >;
      densityRatio         0.5;
      settlingSteps        0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
   FloatingCylinder
   {
      position             < 80, 22.5, 20 >;
      radius               8;
      length               24;
      axis                 < 0, 1, 0 >;
      densityRatio         0.75;
      settlingSteps        0;
      comOffsetZ           0;
      pinPosition          true;
      pinAxes              < 1, 1, 0 >;
      pinRotation          true;
      pinRotationAxes      < 1, 0, 1 >;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
   useFillWeighting              true;   // Eq. 5.9's phi(x_b) blend -- already the default, kept explicit here
   useBognerThreePhaseMEM        true;   // no rhoHydStat subtraction at all (see header)
   useMemOnlyBuoyancy             true;   // no separate vSub*g force channel (see header)
   useAnalyticBoxBuoyancy        false;  // cylinders always use point-sampling (no closed-form oblique clip)
   boxPlaneFitBandFactor         2.0;    // widened reach (see changes.md box-stillwater-showcase investigation)
   writeFloaterPlaneVTK          true;   // emit planeOrigin/planeNormal for each log
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      CellBB_filter_0 { min < 0, 22, 0 >;  max < 96, 23, 40 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 45, 40 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 96, 45, 40 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
