// hopper_clog_cyl_dropwaves_capsule_gas.prm   (hand-derived from hopper_clog_cyl_dropwaves_gas.prm -- only ModelParameters.useCapsuleShapeForCylinders differs)
// ─────────────────────────────────────────────────────────────────────────────
// [Claude, 2026-09-26] CAPSULE-SHAPE EXPERIMENT, per explicit request ("try and wire in the pill
// shaped cylinder"): identical to hopper_clog_cyl_dropwaves_gas.prm (job 4267519, which crashed at
// step ~22037 via a 90%-overlap rod-rod contact-resolution failure in a "band-band-skewed" scenario
// -> MEM-GARBAGE-LINK -> LOW-RHO -> NaN force/torque -> invalid quaternion abort), EXCEPT
// ModelParameters.useCapsuleShapeForCylinders is now true: rod floaters are constructed as
// mesa_pd::data::Capsule (cylinder + hemispherical end caps, SHAPE_TYPE 7) instead of Cylinder.
// Same (radius, length, axis, position, densityRatio, settlingSteps) -- only the mesa_pd shape
// differs (SetupStages.h). No analytic Capsule-Capsule contact routine exists, so every capsule
// pair falls through to generic GJK/EPA (mesa_pd::collision_detection::GeneralContactDetection) --
// a continuous closest-point-between-segments calculation with no flat-cap/rim edge case, unlike
// the analytic Cylinder-Cylinder Kodam+Guo dispatch this scenario otherwise uses. Run on the SAME
// fixes-off mirror/build as job 4267519 (Option A/B and the SimpleBB.h guard all still reverted) so
// any difference in outcome is attributable ONLY to the shape change, not a confound with today's
// other mitigations. See THESIS_PLAN.md.
//
// [Claude, 2026-09-25] "DROP WAVES" cylinder hopper, per explicit request: same 210-rod population
// as the halfrows block scenario (2 across Y x 7 layers x 15 rows, same densities), but
// released as 6 waves of up to 36 rods (6 x 2 x 3) dropped from ABOVE the water
// surface (drop layers Z=[55.1, 62.1, 69.1, 76.1, 83.1, 90.1, 97.1], surface Z=49.13) at the UPSTREAM end of
// the channel (drop zone X=[9.0,113.0], 271.0 LU clear of the
// pillars at X=384) -- similar in spirit to the sphere clogging scenario's staggered
// startInactive+settlingSteps release ladder. Each wave falls through the air, lands in the
// PID-driven flow, and is carried downstream toward the pillars -- any clog has to develop from
// flow-driven transport and pile-up, not a pre-arranged block. Wave releases at steps
// [2000, 5000, 8000, 11000, 14000, 17000] (hold=2000, interval=3000);
// 30000 total timesteps.
//
// THIS RUN IS EXPLICITLY REQUESTED WITH ALL OF THIS SESSION'S 2026-09-25 CRASH-MITIGATION FIXES
// DISABLED (Option A in StreamReconstructAdvectSweep.h, Option B/repairDegenerateObstacleCells in
// SetupStages.h+BuildTimeloop.h, the SimpleBB.h [MEM-GARBAGE-LINK] active guard) -- a genuine
// pre-session baseline for this NEW release mechanic, not validated against any of today's fixes.
// See THESIS_PLAN.md for the disable-patch details and which mirror this was run on.
//
// Same channel/pillars/PID/physics/contact-model as the halfrows block scenario
// (hopper_clog_cyl_frontblock_pidon_2node_halfrows_gas.prm) otherwise -- domain
// <768,40,180>, 144 ranks/2 nodes, PID target 0.04, Re/Fr/We unchanged.
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 64, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             5000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <768, 40, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.0;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.04;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
   enabled                     true;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         30000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits false;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   avgParticleDiameterOverride 8.001943372119138;
   dxSIOverride                0.000362694127490625;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.5;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

CylinderPillars
{
   CylinderPillar { center < 384, 0, 45 >; radius 12; }
   CylinderPillar { center < 384, 40, 45 >; radius 12; }
}

