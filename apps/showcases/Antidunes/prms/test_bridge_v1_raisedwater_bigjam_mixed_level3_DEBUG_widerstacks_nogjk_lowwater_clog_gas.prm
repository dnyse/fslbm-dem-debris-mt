// test_bridge_v1_raisedwater_bigjam_mixed_level3_DEBUG_widerstacks_nogjk_lowwater_clog_gas.prm
// ──────────────────────────────────────────────────────────────────────────────
// GUARANTEED-CLOGGING variant of test_bridge_v1_raisedwater_bigjam_mixed_level3_DEBUG_widerstacks_nogjk_lowwater_gas.prm
// (job 4167764, COMPLETED cleanly at 100000 steps, liquidHeightFactor=2.0 unchanged here). Two
// changes from that file:
//   1. Boxes only -- FloatingSpheres removed entirely (already had no FloatingCylinders). Every
//      floater in this scenario is now a FloatingBox, matching the "all only cuboids" request.
//   2. Aim-point grid DOUBLED and wave count DOUBLED+ to force sustained jamming at every arch
//      rather than clean single-file passage: BOTH upstream rows (X=15 and X=40) now feed EVERY
//      Y aim-point (the original file only put row1 at Y=5/17/30/43/55 and row2 at Y=11/24/36/49,
//      9 non-overlapping points total) -- 18 aim points total, spanning all 3 arches: left arch
//      centre (Y=5), central arch's own 20 LU span sampled at 3 points (Y=24/30/36) instead of
//      just its centre, right arch centre (Y=55), plus the 4 existing pier-adjacent points
//      (Y=11/17/43/49). Each point gets 15 waves (up from 6) at the SAME 9000-step intra-point
//      gap already proven safe across every successful run this session (gap itself unchanged --
//      only point count and wave count increased) -- first wave at step 5000, last at 131000.
//      18 points x 2 rows... already counted x 15 waves = 270 total boxes (was 54).
// timesteps bumped 100000 -> 150000 to give the accumulated jam time to actually develop and
// hold after the last release wave (131000) instead of ending right as it's forming.
// Everything else (domain, liquidHeightFactor=2.0, piers, arches, numSubCycles, maxOverlap clamp,
// no floating cylinders, useAnalyticalContactDetection, useArchTunnelAsMesaPDObject) is
// byte-identical to the lowwater file.
// ──────────────────────────────────────────────────────────────────────────────


BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 15 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 90>;
   wavePeriods        1;
   liquidHeightFactor 2.0;  // LOW-WATER variant -- see this file's own header; absoluteLiquidHeight~49.1, below the springing line (56)
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.01;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         150000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
   useHardcodedUnits true;
   // no gravityOverride -- dynamically computed gravity
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.3; // wet/waterlogged wood-wood -- these are floating logs, soaked, not dry timber
   numSubCycles 40; // unchanged from the base widerstacks file -- see that file's own header for the
                     // 10->20->30->40 history.
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

// DEM bodies matching the BodyBC piers exactly (BodyBC is LBM-only -- floaters need a real mesa_pd
// body to collide with, and nothing else creates one). 4 cylinders (the piers' round end-caps,
// radius 5) + 2 boxes (the connecting box between them, halfExtents = half of X=61-67/Y=10-20-or-
// 40-50/Z=0-76). center Z is cosmetic (CylindricalBoundary is infinite along its axis).
CylinderPillars
{
   CylinderPillar { center < 61, 15, 38 >; radius 5; }
   CylinderPillar { center < 67, 15, 38 >; radius 5; }
   CylinderPillar { center < 61, 45, 38 >; radius 5; }
   CylinderPillar { center < 67, 45, 38 >; radius 5; }
}

Pillars
{
   Pillar { center < 64, 15, 38 >; halfExtents < 3, 5, 38 >; }
   Pillar { center < 64, 45, 38 >; halfExtents < 3, 5, 38 >; }
}

// One entry per arch, matching the BodyBC arch cylinders below exactly (center Y/Z, radius).
// xMin/xMax DELIBERATELY set to the piers' own straight-box span (61..67).
ArchTunnels
{
   ArchTunnel { center < 0, 5, 56 >;  radius 5;  xMin 61; xMax 67; deckTopZ 76; }  // left arch
   ArchTunnel { center < 0, 30, 56 >; radius 10; xMin 61; xMax 67; deckTopZ 76; }  // central arch
   ArchTunnel { center < 0, 55, 56 >; radius 5;  xMin 61; xMax 67; deckTopZ 76; }  // right arch
}

