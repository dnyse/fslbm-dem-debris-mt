// giant_log_righting_gas.prm
// ─────────────────────────────────────────────────────────────────────────────
// CLEAN RIGHTING test for the giant floating LOG — isolates the lowered-COM righting
// torque from impact dynamics. Unlike giant_log_drop_gas.prm (which drops the log 37 LU
// onto the surface and the violent splashdown tumbles it before GM can act), here the log
// STARTS half-submerged at the equilibrium depth (centre at the waterline, z≈56) with a
// 15° tilt and essentially zero translational energy. The ONLY thing acting on its
// orientation is the metacentric/COM righting torque, so we see directly whether it damps
// the 15° tilt back to upright.
//
//   • halfExtents <6,18,6> (12×36×12 log), densityRatio 0.5 → 50%-submerged equilibrium
//     → centre sits AT the surface (z≈56), so it starts half-submerged, no plunge.
//   • initialTiltAngleDeg 15: seeded roll about Y. comOffsetZ -3 → KG=3, GM=+2 (stable).
//   • settlingSteps 2000: held FIXED (tilted, half-submerged) while the free surface and
//     contact line establish around it; then released to right itself from rest.
//   • NO pillars (clean water). The log advects downstream in periodic X while it rights —
//     read the ORIENTATION from [BoxBuoyancy] tiltY, not X.
//
//   EXPECTED: after release, tiltY decays 15° → 0 (damped, possibly with a few small
//   overshoots) and submersion stays ≈50%. If instead tiltY grows/keeps rolling here —
//   where there is no impact energy to blame — the righting torque has a sign/magnitude
//   bug. Set comOffsetZ 0 to confirm the uniform log rolls (control case).
//
// Domain: <128, 60, 180> / cellsPerBlock <32, 20, 30> = 4×3×6 = 72 processes
// ─────────────────────────────────────────────────────────────────────────────

BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 0, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;
   liquidHeightFactor 2.862;
   floorHeightFactor  4.1393;
   initialAmplitude   0;
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;    // master velocity scale — must stay > 0
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;
   Fr                1.31;
   We                15.6188;
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1;
   densityRatio 2.55;
   fixingHeightFactor 1.5;
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed false;
}

FloatingBoxes
{
   FloatingBox
   {
      // GIANT log: 12×36×12 (halfExtents 6×18×6). Centre at (30,30,56): the box centre sits
      // ON the free surface (z≈56) so it starts ≈50% submerged — no free-fall, no splashdown.
      // Rotation about Y keeps the y-extent at ±18 → y∈[12,48] → ≈12 LU clear of the N/S walls.
      position             < 30, 30, 56 >;
      halfExtents          < 6, 18, 6 >;
      densityRatio         0.5;
      settlingSteps        2000;     // hold tilted & half-submerged while the surface settles, then release
      initialTiltAngleDeg  15;       // seeded roll about Y to be damped out
      // Lower the COM so the log self-rights. Half-submerged, rolling about Y: draft d=6 →
      // KB=3, BM=L²/(12d)=12²/72=2, KG=6 (uniform) → GM=−1 (rolls). comOffsetZ=−3 → KG=3 →
      // GM=+2 (stable). Set to 0 for the uniform-log control (should roll over).
      comOffsetZ           -3;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }
   Border { direction N;  walldistance -1; NoSlip{} }
   Border { direction S;  walldistance -1; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         velocity;
      }

      // Y-midplane slab (centred in 60-cell domain), X=0 face slice, full XY volume up to z=150.
      CellBB_filter_0 { min < 0, 29, 0 >;  max < 128, 30, 150 >; }
      CellBB_filter_1 { min < 0, 0, 0 >;   max < 1, 60, 150 >; }
      CellBB_filter_2 { min < 0, 0, 0 >;   max < 128, 60, 150 >; }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
      }

      before_functions { gas_cell_zero_setter; }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}
