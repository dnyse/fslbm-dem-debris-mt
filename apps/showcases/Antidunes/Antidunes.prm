BlockForestParameters
{
   cellsPerBlock                 < 32, 20, 30 >;
   periodicity                   < 1, 1, 0 >;
   loadSnapshot                  false;
   storeSnapshot                 true;
   snapshotFrequency             10000;
   snapshotBaseFolder            snapshots;
}

DomainParameters
{
   domainSize         <128, 60, 180>;
   wavePeriods        1;         // never set to 0 -> division by zero, even if you initialize a flat particle bed
   liquidHeightFactor 2.862;     // h_0 / d (water height / avg particle diameter) -> from experiment [E1=2.862, E2=3.1724, E3=3.27586, E4=3.5862]
   floorHeightFactor  4.1393;    // (floor height / avg particle diameter) from domain bottom to sine's average
   initialAmplitude   0;         // defined from minimum peak to maximum peak as by Pascal et al. (2021)
}

PIDParameters
{
   targetMeanVelocityMagnitude 0.02;
   proportionalGain            2e-4;
   derivativeGain              1e-6;
   integralGain                2e-4;
   maxRamp                     1e-4;
   minActuatingVariable        0;
   maxActuatingVariable        1e-3;
}

PhysicsParameters
{
   enableWetting     false;
   timesteps         100000;
   Re                3100;       // [E1=3100, E2=3772, E3=4180, E4=4800]
   Fr                1.31;       // [E1=1.31, E2=1.38, E3=1.44, E4=1.45]
   We                15.6188;    // [E1=15.6188, E2=21.48, E3=25.54, E4=30.2493]
}

ParticleParameters
{
   inFileName spheres_out.dat;
   bedCopiesInX 1;
   bedCopiesInY 1; // scalingFactor=500, 500*0.015*8=60 matches domainY
   densityRatio 2.55;
   fixingHeightFactor 1.5; // proportional to the mean particle diameter
   frictionCoefficient 0.5;
   restitutionCoefficient 0.97;
   numSubCycles 10;
   useLubricationCorrection true;
   useNoSlipParticles false;
   useParticleBed true;
}

// Box pillars: both DEM (FixedBox) and LBM (NoSlip CellInterval) use rectangular geometry.
// Add or remove Pillar blocks to change the number of box pillars (zero is valid).
Pillars
{
   Pillar   // left pillar: Y=0-22, extends from Y=0 wall
   {
      center      < 64, 11.5, 60 >;
      halfExtents < 16, 11.5, 60 >;
   }
   Pillar   // right pillar: Y=37-59, slit = Y=23-36 (14 cells = 7*2, floater diameter=16 cannot pass)
   {
      center      < 64, 48.5, 60 >;
      halfExtents < 16, 11.5, 60 >;
   }
}

// Cylinder pillars: DEM uses CylindricalBoundary (exterior contact via SolidCylinderContactDetection);
// LBM uses a Body block with shape Cylinder in BoundaryParameters (see below).
// The cylinder spans the full domain height; end caps are the floor/ceiling NoSlip planes.
//CylinderPillars
//{
//   CylinderPillar
//   {
//      center < 64, 30, 60 >;   // XY position of the axis; Z is ignored for DEM (infinite along Z)
//      radius 10;
//   }
//}

FloatingSpheres
{
   FloatingSphere
   {
      position     < 15, 30, 47 >;
      radius       8;
      densityRatio 0.5;
   }
}

ModelParameters
{
   pdfReconstructionModel        OnlyMissing;
   pdfRefillingModel             EquilibriumRefilling;
   excessMassDistributionModel   EvenlyNewInterfaceFallbackLiquid;
   curvatureModel                FiniteDifferenceMethod;
   useSimpleMassExchange         false;
   cellConversionThreshold       1e-2;
   cellConversionForceThreshold  1e-1;
   // FormerMO (uncovered particle cell) reconstruction:
   //   true  = Bogner & Rüde (2013) per-cell gas/liquid/interface state selection.
   //   false = uniform all-interface reconstruction (no fill=1 over-promotion band).
   useBognerReconstruction       true;
}

EvaluationParameters
{
   performanceLogFrequency 10000;
   evaluationFrequency     1000;
   baseFolderName          eval;
}

StabilityChecker
{
   checkFrequency 0;
   streamOutput   false;
   vtkOutput      true;
}

BoundaryParameters
{
   // Z walls
   Border { direction T;  walldistance -1; NoSlip{} }
   Border { direction B;  walldistance -1; NoSlip{} }

   // Box pillar NoSlip: CellInterval min = center - halfExtents, max = center + halfExtents - 1
   // Left:  center <64,11.5,60>, halfExtents <16,11.5,60> → Y=0-22
   CellInterval { min < 48,  0, 0 >; max < 79, 22, 119 >; NoSlip{} }
   // Right: center <64,48.5,60>, halfExtents <16,11.5,60> → Y=37-59, slit Y=23-36 (14 cells = 7*2)
   CellInterval { min < 48, 37, 0 >; max < 79, 59, 119 >; NoSlip{} }

   // Cylinder pillar NoSlip: min/max are the axis endpoints (bottom and top of the cylinder).
   // BodyBC { shape Cylinder; min < 64, 30, 0 >; max < 64, 30, 120 >; radius 10; NoSlip{} }
}

MeshOutputParameters
{
   writeFrequency 0;
   baseFolder     mesh-out;
}

VTK
{
   fluid_field
   {
      writeFrequency       1000;
      ghostLayers          0;
      baseFolder           vtk-out;
      samplingResolution   1;
      useMPIIO false;

      writers
      {
         //fill_level;
         //mapped_flag;
         velocity;
         //density;
         //curvature;
         //normal;
         //obstacle_normal;
         //pdf;
         //flag;
         //force;
      }

      // X-Z midplane (y = 30, cuts through pillar centre)
      CellBB_filter_0 {
         min < 0, 29, 0 >;
         max < 128, 30, 150 >;
      }

      // Y-Z inlet plane
      CellBB_filter_1 {
         min < 0, 0, 0 >;
         max < 1, 60, 150 >;
      }

      // X-Y-Z volume around pillar: full domain in x and y, full z height
      CellBB_filter_2 {
         min < 0, 0, 0 >;
         max < 128, 60, 150 >;
      }

      inclusion_filters
      {
         CellBB_filter_0;
         CellBB_filter_1;
         CellBB_filter_2;
         //liquidInterfaceFilter; // only include liquid and interface cells in VTK output
      }

      before_functions
      {
         //ghost_layer_synchronization; // only needed if writing the ghost layer
         gas_cell_zero_setter;          // sets velocity=0 and density=1 all gas cells before writing VTK output
      }
   }

   domain_decomposition
   {
      writeFrequency             10000000000;
      baseFolder                 vtk-out;
      outputDomainDecomposition  true;
   }
}